   288	    return kTfLiteError;
   289	  }
   290	
   291	  // Match the four scratch buffers requested by TFLM's existing
   292	  // unidirectional FP32 LSTM implementation.
   293	  for (int i = 0; i < 4; ++i) {
   294	    if (context->RequestScratchBufferInArena(
   295	            context, internal_bytes,
   296	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   297	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   298	      return kTfLiteError;
