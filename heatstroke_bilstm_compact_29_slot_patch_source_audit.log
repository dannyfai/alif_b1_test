   179	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   180	                                                TfLiteNode* node) {
   181	  if (node == nullptr || node->builtin_data == nullptr ||
   182	      node->inputs == nullptr || node->outputs == nullptr ||
   183	      node->inputs->size != 29 || node->outputs->size != 1 ||
   184	      node->user_data == nullptr) {
   185	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   186	    return kTfLiteError;
   187	  }
   188	
   189	  auto* op_data =
   190	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   191	
   192	  const auto* params =
   193	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   194	          node->builtin_data);
   195	
   196	  if (!params->time_major || !params->merge_outputs ||
   197	      params->activation != kTfLiteActTanh) {
   198	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   199	    return kTfLiteError;
   200	  }
   201	
   202	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   203	  TfLiteEvalTensor* output =
   204	      context->GetEvalTensor(context, node->outputs->data[0]);
   205	
   206	  if (!IsFloatTensor(input) || !IsFloatTensor(output) ||
   207	      input->dims == nullptr || output->dims == nullptr ||
   208	      input->dims->size != 3 || output->dims->size != 3) {
   209	    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
   210	    return kTfLiteError;
   211	  }
   212	
   213	  const int time_steps = input->dims->data[0];
   214	  const int batch_size = input->dims->data[1];
   215	  const int input_dimension = input->dims->data[2];
   216	
   217	  // The supplied heat-stress model uses time-major, single-batch sequences.
   218	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   219	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   220	    return kTfLiteError;
   221	  }
   222	
   223	  int forward_hidden = 0;
   224	  int backward_hidden = 0;
   225	
   226	  if (!ValidateDirection(context, node, 1, 5, 9, 25, 26, input_dimension, batch_size, &forward_hidden) ||
   227	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   228	      forward_hidden != backward_hidden) {
   229	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   230	    return kTfLiteError;
   231	  }
   232	
   233	  const int hidden = forward_hidden;
   234	
   235	  if (output->dims->data[0] != time_steps ||
   236	      output->dims->data[1] != batch_size ||
   237	      output->dims->data[2] != 2 * hidden) {
   238	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   239	    return kTfLiteError;
   240	  }
   241	
   242	  // The directional evaluator must see [time_steps, batch_size, hidden],
   243	  // not the merged output shape [time_steps, batch_size, 2 * hidden].
   244	  const size_t staged_dims_bytes =
   245	      sizeof(TfLiteIntArray) + 2 * sizeof(int);
   246	  op_data->staged_output_dims =
   247	      static_cast<TfLiteIntArray*>(
   248	          context->AllocatePersistentBuffer(context, staged_dims_bytes));
   249	
   250	  if (op_data->staged_output_dims == nullptr) {
   251	    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
   252	    return kTfLiteError;
   253	  }
   254	
   255	  op_data->staged_output_dims->size = 3;
   256	  op_data->staged_output_dims->data[0] = time_steps;
   257	  op_data->staged_output_dims->data[1] = batch_size;
   258	  op_data->staged_output_dims->data[2] = hidden;
   259	
   260	  // Compact 29-slot model: no separate auxiliary input slots exist.
   261	
   262	  InitializeFloatLstmParameters(
   263	      &op_data->forward, true, batch_size, time_steps,
   264	      input_dimension, hidden, params->activation, params->cell_clip);
   265	
   266	  InitializeFloatLstmParameters(
   267	      &op_data->backward, true, batch_size, time_steps,
   268	      input_dimension, hidden, params->activation, params->cell_clip);
   269	
   270	  const size_t reverse_bytes =
   271	      static_cast<size_t>(time_steps) * batch_size *
   272	      input_dimension * sizeof(float);
   273	
   274	  const size_t stage_bytes =
   275	      static_cast<size_t>(time_steps) * batch_size *
