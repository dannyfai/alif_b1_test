   304	        op_data->forward.buffer_indices[i];
   305	  }
   306	
   307	  return kTfLiteOk;
   308	}
   309	
   310	void PopulateDirectionContents(TfLiteContext* context,
   311	                               TfLiteNode* node,
   312	                               int input_weight_base,
   313	                               int recurrent_weight_base,
   314	                               int bias_base,
   315	                               int hidden_state_position,
   316	                               int cell_state_position,
   317	                               const TfLiteEvalTensor* input,
   318	                               TfLiteEvalTensor* staged_output,
   319	                               LSTMKernelContents* contents) {
   320	  for (int i = 0; i < 24; ++i) {
   321	    contents->internal_tensors[i] = nullptr;
   322	  }
   323	
   324	  contents->internal_tensors[0] =
   325	      const_cast<TfLiteEvalTensor*>(input);
   326	
   327	  for (int gate = 0; gate < 4; ++gate) {
   328	    contents->internal_tensors[1 + gate] =
   329	        GetInputEvalTensor(context, node, input_weight_base + gate);
   330	
   331	    contents->internal_tensors[5 + gate] =
   332	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   333	
   334	    contents->internal_tensors[12 + gate] =
   335	        GetInputEvalTensor(context, node, bias_base + gate);
   336	  }
   337	
   338	  // Optional peephole, projection, and layer-normalization tensors
   339	  // are not present in this model and remain nullptr.
   340	
   341	  contents->internal_tensors[18] =
   342	      GetInputEvalTensor(context, node, hidden_state_position);
   343	
   344	  contents->internal_tensors[19] =
   345	      GetInputEvalTensor(context, node, cell_state_position);
   346	
   347	  contents->output_tensor = staged_output;
   348	}
