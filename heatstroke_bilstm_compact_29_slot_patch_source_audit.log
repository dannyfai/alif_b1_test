   386	  const float* input_data = input->data.f;
   387	  float* output_data = output->data.f;
   388	
   389	  // Reverse the time dimension for the backward direction.
   390	  for (int t = 0; t < time_steps; ++t) {
   391	    std::memcpy(
   392	        reversed_input + t * input_dimension,
   393	        input_data + (time_steps - 1 - t) * input_dimension,
   394	        input_dimension * sizeof(float));
   395	  }
   396	
   397	  TfLiteEvalTensor reversed_input_tensor = *input;
   398	  reversed_input_tensor.data.f = reversed_input;
   399	
   400	  TfLiteEvalTensor staged_output_tensor = *output;
   401	  staged_output_tensor.data.f = staged_output;
   402	  staged_output_tensor.dims = op_data->staged_output_dims;
   403	
   404	  LSTMKernelContents forward_contents{};
   405	  PopulateDirectionContents(context, node, 1, 5, 9, 25, 26, input, &staged_output_tensor, &forward_contents);
   406	
   407	  LSTMBuffers<float> buffers =
   408	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   409	
   410	  TfLiteStatus forward_status =
   411	      EvalLstm<float, float, float, float>(
   412	          op_data->forward, forward_contents, buffers);
   413	  if (forward_status != kTfLiteOk) {
   414	    return forward_status;
   415	  }
   416	
   417	  // Copy forward outputs into the first half of the merged output.
   418	  for (int t = 0; t < time_steps; ++t) {
   419	    std::memcpy(
   420	        output_data + t * (2 * hidden),
   421	        staged_output + t * hidden,
   422	        hidden * sizeof(float));
   423	  }
   424	
   425	  LSTMKernelContents backward_contents{};
   426	  PopulateDirectionContents(context, node, 13, 17, 21, 27, 28, &reversed_input_tensor, &staged_output_tensor, &backward_contents);
   427	
   428	  TfLiteStatus backward_status =
   429	      EvalLstm<float, float, float, float>(
   430	          op_data->backward, backward_contents, buffers);
   431	  if (backward_status != kTfLiteOk) {
   432	    return backward_status;
   433	  }
   434	
   435	  // Restore backward outputs to original time order and copy them
   436	  // into the second half of the merged output.
   437	  for (int t = 0; t < time_steps; ++t) {
   438	    std::memcpy(
   439	        output_data + t * (2 * hidden) + hidden,
   440	        staged_output + (time_steps - 1 - t) * hidden,
   441	        hidden * sizeof(float));
   442	  }
   443	
   444	  return kTfLiteOk;
   445	}
