98-TfLiteStatus UnidirectionalSequenceLstmEval(TfLiteContext* context,
99-                                            TfLiteNode* node) {
100-  TFLITE_DCHECK(node->user_data != nullptr);
101-  const OpDataLSTM& op_data = *reinterpret_cast<OpDataLSTM*>(node->user_data);
102-  auto kernel_content = CreateLSTMKernelContent(context, node);
103-
104-  const auto activation_type =
105-      kernel_content.internal_tensors[kLstmInputTensor]->type;
106-  const auto weight_type =
107-      kernel_content.internal_tensors[kLstmInputToInputWeightsTensor]->type;
108-
109-  switch (activation_type) {
110-    case kTfLiteFloat32: {
111-      LSTMBuffers<float> buffers =
112:          CreateLSTMBuffers<float>(context, op_data.buffer_indices);
113-      EvalLstm<float, float, float, float>(op_data, kernel_content, buffers);
114-      break;
115-    }
116-    case kTfLiteInt8: {
117-      switch (weight_type) {
118-        case kTfLiteInt8: {
119-          // 8(activation)x8(weight)->16(cell) LSTM with 32 bits bias
120-          LSTMBuffers<int16_t> buffers =
121:              CreateLSTMBuffers<int16_t>(context, op_data.buffer_indices);
122-          EvalLstm<int8_t, int8_t, int16_t, int32_t>(op_data, kernel_content,
123-                                                     buffers);
124-          break;
125-        }
126-        default: {
127-          MicroPrintf("Filter type %s (%d) not supported.",
128-                      TfLiteTypeGetName(weight_type), activation_type);
129-          return kTfLiteError;
130-        }
131-      }
132-      break;
133-    }
134-    case kTfLiteInt16: {
135-      switch (weight_type) {
136-        case kTfLiteInt8: {
137-          // 16(activation)x8(weight)->16(cell) LSTM with 64 bits bias
138-          LSTMBuffers<int16_t> buffers =
139:              CreateLSTMBuffers<int16_t>(context, op_data.buffer_indices);
140-          EvalLstm<int16_t, int8_t, int16_t, int64_t>(op_data, kernel_content,
141-                                                      buffers);
142-          break;
143-        }
144-        default: {
145-          MicroPrintf("Filter type %s (%d) not supported.",
146-                      TfLiteTypeGetName(weight_type), weight_type);
147-          return kTfLiteError;
148-        }
149-      }
150-      break;
151-    }
152-    default: {
153-      MicroPrintf("Input type %s (%d) not supported.",
154-                  TfLiteTypeGetName(activation_type), activation_type);
155-      return kTfLiteError;
156-    }
157-  }
158-  return kTfLiteOk;
159-}
