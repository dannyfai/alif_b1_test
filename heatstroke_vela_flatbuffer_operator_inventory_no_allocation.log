    37	def get_model_data(model_path: str) -> list:
    38	    """
    39	    Reads a binary file and returns a C style array as a
    40	    list of strings.
    41	
    42	    Argument:
    43	        model_path:    path to the model.
    44	
    45	    Returns:
    46	        list of strings
    47	    """
    48	    # Read raw bytes so we can emit a C array initializer.
    49	    with open(model_path, 'rb') as model_file:
    50	        data = model_file.read()
    51	
    52	    bytes_per_line = 32
    53	    hex_digits_per_line = bytes_per_line * 2
    54	    hexstream = binascii.hexlify(data).decode('utf-8')
    55	    hexstring = '{'
    56	
