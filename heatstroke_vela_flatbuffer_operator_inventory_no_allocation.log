    17	"""
    18	Utility script to generate model c file that can be included in the
    19	project directly. This should be called as part of CMake framework
    20	should the models need to be generated at configuration stage.
    21	
    22	This script is intentionally thin: it delegates validation to
    23	format-specific modules and focuses on producing the .cc output.
    24	"""
    25	import binascii
    26	from argparse import ArgumentParser
    27	from pathlib import Path
