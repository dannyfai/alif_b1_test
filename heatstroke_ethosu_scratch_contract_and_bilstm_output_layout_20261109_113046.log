    29	struct OpData {
    30	  int cms_data_size;
    31	  int base_addr_idx;
    32	  int base_addr_size_idx;
    33	};
    34	
    35	void* Init(TfLiteContext* context, const char* buffer, size_t length) {
    36	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
    37	  return context->AllocatePersistentBuffer(context, sizeof(OpData));
    38	}
    39	
    40	TfLiteStatus Prepare(TfLiteContext* context, TfLiteNode* node) {
    41	  TFLITE_DCHECK(context != nullptr);
    42	  TF_LITE_ENSURE(context, node->inputs->size > 0);
    43	  TFLITE_DCHECK(node->user_data != nullptr);
    44	  TF_LITE_ENSURE(context, node->custom_initial_data_size > 0);
    45	
    46	  OpData* data = static_cast<OpData*>(node->user_data);
    47	  int num_base_addr = node->inputs->size + node->outputs->size;
    48	
    49	  // Request arrays for the base address pointers and sizes.
    50	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    51	      context, num_base_addr * sizeof(uint64_t), &data->base_addr_idx));
    52	  TF_LITE_ENSURE_STATUS(context->RequestScratchBufferInArena(
    53	      context, num_base_addr * sizeof(size_t), &data->base_addr_size_idx));
    54	
    55	  // Get command stream data size.
    56	  MicroContext* micro_context = GetMicroContext(context);
    57	  TfLiteTensor* tensor = micro_context->AllocateTempInputTensor(node, 0);
    58	  data->cms_data_size = tensor->bytes;
    59	  micro_context->DeallocateTempTfLiteTensor(tensor);
    60	  return kTfLiteOk;
    61	}
    62	
    63	TfLiteStatus Eval(TfLiteContext* context, TfLiteNode* node) {
    64	  TFLITE_DCHECK(node->user_data != nullptr);
    65	  TFLITE_DCHECK(context != nullptr);
    66	  TFLITE_DCHECK(context->GetScratchBuffer != nullptr);
    67	
    68	  // Get base addresses.
    69	  TfLiteEvalTensor* tensor;
    70	  int i = 0;
    71	  int num_tensors = 0;
    72	  void* cms_data;
    73	  uint8_t co_type;
    74	  int result;
    75	  const OpData* data = static_cast<const OpData*>(node->user_data);
    76	  uint64_t* base_addrs = static_cast<uint64_t*>(
    77	      context->GetScratchBuffer(context, data->base_addr_idx));
    78	  size_t* base_addrs_size = static_cast<size_t*>(
    79	      context->GetScratchBuffer(context, data->base_addr_size_idx));
    80	
    81	  const uint8_t* custom_data =
    82	      static_cast<uint8_t const*>(node->custom_initial_data);
    83	  auto root = flexbuffers::GetRoot(custom_data, node->custom_initial_data_size);
    84	  co_type = root.AsInt8();
    85	  if (co_type != CO_TYPE_ETHOSU) {
    86	    MicroPrintf("CO_TYPE != ETHOSU");
    87	    return kTfLiteError;
    88	  }
    89	
    90	  // Get command stream data address.
    91	  tensor = context->GetEvalTensor(context, node->inputs->data[0]);
    92	  cms_data = reinterpret_cast<void*>(tensor->data.uint8);
    93	
    94	  // Get addresses to weights/scratch/input data.
    95	  for (i = 1; i < node->inputs->size; ++i) {
    96	    tensor = context->GetEvalTensor(context, node->inputs->data[i]);
    97	    base_addrs[num_tensors] =
    98	        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
    99	    size_t byte_size = 1;
   100	    for (int k = 0; k < tensor->dims->size; k++) {
   101	      byte_size = byte_size * tensor->dims->data[k];
   102	    }
   103	    base_addrs_size[num_tensors] = byte_size;
   104	    num_tensors++;
   105	  }
   106	
   107	  // Get addresses to output data.
   108	  for (i = 0; i < node->outputs->size; ++i) {
   109	    tensor = context->GetEvalTensor(context, node->outputs->data[i]);
   110	    base_addrs[num_tensors] =
   111	        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(tensor->data.uint8));
   112	    size_t byte_size = 1;
   113	    for (int k = 0; k < tensor->dims->size; k++) {
   114	      byte_size = byte_size * tensor->dims->data[k];
   115	    }
   116	    base_addrs_size[num_tensors] = byte_size;
   117	    num_tensors++;
   118	  }
   119	
   120	  // When Vela optimizes a tflite file it will assign the tensors like this:
   121	  //
   122	  // +-------+------------------------+  +--------+-------------+
   123	  // | INPUT | Description            |  | OUTPUT | Description |
   124	  // +-------+------------------------+  +--------+-------------+
   125	  // |     0 | Ethos-U command stream |  |   0..m | Outputs     |
   126	  // |     1 | TFLM model             |  +--------+-------------+
   127	  // |     2 | TFLM arena             |
   128	  // |     3 | Ethos-U fast scratch   |
   129	  // |  4..n | Inputs                 |
   130	  // +-------+------------------------+
   131	  //
   132	  // This code will assign the NPU base addresses like this:
   133	  //
   134	  // +--------------+----------------------+
   135	  // | Base address | Description          |
   136	  // +--------------+----------------------+
   137	  // |            0 | TFLM model           |
   138	  // |            1 | TFLM arena           |
   139	  // |            2 | Ethos-U fast scratch |
   140	  // |         3..n | Input tensors        |
   141	  // |         n..m | Output tensors       |
   142	  // +--------------+----------------------+
   143	  //
   144	  // The number of base address will be limited to 8.
   145	  //
   146	  // NOTE! The command stream produced by Vela will access the IFM and OFM
   147	  // buffers using base address 1. This means that it is not possible to point
   148	  // the input and output tensors outside of the TFLM arena.
   149	  num_tensors = std::min(num_tensors, 8);
   150	
   151	  struct ethosu_driver* drv = ethosu_reserve_driver();
   152	  result = ethosu_invoke_v3(drv, cms_data, data->cms_data_size, base_addrs,
   153	                            base_addrs_size, num_tensors,
   154	                            GetMicroContext(context)->external_context());
   155	  ethosu_release_driver(drv);
   156	
   157	  if (-1 == result) {
   158	    return kTfLiteError;
   159	  } else {
   160	    return kTfLiteOk;
   161	  }
   162	}
   163	
   164	}  // namespace
