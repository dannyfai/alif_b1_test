===== 4. CUSTOM BILSTM EVAL AND OUTPUT COPYING =====
   230	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   231	      forward_hidden != backward_hidden) {
   232	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   233	    return kTfLiteError;
   234	  }
   235	
   236	  const int hidden = forward_hidden;
   237	
   238	  if (output->dims->data[0] != time_steps ||
   239	      output->dims->data[1] != batch_size ||
   240	      output->dims->data[2] != 2 * hidden) {
   241	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   242	    return kTfLiteError;
   243	  }
   244	
   245	  // The directional evaluator must see [time_steps, batch_size, hidden],
   246	  // not the merged output shape [time_steps, batch_size, 2 * hidden].
   247	  const size_t staged_dims_bytes =
   248	      sizeof(TfLiteIntArray) + 2 * sizeof(int);
   249	  op_data->staged_output_dims =
   250	      static_cast<TfLiteIntArray*>(
   251	          context->AllocatePersistentBuffer(context, staged_dims_bytes));
   252	
   253	  if (op_data->staged_output_dims == nullptr) {
   254	    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
   255	    return kTfLiteError;
   256	  }
   257	
   258	  op_data->staged_output_dims->size = 3;
   259	  op_data->staged_output_dims->data[0] = time_steps;
   260	  op_data->staged_output_dims->data[1] = batch_size;
   261	  op_data->staged_output_dims->data[2] = hidden;
   262	
   263	  // Compact 29-slot model: no separate auxiliary input slots exist.
   264	
   265	  InitializeFloatLstmParameters(
   266	      &op_data->forward, true, batch_size, time_steps,
   267	      input_dimension, hidden, params->activation, params->cell_clip);
   268	
   269	  InitializeFloatLstmParameters(
   270	      &op_data->backward, true, batch_size, time_steps,
   271	      input_dimension, hidden, params->activation, params->cell_clip);
   272	
   273	  const size_t reverse_bytes =
   274	      static_cast<size_t>(time_steps) * batch_size *
   275	      input_dimension * sizeof(float);
   276	
   277	  const size_t stage_bytes =
   278	      static_cast<size_t>(time_steps) * batch_size *
   279	      hidden * sizeof(float);
   280	
   281	  const size_t internal_bytes =
   282	      static_cast<size_t>(batch_size) * hidden * sizeof(float);
   283	
   284	  if (context->RequestScratchBufferInArena(
   285	          context, reverse_bytes, &op_data->reverse_input_buffer) !=
   286	          kTfLiteOk ||
   287	      context->RequestScratchBufferInArena(
   288	          context, stage_bytes, &op_data->stage_output_buffer) !=
   289	          kTfLiteOk) {
   290	    MicroPrintf("Heatstroke BiLSTM: scratch allocation failed");
   291	    return kTfLiteError;
   292	  }
   293	
   294	  // Match the four scratch buffers requested by TFLM's existing
   295	  // unidirectional FP32 LSTM implementation.
   296	  for (int i = 0; i < 4; ++i) {
   297	    if (context->RequestScratchBufferInArena(
   298	            context, internal_bytes,
   299	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   300	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   301	      return kTfLiteError;
   302	    }
   303	
   304	    // Forward and backward passes execute sequentially, so they can
   305	    // safely reuse the same four evaluator scratch buffers.
   306	    op_data->backward.buffer_indices[i] =
   307	        op_data->forward.buffer_indices[i];
   308	  }
   309	
   310	  return kTfLiteOk;
   311	}
   312	
   313	void PopulateDirectionContents(TfLiteContext* context,
   314	                               TfLiteNode* node,
   315	                               int input_weight_base,
   316	                               int recurrent_weight_base,
   317	                               int bias_base,
   318	                               int hidden_state_position,
   319	                               int cell_state_position,
   320	                               const TfLiteEvalTensor* input,
   321	                               TfLiteEvalTensor* staged_output,
   322	                               LSTMKernelContents* contents) {
   323	  for (int i = 0; i < 24; ++i) {
   324	    contents->internal_tensors[i] = nullptr;
   325	  }
   326	
   327	  contents->internal_tensors[0] =
   328	      const_cast<TfLiteEvalTensor*>(input);
   329	
   330	  for (int gate = 0; gate < 4; ++gate) {
   331	    contents->internal_tensors[1 + gate] =
   332	        GetInputEvalTensor(context, node, input_weight_base + gate);
   333	
   334	    contents->internal_tensors[5 + gate] =
   335	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   336	
   337	    contents->internal_tensors[12 + gate] =
   338	        GetInputEvalTensor(context, node, bias_base + gate);
   339	  }
   340	
   341	  // Optional peephole, projection, and layer-normalization tensors
   342	  // are not present in this model and remain nullptr.
   343	
   344	  contents->internal_tensors[18] =
   345	      GetInputEvalTensor(context, node, hidden_state_position);
   346	
   347	  contents->internal_tensors[19] =
   348	      GetInputEvalTensor(context, node, cell_state_position);
   349	
   350	  contents->output_tensor = staged_output;
   351	}
   352	
   353	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   354	                                             TfLiteNode* node) {
   355	  if (node == nullptr || node->user_data == nullptr) {
   356	    return kTfLiteError;
   357	  }
   358	
   359	  const auto* op_data =
   360	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   361	
   362	  const TfLiteEvalTensor* input =
   363	      GetInputEvalTensor(context, node, 0);
   364	
   365	  TfLiteEvalTensor* output =
   366	      context->GetEvalTensor(context, node->outputs->data[0]);
   367	
   368	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   369	    return kTfLiteError;
   370	  }
   371	
   372	  const int time_steps = op_data->forward.size_info.time_steps;
   373	  const int input_dimension = op_data->forward.size_info.input_dimension;
   374	  const int hidden = op_data->forward.size_info.state_dimension;
   375	
   376	  auto* reversed_input = static_cast<float*>(
   377	      context->GetScratchBuffer(
   378	          context, op_data->reverse_input_buffer));
   379	
   380	  auto* staged_output = static_cast<float*>(
   381	      context->GetScratchBuffer(
   382	          context, op_data->stage_output_buffer));
   383	
   384	  if (reversed_input == nullptr || staged_output == nullptr) {
   385	    MicroPrintf("Heatstroke BiLSTM: scratch buffer unavailable");
   386	    return kTfLiteError;
   387	  }
   388	
   389	  const float* input_data = input->data.f;
   390	  float* output_data = output->data.f;
   391	
   392	  // Reverse the time dimension for the backward direction.
   393	  for (int t = 0; t < time_steps; ++t) {
   394	    std::memcpy(
   395	        reversed_input + t * input_dimension,
   396	        input_data + (time_steps - 1 - t) * input_dimension,
   397	        input_dimension * sizeof(float));
   398	  }
   399	
   400	  TfLiteEvalTensor reversed_input_tensor = *input;
   401	  reversed_input_tensor.data.f = reversed_input;
   402	
   403	  TfLiteEvalTensor staged_output_tensor = *output;
   404	  staged_output_tensor.data.f = staged_output;
   405	  staged_output_tensor.dims = op_data->staged_output_dims;
   406	
   407	  LSTMKernelContents forward_contents{};
   408	  PopulateDirectionContents(context, node, 1, 5, 9, 25, 26, input, &staged_output_tensor, &forward_contents);
   409	
   410	  LSTMBuffers<float> buffers =
   411	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   412	
   413	  TfLiteStatus forward_status =
   414	      EvalLstm<float, float, float, float>(
   415	          op_data->forward, forward_contents, buffers);
   416	  if (forward_status != kTfLiteOk) {
   417	    return forward_status;
   418	  }
   419	
   420	  // Copy forward outputs into the first half of the merged output.
   421	  for (int t = 0; t < time_steps; ++t) {
   422	    std::memcpy(
   423	        output_data + t * (2 * hidden),
   424	        staged_output + t * hidden,
   425	        hidden * sizeof(float));
   426	  }
   427	
   428	  LSTMKernelContents backward_contents{};
   429	  PopulateDirectionContents(context, node, 13, 17, 21, 27, 28, &reversed_input_tensor, &staged_output_tensor, &backward_contents);
   430	
   431	  TfLiteStatus backward_status =
   432	      EvalLstm<float, float, float, float>(
   433	          op_data->backward, backward_contents, buffers);
   434	  if (backward_status != kTfLiteOk) {
   435	    return backward_status;
   436	  }
   437	
   438	  // Restore backward outputs to original time order and copy them
   439	  // into the second half of the merged output.
   440	  for (int t = 0; t < time_steps; ++t) {
   441	    std::memcpy(
   442	        output_data + t * (2 * hidden) + hidden,
   443	        staged_output + (time_steps - 1 - t) * hidden,
   444	        hidden * sizeof(float));
   445	  }
   446	
   447	  return kTfLiteOk;
   448	}
