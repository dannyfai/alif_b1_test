     1	import onnx
     2	from collections import defaultdict
     3	
     4	src = (
     5	    "export/layernorm_variance_eps_variants/"
     6	    "qdq_both_variance_eps_preprocess_fp32_v2.onnx"
     7	)
     8	
     9	dst = (
    10	    "export/layernorm_variance_eps_variants/"
    11	    "qdq_both_variance_eps_preprocess_fp32_v2_concat_fp32.onnx"
    12	)
    13	
    14	model = onnx.load(src)
    15	graph = model.graph
    16	
    17	producer = {}
    18	consumers = defaultdict(list)
    19	
    20	for i, node in enumerate(graph.node):
    21	    for output in node.output:
    22	        producer[output] = (i, node)
    23	    for inp in node.input:
    24	        consumers[inp].append((i, node))
    25	
    26	def find_node(name):
    27	    matches = [
    28	        (i, n) for i, n in enumerate(graph.node)
    29	        if n.name == name
    30	    ]
    31	    if len(matches) != 1:
    32	        raise RuntimeError(
    33	            f"Expected exactly one node named {name}, found {len(matches)}"
    34	        )
    35	    return matches[0]
    36	
    37	q_index, q_node = find_node("cumsum_QuantizeLinear")
    38	dq_index, dq_node = find_node("cumsum_DequantizeLinear")
    39	concat_index, concat_node = find_node("node_cat_1")
    40	
    41	if q_node.op_type != "QuantizeLinear":
    42	    raise RuntimeError("Unexpected cumsum quantizer type")
    43	
    44	if dq_node.op_type != "DequantizeLinear":
    45	    raise RuntimeError("Unexpected cumsum dequantizer type")
    46	
    47	if concat_node.op_type != "Concat":
    48	    raise RuntimeError("Unexpected concat node type")
    49	
    50	if len(q_node.input) != 3 or len(dq_node.input) != 3:
    51	    raise RuntimeError("Unexpected Q/DQ input count")
    52	
    53	if q_node.input[0] != "cumsum":
    54	    raise RuntimeError("Quantizer does not consume cumsum")
    55	
    56	if dq_node.input[0] != q_node.output[0]:
    57	    raise RuntimeError("Dequantizer does not consume quantizer output")
    58	
    59	if q_node.input[1:] != dq_node.input[1:]:
    60	    raise RuntimeError("Q/DQ parameters differ")
    61	
    62	if len(consumers[q_node.output[0]]) != 1:
    63	    raise RuntimeError("Quantized cumsum output has additional consumers")
    64	
    65	if consumers[q_node.output[0]][0][1].name != dq_node.name:
    66	    raise RuntimeError("Unexpected consumer of quantized cumsum")
    67	
    68	if len(consumers[dq_node.output[0]]) != 1:
    69	    raise RuntimeError("Dequantized cumsum output has additional consumers")
    70	
    71	if consumers[dq_node.output[0]][0][1].name != concat_node.name:
    72	    raise RuntimeError("Unexpected consumer of dequantized cumsum")
    73	
    74	if "cumsum_DequantizeLinear_Output" not in concat_node.input:
    75	    raise RuntimeError("Expected DQ tensor is not a concat input")
    76	
    77	print("Source graph checks: PASSED")
    78	print("Quantizer:", q_node.name, list(q_node.input), list(q_node.output))
    79	print("Dequantizer:", dq_node.name, list(dq_node.input), list(dq_node.output))
    80	print("Concat before:", list(concat_node.input))
    81	
    82	# Feed the original FP32 cumsum directly into Concat.
    83	for i, name in enumerate(concat_node.input):
    84	    if name == dq_node.output[0]:
    85	        concat_node.input[i] = "cumsum"
    86	
    87	# Remove only the Q/DQ pair immediately before this Concat.
    88	remove_names = {
    89	    q_node.name,
    90	    dq_node.name,
    91	}
    92	
    93	kept_nodes = [
    94	    node for node in graph.node
    95	    if node.name not in remove_names
    96	]
    97	
    98	del graph.node[:]
    99	graph.node.extend(kept_nodes)
   100	
   101	# Remove obsolete intermediate value_info entries.
   102	obsolete = {
   103	    q_node.output[0],
   104	    dq_node.output[0],
   105	}
   106	
   107	kept_value_info = [
   108	    item for item in graph.value_info
   109	    if item.name not in obsolete
   110	]
   111	
   112	del graph.value_info[:]
   113	graph.value_info.extend(kept_value_info)
   114	
   115	onnx.checker.check_model(model)
   116	onnx.save(model, dst)
   117	
   118	# Reload and verify the saved artifact.
   119	saved = onnx.load(dst)
   120	onnx.checker.check_model(saved)
