=== ONNX TO TFLITE CONVERTER ===
     1	#!/usr/bin/env python3
     2	"""
     3	Convert the fixed-shape combined ONNX model to TFLite using NXP ONNX2TFLite.
     4	
     5	This intentionally creates an FP32 TFLite model first. Quantization is a
     6	separate step so graph-conversion errors can be isolated from quantization.
     7	"""
     8	import argparse
     9	import shutil
    10	import subprocess
    11	import sys
    12	from pathlib import Path
    13	
    14	def main():
    15	    p = argparse.ArgumentParser()
    16	    p.add_argument("--onnx", required=True, help="Input combined_static_model.onnx")
    17	    p.add_argument("--out", default="export/combined_static_model_fp32.tflite")
    18	    p.add_argument("--converter", default="onnx2tflite",
    19	                   help="onnx2tflite executable")
    20	    p.add_argument("--skip-shape-inference", action="store_true",
    21	                   help="Use only if ONNX shape inference fails; model shapes must be static")
    22	    p.add_argument("--cast-int64-to-int32", action="store_true")
    23	    p.add_argument("--allow-select-ops", action="store_true",
    24	                   help="Not recommended for TFLite Micro deployment")
    25	    args = p.parse_args()
    26	
    27	    onnx_path = Path(args.onnx).expanduser().resolve()
    28	    out_path = Path(args.out).expanduser().resolve()
    29	    if not onnx_path.is_file():
    30	        p.error(f"ONNX file does not exist: {onnx_path}")
    31	    if shutil.which(args.converter) is None:
    32	        p.error(
    33	            f"Cannot find {args.converter!r}. Install the NXP converter and "
    34	            "ensure its executable is on PATH."
    35	        )
    36	
    37	    out_path.parent.mkdir(parents=True, exist_ok=True)
    38	    cmd = [args.converter, str(onnx_path), "-o", str(out_path)]
    39	    if args.skip_shape_inference:
    40	        cmd.append("--skip-shape-inference")
    41	    if args.cast_int64_to_int32:
    42	        cmd.append("--cast-int64-to-int32")
    43	    if args.allow_select_ops:
    44	        cmd.append("--allow-select-ops")
    45	
    46	    print("Running:")
    47	    print(" ".join(cmd))
    48	    subprocess.run(cmd, check=True)
    49	
    50	    if not out_path.is_file() or out_path.stat().st_size == 0:
    51	        raise RuntimeError("Converter returned successfully but output TFLite is missing/empty.")
    52	
    53	    print(f"\nTFLite model created: {out_path}")
    54	    print(f"File size: {out_path.stat().st_size:,} bytes")
    55	    print("\nNext: run validate_onnx_tflite.py with representative input tensors.")
    56	
    57	if __name__ == "__main__":
    58	    main()

