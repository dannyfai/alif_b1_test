     9	dst = (
    10	    "export/"
    11	    "combined_static_model_gelu_tanh_int32_indices_qdq_"
    12	    "variance_eps_fp32.onnx"
    13	)
    14	
    15	model = onnx.load(src)
    16	graph = model.graph
    17	
    18	targets = [
    19	    "node_layer_norm_variance_eps",
    20	    "node_layer_norm_1_variance_eps",
    21	]
    22	
    23	remove_names = set()
    24	patched = []
    25	
    26	nodes_by_name = {
    27	    node.name: node
    28	    for node in graph.node
    29	}
    30	
    31	for target in targets:
    32	    q_name = target + "_QuantizeLinear"
    33	    dq_name = target + "_DequantizeLinear"
    34	
    35	    if q_name not in nodes_by_name:
    36	        raise RuntimeError(f"Missing Q node: {q_name}")
    37	
    38	    if dq_name not in nodes_by_name:
    39	        raise RuntimeError(f"Missing DQ node: {dq_name}")
    40	
    41	    q_node = nodes_by_name[q_name]
    42	    dq_node = nodes_by_name[dq_name]
    43	
    44	    if q_node.input[0] != target:
    45	        raise RuntimeError(
    46	            f"Unexpected Q input: {q_node.input}"
    47	        )
    48	
    49	    if dq_node.input[0] != q_node.output[0]:
    50	        raise RuntimeError(
    51	            f"Unexpected DQ input: {dq_node.input}"
    52	        )
    53	
    54	    dq_output = dq_node.output[0]
    55	
    56	    replacement_count = 0
    57	
    58	    for node in graph.node:
    59	        for i, inp in enumerate(node.input):
    60	            if inp == dq_output:
    61	                node.input[i] = target
    62	                replacement_count += 1
    63	
    64	    if replacement_count == 0:
    65	        raise RuntimeError(
    66	            f"No consumers found for {dq_output}"
    67	        )
    68	
    69	    remove_names.add(q_name)
    70	    remove_names.add(dq_name)
    71	
    72	    patched.append(
    73	        (target, q_name, dq_name, replacement_count)
    74	    )
    75	
    76	# Remove nodes using their unique names, not Python object IDs.
    77	kept_nodes = [
    78	    node for node in graph.node
    79	    if node.name not in remove_names
    80	]
    81	
    82	del graph.node[:]
    83	graph.node.extend(kept_nodes)
    84	
    85	# Check the graph before saving.
    86	checker.check_model(model)
    87	
    88	onnx.save(model, dst)
    89	
    90	print("Patched nodes:")
    91	
    92	for target, q, dq, count in patched:
    93	    print(f"  {target}")
    94	    print(f"    Removed: {q}")
    95	    print(f"    Removed: {dq}")
    96	    print(f"    Rewired consumers: {count}")
    97	
    98	print("\nSaved:", dst)
    99	print("ONNX checker: PASSED")

=== COMPLETE PREPROCESS FP32 TRANSFORMATION ===
     1	import onnx
     2	import numpy as np
     3	from onnx import numpy_helper
     4	
     5	
     6	SOURCE = (
     7	    "export/layernorm_variance_eps_variants/"
     8	    "qdq_both_variance_eps_fp32.onnx"
     9	)
    10	
    11	OUTPUT = (
    12	    "export/layernorm_variance_eps_variants/"
    13	    "qdq_both_variance_eps_preprocess_fp32_v2.onnx"
    14	)
    15	
    16	
    17	def main():
    18	    print("=" * 90)
    19	    print("CREATE FP32 PREPROCESSING BRANCH VARIANT")
    20	    print("=" * 90)
    21	
    22	    model = onnx.load(SOURCE)
    23	
    24	    # ------------------------------------------------------------
    25	    # 1. Rewire QDQ outputs to their original FP32 tensors.
    26	    # ------------------------------------------------------------
    27	
    28	    rewires = {
    29	        "x_values_DequantizeLinear_Output_1": "x_values",
    30	        "x_values_DequantizeLinear_Output_2": "x_values",
    31	        "mul_3_DequantizeLinear_Output": "mul_3",
    32	        "sum_2_DequantizeLinear_Output": "sum_2",
    33	        "clamp_2_DequantizeLinear_Output": "clamp_2",
    34	        "sum_3_DequantizeLinear_Output": "sum_3",
    35	        "div_1_DequantizeLinear_Output": "div_1",
    36	        "expand_3_DequantizeLinear_Output": "expand_3",
    37	    }
    38	
    39	    all_names = set()
    40	
    41	    for node in model.graph.node:
    42	        all_names.update(node.input)
    43	        all_names.update(node.output)
    44	
    45	    for old, new in rewires.items():
    46	        if old not in all_names:
    47	            raise RuntimeError(
    48	                f"Expected tensor not found: {old}"
    49	            )
    50	
    51	        if new not in all_names:
    52	            raise RuntimeError(
    53	                f"Replacement tensor not found: {new}"
    54	            )
    55	
    56	    replacement_counts = {}
    57	
    58	    for node in model.graph.node:
    59	        for i, name in enumerate(node.input):
    60	            if name in rewires:
    61	                node.input[i] = rewires[name]
    62	
    63	                replacement_counts[name] = (
    64	                    replacement_counts.get(name, 0) + 1
    65	                )
    66	
    67	    print("\nRewired tensors:")
    68	
    69	    for old, new in rewires.items():
    70	        count = replacement_counts.get(old, 0)
    71	
    72	        if count == 0:
    73	            raise RuntimeError(
    74	                f"No consumer was rewired for {old}"
    75	            )
    76	
    77	        print(f"  {old} -> {new}: {count} consumer(s)")
    78	
    79	    # ------------------------------------------------------------
    80	    # 2. Restore the original FP32 Clip minimum.
    81	    #
    82	    # val_110_quantized = 127
    83	    # zero_point = -128
    84	    # scale = 0.003921569
    85	    #
    86	    # Therefore, the original value is approximately 1.0.
    87	    # ------------------------------------------------------------
    88	
    89	    clip_nodes = [
    90	        node
    91	        for node in model.graph.node
    92	        if node.name == "node_clamp_2"
    93	    ]
    94	
    95	    if len(clip_nodes) != 1:
    96	        raise RuntimeError(
    97	            f"Expected one node_clamp_2, found {len(clip_nodes)}"
    98	        )
    99	
   100	    clip = clip_nodes[0]
   101	
   102	    if len(clip.input) < 2:
   103	        raise RuntimeError("Unexpected Clip input count")
   104	
   105	    clip_min_name = "preprocess_clip_min_fp32"
   106	
   107	    if any(
   108	        item.name == clip_min_name
   109	        for item in model.graph.initializer
   110	    ):
   111	        raise RuntimeError(
   112	            f"Initializer already exists: {clip_min_name}"
   113	        )
   114	
   115	    clip.input[1] = clip_min_name
   116	
   117	    model.graph.initializer.append(
   118	        numpy_helper.from_array(
   119	            np.asarray(1.0, dtype=np.float32),
   120	            name=clip_min_name,
   121	        )
   122	    )
   123	
   124	    print("\nClip minimum restored:")
   125	    print(f"  {clip_min_name} = 1.0 (FP32)")
   126	
   127	    # ------------------------------------------------------------
   128	    # 3. Remove only the QDQ nodes belonging to this branch.
   129	    #
   130	    # Binary mask QDQ is intentionally retained.
   131	    # ------------------------------------------------------------
   132	
   133	    nodes_to_remove = {
   134	        "x_values_QuantizeLinear_1",
   135	        "x_values_DequantizeLinear_1",
   136	        "x_values_QuantizeLinear_2",
   137	        "x_values_DequantizeLinear_2",
   138	
   139	        "mul_3_QuantizeLinear",
   140	        "mul_3_DequantizeLinear",
   141	
   142	        "sum_2_QuantizeLinear",
   143	        "sum_2_DequantizeLinear",
   144	
   145	        "clamp_2_QuantizeLinear",
   146	        "clamp_2_DequantizeLinear",
   147	
   148	        "sum_3_QuantizeLinear",
   149	        "sum_3_DequantizeLinear",
   150	
   151	        "div_1_QuantizeLinear",
   152	        "div_1_DequantizeLinear",
   153	
   154	        "expand_3_QuantizeLinear",
   155	        "expand_3_DequantizeLinear",
   156	    }
   157	
   158	    found_nodes = {
   159	        node.name
   160	        for node in model.graph.node
   161	        if node.name in nodes_to_remove
   162	    }
   163	
   164	    missing_nodes = nodes_to_remove - found_nodes
   165	
   166	    if missing_nodes:
   167	        raise RuntimeError(
   168	            "Expected QDQ nodes not found:\n"
   169	            + "\n".join(sorted(missing_nodes))
   170	        )
   171	
   172	    removed_outputs = {
   173	        output
   174	        for node in model.graph.node
   175	        if node.name in nodes_to_remove
   176	        for output in node.output
   177	    }
   178	
   179	    # Verify no remaining node consumes a removed QDQ output.
   180	    for node in model.graph.node:
   181	        if node.name in nodes_to_remove:
   182	            continue
   183	
   184	        for name in node.input:
   185	            if name in removed_outputs:
   186	                raise RuntimeError(
   187	                    "Remaining consumer of removed QDQ output: "
   188	                    f"{name}, node={node.name}"
   189	                )
   190	
   191	    kept_nodes = [
   192	        node
   193	        for node in model.graph.node
   194	        if node.name not in nodes_to_remove
   195	    ]
   196	
   197	    del model.graph.node[:]
   198	    model.graph.node.extend(kept_nodes)
   199	
   200	    print("\nRemoved QDQ nodes:")
   201	
   202	    for name in sorted(nodes_to_remove):
   203	        print(f"  {name}")
   204	
   205	    print(
   206	        f"\nNode count: {len(kept_nodes)} "
   207	        f"(removed {len(nodes_to_remove)})"
   208	    )
   209	
   210	    # ------------------------------------------------------------
   211	    # 4. Check that no QDQ nodes remain on the targeted branch.
   212	    # ------------------------------------------------------------
   213	
   214	    targeted_prefixes = (
   215	        "mul_3",
   216	        "sum_2",
   217	        "clamp_2",
   218	        "sum_3",
   219	        "div_1",
   220	        "expand_3",
   221	    )
   222	
   223	    targeted_x_values = {
   224	        "x_values_DequantizeLinear_Output_1",
   225	        "x_values_DequantizeLinear_Output_2",
   226	    }
   227	
   228	    remaining = []
   229	
   230	    for node in model.graph.node:
   231	        if node.op_type not in (
   232	            "QuantizeLinear",
   233	            "DequantizeLinear",
   234	        ):
   235	            continue
   236	
   237	        names = list(node.input) + list(node.output)
   238	
   239	        if any(
   240	            name.startswith(targeted_prefixes)
   241	            for name in names
   242	        ) or any(
   243	            name in targeted_x_values
   244	            for name in names
   245	        ):
   246	            remaining.append(node)
   247	
   248	    if remaining:
   249	        print("\nRemaining targeted QDQ nodes:")
   250	
   251	        for node in remaining:
   252	            print(
   253	                node.op_type,
   254	                node.name,
   255	                "inputs=", list(node.input),
   256	                "outputs=", list(node.output),
   257	            )
   258	
   259	        raise RuntimeError(
   260	            "Unexpected QDQ nodes remain on the targeted branch"
   261	        )
   262	
   263	    print("\nTargeted preprocessing QDQ check: PASSED")
   264	
   265	    # ------------------------------------------------------------
   266	    # 5. Validate and save.
   267	    # ------------------------------------------------------------
   268	
   269	    onnx.checker.check_model(model)
   270	
   271	    onnx.save(model, OUTPUT)
   272	
   273	    print("\nONNX checker: PASSED")
   274	    print("Saved:", OUTPUT)
   275	    print("=" * 90)
   276	
   277	
   278	if __name__ == "__main__":
   279	    main()

