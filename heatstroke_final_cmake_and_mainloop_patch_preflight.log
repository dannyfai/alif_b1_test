   256	##############################################################################
   257	# Function to prepare a python virtual environment for running the functions
   258	# outlined above.
   259	##############################################################################
   260	function(setup_source_generator)
   261	
   262	    # If a virtual env has been created in the resources_downloaded directory,
   263	    # use it for source generator. Else, fall back to creating a virtual env
   264	    # in the current build directory.
   265	    if (EXISTS ${RESOURCES_PATH}/env)
   266	        set(DEFAULT_VENV_DIR ${RESOURCES_PATH}/env)
   267	    else()
   268	        set(DEFAULT_VENV_DIR ${CMAKE_BINARY_DIR}/venv)
   269	    endif()
   270	
   271	    if (${CMAKE_HOST_WIN32})
   272	        # Windows Python3 is python.exe
   273	        set(PY_EXEC python)
   274	        set(PYTHON ${DEFAULT_VENV_DIR}/Scripts/${PY_EXEC})
   275	    else()
   276	        set(PY_EXEC python3)
   277	        set(PYTHON ${DEFAULT_VENV_DIR}/bin/${PY_EXEC})
   278	    endif()
   279	    set(PYTHON ${PYTHON} PARENT_SCOPE)
   280	    set(PYTHON_VENV ${DEFAULT_VENV_DIR} PARENT_SCOPE)
   281	
   282	    if (EXISTS ${PYTHON})
   283	        message(STATUS "Using existing python at ${PYTHON}")
   284	        return()
   285	    endif ()
   286	
   287	    # If environment is not found, find a supported Python version
   288	    # and create it.
   289	    find_package(Python3 3.10...<3.13
   290	            COMPONENTS Interpreter
   291	            REQUIRED)
   292	
   293	    if (NOT Python3_FOUND)
   294	        message(FATAL_ERROR "Required version of Python3 not found!")
   295	    else()
   296	        message(STATUS "Python3 (v${Python3_VERSION}) found: ${Python3_EXECUTABLE}")
   297	    endif()
   298	
   299	    message(STATUS "Configuring python environment at ${PYTHON}")
   300	

