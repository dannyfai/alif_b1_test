    81	##############################################################################
    82	# This function generates C++ files for tflite NN model files.
    83	# @param[in]    MODEL_PATH      path to a tflite file
    84	# @param[in]    DESTINATION     directory in which the output cc must be
    85	#                               placed
    86	# @param[in]    EXPRESSIONS     C++ code expressions to add to the generated file
    87	# @param[in]    NAMESPACE       model name space
    88	# NOTE: Uses python
    89	##############################################################################
    90	function(generate_model_code)
    91	
    92	    set(multiValueArgs EXPRESSIONS NAMESPACE)
    93	    set(oneValueArgs MODEL_PATH DESTINATION)
    94	    cmake_parse_arguments(PARSED "" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )
    95	
    96	    # Absolute paths for passing into python script
    97	    get_filename_component(ABS_MODEL_PATH ${PARSED_MODEL_PATH} ABSOLUTE)
    98	    get_filename_component(ABS_DESTINATION ${PARSED_DESTINATION} ABSOLUTE)
    99	
   100	    if (EXISTS ${ABS_MODEL_PATH})
   101	        message(STATUS "Using ${ABS_MODEL_PATH}")
   102	    else ()
   103	        message(FATAL_ERROR "${ABS_MODEL_PATH} not found!")
   104	    endif ()
   105	
   106	
   107	    foreach(expression ${PARSED_EXPRESSIONS})
   108	        set(py_arg_exp ${py_arg_exp} --expression=${expression})
   109	    endforeach()
   110	
   111	    foreach(name ${PARSED_NAMESPACE})
   112	        set(py_arg_exp ${py_arg_exp} --namespaces=${name})
   113	    endforeach()
   114	
   115	    # Pass optional Arm Ethos-U NPU validation args if NPU is enabled.
   116	    if (ETHOS_U_NPU_ENABLED)
   117	        if (DEFINED ETHOS_U_NPU_MEMORY_MODE)
   118	            set(py_arg_exp ${py_arg_exp} --ethos_u_memory_mode=${ETHOS_U_NPU_MEMORY_MODE})
   119	        endif()
   120	        if (DEFINED ETHOS_U_NPU_CONFIG_ID)
   121	            # gen_model_cpp.py accepts short forms like H128/Y256/Z256 directly.
   122	            set(py_arg_exp ${py_arg_exp} --ethos_u_config=${ETHOS_U_NPU_CONFIG_ID})
   123	        endif()
   124	    endif()
   125	
   126	    execute_process(
   127	        COMMAND ${CMAKE_COMMAND} -E env
   128	            PYTHONPATH=${MLEK_SCRIPTS_DIR}/py:$ENV{PYTHONPATH}
   129	            ${PYTHON} -m mlek_tools.gen.gen_model_cpp
   130	            --model_path ${ABS_MODEL_PATH}
   131	            --output_dir ${ABS_DESTINATION} ${py_arg_exp}
   132	        RESULT_VARIABLE return_code
   133	    )
   134	    if (NOT return_code EQUAL "0")
   135	        message(FATAL_ERROR "Failed to generate model files.")
   136	    endif ()
   137	endfunction()
