   187	##############################################################################
   188	# This function generates C++ data files for test located in the directory it is
   189	# pointed at.
   190	# @param[in]    INPUT_DIR       directory in which are the npy files
   191	# @param[in]    DESTINATION_SRC directory in which the output cc must be
   192	#                               placed
   193	# @param[in]    DESTINATION_HDR directory in which the output h file must be
   194	#                               placed
   195	# @param[in]    NAMESPACE       data name space
   196	# NOTE: Uses python
   197	##############################################################################
   198	function(generate_test_data_code)
   199	
   200	    set(multiValueArgs NAMESPACE INPUT_DIR)
   201	    set(oneValueArgs DESTINATION_SRC DESTINATION_HDR)
   202	    cmake_parse_arguments(PARSED "" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )
   203	
   204	    list(LENGTH PARSED_INPUT_DIR input_dir_length)
   205	
   206	    if (${input_dir_length} GREATER 1)
   207	        set(add_extra_namespace TRUE)
   208	    else()
   209	        set(add_extra_namespace FALSE)
   210	    endif()
   211	
   212	    foreach(input_dir ${PARSED_INPUT_DIR})
   213	        unset(py_arg_exp)
   214	        file(GLOB_RECURSE input_data_files
   215	                "${input_dir}/*.npy"
   216	                )
   217	        # no input NPY data found => skip code generation.
   218	        if(NOT input_data_files)
   219	            message(WARNING "No files were found to generate input data: ${input_dir}")
   220	            break()
   221	        endif()
   222	
   223	        # Absolute paths for passing into python script
   224	        get_filename_component(input_dir_abs ${input_dir} ABSOLUTE)
   225	        get_filename_component(input_dir_name ${input_dir} NAME)
   226	        get_filename_component(src_out_abs ${PARSED_DESTINATION_SRC} ABSOLUTE)
   227	        get_filename_component(hdr_out_abs ${PARSED_DESTINATION_HDR} ABSOLUTE)
   228	
   229	        foreach(name ${PARSED_NAMESPACE})
   230	            set(py_arg_exp ${py_arg_exp} --namespaces=${name})
   231	        endforeach()
   232	
   233	        if (${add_extra_namespace})
   234	            set(py_arg_exp ${py_arg_exp} --namespaces=${input_dir_name})
   235	        endif()
   236	
   237	        message(STATUS "Generating test ifm and ofm files from ${input_dir_abs}")
   238	        execute_process(
   239	            COMMAND ${CMAKE_COMMAND} -E env
   240	                PYTHONPATH=${MLEK_SCRIPTS_DIR}/py:$ENV{PYTHONPATH}
   241	                ${PYTHON} -m mlek_tools.gen.gen_test_data_cpp
   242	                --data_folder_path ${input_dir_abs}
   243	                --source_folder_path ${src_out_abs}
   244	                --header_folder_path ${hdr_out_abs}
   245	                --usecase ${input_dir_name}
   246	                ${py_arg_exp}
   247	            RESULT_VARIABLE return_code
   248	        )
   249	        if (NOT return_code EQUAL "0")
   250	            message(FATAL_ERROR "Failed to generate test data files.")
   251	        endif ()
   252	    endforeach()
   253	endfunction()
