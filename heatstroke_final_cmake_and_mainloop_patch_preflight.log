   155	bool arm::app::fwk::tflm::PolyUModel1::EnlistOperations()
   156	{
   157	#define HS_ADD_REQUIRED(method)                                      \
   158	    do {                                                              \
   159	        const TfLiteStatus status = this->m_opResolver.method();      \
   160	        if (status != kTfLiteOk) {                                    \
   161	            printf_err(                                               \
   162	                "Failed to register heat-stress operator: %s\n",     \
   163	                #method);                                             \
   164	            return false;                                             \
   165	        }                                                             \
   166	    } while (0)
   167	
   168	    /*
   169	     * 29 ordinary built-in operators required by the exact Vela model.
   170	     * These CPU registrations must remain available with Ethos-U enabled.
   171	     */
   172	    HS_ADD_REQUIRED(AddAdd);
   173	    HS_ADD_REQUIRED(AddBroadcastArgs);
   174	    HS_ADD_REQUIRED(AddBroadcastTo);
   175	    HS_ADD_REQUIRED(AddCast);
   176	    HS_ADD_REQUIRED(AddConcatenation);
   177	    HS_ADD_REQUIRED(AddCumSum);
   178	    HS_ADD_REQUIRED(AddDequantize);
   179	    HS_ADD_REQUIRED(AddDiv);
   180	    HS_ADD_REQUIRED(AddEqual);
   181	    HS_ADD_REQUIRED(AddFloorMod);
   182	    HS_ADD_REQUIRED(AddGather);
   183	    HS_ADD_REQUIRED(AddGreater);
   184	    HS_ADD_REQUIRED(AddLogicalAnd);
   185	    HS_ADD_REQUIRED(AddLogicalNot);
   186	    HS_ADD_REQUIRED(AddMaximum);
   187	    HS_ADD_REQUIRED(AddMean);
   188	    HS_ADD_REQUIRED(AddMul);
   189	    HS_ADD_REQUIRED(AddNeg);
   190	    HS_ADD_REQUIRED(AddQuantize);
   191	    HS_ADD_REQUIRED(AddReshape);
   192	    HS_ADD_REQUIRED(AddRsqrt);
   193	    HS_ADD_REQUIRED(AddSelectV2);
   194	    HS_ADD_REQUIRED(AddSoftmax);
   195	    HS_ADD_REQUIRED(AddSplitV);
   196	    HS_ADD_REQUIRED(AddSqrt);
   197	    HS_ADD_REQUIRED(AddSquare);
   198	    HS_ADD_REQUIRED(AddSub);
   199	    HS_ADD_REQUIRED(AddSum);
   200	    HS_ADD_REQUIRED(AddTopKV2);
   201	
   202	#undef HS_ADD_REQUIRED
   203	
   204	    /*
   205	     * Custom SIGN registration under the built-in SIGN opcode.
   206	     */
   207	    {
   208	        const TFLMRegistration registration =
   209	            RegisterHeatstrokeSignKernel();
   210	
   211	        if (this->m_opResolver.AddBuiltin(
   212	                tflite::BuiltinOperator_SIGN,
   213	                registration,
   214	                ParseHeatstrokeSign) != kTfLiteOk) {
   215	            printf_err("Failed to register heat-stress SIGN.\n");
   216	            return false;
   217	        }
   218	    }
   219	
   220	    /*
   221	     * Custom compact bidirectional LSTM registration.
   222	     */
   223	    {
   224	        const TFLMRegistration registration =
   225	            tflite::RegisterHeatstrokeBidirectionalSequenceLstm();
   226	
   227	        if (this->m_opResolver.AddBuiltin(
   228	                tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
   229	                registration,
   230	                ParseHeatstrokeBidirectionalSequenceLstm) != kTfLiteOk) {
   231	            printf_err(
   232	                "Failed to register heat-stress bidirectional LSTM.\n");
   233	            return false;
   234	        }
   235	    }
   236	
   237	    /*
   238	     * Ethos-U registration.
   239	     *
   240	     * AddEthosU() in this SDK can report success even when the hardware
   241	     * registration is null. Therefore, explicitly verify FindOp().
   242	     */
   243	    if (this->m_opResolver.AddEthosU() != kTfLiteOk) {
   244	        printf_err("Failed to add Ethos-U to the resolver.\n");
   245	        return false;
   246	    }
   247	
   248	    const char* ethos_name = tflite::GetString_ETHOSU();
   249	
   250	    if (ethos_name == nullptr ||
   251	        this->m_opResolver.FindOp(ethos_name) == nullptr) {
   252	        printf_err(
   253	            "Ethos-U registration is missing from the resolver.\n");
   254	        return false;
   255	    }
   256	
   257	    /*
   258	     * Verify all built-in registrations and parser callbacks.
   259	     */
   260	    const tflite::BuiltinOperator required_ops[] = {
   261	        tflite::BuiltinOperator_ADD,
   262	        tflite::BuiltinOperator_BROADCAST_ARGS,
   263	        tflite::BuiltinOperator_BROADCAST_TO,
   264	        tflite::BuiltinOperator_CAST,
   265	        tflite::BuiltinOperator_CONCATENATION,
   266	        tflite::BuiltinOperator_CUMSUM,
   267	        tflite::BuiltinOperator_DEQUANTIZE,
   268	        tflite::BuiltinOperator_DIV,
   269	        tflite::BuiltinOperator_EQUAL,
   270	        tflite::BuiltinOperator_FLOOR_MOD,
   271	        tflite::BuiltinOperator_GATHER,
   272	        tflite::BuiltinOperator_GREATER,
   273	        tflite::BuiltinOperator_LOGICAL_AND,
   274	        tflite::BuiltinOperator_LOGICAL_NOT,
   275	        tflite::BuiltinOperator_MAXIMUM,
   276	        tflite::BuiltinOperator_MEAN,
   277	        tflite::BuiltinOperator_MUL,
   278	        tflite::BuiltinOperator_NEG,
   279	        tflite::BuiltinOperator_QUANTIZE,
   280	        tflite::BuiltinOperator_RESHAPE,
   281	        tflite::BuiltinOperator_RSQRT,
   282	        tflite::BuiltinOperator_SELECT_V2,
   283	        tflite::BuiltinOperator_SIGN,
   284	        tflite::BuiltinOperator_SOFTMAX,
   285	        tflite::BuiltinOperator_SPLIT_V,
   286	        tflite::BuiltinOperator_SQRT,
   287	        tflite::BuiltinOperator_SQUARE,
   288	        tflite::BuiltinOperator_SUB,
   289	        tflite::BuiltinOperator_SUM,
   290	        tflite::BuiltinOperator_TOPK_V2,
   291	        tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM
   292	    };
   293	
   294	    for (const auto op : required_ops) {
   295	        if (this->m_opResolver.FindOp(op) == nullptr) {
   296	            printf_err(
   297	                "Required heat-stress builtin registration is missing: %d\n",
   298	                static_cast<int>(op));
   299	            return false;
   300	        }
   301	
   302	        if (this->m_opResolver.GetOpDataParser(op) == nullptr) {
   303	            printf_err(
   304	                "Required heat-stress builtin parser is missing: %d\n",
   305	                static_cast<int>(op));
   306	            return false;
   307	        }
   308	    }
   309	
   310	    info(
   311	        "Heat-stress resolver ready: 31 built-ins plus Ethos-U (%s).\n",
   312	        ethos_name);
   313	
   314	    return true;
   315	}

