    17	"""
    18	Utility script to generate model c file that can be included in the
    19	project directly. This should be called as part of CMake framework
    20	should the models need to be generated at configuration stage.
    21	
    22	This script is intentionally thin: it delegates validation to
    23	format-specific modules and focuses on producing the .cc output.
    24	"""
    25	import binascii
    26	from argparse import ArgumentParser
    27	from pathlib import Path
    28	
    29	from jinja2 import Environment, FileSystemLoader
    30	
    31	from mlek_tools.gen.gen_utils import gen_header
    32	from mlek_tools.validation.npu_validation import NpuValidationArgs
    33	from mlek_tools.validation.pte_validator import validate_pte_model
    34	from mlek_tools.validation.tflite_validator import validate_tflite_model
    35	
    36	
    37	def get_model_data(model_path: str) -> list:
    38	    """
    39	    Reads a binary file and returns a C style array as a
    40	    list of strings.
    41	
    42	    Argument:
    43	        model_path:    path to the model.
    44	
    45	    Returns:
    46	        list of strings
    47	    """
    48	    # Read raw bytes so we can emit a C array initializer.
    49	    with open(model_path, 'rb') as model_file:
    50	        data = model_file.read()
    51	
    52	    bytes_per_line = 32
    53	    hex_digits_per_line = bytes_per_line * 2
    54	    hexstream = binascii.hexlify(data).decode('utf-8')
    55	    hexstring = '{'
    56	
    57	    for i in range(0, len(hexstream), 2):
    58	        if 0 == (i % hex_digits_per_line):
    59	            hexstring += "\n"
    60	        hexstring += '0x' + hexstream[i:i + 2] + ", "
    61	
    62	    hexstring += '};\n'
    63	    return [hexstring]
    64	
    65	
    66	def main():
    67	    """
    68	    Generate models .cpp
    69	    """
    70	    # pylint: disable=duplicate-code
    71	    parser = ArgumentParser()
    72	
    73	    parser.add_argument(
    74	        "--model_path",
    75	        help="Model path (.tflite or .pte)",
    76	        required=True
    77	    )
    78	
    79	    parser.add_argument(
    80	        "--output_dir",
    81	        help="Output directory",
    82	        required=True
    83	    )
    84	
    85	    parser.add_argument(
    86	        '-e',
    87	        '--expression',
    88	        action='append',
    89	        default=[],
    90	        dest="expr"
    91	    )
    92	
    93	    parser.add_argument(
    94	        '--header',
    95	        action='append',
    96	        default=[],
    97	        dest="headers"
    98	    )
    99	
   100	    parser.add_argument(
   101	        '-ns',
   102	        '--namespaces',
   103	        action='append',
   104	        default=[],
   105	        dest="namespaces"
   106	    )
   107	
   108	    parser.add_argument(
   109	        "--license_template",
   110	        type=str,
   111	        help="Header template file",
   112	        default="header_template.txt"
   113	    )
   114	
   115	    parser.add_argument(
   116	        "--ethos_u_memory_mode",
   117	        type=str,
   118	        help="Arm Ethos-U NPU Vela memory mode (Shared_Sram, Sram_Only, Dedicated_Sram). "
   119	             "If provided, model must be Arm Ethos-U NPU optimized.",
   120	        default=None
   121	    )
   122	
   123	    parser.add_argument(
   124	        "--ethos_u_config",
   125	        type=str,
   126	        help="Arm Ethos-U NPU accelerator config (e.g. ethos-u55-128). "
   127	             "If provided, model must be Arm Ethos-U NPU optimized.",
   128	        default=None
   129	    )
   130	
   131	    args = parser.parse_args()
   132	    # pylint: enable=duplicate-code
   133	
   134	    env = Environment(loader=FileSystemLoader(Path(__file__).parent / 'templates'),
   135	                      trim_blocks=True,
   136	                      lstrip_blocks=True)
   137	
   138	    # Resolve and validate input path early to fail fast.
   139	    model_path = Path(args.model_path)
   140	    if not model_path.is_file():
   141	        raise ValueError(f"{model_path} not found")
   142	
   143	    suffix = model_path.suffix.lower()
   144	
   145	    # Only validate Arm Ethos-U NPU metadata when those args are explicitly provided.
   146	    validation_args = NpuValidationArgs(
   147	        memory_mode=args.ethos_u_memory_mode,
   148	        config=args.ethos_u_config,
   149	    )
   150	    if suffix == ".tflite":
   151	        # TFLite validation runs only when args are set (it will early-return otherwise).
   152	        validate_tflite_model(model_path, validation_args)
   153	    elif suffix == ".pte":
   154	        # PTE validation runs only when args are set (it will early-return otherwise).
   155	        validate_pte_model(model_path, validation_args)
   156	    else:
   157	        raise ValueError(
   158	            f"Unsupported model type for {model_path}. Expected .tflite or .pte."
   159	        )
   160	
   161	    # Output filename mirrors the input model name with a .cc suffix.
   162	    cpp_filename = (Path(args.output_dir) / (model_path.name + ".cc")).resolve()
   163	    print(f"++ Converting {model_path.name} to\
   164	    {cpp_filename.name}")
   165	
   166	    cpp_filename.parent.mkdir(exist_ok=True)
   167	
   168	    hdr = gen_header(env, args.license_template, model_path.name)
   169	
   170	    env \
   171	        .get_template('tflite.cc.template') \
   172	        .stream(common_template_header=hdr,
   173	                model_data=get_model_data(str(model_path)),
   174	                expressions=args.expr,
   175	                additional_headers=args.headers,
   176	                namespaces=args.namespaces).dump(str(cpp_filename))
   177	
   178	
   179	if __name__ == '__main__':
   180	    main()

