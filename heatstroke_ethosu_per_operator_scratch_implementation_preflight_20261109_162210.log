    38	/*
    39	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    40	 * required by this implementation. Validate its options type and leave
    41	 * builtin_data null.
    42	 */
    43	TfLiteStatus ParseHeatstrokeSign(
    44	    const tflite::Operator* op,
    45	    tflite::ErrorReporter*,
    46	    tflite::BuiltinDataAllocator*,
    47	    void** builtin_data)
    48	{
    49	    if (builtin_data != nullptr) {
    50	        *builtin_data = nullptr;
    51	    }
    52	
    53	    if (op == nullptr ||
    54	        op->builtin_options_type() !=
    55	            tflite::BuiltinOptions_SignOptions) {
    56	        return kTfLiteError;
    57	    }
    58	
    59	    return kTfLiteOk;
    60	}
    61	
    62	/*
    63	 * Application-local INT32 SIGN implementation.
    64	 *
    65	 * y = -1 when x < 0
    66	 * y =  0 when x = 0
    67	 * y =  1 when x > 0
    68	 *
    69	 * No temporary buffer or scratch allocation is required.
    70	 */
    71	TfLiteStatus HeatstrokeSignEval(
    72	    TfLiteContext* context,
    73	    TfLiteNode* node)
    74	{
    75	    if (context == nullptr || node == nullptr) {
    76	        return kTfLiteError;
    77	    }
    78	
    79	    const TfLiteEvalTensor* input =
    80	        tflite::micro::GetEvalInput(context, node, 0);
    81	
    82	    TfLiteEvalTensor* output =
    83	        tflite::micro::GetEvalOutput(context, node, 0);
    84	
    85	    if (input == nullptr || output == nullptr) {
    86	        return kTfLiteError;
    87	    }
    88	
    89	    if (input->type != kTfLiteInt32 ||
    90	        output->type != kTfLiteInt32) {
    91	        MicroPrintf(
    92	            "Heatstroke SIGN requires INT32 input/output. "
    93	            "Input=%d Output=%d",
    94	            input->type,
    95	            output->type);
    96	        return kTfLiteError;
    97	    }
    98	
    99	    const auto input_shape =
   100	        tflite::micro::GetTensorShape(input);
   101	
   102	    const auto output_shape =
   103	        tflite::micro::GetTensorShape(output);
   104	
   105	    const int input_count = input_shape.FlatSize();
   106	    const int output_count = output_shape.FlatSize();
   107	
   108	    if (input_count < 0 || input_count != output_count) {
   109	        MicroPrintf(
   110	            "Heatstroke SIGN tensor element-count mismatch.");
   111	        return kTfLiteError;
   112	    }
   113	
   114	    const int32_t* input_data =
   115	        tflite::micro::GetTensorData<int32_t>(input);
   116	
   117	    int32_t* output_data =
   118	        tflite::micro::GetTensorData<int32_t>(output);
   119	
   120	    if (input_count > 0 &&
   121	        (input_data == nullptr || output_data == nullptr)) {
   122	        MicroPrintf(
   123	            "Heatstroke SIGN received a null tensor data pointer.");
   124	        return kTfLiteError;
   125	    }
   126	
   127	    for (int i = 0; i < input_count; ++i) {
   128	        const int32_t value = input_data[i];
   129	
   130	        output_data[i] =
   131	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   132	    }
   133	
   134	    return kTfLiteOk;
   135	}
   136	
   137	TFLMRegistration RegisterHeatstrokeSignKernel()
   138	{
   139	    return tflite::micro::RegisterOp(
   140	        nullptr,
   141	        nullptr,
   142	        HeatstrokeSignEval);
   143	}
