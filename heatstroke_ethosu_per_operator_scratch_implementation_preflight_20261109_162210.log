   155	bool HeatstrokeGatherCheckedMultiply(
   156	    size_t a, size_t b, size_t* result)
   157	{
   158	    if (result == nullptr ||
   159	        (b != 0U &&
   160	         a > (std::numeric_limits<size_t>::max)() / b)) {
   161	        return false;
   162	    }
   163	
   164	    *result = a * b;
   165	    return true;
   166	}
   167	
   168	template <typename InputT, typename IndexT>
   169	TfLiteStatus HeatstrokeGatherCopy(
   170	    const TfLiteGatherParams* params,
   171	    const TfLiteEvalTensor* input,
   172	    const TfLiteEvalTensor* indices,
   173	    TfLiteEvalTensor* output)
   174	{
   175	    if (params == nullptr || input == nullptr ||
   176	        indices == nullptr || output == nullptr ||
   177	        input->dims == nullptr || indices->dims == nullptr ||
   178	        output->dims == nullptr) {
   179	        MicroPrintf("Heatstroke GATHER received invalid tensor metadata.");
   180	        return kTfLiteError;
   181	    }
   182	
   183	    const TfLiteIntArray* input_dims = input->dims;
   184	    const TfLiteIntArray* index_dims = indices->dims;
   185	
   186	    const int input_rank = input_dims->size;
   187	    const int index_rank = index_dims->size;
   188	
   189	    if (input_rank <= 0 || index_rank < 0) {
   190	        MicroPrintf("Heatstroke GATHER received an invalid tensor rank.");
   191	        return kTfLiteError;
   192	    }
   193	
   194	    int axis = params->axis;
   195	    if (axis < 0) {
   196	        axis += input_rank;
   197	    }
   198	
   199	    if (axis < 0 || axis >= input_rank) {
   200	        MicroPrintf("Heatstroke GATHER axis is out of range.");
   201	        return kTfLiteError;
   202	    }
   203	
   204	    int batch_dims = params->batch_dims;
   205	    if (batch_dims < 0) {
   206	        batch_dims += index_rank;
   207	    }
   208	
   209	    if (batch_dims < 0 ||
   210	        batch_dims > axis ||
   211	        batch_dims >= input_rank ||
   212	        batch_dims > index_rank) {
   213	        MicroPrintf("Heatstroke GATHER batch_dims is invalid.");
   214	        return kTfLiteError;
   215	    }
   216	
   217	    for (int i = 0; i < input_rank; ++i) {
   218	        if (input_dims->data[i] < 0) {
   219	            MicroPrintf("Heatstroke GATHER has a negative input dimension.");
   220	            return kTfLiteError;
   221	        }
   222	    }
   223	
   224	    for (int i = 0; i < index_rank; ++i) {
   225	        if (index_dims->data[i] < 0) {
   226	            MicroPrintf("Heatstroke GATHER has a negative index dimension.");
   227	            return kTfLiteError;
   228	        }
   229	    }
   230	
   231	    for (int i = 0; i < batch_dims; ++i) {
   232	        if (input_dims->data[i] != index_dims->data[i]) {
   233	            MicroPrintf("Heatstroke GATHER batch dimensions do not match.");
   234	            return kTfLiteError;
   235	        }
   236	    }
   237	
   238	    const int axis_size = input_dims->data[axis];
   239	
   240	    size_t batch_size = 1U;
   241	    size_t outer_size = 1U;
   242	    size_t inner_size = 1U;
   243	    size_t coord_size = 1U;
   244	
   245	    for (int i = 0; i < batch_dims; ++i) {
   246	        if (!HeatstrokeGatherCheckedMultiply(
   247	                batch_size,
   248	                static_cast<size_t>(input_dims->data[i]),
