   338	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   339	                                             TfLiteNode* node) {
   340	  if (node == nullptr || node->user_data == nullptr) {
   341	    return kTfLiteError;
   342	  }
   343	
   344	  const auto* op_data =
   345	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   346	
   347	  const TfLiteEvalTensor* input =
   348	      GetInputEvalTensor(context, node, 0);
   349	
   350	  TfLiteEvalTensor* output =
   351	      context->GetEvalTensor(context, node->outputs->data[0]);
   352	
   353	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   354	    return kTfLiteError;
   355	  }
   356	
   357	  const int time_steps = op_data->forward.size_info.time_steps;
   358	  const int input_dimension = op_data->forward.size_info.input_dimension;
   359	  const int hidden = op_data->forward.size_info.state_dimension;
   360	
   361	  auto* reversed_input = static_cast<float*>(
   362	      context->GetScratchBuffer(
   363	          context, op_data->reverse_input_buffer));
   364	
   365	  auto* staged_output = static_cast<float*>(
   366	      context->GetScratchBuffer(
   367	          context, op_data->stage_output_buffer));
   368	
   369	  if (reversed_input == nullptr || staged_output == nullptr) {
   370	    MicroPrintf("Heatstroke BiLSTM: scratch buffer unavailable");
   371	    return kTfLiteError;
   372	  }
   373	
   374	  const float* input_data = input->data.f;
   375	  float* output_data = output->data.f;
   376	
   377	  // Reverse the time dimension for the backward direction.
   378	  for (int t = 0; t < time_steps; ++t) {
   379	    std::memcpy(
   380	        reversed_input + t * input_dimension,
   381	        input_data + (time_steps - 1 - t) * input_dimension,
   382	        input_dimension * sizeof(float));
   383	  }
   384	
   385	  TfLiteEvalTensor reversed_input_tensor = *input;
   386	  reversed_input_tensor.data.f = reversed_input;
   387	
   388	  TfLiteEvalTensor staged_output_tensor = *output;
   389	  staged_output_tensor.data.f = staged_output;
   390	
   391	  LSTMKernelContents forward_contents{};
   392	  PopulateDirectionContents(
   393	      context, node, 0, 35, 36,
   394	      input, &staged_output_tensor, &forward_contents);
   395	
   396	  LSTMBuffers<float> buffers =
   397	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   398	
   399	  TF_LITE_ENSURE_STATUS(
   400	      EvalLstm<float, float, float, float>(
   401	          op_data->forward, forward_contents, buffers));
   402	
   403	  // Copy forward outputs into the first half of the merged output.
   404	  for (int t = 0; t < time_steps; ++t) {
   405	    std::memcpy(
   406	        output_data + t * (2 * hidden),
   407	        staged_output + t * hidden,
   408	        hidden * sizeof(float));
   409	  }
   410	
   411	  LSTMKernelContents backward_contents{};
   412	  PopulateDirectionContents(
   413	      context, node, 17, 37, 38,
   414	      &reversed_input_tensor, &staged_output_tensor,
   415	      &backward_contents);
   416	
   417	  TF_LITE_ENSURE_STATUS(
   418	      EvalLstm<float, float, float, float>(
   419	          op_data->backward, backward_contents, buffers));
   420	
   421	  // Restore backward outputs to original time order and copy them
   422	  // into the second half of the merged output.
   423	  for (int t = 0; t < time_steps; ++t) {
   424	    std::memcpy(
   425	        output_data + t * (2 * hidden) + hidden,
   426	        staged_output + (time_steps - 1 - t) * hidden,
   427	        hidden * sizeof(float));
   428	  }
   429	
   430	  return kTfLiteOk;
   431	}
