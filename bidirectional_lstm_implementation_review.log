    59	bool IsMatrix(const TfLiteEvalTensor* tensor, int rows, int columns) {
    60	  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
    61	         tensor->dims->size == 2 &&
    62	         tensor->dims->data[0] == rows &&
    63	         tensor->dims->data[1] == columns;
