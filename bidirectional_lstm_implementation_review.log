   189	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   190	                                                TfLiteNode* node) {
   191	  if (node == nullptr || node->builtin_data == nullptr ||
   192	      node->inputs == nullptr || node->outputs == nullptr ||
   193	      node->inputs->size != 48 || node->outputs->size != 1 ||
   194	      node->user_data == nullptr) {
   195	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   196	    return kTfLiteError;
   197	  }
   198	
   199	  auto* op_data =
   200	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   201	
   202	  const auto* params =
   203	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   204	          node->builtin_data);
   205	
   206	  if (!params->time_major || !params->merge_outputs ||
   207	      params->activation != kTfLiteActTanh) {
   208	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   209	    return kTfLiteError;
   210	  }
   211	
   212	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   213	  TfLiteEvalTensor* output =
   214	      context->GetEvalTensor(context, node->outputs->data[0]);
   215	
   216	  if (!IsFloatTensor(input) || !IsFloatTensor(output) ||
   217	      input->dims == nullptr || output->dims == nullptr ||
   218	      input->dims->size != 3 || output->dims->size != 3) {
   219	    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
   220	    return kTfLiteError;
   221	  }
   222	
   223	  const int time_steps = input->dims->data[0];
   224	  const int batch_size = input->dims->data[1];
   225	  const int input_dimension = input->dims->data[2];
   226	
   227	  // The supplied heat-stress model uses time-major, single-batch sequences.
   228	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   229	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   230	    return kTfLiteError;
   231	  }
   232	
   233	  int forward_hidden = 0;
   234	  int backward_hidden = 0;
   235	
   236	  if (!ValidateDirection(context, node, 0, 35, 36,
   237	                         input_dimension, batch_size, &forward_hidden) ||
   238	      !ValidateDirection(context, node, 17, 37, 38,
   239	                         input_dimension, batch_size, &backward_hidden) ||
   240	      forward_hidden != backward_hidden) {
   241	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   242	    return kTfLiteError;
   243	  }
   244	
   245	  const int hidden = forward_hidden;
   246	
   247	  if (output->dims->data[0] != time_steps ||
   248	      output->dims->data[1] != batch_size ||
   249	      output->dims->data[2] != 2 * hidden) {
   250	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   251	    return kTfLiteError;
   252	  }
   253	
   254	  // The supplied model has no auxiliary input tensors.
   255	  for (int i = 39; i < 48; ++i) {
   256	    if (GetInputEvalTensor(context, node, i) != nullptr) {
   257	      MicroPrintf("Heatstroke BiLSTM: auxiliary inputs are unsupported");
   258	      return kTfLiteError;
   259	    }
   260	  }
   261	
   262	  InitializeFloatLstmParameters(
   263	      &op_data->forward, true, batch_size, time_steps,
   264	      input_dimension, hidden, params->activation, params->cell_clip);
   265	
   266	  InitializeFloatLstmParameters(
   267	      &op_data->backward, true, batch_size, time_steps,
   268	      input_dimension, hidden, params->activation, params->cell_clip);
   269	
   270	  const size_t reverse_bytes =
   271	      static_cast<size_t>(time_steps) * batch_size *
   272	      input_dimension * sizeof(float);
   273	
   274	  const size_t stage_bytes =
   275	      static_cast<size_t>(time_steps) * batch_size *
   276	      hidden * sizeof(float);
   277	
   278	  const size_t internal_bytes =
   279	      static_cast<size_t>(batch_size) * hidden * sizeof(float);
   280	
   281	  if (context->RequestScratchBufferInArena(
   282	          context, reverse_bytes, &op_data->reverse_input_buffer) !=
   283	          kTfLiteOk ||
   284	      context->RequestScratchBufferInArena(
   285	          context, stage_bytes, &op_data->stage_output_buffer) !=
   286	          kTfLiteOk) {
   287	    MicroPrintf("Heatstroke BiLSTM: scratch allocation failed");
   288	    return kTfLiteError;
   289	  }
   290	
   291	  // Match the four scratch buffers requested by TFLM's existing
   292	  // unidirectional FP32 LSTM implementation.
   293	  for (int i = 0; i < 4; ++i) {
   294	    if (context->RequestScratchBufferInArena(
   295	            context, internal_bytes,
   296	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   297	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   298	      return kTfLiteError;
   299	    }
   300	
   301	    // Forward and backward passes execute sequentially, so they can
   302	    // safely reuse the same four evaluator scratch buffers.
   303	    op_data->backward.buffer_indices[i] =
   304	        op_data->forward.buffer_indices[i];
   305	  }
   306	
   307	  return kTfLiteOk;
