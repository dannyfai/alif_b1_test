    72	bool ValidateDirection(TfLiteContext* context,
    73	                       TfLiteNode* node,
    74	                       int parameter_base,
    75	                       int hidden_state_position,
    76	                       int cell_state_position,
    77	                       int input_dimension,
    78	                       int batch_size,
    79	                       int* hidden_dimension) {
    80	  // Four input weights, four recurrent weights, and four biases.
    81	  TfLiteEvalTensor* first_weight =
    82	      GetInputEvalTensor(context, node, parameter_base + 1);
    83	
    84	  if (first_weight == nullptr || first_weight->dims == nullptr ||
    85	      first_weight->dims->size != 2) {
    86	    return false;
    87	  }
    88	
    89	  const int hidden = first_weight->dims->data[0];
    90	
    91	  if (hidden <= 0 ||
    92	      first_weight->dims->data[1] != input_dimension) {
    93	    return false;
    94	  }
    95	
    96	  for (int gate = 0; gate < 4; ++gate) {
    97	    TfLiteEvalTensor* input_weight =
    98	        GetInputEvalTensor(context, node, parameter_base + 1 + gate);
    99	    TfLiteEvalTensor* recurrent_weight =
   100	        GetInputEvalTensor(context, node, parameter_base + 5 + gate);
   101	    TfLiteEvalTensor* bias =
   102	        GetInputEvalTensor(context, node, parameter_base + 12 + gate);
   103	
   104	    if (!IsMatrix(input_weight, hidden, input_dimension) ||
   105	        !IsMatrix(recurrent_weight, hidden, hidden) ||
   106	        !IsVector(bias, hidden)) {
   107	      return false;
   108	    }
   109	  }
   110	
   111	  // This app-local evaluator currently supports standard LSTM only:
   112	  // no peephole weights and no projection weights.
   113	  for (int i = 9; i <= 11; ++i) {
   114	    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
   115	      return false;
   116	    }
   117	  }
   118	
   119	  for (int i = 16; i <= 17; ++i) {
   120	    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
   121	      return false;
   122	    }
   123	  }
   124	
   125	  TfLiteEvalTensor* hidden_state =
   126	      GetInputEvalTensor(context, node, hidden_state_position);
   127	  TfLiteEvalTensor* cell_state =
   128	      GetInputEvalTensor(context, node, cell_state_position);
   129	
   130	  if (!IsFloatTensor(hidden_state) || !IsFloatTensor(cell_state) ||
   131	      TensorElementCount(hidden_state) !=
   132	          static_cast<size_t>(batch_size * hidden) ||
   133	      TensorElementCount(cell_state) !=
   134	          static_cast<size_t>(batch_size * hidden)) {
   135	    return false;
   136	  }
   137	
   138	  *hidden_dimension = hidden;
   139	  return true;
   140	}
