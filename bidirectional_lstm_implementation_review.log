   310	void PopulateDirectionContents(TfLiteContext* context,
   311	                               TfLiteNode* node,
   312	                               int parameter_base,
   313	                               int hidden_state_position,
   314	                               int cell_state_position,
   315	                               const TfLiteEvalTensor* input,
   316	                               TfLiteEvalTensor* staged_output,
   317	                               LSTMKernelContents* contents) {
   318	  for (int i = 0; i < 24; ++i) {
   319	    contents->internal_tensors[i] = nullptr;
   320	  }
   321	
   322	  contents->internal_tensors[0] =
   323	      const_cast<TfLiteEvalTensor*>(input);
   324	
   325	  for (int i = 1; i <= 17; ++i) {
   326	    contents->internal_tensors[i] =
   327	        GetInputEvalTensor(context, node, parameter_base + i);
   328	  }
   329	
   330	  contents->internal_tensors[18] =
   331	      GetInputEvalTensor(context, node, hidden_state_position);
   332	  contents->internal_tensors[19] =
   333	      GetInputEvalTensor(context, node, cell_state_position);
   334	
   335	  contents->output_tensor = staged_output;
   336	}
