    24	TfLiteEvalTensor* GetInputEvalTensor(TfLiteContext* context,
    25	                                     TfLiteNode* node,
    26	                                     int input_position) {
    27	  if (input_position < 0 || input_position >= node->inputs->size) {
    28	    return nullptr;
    29	  }
    30	
    31	  const int tensor_index = node->inputs->data[input_position];
    32	  if (tensor_index < 0) {
    33	    return nullptr;
    34	  }
    35	
    36	  return context->GetEvalTensor(context, tensor_index);
    37	}
