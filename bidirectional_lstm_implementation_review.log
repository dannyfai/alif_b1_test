    39	size_t TensorElementCount(const TfLiteEvalTensor* tensor) {
    40	  if (tensor == nullptr || tensor->dims == nullptr) {
    41	    return 0;
    42	  }
    43	
    44	  size_t count = 1;
    45	  for (int i = 0; i < tensor->dims->size; ++i) {
    46	    if (tensor->dims->data[i] < 0) {
    47	      return 0;
    48	    }
    49	    count *= static_cast<size_t>(tensor->dims->data[i]);
    50	  }
    51	  return count;
    52	}
