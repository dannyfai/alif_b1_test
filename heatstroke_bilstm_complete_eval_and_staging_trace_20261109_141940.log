   182	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   183	                                                TfLiteNode* node) {
   184	  if (node == nullptr || node->builtin_data == nullptr ||
   185	      node->inputs == nullptr || node->outputs == nullptr ||
   186	      node->inputs->size != 29 || node->outputs->size != 1 ||
   187	      node->user_data == nullptr) {
   188	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   189	    return kTfLiteError;
   190	  }
   191	
   192	  auto* op_data =
   193	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   194	
   195	  const auto* params =
   196	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   197	          node->builtin_data);
   198	
   199	  if (!params->time_major || !params->merge_outputs ||
   200	      params->activation != kTfLiteActTanh) {
   201	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   202	    return kTfLiteError;
   203	  }
   204	
   205	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   206	  TfLiteEvalTensor* output =
   207	      context->GetEvalTensor(context, node->outputs->data[0]);
   208	
   209	  if (!IsFloatTensorType(input) || !IsFloatTensorType(output) ||
   210	      input->dims == nullptr || output->dims == nullptr ||
   211	      input->dims->size != 3 || output->dims->size != 3) {
   212	    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
   213	    return kTfLiteError;
   214	  }
   215	
   216	  const int time_steps = input->dims->data[0];
   217	  const int batch_size = input->dims->data[1];
   218	  const int input_dimension = input->dims->data[2];
   219	
   220	  // The supplied heat-stress model uses time-major, single-batch sequences.
   221	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   222	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   223	    return kTfLiteError;
   224	  }
   225	
   226	  int forward_hidden = 0;
   227	  int backward_hidden = 0;
   228	
   229	  if (!ValidateDirection(context, node, 1, 5, 9, 25, 26, input_dimension, batch_size, &forward_hidden) ||
   230	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   231	      forward_hidden != backward_hidden) {
   232	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   233	    return kTfLiteError;
   234	  }
   235	
   236	  const int hidden = forward_hidden;
   237	
   238	  if (output->dims->data[0] != time_steps ||
   239	      output->dims->data[1] != batch_size ||
   240	      output->dims->data[2] != 2 * hidden) {
   241	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   242	    return kTfLiteError;
   243	  }
   244	
   245	  // The directional evaluator must see [time_steps, batch_size, hidden],
   246	  // not the merged output shape [time_steps, batch_size, 2 * hidden].
   247	  const size_t staged_dims_bytes =
   248	      sizeof(TfLiteIntArray) + 2 * sizeof(int);
   249	  op_data->staged_output_dims =
   250	      static_cast<TfLiteIntArray*>(
   251	          context->AllocatePersistentBuffer(context, staged_dims_bytes));
   252	
   253	  if (op_data->staged_output_dims == nullptr) {
   254	    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
   255	    return kTfLiteError;
   256	  }
   257	
   258	  op_data->staged_output_dims->size = 3;
