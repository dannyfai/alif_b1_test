===== REVERSE V2 IMPLEMENTATION =====

#include "reverse_v2.h"

#include <cstdint>
#include <cstring>

#include "tensorflow/lite/kernels/kernel_util.h"
#include "tensorflow/lite/micro/kernels/kernel_util.h"

namespace tflite {
namespace {

struct ReverseV2OpData {
  // No persistent or temporary memory required.
};

// Check whether a dimension is included in the axis tensor.
template <typename AxisType>
bool IsDimensionReversed(
    int dimension,
    int rank,
    const AxisType* axes,
    int num_axes) {

  for (int i = 0; i < num_axes; ++i) {
    int axis = static_cast<int>(axes[i]);

    // Normalize negative axes.
    if (axis < 0) {
      axis += rank;
    }

    if (axis == dimension) {
      return true;
    }
  }

  return false;
}

// Validate axis values.
template <typename AxisType>
bool ValidateAxes(
    const AxisType* axes,
    int num_axes,
    int rank) {

  for (int i = 0; i < num_axes; ++i) {
    const int64_t axis = static_cast<int64_t>(axes[i]);

    if (axis < -rank || axis >= rank) {
      return false;
    }
  }

  return true;
}

// Generic reverse implementation.
template <typename T, typename AxisType>
void ReverseTensor(
    const T* input,
    T* output,
    const TfLiteIntArray* dims,
    const AxisType* axes,
    int num_axes,
    int rank,
    int num_elements) {

  for (int out_index = 0;
       out_index < num_elements;
       ++out_index) {

    int input_index = 0;

    // Calculate the corresponding input offset.
    for (int d = 0; d < rank; ++d) {

      const int dim_size = dims->data[d];

      int stride = 1;

      for (int j = d + 1; j < rank; ++j) {
        stride *= dims->data[j];
      }

      const int coordinate =
          (out_index / stride) % dim_size;

      const bool reverse = IsDimensionReversed(
          d, rank, axes, num_axes);

      const int input_coordinate =
          reverse ? (dim_size - 1 - coordinate)
                  : coordinate;

      input_index += input_coordinate * stride;
    }

    output[out_index] = input[input_index];
  }
}

TfLiteStatus Prepare(
    TfLiteContext* context,
    TfLiteNode* node) {
      
  MicroContext* micro_context = GetMicroContext(context);

  TF_LITE_ENSURE_EQ(context, NumInputs(node), 2);
  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);

  TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
  TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 1);
  TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);

  TF_LITE_ENSURE(context, input != nullptr);
  TF_LITE_ENSURE(context, axis != nullptr);
  TF_LITE_ENSURE(context, output != nullptr);

  TF_LITE_ENSURE_EQ(context, input->type, output->type);

  TF_LITE_ENSURE_EQ(
      context, input->dims->size, output->dims->size);

  for (int i = 0; i < input->dims->size; ++i) {
    TF_LITE_ENSURE_EQ(
        context,
        input->dims->data[i],
        output->dims->data[i]);
  }

  TF_LITE_ENSURE(
      context,
      axis->type == kTfLiteInt32 ||
      axis->type == kTfLiteInt64);

  micro_context->DeallocateTempTfLiteTensor(input);
  micro_context->DeallocateTempTfLiteTensor(axis);
  micro_context->DeallocateTempTfLiteTensor(output);

  return kTfLiteOk;
}

template <typename T, typename AxisType>
TfLiteStatus EvalTyped(
    TfLiteContext* context,
    const TfLiteTensor* input,
    const TfLiteTensor* axis,
    TfLiteTensor* output) {

  const AxisType* axes =
      GetTensorData<AxisType>(axis);

  const int rank = input->dims->size;
  const int num_axes = NumElements(axis);
  const int num_elements = NumElements(input);

  if (num_axes > 0) {
    TF_LITE_ENSURE(context, axes != nullptr);

    TF_LITE_ENSURE(
        context,
        ValidateAxes(axes, num_axes, rank));
  }

  const T* input_data = GetTensorData<T>(input);
  T* output_data = GetTensorData<T>(output);

  if (num_elements == 0) {
    return kTfLiteOk;
  }

  TF_LITE_ENSURE(context, input_data != nullptr);
  TF_LITE_ENSURE(context, output_data != nullptr);

  ReverseTensor(
      input_data,
      output_data,
      input->dims,
      axes,
      num_axes,
      rank,
      num_elements);

  return kTfLiteOk;
}

TfLiteStatus Eval(
    TfLiteContext* context,
    TfLiteNode* node) {

  const TfLiteTensor* input =
      GetInput(context, node, 0);

  const TfLiteTensor* axis =
      GetInput(context, node, 1);

  TfLiteTensor* output =
      GetOutput(context, node, 0);

  TF_LITE_ENSURE(context, input != nullptr);
  TF_LITE_ENSURE(context, axis != nullptr);
  TF_LITE_ENSURE(context, output != nullptr);

  if (axis->type == kTfLiteInt32) {

    switch (input->type) {

      case kTfLiteFloat32:
        return EvalTyped<float, int32_t>(
            context, input, axis, output);

      case kTfLiteInt8:
        return EvalTyped<int8_t, int32_t>(
            context, input, axis, output);

      case kTfLiteUInt8:
        return EvalTyped<uint8_t, int32_t>(
            context, input, axis, output);

      case kTfLiteInt16:
        return EvalTyped<int16_t, int32_t>(
            context, input, axis, output);

      case kTfLiteInt32:
        return EvalTyped<int32_t, int32_t>(
            context, input, axis, output);

      default:
        TF_LITE_KERNEL_LOG(
            context,
            "REVERSE_V2: Unsupported input type %d",
            input->type);
        return kTfLiteError;
    }
  }

  if (axis->type == kTfLiteInt64) {

    switch (input->type) {

      case kTfLiteFloat32:
        return EvalTyped<float, int64_t>(
            context, input, axis, output);

      case kTfLiteInt8:
        return EvalTyped<int8_t, int64_t>(
            context, input, axis, output);

      case kTfLiteUInt8:
        return EvalTyped<uint8_t, int64_t>(
            context, input, axis, output);

      case kTfLiteInt16:
        return EvalTyped<int16_t, int64_t>(
            context, input, axis, output);

      case kTfLiteInt32:
        return EvalTyped<int32_t, int64_t>(
            context, input, axis, output);

      default:
        TF_LITE_KERNEL_LOG(
            context,
            "REVERSE_V2: Unsupported input type %d",
            input->type);
        return kTfLiteError;
    }
  }

  return kTfLiteError;
}

}  // namespace

TFLMRegistration Register_REVERSE_V2() {
  return tflite::micro::RegisterOp(nullptr, Prepare, Eval);
}

}  // namespace tflite

