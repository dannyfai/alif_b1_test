#include "reverse_v2.h"
#include "heatstroke_bidirectional_lstm.h"

const tflite::MicroOpResolver& arm::app::fwk::tflm::PolyUModel1::GetOpResolver()
{
    return this->m_opResolver;
}

TfLiteStatus ParseReverseV2(const tflite::Operator*, tflite::ErrorReporter*, tflite::BuiltinDataAllocator*,
                        void**) {
  return kTfLiteOk;
}

TfLiteStatus ParseHeatstrokeBidirectionalSequenceLstm(
    const tflite::Operator* op,
    tflite::ErrorReporter* error_reporter,
    tflite::BuiltinDataAllocator* allocator,
    void** builtin_data) {
    return tflite::ParseOpData(
        op,
        tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
        error_reporter,
        allocator,
        builtin_data);
}


bool arm::app::fwk::tflm::PolyUModel1::EnlistOperations()
{
#ifndef ETHOS_U_NPU_ASSUMED
    
    this->m_opResolver.AddStridedSlice();
    this->m_opResolver.AddFullyConnected();
    this->m_opResolver.AddReshape();
    this->m_opResolver.AddAveragePool2D();
    this->m_opResolver.AddUnpack();
    this->m_opResolver.AddAdd();
    this->m_opResolver.AddSplit();
    this->m_opResolver.AddTanh();
    this->m_opResolver.AddLogistic();
    this->m_opResolver.AddMul();
    this->m_opResolver.AddPack();
    this->m_opResolver.AddConcatenation();
    this->m_opResolver.AddTranspose();
    this->m_opResolver.AddGather();
    this->m_opResolver.AddMean();
    this->m_opResolver.AddSquaredDifference();
    this->m_opResolver.AddRsqrt();
    this->m_opResolver.AddSub();
    this->m_opResolver.AddPad();
    this->m_opResolver.AddConv2D();
    this->m_opResolver.AddSoftmax();
    //this->m_opResolver.AddCustom("ReverseV2", tflite::Register_REVERSE_V2());
    const TFLMRegistration& registration = tflite::Register_REVERSE_V2();
    this->m_opResolver.AddBuiltin(tflite::BuiltinOperator_REVERSE_V2, registration,
                      ParseReverseV2);

#endif

    
    {
        const TFLMRegistration registration =
            tflite::RegisterHeatstrokeBidirectionalSequenceLstm();

        if (this->m_opResolver.AddBuiltin(
                tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
                registration, ParseHeatstrokeBidirectionalSequenceLstm) != kTfLiteOk) {
            return false;
        }
    }

if (kTfLiteOk == this->m_opResolver.AddEthosU()) {
        info("Added %s support to op resolver\n", tflite::GetString_ETHOSU());
    } else {
        printf_err("Failed to add Arm NPU support to op resolver.");
        return false;
    }
    return true;
}

