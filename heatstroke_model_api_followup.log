  const int input_dimension = op_data->forward.size_info.input_dimension;
  const int hidden = op_data->forward.size_info.state_dimension;

  auto* reversed_input = static_cast<float*>(
      context->GetScratchBuffer(
          context, op_data->reverse_input_buffer));

  auto* staged_output = static_cast<float*>(
