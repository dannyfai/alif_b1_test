#ifndef POLYU_MODEL1_HPP
#define POLYU_MODEL1_HPP

#include "mlek/fwk/tflm/TflmModel.hpp"

namespace arm::app::asr {
extern const int g_FrameLength;
extern const int g_FrameStride;
