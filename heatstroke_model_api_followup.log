  TfLiteEvalTensor reversed_input_tensor = *input;
  reversed_input_tensor.data.f = reversed_input;

  TfLiteEvalTensor staged_output_tensor = *output;
  staged_output_tensor.data.f = staged_output;
  staged_output_tensor.dims = op_data->staged_output_dims;

  LSTMKernelContents forward_contents{};
