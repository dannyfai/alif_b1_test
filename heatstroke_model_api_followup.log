#include "heatstroke_bidirectional_lstm.h"

#include <cstddef>
#include <cstdint>
#include <cstring>

#include "tensorflow/lite/c/builtin_op_data.h"
#include "tensorflow/lite/c/common.h"
#include "tensorflow/lite/micro/kernels/kernel_util.h"
#include "tensorflow/lite/micro/kernels/lstm_eval.h"
#include "tensorflow/lite/micro/kernels/lstm_shared.h"
#include "tensorflow/lite/micro/micro_log.h"

namespace tflite {
namespace {

struct HeatstrokeBidirectionalLstmOpData {
  OpDataLSTM forward;
  OpDataLSTM backward;
  TfLiteIntArray* staged_output_dims;
  int reverse_input_buffer;
  int stage_output_buffer;
};

TfLiteEvalTensor* GetInputEvalTensor(TfLiteContext* context,
                                     TfLiteNode* node,
                                     int input_position) {
  if (input_position < 0 || input_position >= node->inputs->size) {
    return nullptr;
  }

  const int tensor_index = node->inputs->data[input_position];
  if (tensor_index < 0) {
    return nullptr;
  }

  return context->GetEvalTensor(context, tensor_index);
}

size_t TensorElementCount(const TfLiteEvalTensor* tensor) {
  if (tensor == nullptr || tensor->dims == nullptr) {
    return 0;
  }

  size_t count = 1;
  for (int i = 0; i < tensor->dims->size; ++i) {
    if (tensor->dims->data[i] < 0) {
      return 0;
    }
    count *= static_cast<size_t>(tensor->dims->data[i]);
  }
  return count;
}

bool IsFloatTensor(const TfLiteEvalTensor* tensor) {
  return tensor != nullptr && tensor->type == kTfLiteFloat32 &&
         tensor->data.f != nullptr;
}

bool IsMatrix(const TfLiteEvalTensor* tensor, int rows, int columns) {
  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
         tensor->dims->size == 2 &&
         tensor->dims->data[0] == rows &&
         tensor->dims->data[1] == columns;
}

bool IsVector(const TfLiteEvalTensor* tensor, int length) {
  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
         tensor->dims->size == 1 &&
         tensor->dims->data[0] == length;
}

bool ValidateDirection(TfLiteContext* context,
                       TfLiteNode* node,
                       int parameter_base,
                       int hidden_state_position,
                       int cell_state_position,
                       int input_dimension,
                       int batch_size,
                       int* hidden_dimension) {
  // Four input weights, four recurrent weights, and four biases.
  TfLiteEvalTensor* first_weight =
      GetInputEvalTensor(context, node, parameter_base + 1);

  if (first_weight == nullptr || first_weight->dims == nullptr ||
      first_weight->dims->size != 2) {
    return false;
  }

  const int hidden = first_weight->dims->data[0];

  if (hidden <= 0 ||
      first_weight->dims->data[1] != input_dimension) {
    return false;
  }

  for (int gate = 0; gate < 4; ++gate) {
    TfLiteEvalTensor* input_weight =
        GetInputEvalTensor(context, node, parameter_base + 1 + gate);
    TfLiteEvalTensor* recurrent_weight =
        GetInputEvalTensor(context, node, parameter_base + 5 + gate);
    TfLiteEvalTensor* bias =
        GetInputEvalTensor(context, node, parameter_base + 12 + gate);

    if (!IsMatrix(input_weight, hidden, input_dimension) ||
        !IsMatrix(recurrent_weight, hidden, hidden) ||
        !IsVector(bias, hidden)) {
      return false;
    }
  }

  // This app-local evaluator currently supports standard LSTM only:
  // no peephole weights and no projection weights.
  for (int i = 9; i <= 11; ++i) {
    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
      return false;
    }
  }

  for (int i = 16; i <= 17; ++i) {
    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
      return false;
    }
  }

  TfLiteEvalTensor* hidden_state =
      GetInputEvalTensor(context, node, hidden_state_position);
  TfLiteEvalTensor* cell_state =
      GetInputEvalTensor(context, node, cell_state_position);

  if (!IsFloatTensor(hidden_state) || !IsFloatTensor(cell_state) ||
      TensorElementCount(hidden_state) !=
          static_cast<size_t>(batch_size * hidden) ||
      TensorElementCount(cell_state) !=
          static_cast<size_t>(batch_size * hidden)) {
    return false;
  }

  *hidden_dimension = hidden;
  return true;
}

void InitializeFloatLstmParameters(
    OpDataLSTM* op_data,
    bool time_major,
    int batch_size,
    int time_steps,
    int input_dimension,
    int hidden_dimension,
    TfLiteFusedActivation activation,
    float cell_clip) {
  op_data->size_info.time_major = time_major;
  op_data->size_info.batch_size = batch_size;
  op_data->size_info.time_steps = time_steps;
  op_data->size_info.input_dimension = input_dimension;
  op_data->size_info.state_dimension = hidden_dimension;

  op_data->cell_gate_nonlinear_type = activation;
  op_data->cell_state_info = CreateLstmCellStateInfoFloat(cell_clip);

  op_data->forget_gate_parameters = CreateGateParamsFloat();
  op_data->input_gate_parameters = CreateGateParamsFloat();
  op_data->cell_gate_parameters = CreateGateParamsFloat();
  op_data->output_gate_parameters = CreateGateParamsFloat();

  op_data->inter_gate_parameters.forget_cell_mul_params =
      CreateInterGateMulParamsFloat();
  op_data->inter_gate_parameters.input_mul_params =
      CreateInterGateMulParamsFloat();
  op_data->inter_gate_parameters.output_mul_params =
      CreateInterGateMulParamsFloat();
}

void* HeatstrokeBidirectionalLstmInit(TfLiteContext* context,
                                      const char* buffer,
                                      size_t length) {
  (void)buffer;
  (void)length;

  auto* data = static_cast<HeatstrokeBidirectionalLstmOpData*>(
      context->AllocatePersistentBuffer(
          context, sizeof(HeatstrokeBidirectionalLstmOpData)));

  if (data != nullptr) {
    std::memset(data, 0, sizeof(*data));
  }
  return data;
}

TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
                                                TfLiteNode* node) {
  if (node == nullptr || node->builtin_data == nullptr ||
      node->inputs == nullptr || node->outputs == nullptr ||
      node->inputs->size != 48 || node->outputs->size != 1 ||
      node->user_data == nullptr) {
    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
    return kTfLiteError;
  }

  auto* op_data =
      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);

  const auto* params =
      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
          node->builtin_data);

  if (!params->time_major || !params->merge_outputs ||
      params->activation != kTfLiteActTanh) {
    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
    return kTfLiteError;
  }

  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
  TfLiteEvalTensor* output =
      context->GetEvalTensor(context, node->outputs->data[0]);

  if (!IsFloatTensor(input) || !IsFloatTensor(output) ||
      input->dims == nullptr || output->dims == nullptr ||
      input->dims->size != 3 || output->dims->size != 3) {
    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
    return kTfLiteError;
  }

  const int time_steps = input->dims->data[0];
  const int batch_size = input->dims->data[1];
  const int input_dimension = input->dims->data[2];

  // The supplied heat-stress model uses time-major, single-batch sequences.
  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
    return kTfLiteError;
  }

  int forward_hidden = 0;
  int backward_hidden = 0;

  if (!ValidateDirection(context, node, 0, 35, 36,
                         input_dimension, batch_size, &forward_hidden) ||
      !ValidateDirection(context, node, 17, 37, 38,
                         input_dimension, batch_size, &backward_hidden) ||
      forward_hidden != backward_hidden) {
    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
    return kTfLiteError;
  }

  const int hidden = forward_hidden;

  if (output->dims->data[0] != time_steps ||
      output->dims->data[1] != batch_size ||
      output->dims->data[2] != 2 * hidden) {
    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
    return kTfLiteError;
  }

  // The directional evaluator must see [time_steps, batch_size, hidden],
  // not the merged output shape [time_steps, batch_size, 2 * hidden].
  const size_t staged_dims_bytes =
      sizeof(TfLiteIntArray) + 2 * sizeof(int);
  op_data->staged_output_dims =
      static_cast<TfLiteIntArray*>(
          context->AllocatePersistentBuffer(context, staged_dims_bytes));

  if (op_data->staged_output_dims == nullptr) {
    MicroPrintf("Heatstroke BiLSTM: output dimensions allocation failed");
    return kTfLiteError;
  }

  op_data->staged_output_dims->size = 3;
  op_data->staged_output_dims->data[0] = time_steps;
  op_data->staged_output_dims->data[1] = batch_size;
  op_data->staged_output_dims->data[2] = hidden;

  // The supplied model has no auxiliary input tensors.
  for (int i = 39; i < 48; ++i) {
    if (GetInputEvalTensor(context, node, i) != nullptr) {
      MicroPrintf("Heatstroke BiLSTM: auxiliary inputs are unsupported");
      return kTfLiteError;
    }
  }

  InitializeFloatLstmParameters(
      &op_data->forward, true, batch_size, time_steps,
      input_dimension, hidden, params->activation, params->cell_clip);

  InitializeFloatLstmParameters(
      &op_data->backward, true, batch_size, time_steps,
      input_dimension, hidden, params->activation, params->cell_clip);

  const size_t reverse_bytes =
      static_cast<size_t>(time_steps) * batch_size *
      input_dimension * sizeof(float);

  const size_t stage_bytes =
      static_cast<size_t>(time_steps) * batch_size *
      hidden * sizeof(float);

  const size_t internal_bytes =
      static_cast<size_t>(batch_size) * hidden * sizeof(float);

  if (context->RequestScratchBufferInArena(
          context, reverse_bytes, &op_data->reverse_input_buffer) !=
          kTfLiteOk ||
      context->RequestScratchBufferInArena(
          context, stage_bytes, &op_data->stage_output_buffer) !=
          kTfLiteOk) {
    MicroPrintf("Heatstroke BiLSTM: scratch allocation failed");
    return kTfLiteError;
  }

  // Match the four scratch buffers requested by TFLM's existing
  // unidirectional FP32 LSTM implementation.
  for (int i = 0; i < 4; ++i) {
    if (context->RequestScratchBufferInArena(
            context, internal_bytes,
            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
      return kTfLiteError;
    }

    // Forward and backward passes execute sequentially, so they can
    // safely reuse the same four evaluator scratch buffers.
    op_data->backward.buffer_indices[i] =
        op_data->forward.buffer_indices[i];
  }

  return kTfLiteOk;
}

void PopulateDirectionContents(TfLiteContext* context,
                               TfLiteNode* node,
                               int parameter_base,
                               int hidden_state_position,
                               int cell_state_position,
                               const TfLiteEvalTensor* input,
                               TfLiteEvalTensor* staged_output,
                               LSTMKernelContents* contents) {
  for (int i = 0; i < 24; ++i) {
    contents->internal_tensors[i] = nullptr;
  }

  contents->internal_tensors[0] =
      const_cast<TfLiteEvalTensor*>(input);

  for (int i = 1; i <= 17; ++i) {
    contents->internal_tensors[i] =
        GetInputEvalTensor(context, node, parameter_base + i);
  }

  contents->internal_tensors[18] =
      GetInputEvalTensor(context, node, hidden_state_position);
  contents->internal_tensors[19] =
      GetInputEvalTensor(context, node, cell_state_position);

  contents->output_tensor = staged_output;
}

TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
                                             TfLiteNode* node) {
  if (node == nullptr || node->user_data == nullptr) {
    return kTfLiteError;
  }

