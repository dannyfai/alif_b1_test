    85	
    86	volatile uint8_t button_pressed = 0U;
    87	static struct gpio_callback button_cb_data;
    88	static bool por_boot;
    89	static struct k_sem button_wait_sem;
    90	
    91	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
    92	{
    93		ARG_UNUSED(dev);
    94		ARG_UNUSED(cb);
    95		ARG_UNUSED(pins);
    96	
    97		if (por_boot) {
    98			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
    99			return;
   100		}
   101	
   102		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   103	    if (val < 0) {
   104	        LOG_ERR("Failed to read pin: %d", val);
   105	        return;
   106	    }
   107	
   108	    button_pressed = (val == 1);
   109	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   110	
   111		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   112			k_sem_give(&button_wait_sem);
   113		}
   114	}
   115	
   116	/**
   117	 * Configure LPGPIO0 and LPGPIO1 as inputs with interrupts
   118	 * With B1/E1C need to connect wire between SW5 (P5_7) and P15_0 to use button as Push-to-talk button.
   119	 * With B1/E1C devkit you need to also remove resistor R64. */
   120	static int configure_lpgpio(void)
   121	{
   122		int ret;
   123		const struct gpio_dt_spec *spec = &lpgpio_config;
   124	
   125		if (!spec || !spec->port) {
   126			/* Just ignore */
   127			LOG_ERR("lpgpio invalid");
   128			return -ENODEV;
   129		}
   130	
   131		/* Configure LPGPIO0 for wakeup */
   132		if (!gpio_is_ready_dt(spec)) {
   133			LOG_ERR("LPGPIO0 device is not ready");
   134			return -ENODEV;
   135		}
   136	
   137		ret = gpio_pin_configure_dt(spec, GPIO_INPUT | spec->dt_flags);
   138		if (ret != 0) {
   139			LOG_ERR("Failed to configure LPGPIO as input: %d", ret);
   140			return ret;
   141		}
   142	
   143		ret = gpio_pin_interrupt_configure_dt(spec,
   144						      GPIO_INT_EDGE_BOTH);
   145		if (ret != 0) {
   146			LOG_ERR("Failed to configure LPGPIO interrupt: %d", ret);
   147			return ret;
   148		}
   149	
   150		gpio_init_callback(&button_cb_data, button_callback, BIT(spec->pin));
   151		ret = gpio_add_callback(spec->port, &button_cb_data);
   152		if (ret != 0) {
   153			LOG_ERR("Failed to add button callback: %d", ret);
   154			return ret;
   155		}
   156	
   157		LOG_INF("LPGPIO%d configured", spec->pin);
   158	
   159		return 0;
   160	}
