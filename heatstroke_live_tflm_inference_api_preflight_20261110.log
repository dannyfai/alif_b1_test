   162	/** @brief   Verify input and output tensor are of certain min dimensions. */
   163	
   164	static bool VerifyOneTensor(
   165	    const char* label,
   166	    size_t index,
   167	    const std::shared_ptr<arm::app::fwk::iface::TensorIface>& tensor,
   168	    const std::vector<size_t>& expectedShape)
   169	{
   170	    using arm::app::fwk::iface::TensorType;
   171	
   172	    if (!tensor) {
   173	        LOG_ERR("%s[%u] tensor handle is null",
   174	                label, static_cast<unsigned int>(index));
   175	        return false;
   176	    }
   177	
   178	    const std::vector<size_t> actualShape = tensor->Shape();
   179	    if (actualShape != expectedShape) {
   180	        LOG_ERR("%s[%u] shape mismatch",
   181	                label, static_cast<unsigned int>(index));
   182	        return false;
   183	    }
   184	
   185	    if (tensor->Type() != TensorType::FP32) {
   186	        LOG_ERR("%s[%u] must be FP32; got %s",
   187	                label,
   188	                static_cast<unsigned int>(index),
   189	                arm::app::fwk::iface::GetTensorDataTypeName(tensor->Type()));
   190	        return false;
   191	    }
   192	
   193	    size_t expectedElements = 1U;
   194	    for (const size_t dimension : expectedShape) {
   195	        expectedElements *= dimension;
   196	    }
   197	
   198	    if (tensor->GetNumElements() != expectedElements ||
   199	        tensor->Bytes() != expectedElements * sizeof(float) ||
   200	        tensor->GetData() == nullptr) {
   201	        LOG_ERR("%s[%u] element count, byte size, or data pointer is invalid",
   202	                label, static_cast<unsigned int>(index));
   203	        return false;
   204	    }
   205	
   206	    LOG_INF("%s[%u]: FP32, elements=%u, bytes=%u",
   207	            label,
   208	            static_cast<unsigned int>(index),
   209	            static_cast<unsigned int>(tensor->GetNumElements()),
   210	            static_cast<unsigned int>(tensor->Bytes()));
   211	
   212	    return true;
   213	}
   214	
   215	static bool VerifyTensorInterface(const arm::app::fwk::iface::Model& model)
   216	{
   217	    if (model.GetNumInputs() != 4U || model.GetNumOutputs() != 2U) {
   218	        LOG_ERR("Model I/O count mismatch: inputs=%u outputs=%u; expected 4/2",
   219	                static_cast<unsigned int>(model.GetNumInputs()),
   220	                static_cast<unsigned int>(model.GetNumOutputs()));
   221	        return false;
   222	    }
   223	
   224	    const std::vector<std::vector<size_t>> expectedInputs = {
   225	        {1U, 900U, 6U},  /* x_values */
   226	        {1U, 900U, 6U},  /* missing_mask */
   227	        {1U, 900U, 3U},  /* x_mark */
   228	        {1U, 30U}        /* worker_features */
   229	    };
   230	
   231	    const char* inputNames[] = {
   232	        "x_values", "missing_mask", "x_mark", "worker_features"
   233	    };
   234	
   235	    for (size_t i = 0; i < expectedInputs.size(); ++i) {
   236	        if (!VerifyOneTensor(
   237	                "Input", i, model.GetInputTensor(i), expectedInputs[i])) {
   238	            LOG_ERR("Input contract failed for %s", inputNames[i]);
   239	            return false;
   240	        }
   241	    }
   242	
   243	    const std::vector<std::vector<size_t>> expectedOutputs = {
   244	        {1U, 4U},  /* rpe_logits */
   245	        {1U, 4U}   /* psi_logits */
   246	    };
   247	
   248	    const char* outputNames[] = {"rpe_logits", "psi_logits"};
   249	
   250	    for (size_t i = 0; i < expectedOutputs.size(); ++i) {
   251	        if (!VerifyOneTensor(
   252	                "Output", i, model.GetOutputTensor(i), expectedOutputs[i])) {
   253	            LOG_ERR("Output contract failed for %s", outputNames[i]);
   254	            return false;
   255	        }
   256	    }
   257	
   258	    return true;
   259	}
   260	
   261	void MainLoop()
   262	{
   263	    por_boot = true;
   264	    k_sem_init(&button_wait_sem, 0, 1);
   265	
   266	    if (configure_lpgpio()) {
   267	        LOG_ERR("Failed to configure LPGPIO for button input");
   268	        return;
   269	    }
   270	
   271	    const uint8_t* modelPointer =
   272	        arm::app::polyu_heatstroke::GetModelPointer();
   273	    const size_t modelLength =
   274	        arm::app::polyu_heatstroke::GetModelLen();
   275	
   276	    if (modelPointer == nullptr || modelLength == 0U) {
   277	        LOG_ERR("Combined heat-stress model pointer or length is invalid");
   278	        return;
   279	    }
   280	
   281	    LOG_INF("=====================");
   282	    LOG_INF("Combined model pointer: %p",
   283	            static_cast<const void*>(modelPointer));
   284	    LOG_INF("Combined model size: %u bytes",
   285	            static_cast<unsigned int>(modelLength));
   286	
   287	    /* MLEK MemoryRegion is mutable; the generated model itself is const. */
   288	    arm::app::fwk::iface::MemoryRegion modelMem{
   289	        const_cast<uint8_t*>(modelPointer), modelLength};
   290	
   291	    arm::app::fwk::iface::MemoryRegion computeMem{
   292	        arm::app::activationBuf, sizeof(arm::app::activationBuf)};
   293	
   294	    PolyUModel1 model;
   295	
   296	    if (!model.Init(computeMem, modelMem)) {
   297	        LOG_ERR("Failed to initialise combined heat-stress model");
   298	        return;
   299	    }
   300	
   301	    LOG_INF("Combined heat-stress model initialisation: OK");
   302	    LOG_INF("Contains Ethos-U operators: %s",
   303	            model.ContainsEthosUOperator() ? "yes" : "no");
   304	
   305	    if (!VerifyTensorInterface(model)) {
   306	        LOG_ERR("Combined heat-stress model I/O contract verification failed");
   307	        return;
   308	    }
   309	
   310	    LOG_INF("Combined heat-stress model I/O contract verified.");
   311	    LOG_INF("Inference not started: real input preprocessing/data binding "
   312	            "will be validated separately.");
   313	}

