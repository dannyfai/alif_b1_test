    18	
    19	#ifndef MLEK_TENSOR_HPP
    20	#define MLEK_TENSOR_HPP
    21	
    22	#include <cstddef>
    23	#include <vector>
    24	
    25	namespace arm::app::fwk::iface {
    26	
    27	/** Struct for quantization parameters. */
    28	struct QuantParams {
    29	    float scale{0.0};
    30	    int offset{0};
    31	};
    32	
    33	/** Enum representing tensor data types supported. */
    34	enum class TensorType { INT8 = 0, UINT8 = 1, INT16 = 2, INT32 = 3, FP16 = 4, FP32 = 5, INVALID = 6 };
    35	
    36	/** Enum representing tensor layout. */
    37	enum class TensorLayout { NHWC = 0, NCHW = 1, INVALID = 2 };
    38	
    39	/**
    40	 * @brief       Gets the tensor data type name as character array.
    41	 * @param[in]   type Tensor data type object.
    42	 * @return      String represented as const char pointer.
    43	 */
    44	const inline char* GetTensorDataTypeName(const TensorType type)
    45	{
    46	    switch (type) {
    47	    case TensorType::INT8:
    48	        return "int8";
    49	    case TensorType::UINT8:
    50	        return "uint8";
    51	    case TensorType::INT16:
    52	        return "int16";
    53	    case TensorType::INT32:
    54	        return "int32";
    55	    case TensorType::FP16:
    56	        return "fp16";
    57	    case TensorType::FP32:
    58	        return "fp32";
    59	    default:
    60	        return "unknown";
    61	    }
    62	}
    63	
    64	/**
    65	 * @brief       Gets the tensor data type name as character array.
    66	 * @param[in]   type Tensor data type object.
    67	 * @return      String represented as const char pointer.
    68	 */
    69	const inline char* GetTensorLayoutName(const TensorLayout layout)
    70	{
    71	    switch (layout) {
    72	    case TensorLayout::NHWC:
    73	        return "NHWC";
    74	    case TensorLayout::NCHW:
    75	        return "NCHW";
    76	    default:
    77	        return "unknown";
    78	    }
    79	}
    80	
    81	/**
    82	 * @brief       Gets the tensor element size in bytes.
    83	 * @param[in]   type Tensor data type object.
    84	 * @return      Number of bytes as a signed integer.
    85	 */
    86	inline int GetTensorDataTypeSize(const TensorType type)
    87	{
    88	    switch (type) {
    89	    case TensorType::INT8:
    90	        [[fallthrough]];
    91	    case TensorType::UINT8:
    92	        return 1;
    93	    case TensorType::INT16:
    94	        [[fallthrough]];
    95	    case TensorType::FP16:
    96	        return 2;
    97	    case TensorType::INT32:
    98	        [[fallthrough]];
    99	    case TensorType::FP32:
   100	        return 4;
   101	    default:
   102	        return 0;
   103	    }
   104	}
   105	
   106	/**
   107	 * @brief Tensor interface class.
   108	 */
   109	class TensorIface {
   110	public:
   111	    TensorIface()                        = default; /**< Constructor */
   112	    virtual ~TensorIface()               = default; /** Destructor */
   113	
   114	    /** Gets pointer to actual tensor data. */
   115	    virtual void* GetData()              = 0;
   116	
   117	    /** Gets number of bytes occupied by tensor data. */
   118	    virtual size_t Bytes()               = 0;
   119	
   120	    /** Gets number of elements in the tensor (all dimensions combined). */
   121	    virtual size_t GetNumElements()      = 0;
   122	
   123	    /** Gets the tensor data type. */
   124	    virtual TensorType Type()            = 0;
   125	
   126	    /** Gets the tensor layout. */
   127	    virtual TensorLayout Layout()        = 0;
   128	
   129	    /** Gets the tensor shape, expressed as a std::vector */
   130	    virtual std::vector<size_t> Shape()  = 0;
   131	
   132	    /** Gets the quantization parameters for this tensor. */
   133	    virtual QuantParams GetQuantParams() = 0;
   134	
   135	    /** Utility function to get the tensor data pointer in required pointer format. */
   136	    template <typename T>
   137	    T* GetData()
   138	    {
   139	        return reinterpret_cast<T*>(this->GetData());
   140	    }
   141	};
   142	} // namespace arm::app::fwk::iface
   143	
   144	#endif /* MLEK_TENSOR_HPP */

