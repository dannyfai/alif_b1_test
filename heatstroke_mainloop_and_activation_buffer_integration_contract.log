    58	/* ITGU READ-ONLY DIAGNOSTIC
    59	 * Reads ITGU registers only. No security configuration is modified.
    60	 */
    61	static void PrintItguRegisters()
    62	{
    63	    constexpr std::uintptr_t ITGU_BASE = 0xE001E500UL;
    64	    constexpr std::uintptr_t ITGU_CTRL = ITGU_BASE + 0x00UL;
    65	    constexpr std::uintptr_t ITGU_CFG  = ITGU_BASE + 0x04UL;
    66	    constexpr std::uintptr_t ITGU_LUT  = ITGU_BASE + 0x10UL;
    67	
    68	    LOG_INF("ITGU READ-ONLY DIAGNOSTIC START");
    69	    LOG_INF("No ITGU/DTGU/SAU registers will be written.");
    70	
    71	    LOG_INF("About to read ITGU_CTRL at 0x%08x",
    72	            static_cast<unsigned int>(ITGU_CTRL));
    73	    const auto ctrl = *reinterpret_cast<volatile const std::uint32_t *>(ITGU_CTRL);
    74	    LOG_INF("ITGU_CTRL = 0x%08x", static_cast<unsigned int>(ctrl));
    75	
    76	    LOG_INF("About to read ITGU_CFG at 0x%08x",
    77	            static_cast<unsigned int>(ITGU_CFG));
    78	    const auto cfg = *reinterpret_cast<volatile const std::uint32_t *>(ITGU_CFG);
    79	    LOG_INF("ITGU_CFG = 0x%08x", static_cast<unsigned int>(cfg));
    80	
    81	    for (unsigned int i = 0; i < 16; ++i) {
    82	        const std::uintptr_t address = ITGU_LUT + (i * 4U);
    83	        LOG_INF("About to read ITGU_LUT[%u] at 0x%08x",
    84	                i, static_cast<unsigned int>(address));
    85	        const auto value = *reinterpret_cast<volatile const std::uint32_t *>(address);
    86	        LOG_INF("ITGU_LUT[%u] = 0x%08x",
    87	                i, static_cast<unsigned int>(value));
    88	    }
    89	
    90	    LOG_INF("ITGU READ-ONLY DIAGNOSTIC COMPLETE");
    91	}
    92	int main ()
    93	{
    94		console_getline_init();
    95	
    96		/* Application information, UART should have been initialised. */
    97		PrintApplicationIntro();
    98		PrintItguRegisters();
    99	
   100		std::set_new_handler(out_of_heap);
   101	
   102		/* Run the application. */
   103		MainLoop();
   104	
   105	    /* This is unreachable without errors. */
   106	    LOG_INF("program terminating...\n");
   107	
   108	    return 0;
   109	}

