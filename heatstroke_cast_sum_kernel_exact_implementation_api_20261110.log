   31: const int kMaxNumberOfAxis = 5;
   32: const int kMaxNumberOfReducedAxis = 2;
   33: 
   34: TfLiteStatus PrepareSimple(TfLiteContext* context, TfLiteNode* node,
   35:                            int32_t* multiplier, int* shift) {
   36:   MicroContext* micro_context = GetMicroContext(context);
   37: 
   38:   // Inputs Tensor (dtype depends on quantization):
   39:   // [0] = Input
   40:   // [1] = Axis
   41:   TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
   42: 
   43:   // Outputs Tensor (dtype depends on quantization):
   44:   // [0] = Output
   45: 
   46:   // Validate number of inputs and outputs
   47:   TF_LITE_ENSURE_EQ(context, node->inputs->size, 2);
   48:   TF_LITE_ENSURE_EQ(context, node->outputs->size, 1);
   49: 
   50:   // Validate axis type
   51:   TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 1);
   52:   TF_LITE_ENSURE(context, axis != nullptr);
   53:   TF_LITE_ENSURE_TYPES_EQ(context, axis->type, kTfLiteInt32);
   54: 
   55:   if (input->type == kTfLiteInt8) {
   56:     TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);
   57:     const double real_multiplier = static_cast<double>(input->params.scale) /
   58:                                    static_cast<double>(output->params.scale);
   59:     QuantizeMultiplier(real_multiplier, multiplier, shift);
   60:     micro_context->DeallocateTempTfLiteTensor(output);
   61:   }
   62:   micro_context->DeallocateTempTfLiteTensor(axis);
   63:   micro_context->DeallocateTempTfLiteTensor(input);
   64:   return kTfLiteOk;
   65: }
   66: 
   67: TfLiteStatus PrepareMaxHelper(TfLiteContext* context, TfLiteNode* node,
   68:                               OpDataReduce* op_data) {
   69:   TF_LITE_ENSURE_OK(context, PrepareSimple(context, node, &op_data->multiplier,
   70:                                            &op_data->shift));
   71: 
   72:   MicroContext* micro_context = GetMicroContext(context);
   73:   TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
   74:   TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);
   75:   TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 1);
   76: 
   77:   op_data->input_zp = input->params.zero_point;
   78:   op_data->input_scale = input->params.scale;
   79:   op_data->output_zp = output->params.zero_point;
   80:   op_data->output_scale = output->params.scale;
   81:   op_data->num_output_elements = NumElements(output);
   82: 
   83:   context->RequestScratchBufferInArena(context, sizeof(int) * input->dims->size,
   84:                                        &op_data->temp_buffer_idx);
   85:   context->RequestScratchBufferInArena(
   86:       context, sizeof(int) * static_cast<int>(ElementCount(*axis->dims)),
   87:       &op_data->resolved_axis_idx);
   88: 
   89:   micro_context->DeallocateTempTfLiteTensor(input);
   90:   micro_context->DeallocateTempTfLiteTensor(output);
   91:   micro_context->DeallocateTempTfLiteTensor(axis);
   92:   return kTfLiteOk;
   93: }
   94: 
   95: TfLiteStatus PrepareMeanOrSumHelper(TfLiteContext* context, TfLiteNode* node,
   96:                                     OpDataReduce* op_data) {
   97:   MicroContext* micro_context = GetMicroContext(context);
   98:   TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
   99:   TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);
  100:   TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 1);
  101:   if (input->type == kTfLiteInt8 || input->type == kTfLiteInt16) {
  102:     const double real_multiplier = static_cast<double>(input->params.scale) /
  103:                                    static_cast<double>(output->params.scale);
  104:     QuantizeMultiplier(real_multiplier, &op_data->multiplier, &op_data->shift);
  105:   }
  106: 
  107:   int output_size = NumElements(output);
  108:   op_data->num_axis = NumElements(axis);
  109: 
  110:   if (input->type == kTfLiteInt8 || input->type == kTfLiteInt16) {
  111:     context->RequestScratchBufferInArena(context, output_size * sizeof(int32_t),
  112:                                          &op_data->temp_buffer_idx);
  113:     op_data->input_zp = input->params.zero_point;
  114:     op_data->input_scale = input->params.scale;
  115:     op_data->output_zp = output->params.zero_point;
  116:     op_data->output_scale = output->params.scale;
  117:   }
  118: 
  119:   TF_LITE_ENSURE_OK(
  120:       context,
  121:       PrepareSimple(context, node, &(op_data->multiplier), &(op_data->shift)));
  122:   // TODO(b/144955155): Support uint8_t(b/144955155) and int8_t(b/144955018)
  123:   micro_context->DeallocateTempTfLiteTensor(input);
  124:   micro_context->DeallocateTempTfLiteTensor(output);
  125:   micro_context->DeallocateTempTfLiteTensor(axis);
  126:   return kTfLiteOk;
  127: }
  128: 
  129: void ResolveAxis(const int* axis_data, int axis_count,
  130:                  tflite::MeanParams* op_params) {
  131:   int i = 0;
  132:   for (; i < axis_count; ++i) {
  133:     op_params->axis[i] = static_cast<int16_t>(axis_data[i]);
  134:   }
  135:   for (; i < 4; ++i) {
  136:     op_params->axis[i] = 1;
  137:   }
  138:   op_params->axis_count = axis_count;
  139: }
  140: 
  141: template <typename T>
  142: TfLiteStatus QuantizedMeanOrSum(TfLiteContext* context, TfLiteNode* node,
  143:                                 int* temp_index, int* resolved_axis,
  144:                                 int32_t* temp_sum, OpDataReduce* op_data,
  145:                                 bool compute_sum) {
  146:   const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
  147:   const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 1);
  148:   TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
  149:   TfLiteReducerParams* params =
  150:       static_cast<TfLiteReducerParams*>(node->builtin_data);
  151: 
  152:   bool result = reference_ops::QuantizedMeanOrSumExtraArgs<T, int32_t>(
  153:       tflite::micro::GetTensorData<T>(input), op_data->input_zp,
  154:       op_data->input_scale, &input->dims->data[0], input->dims->size,
  155:       tflite::micro::GetTensorData<T>(output), op_data->output_scale,
  156:       op_data->multiplier, op_data->shift, op_data->output_zp,
  157:       &output->dims->data[0], output->dims->size,
  158:       tflite::micro::GetTensorData<int>(axis), op_data->num_axis,
  159:       params->keep_dims, temp_index, resolved_axis, temp_sum, compute_sum);
  160:   TF_LITE_ENSURE(context, result);
  161: 
  162:   return kTfLiteOk;
  163: }
  164: 
  165: template <typename integer_type>
  166: TfLiteStatus EvalIntegerMean(TfLiteContext* context, TfLiteNode* node,
  167:                              int num_axis, OpDataReduce* op_data,
  168:                              int* temp_index, int* resolved_axis) {
  169:   int32_t* temp_sum = static_cast<int32_t*>(
  170:       context->GetScratchBuffer(context, op_data->temp_buffer_idx));
  171: 
  172:   QuantizedMeanOrSum<integer_type>(context, node, temp_index, resolved_axis,
  173:                                    temp_sum, op_data, /*compute_sum=*/false);
  174: 
  175:   return kTfLiteOk;
  176: }
  177: 
  178: TfLiteStatus EvalMeanHelper(TfLiteContext* context, TfLiteNode* node,
  179:                             OpDataReduce* op_data) {
  180:   const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
  181:   const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 1);
  182:   TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
  183:   TfLiteReducerParams* params =
  184:       reinterpret_cast<TfLiteReducerParams*>(node->builtin_data);
  185: 
  186:   int num_axis = static_cast<int>(ElementCount(*axis->dims));
  187:   int temp_index[kMaxNumberOfAxis];
  188:   int resolved_axis[kMaxNumberOfReducedAxis];
  189: 
  190:   switch (input->type) {
  191:     case kTfLiteFloat32: {
  192:       tflite::MeanParams op_params;
  193:       ResolveAxis(tflite::micro::GetTensorData<int>(axis), num_axis,
  194:                   &op_params);
  195: 
  196:       // Special case mean implementation exists for 4D mean across axes 1
  197:       // and 2.
  198:       bool special_case_4d_axes_1_and_2 =
  199:           input->dims->size == 4 && op_params.axis_count == 2 &&
  200:           ((op_params.axis[0] == 1 && op_params.axis[1] == 2) ||
  201:            (op_params.axis[0] == 2 && op_params.axis[1] == 1));
  202: 
  203:       // Defer to specialized implementation for 4D Mean across axes 1 & 2.
  204:       if (params->keep_dims && special_case_4d_axes_1_and_2) {
  205:         reference_ops::Mean(op_params, tflite::micro::GetTensorShape(input),
  206:                             tflite::micro::GetTensorData<float>(input),
  207:                             tflite::micro::GetTensorShape(output),
  208:                             tflite::micro::GetTensorData<float>(output));
  209:       } else {
  210:         TF_LITE_ENSURE(
  211:             context,
  212:             reference_ops::Mean(
  213:                 tflite::micro::GetTensorData<float>(input), input->dims->data,
  214:                 input->dims->size, tflite::micro::GetTensorData<float>(output),
  215:                 output->dims->data, output->dims->size,
  216:                 tflite::micro::GetTensorData<int>(axis), num_axis,
  217:                 params->keep_dims, temp_index, resolved_axis,
  218:                 tflite::micro::GetTensorData<float>(output)));
  219:       }
  220:     } break;
  221:     case kTfLiteInt8: {
  222:       TF_LITE_ENSURE_OK(
  223:           context, EvalIntegerMean<int8_t>(context, node, num_axis, op_data,
  224:                                            temp_index, resolved_axis));
  225:     } break;
  226:     case kTfLiteInt16: {
  227:       TF_LITE_ENSURE_OK(
  228:           context, EvalIntegerMean<int16_t>(context, node, num_axis, op_data,
  229:                                             temp_index, resolved_axis));
  230:     } break;
  231:     default:
  232:       TF_LITE_ENSURE_MSG(context, false,
  233:                          "Currently, only float32, int8 or int16 input type "
  234:                          "is supported.");
  235:   }
  236:   return kTfLiteOk;
  237: }
  238: 
  239: TfLiteStatus EvalMaxHelper(TfLiteContext* context, TfLiteNode* node,
  240:                            OpDataReduce* op_data) {
  241:   const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
  242:   const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 1);
  243:   TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
  244:   TF_LITE_ENSURE_TYPES_EQ(context, input->type, output->type);
  245:   TfLiteReducerParams* params =
  246:       static_cast<TfLiteReducerParams*>(node->builtin_data);
  247: 
  248:   // Interpret an axis tensor with null dimensions as a scalar
  249:   int num_axis = static_cast<int>(ElementCount(*axis->dims));
  250:   int* temp_buffer = static_cast<int*>(
  251:       context->GetScratchBuffer(context, op_data->temp_buffer_idx));
  252:   int* resolved_axis = static_cast<int*>(
  253:       context->GetScratchBuffer(context, op_data->resolved_axis_idx));
  254:   switch (input->type) {
  255:     case kTfLiteFloat32:
  256:       TF_LITE_ENSURE(
  257:           context,
  258:           reference_ops::ReduceGeneric<float>(
  259:               tflite::micro::GetTensorData<float>(input), input->dims->data,
  260:               input->dims->size, tflite::micro::GetTensorData<float>(output),
  261:               output->dims->data, output->dims->size,
  262:               tflite::micro::GetTensorData<int>(axis), num_axis,
  263:               params->keep_dims, temp_buffer, resolved_axis,
  264:               std::numeric_limits<float>::lowest(),
  265:               [](const float current, const float in) -> float {
  266:                 return (in > current) ? in : current;
  267:               }));
  268:       break;
  269:     case kTfLiteInt8:
  270:       TF_LITE_ENSURE_EQ(context, static_cast<double>(op_data->input_scale),
  271:                         static_cast<double>(op_data->output_scale));
  272:       TF_LITE_ENSURE_EQ(context, op_data->input_zp, op_data->output_zp);
