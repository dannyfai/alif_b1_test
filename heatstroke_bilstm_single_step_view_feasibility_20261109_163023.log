   237	// Increment the data offset so the sigle time step invocation call can access
   238	// the corresponding input/output tensor data at the time step
   239	void LstmStepManager::UpdateTime() {
   240	  current_time_ += 1;
   241	  TFLITE_DCHECK_LE(current_time_, size_info_.time_steps);
   242	  // default as one batch per inference
   243	  int input_step = size_info_.input_dimension;
   244	  int output_step = size_info_.state_dimension;
   245	  // time major: batch inference
   246	  if (size_info_.time_major) {
   247	    input_step = input_step * size_info_.batch_size;
   248	    output_step = output_step * size_info_.batch_size;
   249	  }
   250	
   251	  input_offset_ += input_step;
   252	  output_offset_ += output_step;
   253	}
   254	
   255	// Increment the data offset so the sigle time step invocation call can access
   256	// the corresponding hidden/cell state tensor data at the time step (for single
   257	// batch inference only)
   258	void LstmStepManager::UpdateBatch() {
   259	  current_batch_ += 1;
   260	  TFLITE_DCHECK_LE(current_batch_, size_info_.batch_size);
   261	  // batch inference for time major: no action needed
   262	  if (size_info_.time_major) {
   263	    return;
   264	  }
   265	  // otherwise: singe batch inference, go to the next batch
   266	  hidden_state_offset_ += size_info_.state_dimension;
   267	  cell_state_offset_ += size_info_.state_dimension;
   268	}
   269	
   270	// Input shape for each single time LSTM invocation.
   271	// Multi-batch for time_major input
   272	RuntimeShape LstmStepManager::InputShape() const {
   273	  int batch_size = 1;
   274	  if (size_info_.time_major) {
   275	    batch_size = size_info_.batch_size;
   276	  }
   277	  const int dims[2] = {batch_size, size_info_.input_dimension};
   278	  const int32_t* dims_data = reinterpret_cast<const int32_t*>(dims);
   279	  return RuntimeShape(2, dims_data);
   280	}
   281	
   282	// State shape (both hidden and cell) for each single time LSTM invocation.
   283	// Multi-batch for time_major input
   284	RuntimeShape LstmStepManager::StateShape() const {
   285	  int batch_size = 1;
   286	  if (size_info_.time_major) {
   287	    batch_size = size_info_.batch_size;
   288	  }
   289	  const int dims[2] = {batch_size, size_info_.state_dimension};
   290	  const int32_t* dims_data = reinterpret_cast<const int32_t*>(dims);
   291	  return RuntimeShape(2, dims_data);
   292	}
