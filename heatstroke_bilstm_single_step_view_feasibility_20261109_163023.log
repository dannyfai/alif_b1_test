   166	void* HeatstrokeBidirectionalLstmInit(TfLiteContext* context,
   167	                                      const char* buffer,
   168	                                      size_t length) {
   169	  (void)buffer;
   170	  (void)length;
   171	
   172	  auto* data = static_cast<HeatstrokeBidirectionalLstmOpData*>(
   173	      context->AllocatePersistentBuffer(
   174	          context, sizeof(HeatstrokeBidirectionalLstmOpData)));
   175	
   176	  if (data != nullptr) {
   177	    std::memset(data, 0, sizeof(*data));
   178	  }
   179	  return data;
   180	}
