   220	void Clipping(const int v_size, const CellStateInfo& cell_state_info,
   221	              int16_t* vector) {
   222	  for (int i = 0; i < v_size; i++) {
   223	    vector[i] =
   224	        std::max(std::min(cell_state_info.quantized_cell_clip, vector[i]),
   225	                 static_cast<int16_t>(-cell_state_info.quantized_cell_clip));
   226	  }
   227	}
   228	
   229	void Clipping(const int v_size, const CellStateInfo& cell_state_info,
   230	              float* vector) {
   231	  for (int i = 0; i < v_size; i++) {
   232	    vector[i] = std::max(std::min(cell_state_info.cell_clip, vector[i]),
   233	                         -cell_state_info.cell_clip);
   234	  }
   235	}
