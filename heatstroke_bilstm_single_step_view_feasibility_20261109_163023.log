   132	void Sigmoid(const RuntimeShape& data_shape, int16_t* data) {
   133	  reference_integer_ops::Logistic(
   134	      0 /*data->input_multiplier*/, 0 /*data->input_left_shift */,
   135	      data_shape.FlatSize() /*NumElements(input->dims)*/,
   136	      data /* tflite::micro::GetTensorData<int16_t>(input) */,
   137	      data /*tflite::micro::GetTensorData<int16_t>(output) */);
   138	}
   139	
   140	void Sigmoid(const RuntimeShape& data_shape, float* data) {
   141	  reference_ops::Logistic(data_shape, data, data_shape, data);
   142	}
   143	
   144	void Tanh(int32_t cell_state_scale_power, const RuntimeShape& input_data_shape,
   145	          int16_t* input_data, const RuntimeShape& output_data_shape,
   146	          int16_t* output_data) {
   147	  int32_t tanh_input_left_shift = (15 + cell_state_scale_power) - 3;
   148	  int32_t input_multiplier = 0;
   149	  if (tanh_input_left_shift < 0) /* handling negative shift value */
   150	  {
   151	    tanh_input_left_shift = -tanh_input_left_shift;
   152	    input_multiplier = 3;
   153	  }
   154	  reference_integer_ops::Tanh(input_multiplier, tanh_input_left_shift,
   155	                              input_data_shape, input_data, output_data_shape,
   156	                              output_data);
   157	}
   158	
   159	void Tanh(int32_t cell_state_scale_power, const RuntimeShape& input_data_shape,
   160	          float* input_data, const RuntimeShape& output_data_shape,
   161	          float* output_data) {
   162	  reference_ops::Tanh(input_data_shape, input_data, output_data_shape,
   163	                      output_data);
   164	}
