  152:   bool result = reference_ops::QuantizedMeanOrSumExtraArgs<T, int32_t>(
  153:       tflite::micro::GetTensorData<T>(input), op_data->input_zp,
  154:       op_data->input_scale, &input->dims->data[0], input->dims->size,
  155:       tflite::micro::GetTensorData<T>(output), op_data->output_scale,
