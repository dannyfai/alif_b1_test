   344	
   345	#if (IS_ENABLED(CONFIG_SOC_SERIES_E1C) || IS_ENABLED(CONFIG_SOC_SERIES_B1))
   346		free(my_slab_buffer);
   347	#endif
   348		audio_codec_stop_output(codec_dev);
   349		audio_codec_clear_errors(codec_dev);
   350	#endif /* CONFIG_OUTPUT_TO_LINE_OUT */
   351	
   352		/* Audio clip needs enough samples to produce at least 1 MFCC feature. */
   353		if (audioArrSize < mfccFrameLen) {
   354			LOG_ERR("Not enough audio samples, minimum needed is %" PRIu32 "\n", mfccFrameLen);
   355			return false;
   356		}
   357	
   358		/* Creating a sliding window through the whole audio clip. */
   359		auto audioDataSlider = audio::FractionalSlidingWindow<const int16_t>(
   360			audioArr, audioArrSize, audioDataWindowLen, audioDataWindowStride);
   361	
   362		/* Declare a container for final results. */
   363		std::vector<asr::AsrResult> finalResults;
   364		size_t inferenceWindowLen = audioDataWindowLen;
   365	
   366		/* Start sliding through audio clip. */
   367		while (audioDataSlider.HasNext()) {
   368	
   369			/* If not enough audio, see how much can be sent for processing. */
   370			size_t nextStartIndex = audioDataSlider.NextWindowStartIndex();
   371			if (nextStartIndex + audioDataWindowLen > audioArrSize) {
   372				inferenceWindowLen = audioArrSize - nextStartIndex;
   373			}
   374	
   375			const int16_t *inferenceWindow = audioDataSlider.Next();
   376	
   377			LOG_INF("Inference %zu/%zu\n", audioDataSlider.Index() + 1,
   378				static_cast<size_t>(ceilf(audioDataSlider.FractionalTotalStrides() + 1)));
   379	
   380			/* Run the pre-processing, inference and post-processing. */
   381			if (!preProcess.DoPreProcess(inferenceWindow, inferenceWindowLen)) {
   382				LOG_ERR("Pre-processing failed.");
   383				return false;
   384			}
   385	
   386			if (!model.RunInference()) {
   387				LOG_ERR("Inference failed.");
   388				return false;
   389			}
   390	
   391			LOG_INF("NPU inference done.");
   392	
   393			/* Post processing needs to know if we are on the last audio window. */
   394			postProcess.m_lastIteration = !audioDataSlider.HasNext();
   395			if (!postProcess.DoPostProcess()) {
   396				LOG_ERR("Post-processing failed.");
   397				return false;
   398			}
   399	
   400			/* Add results from this window to our final results vector. */
   401			finalResults.emplace_back(asr::AsrResult(
   402				singleInfResult,
   403				(audioDataSlider.Index() * secondsPerSample * audioDataWindowStride),
   404				audioDataSlider.Index(), scoreThreshold));
   405	
   406		} /* while (audioDataSlider.HasNext()) */
   407	
   408		PresentInferenceResult(finalResults);
   409		audio_uninit();
   410	
   411		return true;
   412	}
   413	
   414	static bool PresentInferenceResult(std::vector<asr::AsrResult> &results)
   415	{
   416		LOG_INF("Final results:\n");
   417		LOG_INF("Total number of inferences: %zu\n", results.size());
   418	
   419		/* Get each inference result string using the decoder. */
   420		std::string combinedResultStr;
   421		for (const auto &result : results) {
   422			std::string infResultStr = audio::asr::DecodeOutput(result.m_resultVec);
   423	
   424			LOG_INF("For timestamp: %f (inference #: %" PRIu32 "); label: %s\n",
   425				(double)result.m_timeStamp, result.m_inferenceNumber, infResultStr.c_str());
   426			combinedResultStr += infResultStr;
   427		}
   428	
   429		ClassificationResult res;
   430		res.m_label = combinedResultStr;
   431		std::vector<ClassificationResult> combinedResults;
   432		combinedResults.push_back(res);
   433	
   434		/* Get the decoded result for the combined result. */
   435		std::string finalResultStr = audio::asr::DecodeOutput(combinedResults);
   436	
   437		LOG_INF("Complete recognition: %s\n", finalResultStr.c_str());
   438		return true;
   439	}
