   250	#if CONFIG_OUTPUT_TO_LINE_OUT
   251		const struct device *const codec_dev = DEVICE_DT_GET(CODEC_CFG_NODE);
   252		const struct device *const i2s_dev_tx = DEVICE_DT_GET(I2S_TX_NODE);
   253	
   254		/* Each block is one stereo chunk: AUDIO_CHUNK_SIZE_SAMPLES * AUDIO_CHANNELS * SAMPLE_SIZE.
   255		 * With 2ch 16-bit: 8000 * 2 * 2 = 32000 bytes.
   256		 * num_blocks = sizeof(my_slab_buffer) / i2s_block_bytes
   257		 *            = (AUDIO_CHANNELS*WORD_SIZE*AUDIO_CHUNK_SIZE_SAMPLES) /
   258		 * (AUDIO_CHUNK_SIZE_SAMPLES*AUDIO_CHANNELS*SAMPLE_SIZE) = WORD_SIZE / SAMPLE_SIZE = 16/2
   259		 * = 8.
   260		 */
   261		const size_t i2s_block_bytes = AUDIO_CHUNK_SIZE_SAMPLES * AUDIO_CHANNELS * SAMPLE_SIZE;
   262		const uint32_t i2s_num_blocks = WORD_SIZE / SAMPLE_SIZE; /* = 8 */
   263	#if (IS_ENABLED(CONFIG_SOC_SERIES_E1C) || IS_ENABLED(CONFIG_SOC_SERIES_B1))
   264		char *my_slab_buffer =
   265			(char *)malloc(AUDIO_CHANNELS * WORD_SIZE * AUDIO_CHUNK_SIZE_SAMPLES);
   266	#endif
   267		k_mem_slab_init(&mem_slab, my_slab_buffer, i2s_block_bytes, i2s_num_blocks);
   268	
   269		if (!device_is_ready(i2s_dev_tx)) {
   270			LOG_ERR("%s is not ready", i2s_dev_tx->name);
   271			return 0;
   272		}
   273	
   274		if (!device_is_ready(codec_dev)) {
   275			LOG_ERR("%s is not ready", codec_dev->name);
   276			return 0;
   277		}
   278		if (!configure_streams(i2s_dev_tx)) {
   279			return 0;
   280		}
   281	
   282		audio_codec_start_output(codec_dev);
   283	
   284		int xx = 0;
   285		bool trigger_started = false;
   286		while (xx < audio_idx) {
   287			void *slab_block;
   288			/* Wait up to 2s for a block to be freed by the I2S ISR. */
   289			if (k_mem_slab_alloc(&mem_slab, &slab_block, K_MSEC(2000)) < 0) {
   290				LOG_ERR("Failed to allocate TX slab block");
   291				break;
   292			}
   293	
   294			// we have 16bit mono audio, but I2S is configured for stereo, so we need to
   295			// duplicate samples for left and right channels
   296			int16_t *stereo_buffer = (int16_t *)slab_block;
   297			for (size_t i = 0; i < AUDIO_CHUNK_SIZE_SAMPLES; i++) {
   298				stereo_buffer[2 * i] = audio_inf_ptr[xx * AUDIO_CHUNK_SIZE_SAMPLES + i];
   299				stereo_buffer[2 * i + 1] = audio_inf_ptr[xx * AUDIO_CHUNK_SIZE_SAMPLES + i];
   300			}
   301	
   302			err = i2s_write(i2s_dev_tx, slab_block, i2s_block_bytes);
   303			if (err < 0) {
   304				LOG_ERR("Failed to write data: %d", err);
   305				break;
   306			}
   307			xx++;
   308	
   309			/* Start the I2S output on the first chunk. */
   310			if (!trigger_started) {
   311				err = i2s_trigger(i2s_dev_tx, I2S_DIR_TX, I2S_TRIGGER_START);
   312				if (err < 0) {
   313					LOG_ERR("Failed to start I2S output: %d", err);
   314					return 0;
   315				}
   316				trigger_started = true;
   317			}
   318		}
   319	
   320		{
   321			uint32_t block_ms = (AUDIO_CHUNK_SIZE_SAMPLES * 1000U) / AUDIO_RATE;
   322			/* The feed loop above is paced by the i2s_num_blocks-deep slab
   323			 * (k_mem_slab_alloc blocks until the ISR frees a played block),
   324			 * so most of the audio has already played by the time we get
   325			 * here. At most i2s_num_blocks are still queued, so only wait
   326			 * for those remaining blocks rather than the whole stream. */
   327			uint32_t queued_blocks =
   328				((uint32_t)xx < i2s_num_blocks) ? (uint32_t)xx : i2s_num_blocks;
   329			k_sleep(K_MSEC(queued_blocks * block_ms + 200U));
   330		}
