    97	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
    98	{
    99		ARG_UNUSED(dev);
   100		ARG_UNUSED(cb);
   101		ARG_UNUSED(pins);
   102	
   103		if (por_boot) {
   104			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
   105			return;
   106		}
   107	
   108		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   109	    if (val < 0) {
   110	        LOG_ERR("Failed to read pin: %d", val);
   111	        return;
   112	    }
   113	
   114	    button_pressed = (val == 1);
   115	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   116	
   117		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   118			k_sem_give(&button_wait_sem);
   119		}
   120	}
