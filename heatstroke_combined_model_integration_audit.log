   262	
   263	static bool VerifyTensorDimensions(const arm::app::fwk::iface::Model& model)
   264	{
   265	    /* Populate tensor related parameters. */
   266	    auto inputTensor = model.GetInputTensor(0);
   267		LOG_ERR("Input tensor size = %d\n", inputTensor->Shape().size());
   268	    if (inputTensor->Shape().empty()) {
   269	        LOG_ERR("Invalid input tensor dims\n");
   270	        return false;
   271	    }
   272	    if (inputTensor->Shape().size() < 3) {
   273	        LOG_ERR("Input tensor dimension should be >= 3\n");
   274	        return false;
   275	    }
   276	
   277	    auto outputTensor = model.GetOutputTensor(0);
   278		LOG_ERR("Output tensor size = %d\n", outputTensor->Shape().size());
   279	    if (outputTensor->Shape().empty()) {
   280	        LOG_ERR("Invalid output tensor dims\n");
   281	        return false;
   282	    }
   283	
   284	    if (outputTensor->Shape().size() < 3) {
   285	        LOG_ERR("Output tensor dimension should be >= 3\n");
   286	        return false;
   287	    }
   288	
   289	    return true;
   290	}

