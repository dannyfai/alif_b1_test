    89	{
    90		struct i2s_config config;
    91	
    92		config.word_size = WORD_SIZE;
    93		config.channels = AUDIO_CHANNELS;
    94		config.format = I2S_FMT_DATA_FORMAT_I2S;
    95		config.options = I2S_OPT_BIT_CLK_MASTER | I2S_OPT_FRAME_CLK_MASTER;
    96		config.frame_clk_freq = AUDIO_RATE;
    97		config.mem_slab = &mem_slab;
    98		config.block_size = AUDIO_CHUNK_SIZE_SAMPLES * AUDIO_CHANNELS * SAMPLE_SIZE;
    99		config.timeout = 1000;
   100	
   101		int ret = i2s_configure(i2s_dev_tx, I2S_DIR_TX, &config);
   102		if (ret < 0) {
   103			LOG_ERR("Failed to configure TX stream: %d\n", ret);
   104			return false;
   105		}
   106	
   107		audio_codec_stop_output(DEVICE_DT_GET(CODEC_CFG_NODE));
   108	
   109		struct audio_codec_cfg codec_cfg = {
   110			.dai_type = AUDIO_DAI_TYPE_I2S,
   111			.dai_cfg =
   112				{
   113					.i2s =
   114						{
   115							.word_size = AUDIO_PCM_WIDTH_16_BITS,
   116							.channels = 2,
   117							.format = I2S_FMT_DATA_FORMAT_I2S,
   118							.options = 0,
   119							.frame_clk_freq = AUDIO_RATE,
   120							.mem_slab = NULL,
   121							.block_size = 0,
   122							.timeout = 0,
   123						},
   124				},
   125		};
   126		ret = audio_codec_configure(DEVICE_DT_GET(CODEC_CFG_NODE), &codec_cfg);
   127		if (ret) {
   128			LOG_ERR("audio_codec_configure failed with error: %d", ret);
   129			return false;
   130		}
   131	
   132		return true;
