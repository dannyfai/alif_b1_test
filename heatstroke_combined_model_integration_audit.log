   155		auto inputCtxLen = ctx.Get<uint32_t>("ctxLen");
   156	
   157		if (!model.IsInited()) {
   158			LOG_ERR("Model is not initialised! Terminating processing.\n");
   159			return false;
   160		}
   161	
   162		const auto inputTensor = model.GetInputTensor(0);
   163		const auto outputTensor = model.GetOutputTensor(0);
   164	
   165		/* Get input shape. Dimensions of the tensor should have been verified by
   166		 * the callee. */
   167		auto inputShape = model.GetInputShape(0);
   168	
   169		const uint32_t inputRowsSize = inputShape[fwk::tflm::Wav2LetterModel::ms_inputRowsIdx];
   170		const uint32_t inputInnerLen = inputRowsSize - (2 * inputCtxLen);
   171	
   172		/* Audio data stride corresponds to inputInnerLen feature vectors. */
   173		const uint32_t audioDataWindowLen = (inputRowsSize - 1) * mfccFrameStride + (mfccFrameLen);
   174		const uint32_t audioDataWindowStride = inputInnerLen * mfccFrameStride;
   175	
   176		/* NOTE: This is only used for time stamp calculation. */
   177		const float secondsPerSample = (1.0 / audio::Wav2LetterMFCC::ms_defaultSamplingFreq);
   178	
   179		/* Set up pre and post-processing objects. */
   180		AsrPreProcess preProcess =
   181			AsrPreProcess(inputTensor, fwk::tflm::Wav2LetterModel::ms_numMfccFeatures,
   182				      inputShape[fwk::tflm::Wav2LetterModel::ms_inputRowsIdx], mfccFrameLen,
   183				      mfccFrameStride);
   184	
   185		std::vector<ClassificationResult> singleInfResult;
   186		AsrPostProcess postProcess =
   187			AsrPostProcess(model, ctx.Get<AsrClassifier &>("classifier"),
   188				       ctx.Get<std::vector<std::string> &>("labels"), singleInfResult,
   189				       inputCtxLen, fwk::tflm::Wav2LetterModel::ms_blankTokenIdx,
   190				       fwk::tflm::Wav2LetterModel::ms_outputRowsIdx);
   191	
   192	#ifndef CONFIG_PUSH_TO_TALK
   193		// Application is not in push-to-talk mode. Start capturing audio once the button is pressed
   194		// for the first time, and keep capturing until we have the max number of samples or button
   195		// is released.
   196		button_pressed = false;
   197	#endif
   198	
   199		while (!button_pressed) {
   200			k_sleep(K_MSEC(500));
   201			LOG_INF("Waiting for button press to start audio capture... (btn=%d)",
   202				(int)button_pressed);
   203		}
   204	
   205		LOG_INF("Button pressed. Init audio and start audio capture...\n");
   206	
   207		int err = audio_init(AUDIO_RATE);
   208		if (err) {
   209			LOG_ERR("hal_audio_init failed with error: %d", err);
   210			return false;
   211		}
   212	
   213		// Capture audio as long as button is kept pressed or until we have max samples
   214		int16_t *audio_inf_ptr = &audio_inf[0];
   215		int audio_idx = 0;
   216	
   217		get_audio_data(audio_inf_ptr, AUDIO_CHUNK_SIZE_SAMPLES);
   218	
   219		while (1) {
   220			err = wait_for_audio();
   221			if (err) {
   222				LOG_ERR("hal_get_audio_data failed with error: %d", err);
   223				audio_uninit();
   224				return false;
   225			}
   226	
   227			// Start next chunk
   228			if (audio_idx < (AUDIO_CHUNKS - 1)) {
   229				get_audio_data(audio_inf_ptr + ((audio_idx + 1) * AUDIO_CHUNK_SIZE_SAMPLES),
   230					       AUDIO_CHUNK_SIZE_SAMPLES);
   231			}
   232	
   233			audio_preprocessing(audio_inf_ptr + (audio_idx * AUDIO_CHUNK_SIZE_SAMPLES),
   234					    AUDIO_CHUNK_SIZE_SAMPLES);
   235	
   236			if (!button_pressed) {
   237				break;
   238			}
   239	
   240			if (audio_idx >= (AUDIO_CHUNKS - 1)) {
   241				break;
   242			}
   243			audio_idx++;
   244		}
   245		LOG_INF("Audio capture finished.\n");
   246	
   247		int16_t *audioArr = audio_inf;
   248		uint32_t audioArrSize = (audio_idx + 1) * AUDIO_CHUNK_SIZE_SAMPLES;
