    25	    static constexpr uint32_t ms_blankTokenIdx   = 28;
    26	    static constexpr uint32_t ms_numMfccFeatures = 13;
    27	
    28	protected:
    29	    /** @brief   Gets the reference to op resolver interface class. */
    30	    const tflite::MicroOpResolver& GetOpResolver() override;
    31	
    32	    /** @brief   Adds operations to the op resolver instance. */
    33	    bool EnlistOperations() override;
    34	
    35	private:
    36	    /* Maximum number of individual operations that can be enlisted. */
    37	    static constexpr int ms_maxOpCnt = 24;
    38	
