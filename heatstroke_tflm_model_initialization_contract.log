    24	namespace arm::app::fwk::iface {
    25	
    26	/**
    27	 * @brief   Memory region used by underlying framework
    28	 */
    29	struct MemoryRegion {
    30	    uint8_t* data{nullptr};
    31	    size_t size{0};
    32	    explicit MemoryRegion(uint8_t* addr, size_t bytes) : data(addr), size(bytes) {}
    33	    MemoryRegion() = default;
    34	};
    35	
    36	/**
    37	 * @brief   NN model class wrapping the underlying TensorFlow-Lite-Micro API.
    38	 */
    39	class Model {
    40	public:
    41	    /** @brief Constructor. */
    42	    Model() = default;
    43	
    44	    /** @brief Destructor. */
    45	    virtual ~Model() = 0;
    46	
    47	    /** @brief  Gets the pointer to the model's input tensor at given input index. */
    48	    virtual std::shared_ptr<TensorIface> GetInputTensor(size_t index) const = 0;
    49	
    50	    /** @brief  Gets the pointer to the model's output tensor at given output index. */
    51	    virtual std::shared_ptr<TensorIface> GetOutputTensor(size_t index) const = 0;
    52	
    53	    /** @brief  Gets the model's data type. */
    54	    virtual TensorType GetType() const = 0;
    55	
    56	    /** @brief  Gets the pointer to the model's input shape. */
    57	    virtual std::vector<size_t> GetInputShape(size_t index) const = 0;
    58	
    59	    /** @brief  Gets the pointer to the model's output shape at given output index. */
    60	    virtual std::vector<size_t> GetOutputShape(size_t index) const = 0;
    61	
    62	    /** @brief  Gets the number of input tensors the model has. */
    63	    virtual size_t GetNumInputs() const = 0;
    64	
    65	    /** @brief  Gets the number of output tensors the model has. */
    66	    virtual size_t GetNumOutputs() const = 0;
    67	
    68	    /** @brief  Logs the tensor information to stdout. */
    69	    virtual void LogTensorInfo(std::shared_ptr<TensorIface> tensor) = 0;
    70	
    71	    /** @brief  Logs the interpreter information to stdout. */
    72	    virtual void LogInterpreterInfo() = 0;
    73	
    74	    /** @brief      Initialise the model class object.
    75	     *  @return     true if initialisation succeeds, false otherwise.
    76	     **/
    77	    virtual bool
    78	    Init(MemoryRegion& computeBuffer, MemoryRegion& nnModel, const void* backendData) = 0;
    79	
    80	    /** @brief  Checks if this object has been initialised. */
    81	    virtual bool IsInited() const = 0;
    82	
    83	    /** @brief  Checks if the model uses signed data. */
    84	    virtual bool IsDataSigned() const = 0;
    85	
    86	    /** @brief Checks if the model uses Ethos-U operator */
    87	    virtual bool ContainsEthosUOperator() const = 0;
    88	
    89	    /** @brief  Runs the inference (invokes the interpreter). */
    90	    virtual bool RunInference() = 0;
    91	
    92	    /**
    93	     * @brief   Gets memory region information for the backend's compute buffer.
    94	     * @return  Const reference to MemoryRegion object.
    95	     */
    96	    virtual const MemoryRegion& GetComputeBuffer() const = 0;
    97	
    98	    /**
    99	     * @brief   Gets memory region information for neural network model.
   100	     * @return  Const reference to MemoryRegion object.
   101	     */
   102	    virtual const MemoryRegion& GetModelBuffer() const = 0;
   103	};
   104	
   105	inline Model::~Model() {}
   106	
   107	} /* namespace arm::app::fwk::iface */
   108	
   109	#endif /* MLEK_MODEL_HPP */

