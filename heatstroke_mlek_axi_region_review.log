   575	typedef struct address_range
   576	{
   577	    uintptr_t base;
   578	    uintptr_t limit;
   579	} address_range_t;
   580	
   581	const address_range_t no_need_to_invalidate_areas[] = {
   582	    /* TCM is never cached */
   583	    {
   584	        .base = 0x00000000,
   585	        .limit = 0x01FFFFFF,
   586	    },
   587	    {
   588	        .base = 0x20000000,
   589	        .limit = 0x21FFFFFF,
   590	    },
   591	    /* MRAM should never change while running */
   592	    {
   593	        .base = SOC_FEAT_MRAM_BASE,
   594	        .limit = SOC_FEAT_MRAM_BASE + SOC_FEAT_MRAM_SIZE - 1,
   595	    }
   596	};
   597	
   598	static bool check_need_to_invalidate(const void *p, size_t bytes)
   599	{
   600	    uintptr_t base = (uintptr_t) p;
   601	    if (bytes == 0) {
   602	        return false;
   603	    }
   604	    uintptr_t limit = base + bytes - 1;
   605	    for (unsigned int i = 0; i < sizeof no_need_to_invalidate_areas / sizeof no_need_to_invalidate_areas[0]; i++) {
   606	        if (base >= no_need_to_invalidate_areas[i].base && limit <= no_need_to_invalidate_areas[i].limit) {
   607	            return false;
   608	        }
   609	    }
   610	    return true;
   611	}
