   495	
   496	bool run_requested(void)
   497	{
   498	#if BOARD_BUTTON_COUNT < 2
   499	
   500	    bool ret = true;
   501	    if (do_inference_once)
   502	    {
   503	        ret = false;
   504	    }
   505	    return ret;
   506	
   507	#else
   508	
   509	    bool ret = true;
   510	    bool new_btn1, new_btn2;
   511	    BOARD_BUTTON_STATE btn_state1, btn_state2;
   512	
   513	    // Get new button state (active low)
   514	    BOARD_BUTTON1_GetState(&btn_state1);
   515	    BOARD_BUTTON2_GetState(&btn_state2);
   516	    new_btn1 = btn_state1 == BOARD_BUTTON_STATE_LOW;
   517	    new_btn2 = btn_state2 == BOARD_BUTTON_STATE_LOW;
   518	
   519	    if (do_inference_once)
   520	    {
   521	        // Edge detector - run inference on the positive edge of the button pressed signal
   522	        ret = !last_btn1 && new_btn1;
   523	    }
   524	    if (new_btn2 && last_btn2 != new_btn2)
   525	    {
   526	        // Switch single shot and continuous inference mode
   527	        do_inference_once ^= 1;
   528	    }
   529	    last_btn1 = new_btn1;
   530	    last_btn2 = new_btn2;
   531	    return ret;
   532	
   533	#endif
   534	}
