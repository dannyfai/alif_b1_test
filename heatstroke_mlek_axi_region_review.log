   543	
   544	unsigned int ethosu_config_select(uint64_t address, int index)
   545	{
   546	#if ETHOS_U_BASE_ADDR == ETHOS_U85_NPU_BASE
   547	    UNUSED(index);
   548	    // Accessible regions to U85 are main SRAM (0), OSPI (2,A,B,C,D), MRAM (8) and TCMs (5)
   549	    // SRAM and TCMs need to use SRAM ports, MRAM and OSPI need to use EXT port
   550	    // Quick-and-dirty check that gives the right answer for valid addresses:
   551	    return address & 0xA0000000 ? 2 : 0;
   552	#else
   553	
   554	    // U55s' M1 AXI ports in Ensemble B can't reach MRAM or OSPI. Catch that here.
   555	    if ((!SOC_FEAT_U55_M1_CAN_ACCESS_HIGHER_ADDRESS) && (address >= U55_M1_HIGHER_ADDRESS)) {
   556	        return 0;
   557	    }
   558	    // Otherwise use original define scheme
   559	    switch (index) {
   560	    case -1: return NPU_QCONFIG; break;
   561	    default:
   562	    case 0: return NPU_REGIONCFG_0; break;
   563	    case 1: return NPU_REGIONCFG_1; break;
   564	    case 2: return NPU_REGIONCFG_2; break;
   565	    case 3: return NPU_REGIONCFG_3; break;
   566	    case 4: return NPU_REGIONCFG_4; break;
   567	    case 5: return NPU_REGIONCFG_5; break;
   568	    case 6: return NPU_REGIONCFG_6; break;
   569	    case 7: return NPU_REGIONCFG_7; break;
   570	    }
   571	#endif
   572	}
   573	#endif /* defined(ARM_NPU) */
