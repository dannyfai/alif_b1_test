   614	#define BOARD_OSPI_RAM_BASE     0xA0000000
   615	#define BOARD_OSPI_RAM_SIZE     0x20000000
   616	#endif
   617	#ifndef BOARD_OSPI_FLASH_BASE
   618	#define BOARD_OSPI_FLASH_BASE   0xC0000000
   619	#define BOARD_OSPI_FLASH_SIZE   0x20000000
   620	#endif
   621	
   622	bool ethosu_area_needs_invalidate_dcache(const void *p, size_t bytes)
   623	{
   624	    /* API says null pointer can be passed */
   625	    if (!p) {
   626	        return true;
   627	    }
   628	    /* We know we have a cache and assume the cache is on */
   629	    return check_need_to_invalidate(p, bytes);
   630	}
   631	
   632	bool ethosu_area_needs_flush_dcache(const void *p, size_t bytes)
   633	{
   634	#ifdef OSPI_RAM_SUPPORT
   635	    if (!p) {
   636	        return true;
   637	    }
   638	    uintptr_t area_start = (uintptr_t) p;
   639	    uintptr_t area_end = area_start + bytes;
   640	    if (area_end > BOARD_OSPI_RAM_BASE && area_start < BOARD_OSPI_RAM_BASE + BOARD_OSPI_RAM_SIZE) {
   641	        return true;
   642	    }
   643	#else
   644	    /* We're not using writeback for any Ethos areas */
   645	    UNUSED(p);
   646	    UNUSED(bytes);
   647	#endif
   648	    return false;
   649	}
