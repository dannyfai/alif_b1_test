    89	volatile uint8_t button_pressed = 0U;
    90	static struct gpio_callback button_cb_data;
    91	static bool por_boot;
    92	static struct k_sem button_wait_sem;
    93	
    94	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
    95	{
    96		ARG_UNUSED(dev);
    97		ARG_UNUSED(cb);
    98		ARG_UNUSED(pins);
    99	
   100		if (por_boot) {
   101			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
   102			return;
   103		}
   104	
   105		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   106	    if (val < 0) {
   107	        LOG_ERR("Failed to read pin: %d", val);
   108	        return;
   109	    }
   110	
   111	    button_pressed = (val == 1);
   112	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   113	
   114		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   115			k_sem_give(&button_wait_sem);
   116		}
   117	}
   118	
   119	/**
   120	 * Configure LPGPIO0 and LPGPIO1 as inputs with interrupts
   121	 * With B1/E1C need to connect wire between SW5 (P5_7) and P15_0 to use button as Push-to-talk button.
   122	 * With B1/E1C devkit you need to also remove resistor R64. */
   123	static int configure_lpgpio(void)
   124	{
   125		int ret;
   126		const struct gpio_dt_spec *spec = &lpgpio_config;
   127	
   128		if (!spec || !spec->port) {
   129			/* Just ignore */
   130			LOG_ERR("lpgpio invalid");
   131			return -ENODEV;
   132		}
   133	
   134		/* Configure LPGPIO0 for wakeup */
   135		if (!gpio_is_ready_dt(spec)) {
   136			LOG_ERR("LPGPIO0 device is not ready");
   137			return -ENODEV;
   138		}
   139	
   140		ret = gpio_pin_configure_dt(spec, GPIO_INPUT | spec->dt_flags);

