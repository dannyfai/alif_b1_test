   261	void MainLoop()
   262	{
   263	    por_boot = true;
   264	    k_sem_init(&button_wait_sem, 0, 1);
   265	
   266	    if (configure_lpgpio()) {
   267	        LOG_ERR("Failed to configure LPGPIO for button input");
   268	        return;
   269	    }
   270	
   271	    const uint8_t* modelPointer =
   272	        arm::app::polyu_heatstroke::GetModelPointer();
   273	    const size_t modelLength =
   274	        arm::app::polyu_heatstroke::GetModelLen();
   275	
   276	    if (modelPointer == nullptr || modelLength == 0U) {
   277	        LOG_ERR("Combined heat-stress model pointer or length is invalid");
   278	        return;
   279	    }
   280	
   281	    LOG_INF("=====================");
   282	    LOG_INF("Combined model pointer: %p",
   283	            static_cast<const void*>(modelPointer));
   284	    LOG_INF("Combined model size: %u bytes",
   285	            static_cast<unsigned int>(modelLength));
   286	
   287	    /* MLEK MemoryRegion is mutable; the generated model itself is const. */
   288	    arm::app::fwk::iface::MemoryRegion modelMem{
   289	        const_cast<uint8_t*>(modelPointer), modelLength};
   290	
   291	    arm::app::fwk::iface::MemoryRegion computeMem{
   292	        arm::app::activationBuf, sizeof(arm::app::activationBuf)};
   293	
   294	    PolyUModel1 model;
   295	
   296	    if (!model.Init(computeMem, modelMem)) {
   297	        LOG_ERR("Failed to initialise combined heat-stress model");
   298	        return;
   299	    }
   300	
   301	    LOG_INF("Combined heat-stress model initialisation: OK");
   302	    LOG_INF("Contains Ethos-U operators: %s",
   303	            model.ContainsEthosUOperator() ? "yes" : "no");
   304	
   305	    if (!VerifyTensorInterface(model)) {
   306	        LOG_ERR("Combined heat-stress model I/O contract verification failed");
   307	        return;
   308	    }
   309	
   310	    LOG_INF("Combined heat-stress model I/O contract verified.");
   311	    LOG_INF("Inference not started: real input preprocessing/data binding "
   312	            "will be validated separately.");
   313	}

