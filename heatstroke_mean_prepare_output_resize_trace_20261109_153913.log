323-                               const int* output_dims,
324-                               const int output_num_dims, const int* axis,
325-                               const int num_axis_dimensions, bool keep_dims,
326-                               int* temp_index, int* resolved_axis, U* temp_sum,
327-                               bool compute_sum) {
328-  const int32_t kMinValue = std::numeric_limits<T>::min();
329-  const int32_t kMaxValue = std::numeric_limits<T>::max();
330-  const bool uint8_case = std::is_same<T, uint8_t>::value;
331-  const bool int16_case = std::is_same<T, int16_t>::value;
