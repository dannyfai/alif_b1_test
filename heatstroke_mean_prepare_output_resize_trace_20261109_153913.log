182-                          const int* output_dims, const int output_num_dims,
183-                          const int* axis, const int64_t num_axis_dimensions,
184-                          bool keep_dims, int* temp_index, int* resolved_axis,
185-                          T init_value,
186-                          T reducer(const T current, const T in)) {
