   179	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   180	                                                TfLiteNode* node) {
   181	  if (node == nullptr || node->builtin_data == nullptr ||
   182	      node->inputs == nullptr || node->outputs == nullptr ||
   183	      node->inputs->size != 29 || node->outputs->size != 1 ||
   184	      node->user_data == nullptr) {
   185	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   186	    return kTfLiteError;
   187	  }
   188	
   189	  auto* op_data =
   190	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   191	
   192	  const auto* params =
   193	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   194	          node->builtin_data);
   195	
   196	  if (!params->time_major || !params->merge_outputs ||
   197	      params->activation != kTfLiteActTanh) {
   198	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   199	    return kTfLiteError;
   200	  }
   201	
   202	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   203	  TfLiteEvalTensor* output =
   204	      context->GetEvalTensor(context, node->outputs->data[0]);
   205	
   206	  if (!IsFloatTensorType(input) || !IsFloatTensorType(output) ||
   207	      input->dims == nullptr || output->dims == nullptr ||
   208	      input->dims->size != 3 ||
   209	      (output->dims->size != 3 && output->dims->size != 4)) {
   210	    MicroPrintf(
   211	        "Heatstroke BiLSTM: expected rank-3 FP32 input and "
   212	        "rank-3 or rank-4 FP32 output");
   213	    return kTfLiteError;
   214	  }
   215	
   216	  const int time_steps = input->dims->data[0];
   217	  const int batch_size = input->dims->data[1];
   218	  const int input_dimension = input->dims->data[2];
   219	
   220	  // The supplied heat-stress model uses time-major, single-batch sequences.
   221	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
   222	    MicroPrintf("Heatstroke BiLSTM: unsupported input dimensions");
   223	    return kTfLiteError;
   224	  }
   225	
   226	  int forward_hidden = 0;
   227	  int backward_hidden = 0;
   228	
   229	  if (!ValidateDirection(context, node, 1, 5, 9, 25, 26, input_dimension, batch_size, &forward_hidden) ||
   230	      !ValidateDirection(context, node, 13, 17, 21, 27, 28, input_dimension, batch_size, &backward_hidden) ||
   231	      forward_hidden != backward_hidden) {
   232	    MicroPrintf("Heatstroke BiLSTM: unsupported weights or state tensors");
   233	    return kTfLiteError;
   234	  }
   235	
   236	  const int hidden = forward_hidden;
   237	
   238	  bool output_shape_valid = false;
   239	
   240	  if (output->dims->size == 3) {
   241	    // Standard merged layout: [time, batch, forward + backward].
   242	    output_shape_valid =
   243	        output->dims->data[0] == time_steps &&
   244	        output->dims->data[1] == batch_size &&
   245	        output->dims->data[2] == 2 * hidden;
   246	  } else if (output->dims->size == 4) {
   247	    // Rank-4 layout: [time, batch, direction, hidden].
   248	    output_shape_valid =
   249	        output->dims->data[0] == time_steps &&
   250	        output->dims->data[1] == batch_size &&
   251	        output->dims->data[2] == 2 &&
   252	        output->dims->data[3] == hidden;
   253	  }
   254	
   255	  if (!output_shape_valid) {
   256	    MicroPrintf("Heatstroke BiLSTM: unexpected output dimensions");
   257	    return kTfLiteError;
   258	  }
   259	
   260	  // Compact 29-slot model: no separate auxiliary input slots exist.
   261	
   262	  InitializeFloatLstmParameters(
   263	      &op_data->forward, true, batch_size, time_steps,
   264	      input_dimension, hidden, params->activation, params->cell_clip);
   265	
   266	  InitializeFloatLstmParameters(
   267	      &op_data->backward, true, batch_size, time_steps,
   268	      input_dimension, hidden, params->activation, params->cell_clip);
   269	
   270	  const size_t internal_bytes =
   271	      static_cast<size_t>(batch_size) * hidden * sizeof(float);
   272	
   273	  // Match the four scratch buffers requested by TFLM's existing
   274	  // unidirectional FP32 LSTM implementation.
   275	  for (int i = 0; i < 4; ++i) {
   276	    if (context->RequestScratchBufferInArena(
   277	            context, internal_bytes,
   278	            &op_data->forward.buffer_indices[i]) != kTfLiteOk) {
   279	      MicroPrintf("Heatstroke BiLSTM: LSTM scratch allocation failed");
   280	      return kTfLiteError;
   281	    }
   282	
   283	    // Forward and backward passes execute sequentially, so they can
   284	    // safely reuse the same four evaluator scratch buffers.
   285	    op_data->backward.buffer_indices[i] =
   286	        op_data->forward.buffer_indices[i];
   287	  }
   288	
   289	  return kTfLiteOk;
   290	}
   291	
   292	void PopulateDirectionContents(TfLiteContext* context,
   293	                               TfLiteNode* node,
   294	                               int input_weight_base,
   295	                               int recurrent_weight_base,
   296	                               int bias_base,
   297	                               int hidden_state_position,
   298	                               int cell_state_position,
   299	                               const TfLiteEvalTensor* input,
   300	                               TfLiteEvalTensor* staged_output,
   301	                               LSTMKernelContents* contents) {
   302	  for (int i = 0; i < 24; ++i) {
   303	    contents->internal_tensors[i] = nullptr;
   304	  }
   305	
   306	  contents->internal_tensors[0] =
   307	      const_cast<TfLiteEvalTensor*>(input);
   308	
   309	  for (int gate = 0; gate < 4; ++gate) {
   310	    contents->internal_tensors[1 + gate] =
   311	        GetInputEvalTensor(context, node, input_weight_base + gate);
   312	
   313	    contents->internal_tensors[5 + gate] =
   314	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   315	
   316	    contents->internal_tensors[12 + gate] =
   317	        GetInputEvalTensor(context, node, bias_base + gate);
   318	  }
   319	
   320	  // Optional peephole, projection, and layer-normalization tensors
   321	  // are not present in this model and remain nullptr.
   322	
   323	  contents->internal_tensors[18] =
   324	      GetInputEvalTensor(context, node, hidden_state_position);
   325	
   326	  contents->internal_tensors[19] =
   327	      GetInputEvalTensor(context, node, cell_state_position);
   328	
   329	  contents->output_tensor = staged_output;
   330	}
