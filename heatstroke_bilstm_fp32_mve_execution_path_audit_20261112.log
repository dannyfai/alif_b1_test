   332	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   333	                                             TfLiteNode* node) {
   334	  if (node == nullptr || node->user_data == nullptr) {
   335	    return kTfLiteError;
   336	  }
   337	
   338	  const auto* op_data =
   339	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   340	
   341	  const TfLiteEvalTensor* input =
   342	      GetInputEvalTensor(context, node, 0);
   343	
   344	  TfLiteEvalTensor* output =
   345	      context->GetEvalTensor(context, node->outputs->data[0]);
   346	
   347	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   348	    return kTfLiteError;
   349	  }
   350	
   351	  const int time_steps = op_data->forward.size_info.time_steps;
   352	  const int input_dimension = op_data->forward.size_info.input_dimension;
   353	  const int hidden = op_data->forward.size_info.state_dimension;
   354	
   355	  const float* input_data = input->data.f;
   356	  float* output_data = output->data.f;
   357	
   358	  if (time_steps <= 0 || input_dimension <= 0 || hidden <= 0 ||
   359	      input_data == nullptr || output_data == nullptr) {
   360	    MicroPrintf("Heatstroke BiLSTM: invalid single-step tensor data");
   361	    return kTfLiteError;
   362	  }
   363	
   364	  // Each view redirects the existing tensor data pointer to one timestep.
   365	  // Its dimensions remain the original tensor dimensions; EvalLstm's
   366	  // step manager supplies the single-step arithmetic shapes.
   367	  TfLiteEvalTensor forward_input_view = *input;
   368	  TfLiteEvalTensor forward_output_view = *output;
   369	
   370	  LSTMKernelContents forward_contents{};
   371	  PopulateDirectionContents(
   372	      context, node, 1, 5, 9, 25, 26,
   373	      &forward_input_view, &forward_output_view, &forward_contents);
   374	
   375	  LSTMBuffers<float> buffers =
   376	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   377	
   378	  OpDataLSTM forward_step_data = op_data->forward;
   379	  forward_step_data.size_info.time_steps = 1;
   380	
   381	  // Forward direction: original sequence order.
   382	  for (int t = 0; t < time_steps; ++t) {
   383	    const size_t input_offset =
   384	        static_cast<size_t>(t) * input_dimension;
   385	    const size_t output_offset =
   386	        static_cast<size_t>(t) * 2U * hidden;
   387	
   388	    forward_input_view.data.f =
   389	        const_cast<float*>(input_data + input_offset);
   390	    forward_output_view.data.f = output_data + output_offset;
   391	
   392	    TfLiteStatus status =
   393	        EvalLstm<float, float, float, float>(
   394	            forward_step_data, forward_contents, buffers);
   395	
   396	    if (status != kTfLiteOk) {
   397	      return status;
   398	    }
   399	  }
   400	
   401	  TfLiteEvalTensor backward_input_view = *input;
   402	  TfLiteEvalTensor backward_output_view = *output;
   403	
   404	  LSTMKernelContents backward_contents{};
   405	  PopulateDirectionContents(
   406	      context, node, 13, 17, 21, 27, 28,
   407	      &backward_input_view, &backward_output_view, &backward_contents);
   408	
   409	  OpDataLSTM backward_step_data = op_data->backward;
   410	  backward_step_data.size_info.time_steps = 1;
   411	
   412	  // Backward direction: traverse the original input backwards.
   413	  // Write each hidden state directly into the backward half of its
   414	  // corresponding original-time output row.
   415	  for (int t = time_steps - 1; t >= 0; --t) {
   416	    const size_t input_offset =
   417	        static_cast<size_t>(t) * input_dimension;
   418	    const size_t output_offset =
   419	        static_cast<size_t>(t) * 2U * hidden + hidden;
   420	
   421	    backward_input_view.data.f =
   422	        const_cast<float*>(input_data + input_offset);
   423	    backward_output_view.data.f = output_data + output_offset;
   424	
   425	    TfLiteStatus status =
   426	        EvalLstm<float, float, float, float>(
   427	            backward_step_data, backward_contents, buffers);
   428	
   429	    if (status != kTfLiteOk) {
   430	      return status;
   431	    }
   432	  }
   433	
   434	  return kTfLiteOk;
   435	}
