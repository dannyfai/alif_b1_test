    22	TfLiteEvalTensor* GetInputEvalTensor(TfLiteContext* context,
    23	                                     TfLiteNode* node,
    24	                                     int input_position) {
    25	  if (input_position < 0 || input_position >= node->inputs->size) {
    26	    return nullptr;
    27	  }
    28	
    29	  const int tensor_index = node->inputs->data[input_position];
    30	  if (tensor_index < 0) {
    31	    return nullptr;
    32	  }
    33	
    34	  return context->GetEvalTensor(context, tensor_index);
    35	}
    36	
    37	size_t TensorElementCount(const TfLiteEvalTensor* tensor) {
    38	  if (tensor == nullptr || tensor->dims == nullptr) {
    39	    return 0;
    40	  }
    41	
    42	  size_t count = 1;
    43	  for (int i = 0; i < tensor->dims->size; ++i) {
    44	    if (tensor->dims->data[i] < 0) {
    45	      return 0;
    46	    }
    47	    count *= static_cast<size_t>(tensor->dims->data[i]);
    48	  }
    49	  return count;
    50	}
    51	
    52	bool IsFloatTensorType(const TfLiteEvalTensor* tensor) {
    53	  return tensor != nullptr && tensor->type == kTfLiteFloat32;
    54	}
    55	
    56	bool IsFloatTensor(const TfLiteEvalTensor* tensor) {
    57	  return IsFloatTensorType(tensor) && tensor->data.f != nullptr;
    58	}
    59	
    60	bool IsMatrix(const TfLiteEvalTensor* tensor, int rows, int columns) {
    61	  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
    62	         tensor->dims->size == 2 &&
    63	         tensor->dims->data[0] == rows &&
    64	         tensor->dims->data[1] == columns;
    65	}
    66	
    67	bool IsVector(const TfLiteEvalTensor* tensor, int length) {
    68	  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
    69	         tensor->dims->size == 1 &&
    70	         tensor->dims->data[0] == length;
    71	}
    72	
    73	bool ValidateDirection(TfLiteContext* context,
    74	                       TfLiteNode* node,
    75	                       int input_weight_base,
    76	                       int recurrent_weight_base,
    77	                       int bias_base,
    78	                       int hidden_state_position,
    79	                       int cell_state_position,
    80	                       int input_dimension,
    81	                       int batch_size,
    82	                       int* hidden_dimension) {
    83	  TfLiteEvalTensor* first_weight =
    84	      GetInputEvalTensor(context, node, input_weight_base);
    85	
    86	  if (first_weight == nullptr || first_weight->dims == nullptr ||
    87	      first_weight->dims->size != 2) {
    88	    return false;
    89	  }
    90	
    91	  const int hidden = first_weight->dims->data[0];
    92	
    93	  if (hidden <= 0 || first_weight->dims->data[1] != input_dimension) {
    94	    return false;
    95	  }
    96	
    97	  for (int gate = 0; gate < 4; ++gate) {
    98	    TfLiteEvalTensor* input_weight =
    99	        GetInputEvalTensor(context, node, input_weight_base + gate);
   100	
   101	    TfLiteEvalTensor* recurrent_weight =
   102	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   103	
   104	    TfLiteEvalTensor* bias =
   105	        GetInputEvalTensor(context, node, bias_base + gate);
   106	
   107	    if (!IsMatrix(input_weight, hidden, input_dimension) ||
   108	        !IsMatrix(recurrent_weight, hidden, hidden) ||
   109	        !IsVector(bias, hidden)) {
   110	      return false;
   111	    }
   112	  }
   113	
   114	  TfLiteEvalTensor* hidden_state =
   115	      GetInputEvalTensor(context, node, hidden_state_position);
   116	
   117	  TfLiteEvalTensor* cell_state =
   118	      GetInputEvalTensor(context, node, cell_state_position);
   119	
   120	  if (!IsFloatTensorType(hidden_state) || !IsFloatTensorType(cell_state) ||
   121	      TensorElementCount(hidden_state) !=
   122	          static_cast<size_t>(batch_size * hidden) ||
   123	      TensorElementCount(cell_state) !=
   124	          static_cast<size_t>(batch_size * hidden)) {
   125	    return false;
   126	  }
   127	
   128	  *hidden_dimension = hidden;
   129	  return true;
   130	}
