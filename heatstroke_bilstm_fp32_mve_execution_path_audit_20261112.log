   132	void InitializeFloatLstmParameters(
   133	    OpDataLSTM* op_data,
   134	    bool time_major,
   135	    int batch_size,
   136	    int time_steps,
   137	    int input_dimension,
   138	    int hidden_dimension,
   139	    TfLiteFusedActivation activation,
   140	    float cell_clip) {
   141	  op_data->size_info.time_major = time_major;
   142	  op_data->size_info.batch_size = batch_size;
   143	  op_data->size_info.time_steps = time_steps;
   144	  op_data->size_info.input_dimension = input_dimension;
   145	  op_data->size_info.state_dimension = hidden_dimension;
   146	
   147	  op_data->cell_gate_nonlinear_type = activation;
   148	  op_data->cell_state_info = CreateLstmCellStateInfoFloat(cell_clip);
   149	
   150	  op_data->forget_gate_parameters = CreateGateParamsFloat();
   151	  op_data->input_gate_parameters = CreateGateParamsFloat();
   152	  op_data->cell_gate_parameters = CreateGateParamsFloat();
   153	  op_data->output_gate_parameters = CreateGateParamsFloat();
   154	
   155	  op_data->inter_gate_parameters.forget_cell_mul_params =
   156	      CreateInterGateMulParamsFloat();
   157	  op_data->inter_gate_parameters.input_mul_params =
   158	      CreateInterGateMulParamsFloat();
   159	  op_data->inter_gate_parameters.output_mul_params =
   160	      CreateInterGateMulParamsFloat();
   161	}
