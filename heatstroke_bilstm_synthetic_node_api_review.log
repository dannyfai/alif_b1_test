    73	bool ValidateDirection(TfLiteContext* context,
    74	                       TfLiteNode* node,
    75	                       int parameter_base,
    76	                       int hidden_state_position,
    77	                       int cell_state_position,
    78	                       int input_dimension,
    79	                       int batch_size,
    80	                       int* hidden_dimension) {
    81	  // Four input weights, four recurrent weights, and four biases.
    82	  TfLiteEvalTensor* first_weight =
    83	      GetInputEvalTensor(context, node, parameter_base + 1);
    84	
    85	  if (first_weight == nullptr || first_weight->dims == nullptr ||
    86	      first_weight->dims->size != 2) {
    87	    return false;
    88	  }
    89	
    90	  const int hidden = first_weight->dims->data[0];
    91	
    92	  if (hidden <= 0 ||
    93	      first_weight->dims->data[1] != input_dimension) {
    94	    return false;
    95	  }
    96	
    97	  for (int gate = 0; gate < 4; ++gate) {
    98	    TfLiteEvalTensor* input_weight =
    99	        GetInputEvalTensor(context, node, parameter_base + 1 + gate);
   100	    TfLiteEvalTensor* recurrent_weight =
   101	        GetInputEvalTensor(context, node, parameter_base + 5 + gate);
   102	    TfLiteEvalTensor* bias =
   103	        GetInputEvalTensor(context, node, parameter_base + 12 + gate);
   104	
   105	    if (!IsMatrix(input_weight, hidden, input_dimension) ||
   106	        !IsMatrix(recurrent_weight, hidden, hidden) ||
   107	        !IsVector(bias, hidden)) {
   108	      return false;
   109	    }
   110	  }
   111	
   112	  // This app-local evaluator currently supports standard LSTM only:
   113	  // no peephole weights and no projection weights.
   114	  for (int i = 9; i <= 11; ++i) {
   115	    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
   116	      return false;
   117	    }
   118	  }
   119	
   120	  for (int i = 16; i <= 17; ++i) {
   121	    if (GetInputEvalTensor(context, node, parameter_base + i) != nullptr) {
   122	      return false;
   123	    }
   124	  }
   125	
   126	  TfLiteEvalTensor* hidden_state =
   127	      GetInputEvalTensor(context, node, hidden_state_position);
   128	  TfLiteEvalTensor* cell_state =
   129	      GetInputEvalTensor(context, node, cell_state_position);
   130	
   131	  if (!IsFloatTensor(hidden_state) || !IsFloatTensor(cell_state) ||
   132	      TensorElementCount(hidden_state) !=
   133	          static_cast<size_t>(batch_size * hidden) ||
   134	      TensorElementCount(cell_state) !=
   135	          static_cast<size_t>(batch_size * hidden)) {
   136	    return false;
   137	  }
   138	
   139	  *hidden_dimension = hidden;
   140	  return true;
   141	}
