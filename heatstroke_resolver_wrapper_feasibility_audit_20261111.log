    63	/*
    64	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    65	 * required by this implementation. Validate its options type and leave
    66	 * builtin_data null.
    67	 */
    68	TfLiteStatus ParseHeatstrokeSign(
    69	    const tflite::Operator* op,
    70	    tflite::ErrorReporter*,
    71	    tflite::BuiltinDataAllocator*,
    72	    void** builtin_data)
    73	{
    74	    if (builtin_data != nullptr) {
    75	        *builtin_data = nullptr;
    76	    }
    77	
    78	    if (op == nullptr ||
    79	        op->builtin_options_type() !=
    80	            tflite::BuiltinOptions_SignOptions) {
    81	        return kTfLiteError;
    82	    }
    83	
    84	    return kTfLiteOk;
    85	}
    86	
    87	/*
    88	 * Application-local INT32 SIGN implementation.
    89	 *
    90	 * y = -1 when x < 0
    91	 * y =  0 when x = 0
    92	 * y =  1 when x > 0
    93	 *
    94	 * No temporary buffer or scratch allocation is required.
    95	 */
    96	TfLiteStatus HeatstrokeSignEval(
    97	    TfLiteContext* context,
    98	    TfLiteNode* node)
    99	{
   100	    if (context == nullptr || node == nullptr) {
   101	        return kTfLiteError;
   102	    }
   103	
   104	    const TfLiteEvalTensor* input =
   105	        tflite::micro::GetEvalInput(context, node, 0);
   106	
   107	    TfLiteEvalTensor* output =
   108	        tflite::micro::GetEvalOutput(context, node, 0);
   109	
   110	    if (input == nullptr || output == nullptr) {
   111	        return kTfLiteError;
   112	    }
   113	
   114	    if (input->type != kTfLiteInt32 ||
   115	        output->type != kTfLiteInt32) {
   116	        MicroPrintf(
   117	            "Heatstroke SIGN requires INT32 input/output. "
   118	            "Input=%d Output=%d",
   119	            input->type,
   120	            output->type);
   121	        return kTfLiteError;
   122	    }
   123	
   124	    const auto input_shape =
   125	        tflite::micro::GetTensorShape(input);
   126	
   127	    const auto output_shape =
   128	        tflite::micro::GetTensorShape(output);
   129	
   130	    const int input_count = input_shape.FlatSize();
   131	    const int output_count = output_shape.FlatSize();
   132	
   133	    if (input_count < 0 || input_count != output_count) {
   134	        MicroPrintf(
   135	            "Heatstroke SIGN tensor element-count mismatch.");
   136	        return kTfLiteError;
   137	    }
   138	
   139	    const int32_t* input_data =
   140	        tflite::micro::GetTensorData<int32_t>(input);
   141	
   142	    int32_t* output_data =
   143	        tflite::micro::GetTensorData<int32_t>(output);
   144	
   145	    if (input_count > 0 &&
   146	        (input_data == nullptr || output_data == nullptr)) {
   147	        MicroPrintf(
   148	            "Heatstroke SIGN received a null tensor data pointer.");
   149	        return kTfLiteError;
   150	    }
   151	
   152	    for (int i = 0; i < input_count; ++i) {
   153	        const int32_t value = input_data[i];
   154	
   155	        output_data[i] =
   156	            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
   157	    }
   158	
   159	    return kTfLiteOk;
   160	}
   161	
   162	TFLMRegistration RegisterHeatstrokeSignKernel()
   163	{
   164	    return tflite::micro::RegisterOp(
   165	        nullptr,
   166	        nullptr,
   167	        HeatstrokeSignEval);
   168	}
