    18	cmake_minimum_required(VERSION 3.21.0)
    19	
    20	# Build in release mode by default
    21	if (NOT CMAKE_BUILD_TYPE STREQUAL Debug)
    22	    set(CMAKE_BUILD_TYPE Release CACHE INTERNAL "")
    23	endif()
    24	
    25	# Set language standards.
    26	set(CMAKE_C_STANDARD   11)
    27	set(CMAKE_CXX_STANDARD 17)
    28	
    29	# Make the standard a requirement => prevent fallback to previous
    30	# supported standard
    31	set(CMAKE_C_STANDARD_REQUIRED ON)
    32	set(CMAKE_CXX_STANDARD_REQUIRED ON)
    33	
    34	# We want to pass standard C/C++ flags, without gnu extensions
    35	set(CMAKE_C_EXTENSIONS OFF)
    36	set(CMAKE_CXX_EXTENSIONS OFF)
    37	
    38	project(MLEK_API
    39	        DESCRIPTION "Generic platform agnostic API"
    40	        LANGUAGES   CXX)
    41	
    42	# Default configuration - paths and other defaults
    43	include(${CMAKE_CURRENT_SOURCE_DIR}/config.cmake)
    44	
    45	add_subdirectory(mlek/log)
    46	add_subdirectory(mlek/math)
    47	add_subdirectory(mlek/fwk)
    48	add_subdirectory(mlek/common)
    49	add_subdirectory(mlek/use_case)
    50	
    51	###############################################################################
    52	# Function to add current directory to the targets includes. This ensures
    53	# that all the headers included refer to this base directory as the root.
    54	# It will be the same for installation target.
    55	# @param[in]    target_name     Name of the CMake target to add include
    56	#                               directories for.
    57	###############################################################################
    58	function(mlek_api_set_include_dirs target_name)
    59	    if (NOT TARGET ${target_name})
    60	        message(WARNING "${target_name} is not defined")
    61	        return()
    62	    endif()
    63	
    64	    get_target_property(_target_type ${target_name} TYPE)
    65	    if (_target_type STREQUAL "INTERFACE_LIBRARY")
    66	        set(_scope INTERFACE)
    67	    else()
    68	        set(_scope PUBLIC)
    69	    endif()
    70	
    71	    target_include_directories(${target_name} ${_scope}
    72	        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
    73	        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
    74	endfunction()
    75	
    76	
    77	###############################################################################
    78	# Function to create an ML framework specific implementation interface library
    79	# to allow easier use of targets defined in this CMake project.
    80	# The function will create an alias library as well namespaced with 'mlek::'
    81	# and the library will be called 'API_NAME_et_impl' or 'API_NAME_tflm_impl'.
    82	# @param[in]    API_NAME        Name of the API to target. The name is suffixed
    83	#                               by '_api' to get the expected target defined
    84	#                               by subdirectory 'use_case'.
    85	###############################################################################
    86	function(create_mlek_impl_lib_target)
    87	    set(oneValueArgs API_NAME)
    88	    cmake_parse_arguments(PARSED "" "${oneValueArgs}"
    89	                          "${multiValueArgs}" ${ARGN})
    90	    set(TARGET_LIB_NAME ${PARSED_API_NAME}_impl)
    91	    if (NOT TARGET mlek::ml_framework_impl)
    92	        message(FATAL_ERROR "mlek::ml_framework_impl target must "
    93	                            "exist before creating ${TARGET_LIB_NAME}")
    94	    endif()
    95	    add_library(${TARGET_LIB_NAME} INTERFACE)
    96	    target_link_libraries(${TARGET_LIB_NAME} INTERFACE
    97	        ${PARSED_API_NAME}_api      # API target (relies on abstract fwk interface)
    98	        mlek::ml_framework_impl)    # The ML framework impl to pull in
    99	
   100	    add_library(mlek::${TARGET_LIB_NAME} ALIAS ${TARGET_LIB_NAME})
   101	    message(STATUS "Created interface target: mlek::${TARGET_LIB_NAME}")
   102	endfunction()
   103	
   104	# Set include directories for base targets. All other targets depend on at
   105	# least one of these targets.
   106	mlek_api_set_include_dirs(mlek_log)
   107	mlek_api_set_include_dirs(arm_math)
   108	mlek_api_set_include_dirs(common_api)
   109	mlek_api_set_include_dirs(ml_framework_iface)
   110	
   111	# Create alises and add namepaced targets for easier linking.
   112	if (NOT DEFINED MLEK_API_LIST)
   113	    message(FATAL_ERROR "MLEK_API_LIST variable should be exposed by "
   114	                        "${CMAKE_CURRENT_SOURCE_DIR}/mlek/use_case")
   115	endif()
   116	
   117	foreach(_api_name ${MLEK_API_LIST})
   118	    create_mlek_impl_lib_target(API_NAME ${_api_name})
   119	endforeach()
   120	
   121	# Only include export/install logic when building as part of the top-level MLEK
   122	# project. When this library is embedded in another project, defer export to
   123	# the parent to avoid clashing install/export settings.
   124	if (CMAKE_SOURCE_DIR STREQUAL MLEK_ROOT)
   125	    include(${CMAKE_CURRENT_SOURCE_DIR}/export.cmake)
   126	endif()

