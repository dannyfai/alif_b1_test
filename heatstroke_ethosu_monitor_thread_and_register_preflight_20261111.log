   264	
   265	static bool BindSmokeInputTensor(
   266	    PolyUModel1& model,
   267	    size_t index,
   268	    const char* name,
   269	    const std::uint32_t* sourceBits,
   270	    size_t sourceBytes,
   271	    const std::vector<size_t>& expectedShape)
   272	{
   273	    auto tensor = model.GetInputTensor(index);
   274	    if (!VerifyOneTensor(name, index, tensor, expectedShape)) {
   275	        return false;
   276	    }
   277	
   278	    if (tensor->Bytes() != sourceBytes || sourceBits == nullptr) {
   279	        LOG_ERR("%s[%u] input payload size mismatch",
   280	                name, static_cast<unsigned int>(index));
   281	        return false;
   282	    }
   283	
   284	    std::memcpy(tensor->GetData(), sourceBits, sourceBytes);
   285	    LOG_INF("%s[%u] bound: %u bytes",
   286	            name,
   287	            static_cast<unsigned int>(index),
   288	            static_cast<unsigned int>(sourceBytes));
   289	    return true;
   290	}
   291	
   292	static float DecodeSmokeReference(const std::uint32_t bits)
   293	{
   294	    float value = 0.0F;
   295	    std::memcpy(&value, &bits, sizeof(value));
   296	    return value;
   297	}
   298	
   299	static int SmokeFloatToMicro(const float value)
   300	{
   301	    const double scaled = static_cast<double>(value) * 1000000.0;
   302	    if (scaled > 2147483647.0) {
   303	        return 2147483647;
   304	    }
   305	    if (scaled < -2147483648.0) {
   306	        return (-2147483647 - 1);
   307	    }
   308	    return static_cast<int>(scaled >= 0.0 ? scaled + 0.5 : scaled - 0.5);
   309	}
   310	
   311	static unsigned int SmokeArgMax4(const float* values)
   312	{
   313	    unsigned int best = 0U;
   314	    for (unsigned int i = 1U; i < 4U; ++i) {
   315	        if (values[i] > values[best]) {
   316	            best = i;
   317	        }
   318	    }
   319	    return best;
   320	}
