    25	TfLiteEvalTensor* GetInputEvalTensor(TfLiteContext* context,
    26	                                     TfLiteNode* node,
    27	                                     int input_position) {
    28	  if (input_position < 0 || input_position >= node->inputs->size) {
    29	    return nullptr;
    30	  }
    31	
    32	  const int tensor_index = node->inputs->data[input_position];
    33	  if (tensor_index < 0) {
    34	    return nullptr;
    35	  }
    36	
    37	  return context->GetEvalTensor(context, tensor_index);
    38	}
    39	
    40	size_t TensorElementCount(const TfLiteEvalTensor* tensor) {
    41	  if (tensor == nullptr || tensor->dims == nullptr) {
    42	    return 0;
    43	  }
    44	
    45	  size_t count = 1;
    46	  for (int i = 0; i < tensor->dims->size; ++i) {
    47	    if (tensor->dims->data[i] < 0) {
    48	      return 0;
    49	    }
    50	    count *= static_cast<size_t>(tensor->dims->data[i]);
    51	  }
    52	  return count;
    53	}
    54	
    55	bool IsFloatTensorType(const TfLiteEvalTensor* tensor) {
    56	  return tensor != nullptr && tensor->type == kTfLiteFloat32;
    57	}
    58	
    59	bool IsFloatTensor(const TfLiteEvalTensor* tensor) {
    60	  return IsFloatTensorType(tensor) && tensor->data.f != nullptr;
    61	}
    62	
    63	bool IsMatrix(const TfLiteEvalTensor* tensor, int rows, int columns) {
    64	  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
    65	         tensor->dims->size == 2 &&
    66	         tensor->dims->data[0] == rows &&
    67	         tensor->dims->data[1] == columns;
    68	}
    69	
    70	bool IsVector(const TfLiteEvalTensor* tensor, int length) {
    71	  return IsFloatTensor(tensor) && tensor->dims != nullptr &&
    72	         tensor->dims->size == 1 &&
    73	         tensor->dims->data[0] == length;
    74	}
