    76	bool ValidateDirection(TfLiteContext* context,
    77	                       TfLiteNode* node,
    78	                       int input_weight_base,
    79	                       int recurrent_weight_base,
    80	                       int bias_base,
    81	                       int hidden_state_position,
    82	                       int cell_state_position,
    83	                       int input_dimension,
    84	                       int batch_size,
    85	                       int* hidden_dimension) {
    86	  TfLiteEvalTensor* first_weight =
    87	      GetInputEvalTensor(context, node, input_weight_base);
    88	
    89	  if (first_weight == nullptr || first_weight->dims == nullptr ||
    90	      first_weight->dims->size != 2) {
    91	    return false;
    92	  }
    93	
    94	  const int hidden = first_weight->dims->data[0];
    95	
    96	  if (hidden <= 0 || first_weight->dims->data[1] != input_dimension) {
    97	    return false;
    98	  }
    99	
   100	  for (int gate = 0; gate < 4; ++gate) {
   101	    TfLiteEvalTensor* input_weight =
   102	        GetInputEvalTensor(context, node, input_weight_base + gate);
   103	
   104	    TfLiteEvalTensor* recurrent_weight =
   105	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   106	
   107	    TfLiteEvalTensor* bias =
   108	        GetInputEvalTensor(context, node, bias_base + gate);
   109	
   110	    if (!IsMatrix(input_weight, hidden, input_dimension) ||
   111	        !IsMatrix(recurrent_weight, hidden, hidden) ||
   112	        !IsVector(bias, hidden)) {
   113	      return false;
   114	    }
   115	  }
   116	
   117	  TfLiteEvalTensor* hidden_state =
   118	      GetInputEvalTensor(context, node, hidden_state_position);
   119	
   120	  TfLiteEvalTensor* cell_state =
   121	      GetInputEvalTensor(context, node, cell_state_position);
   122	
   123	  if (!IsFloatTensorType(hidden_state) || !IsFloatTensorType(cell_state) ||
   124	      TensorElementCount(hidden_state) !=
   125	          static_cast<size_t>(batch_size * hidden) ||
   126	      TensorElementCount(cell_state) !=
   127	          static_cast<size_t>(batch_size * hidden)) {
   128	    return false;
   129	  }
   130	
   131	  *hidden_dimension = hidden;
   132	  return true;
   133	}
