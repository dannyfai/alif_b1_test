   135	void InitializeFloatLstmParameters(
   136	    OpDataLSTM* op_data,
   137	    bool time_major,
   138	    int batch_size,
   139	    int time_steps,
   140	    int input_dimension,
   141	    int hidden_dimension,
   142	    TfLiteFusedActivation activation,
   143	    float cell_clip) {
   144	  op_data->size_info.time_major = time_major;
   145	  op_data->size_info.batch_size = batch_size;
   146	  op_data->size_info.time_steps = time_steps;
   147	  op_data->size_info.input_dimension = input_dimension;
   148	  op_data->size_info.state_dimension = hidden_dimension;
   149	
   150	  op_data->cell_gate_nonlinear_type = activation;
   151	  op_data->cell_state_info = CreateLstmCellStateInfoFloat(cell_clip);
   152	
   153	  op_data->forget_gate_parameters = CreateGateParamsFloat();
   154	  op_data->input_gate_parameters = CreateGateParamsFloat();
   155	  op_data->cell_gate_parameters = CreateGateParamsFloat();
   156	  op_data->output_gate_parameters = CreateGateParamsFloat();
   157	
   158	  op_data->inter_gate_parameters.forget_cell_mul_params =
   159	      CreateInterGateMulParamsFloat();
   160	  op_data->inter_gate_parameters.input_mul_params =
   161	      CreateInterGateMulParamsFloat();
   162	  op_data->inter_gate_parameters.output_mul_params =
   163	      CreateInterGateMulParamsFloat();
   164	}
