import hashlib
import random
import sys
import traceback
from pathlib import Path

import numpy as np
import torch
import tensorflow as tf

MODEL = Path("/home/user/sdk-alif/beeinventor/PolyU/Heat_Stress_Model_1_v20260514")
TFLITE = Path(sys.argv[1])
CHECKPOINT = Path(sys.argv[2])
EXPECTED_SHA = "8dc264a764c25c949af7fcbd6683267f44ca8471bcde4a2993dda27c16bc403f"

sys.path.insert(0, str(MODEL))

from run import Cla_Model, Heat_Stress_Dataset
from a_prepare_static_model import (
    StaticRegModel,
    StaticCombinedModel,
    load_state_dict_compat,
)


def sha256_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def as_sample_array(value, expected_shape, name):
    if isinstance(value, torch.Tensor):
        value = value.detach().cpu().numpy()

    # Copy protects against read-only NumPy dataset buffers.
    array = np.array(value, dtype=np.float32, copy=True)

    if array.shape == (1,) + expected_shape:
        array = array[0]

    if array.shape != expected_shape:
        raise ValueError(
            f"{name} shape {array.shape}; expected {expected_shape}"
        )
    return array


def max_error(values):
    values = np.asarray(values, dtype=np.float64)
    return float(np.max(values)) if values.size else 0.0


def report_errors(name, errors):
    values = np.concatenate(errors).astype(np.float64)
    print(f"{name}_elements={values.size}")
    print(f"{name}_max_abs_error={np.max(values):.10g}")
    print(f"{name}_mean_abs_error={np.mean(values):.10g}")
    print(f"{name}_p95_abs_error={np.percentile(values, 95):.10g}")
    print(f"{name}_p99_abs_error={np.percentile(values, 99):.10g}")
    print(f"{name}_rmse={np.sqrt(np.mean(values ** 2)):.10g}")


def main():
    random.seed(0)
    np.random.seed(0)
    torch.manual_seed(0)
    torch.set_num_threads(1)

    print("=== MODEL IDENTITY ===")
    actual_sha = sha256_file(TFLITE)
    print("Pre-Vela model:", TFLITE)
    print("Actual SHA256:", actual_sha)
    print("Expected SHA256:", EXPECTED_SHA)

    if actual_sha != EXPECTED_SHA:
        raise RuntimeError("Pre-Vela model SHA-256 mismatch")
    if not CHECKPOINT.is_file():
        raise FileNotFoundError(CHECKPOINT)

    print("\n=== STATIC FP32 CHECKPOINT ===")
    static_model = StaticCombinedModel(
        StaticRegModel(), Cla_Model()
    ).cpu().eval()
    static_model.load_state_dict(
        load_state_dict_compat(CHECKPOINT), strict=True
    )
    print("Static checkpoint loaded")

    print("\n=== LOAD HELD-OUT TEST DATASET ===")
    dataset = Heat_Stress_Dataset(
        data_root_path=str(MODEL / "data" / "split_byid") + "/",
        flag="test",
        seq_input_len=900,
        seq_pred_len=900,
        target=["rpe", "psi"],
        seq_random_missing=True,
    )
    sample_count = len(dataset)
    print("Dataset samples:", sample_count)

    if sample_count == 0:
        raise RuntimeError("Test dataset is empty")

    print("\n=== CREATE FP32 TFLITE CPU INTERPRETER ===")
    resolver = (
        tf.lite.experimental.OpResolverType
        .BUILTIN_WITHOUT_DEFAULT_DELEGATES
    )
    interpreter = tf.lite.Interpreter(
        model_path=str(TFLITE),
        experimental_op_resolver_type=resolver,
    )
    interpreter.allocate_tensors()

    inputs = interpreter.get_input_details()
