import random
import sys
import traceback
from pathlib import Path

import numpy as np
import torch
import tensorflow as tf
from torch.utils.data import DataLoader

MODEL = Path("/home/user/sdk-alif/beeinventor/PolyU/Heat_Stress_Model_1_v20260514")
TFLITE = Path(sys.argv[1])
CHECKPOINT = Path(sys.argv[2])

sys.path.insert(0, str(MODEL))

from run import Cla_Model, Heat_Stress_Dataset
from a_prepare_static_model import (
    StaticRegModel,
    StaticCombinedModel,
    load_state_dict_compat,
)


def max_abs(a, b):
    a = np.asarray(a, dtype=np.float64)
    b = np.asarray(b, dtype=np.float64)
    if a.shape != b.shape:
        raise ValueError(f"Shape mismatch: {a.shape} vs {b.shape}")
    return float(np.max(np.abs(a - b))) if a.size else 0.0


def tensor_description(index, detail_map):
    if index == -1:
        return "optional tensor (-1)"
    d = detail_map.get(int(index))
    if d is None:
        return f"tensor index {index}: detail unavailable"

    q = d.get("quantization_parameters", {})
    return (
        f"index={index}, name={d.get('name')}, "
        f"shape={d.get('shape')}, dtype={d.get('dtype')}, "
        f"quantization={d.get('quantization')}, "
        f"scales={q.get('scales', np.array([]))}, "
        f"zero_points={q.get('zero_points', np.array([]))}"
    )


def main():
    random.seed(0)
    np.random.seed(0)
    torch.manual_seed(0)
    torch.set_num_threads(1)

    print("=== MODEL FILES ===")
    print("TFLite:", TFLITE)
    print("Static checkpoint:", CHECKPOINT)
    if not TFLITE.is_file():
        raise FileNotFoundError(TFLITE)
    if not CHECKPOINT.is_file():
        raise FileNotFoundError(CHECKPOINT)

    print("\n=== LOAD STATIC FP32 REFERENCE ===")
    static_model = StaticCombinedModel(
        StaticRegModel(), Cla_Model()
    ).cpu().eval()
    static_model.load_state_dict(
        load_state_dict_compat(CHECKPOINT), strict=True
    )
    print("Static checkpoint loaded successfully")

    print("\n=== LOAD ONE REAL TEST SAMPLE ===")
    dataset = Heat_Stress_Dataset(
        data_root_path=str(MODEL / "data" / "split_byid") + "/",
        flag="test",
        seq_input_len=900,
        seq_pred_len=900,
        target=["rpe", "psi"],
        seq_random_missing=True,
    )
    if len(dataset) == 0:
        raise RuntimeError("Test dataset is empty")

    loader = DataLoader(
        dataset, batch_size=1, shuffle=False,
        num_workers=0, drop_last=False
    )
    batch = next(iter(loader))
    batch_x1_1, batch_x1_2, batch_x2, _, batch_x_mark, _ = batch

    x_original = batch_x1_1.float()
    x_reg = batch_x1_2.float()
    worker = batch_x2.float()
    x_mark = batch_x_mark.float()

    mask = (
        (x_reg == -9997.0)
        | (x_reg == -9998.0)
        | (x_reg == -9999.0)
    )
    x_values = torch.where(
        mask, torch.zeros_like(x_original), x_original
    )
    mask_float = mask.float()

    print("x_values:", tuple(x_values.shape), x_values.dtype)
    print("missing_mask:", tuple(mask_float.shape), mask_float.dtype)
    print("x_mark:", tuple(x_mark.shape), x_mark.dtype)
    print("worker_features:", tuple(worker.shape), worker.dtype)
    print("Missing positions:", int(mask.sum().item()))
    print(
        "Observed-position mismatches:",
        int((x_reg[~mask] != x_original[~mask]).sum().item())
    )

    with torch.inference_mode():
        static_rpe, static_psi = static_model(
            x_values, mask_float, x_mark, worker
        )

    static_rpe = static_rpe.cpu().numpy()
    static_psi = static_psi.cpu().numpy()

    print("\n=== CREATE TFLITE INTERPRETER ===")
    resolver = (
        tf.lite.experimental.OpResolverType
        .BUILTIN_WITHOUT_DEFAULT_DELEGATES
    )
    interpreter = tf.lite.Interpreter(
        model_path=str(TFLITE),
        experimental_preserve_all_tensors=True,
        experimental_op_resolver_type=resolver,
    )
    interpreter.allocate_tensors()
    print("TFLite allocate_tensors(): PASS")

    inputs = interpreter.get_input_details()
    outputs = interpreter.get_output_details()
    tensor_map = {
        int(d["index"]): d for d in interpreter.get_tensor_details()
    }

    print("\n=== TFLITE INPUT INTERFACE ===")
    input_values = {
        "x_values": x_values.numpy().astype(np.float32, copy=True),
        "missing_mask": mask_float.numpy().astype(np.float32, copy=True),
        "x_mark": x_mark.numpy().astype(np.float32, copy=True),
        "worker_features": worker.numpy().astype(np.float32, copy=True),
    }

    for name, value in input_values.items():
        matches = [d for d in inputs if name in d["name"]]
        if len(matches) != 1:
            raise RuntimeError(
                f"Expected exactly one input matching {name}; "
                f"found {[d['name'] for d in matches]}"
            )
        d = matches[0]
        print(
            f"{name}: index={d['index']}, tensor_name={d['name']}, "
            f"shape={d['shape']}, dtype={d['dtype']}, "
            f"quantization={d['quantization']}"
        )
        if d["dtype"] != np.float32:
            raise RuntimeError(
                f"{name} is {d['dtype']}, expected FP32"
            )
        if tuple(value.shape) != tuple(d["shape"]):
            raise RuntimeError(
                f"{name} shape mismatch: {value.shape} vs {d['shape']}"
            )
        interpreter.set_tensor(d["index"], value)

    print("\n=== TFLITE OUTPUT INTERFACE ===")
    output_map = {}
    for name in ("rpe_logits", "psi_logits"):
        matches = [d for d in outputs if name in d["name"]]
        if len(matches) != 1:
            raise RuntimeError(
                f"Expected exactly one output matching {name}; "
                f"found {[d['name'] for d in matches]}"
            )
        d = matches[0]
        output_map[name] = d
        print(
            f"{name}: index={d['index']}, tensor_name={d['name']}, "
            f"shape={d['shape']}, dtype={d['dtype']}, "
            f"quantization={d['quantization']}"
        )
        if d["dtype"] != np.float32:
            raise RuntimeError(
                f"{name} is {d['dtype']}, expected FP32"
            )

    print("\n=== OPERATOR INVENTORY ===")
    ops = interpreter._get_ops_details()
    counts = {}
    for op in ops:
        counts[op["op_name"]] = counts.get(op["op_name"], 0) + 1
    print("Total operators:", len(ops))
    for name, count in sorted(counts.items()):
        print(f"{name}: {count}")

    print("\n=== BIDIRECTIONAL LSTM TENSOR TYPES ===")
    lstm_index = 0
    for op in ops:
        if op["op_name"] != "BIDIRECTIONAL_SEQUENCE_LSTM":
            continue
        lstm_index += 1
        print(f"\nBiLSTM operator {lstm_index}:")
        for index in op["inputs"]:
            print("  INPUT ", tensor_description(index, tensor_map))
        for index in op["outputs"]:
            print("  OUTPUT", tensor_description(index, tensor_map))

    ethos_ops = [op for op in ops if op["op_name"] == "ethos-u"]
    print("\nEthos-U operators:", len(ethos_ops))
    if ethos_ops:
        for label, op in (
            ("first", ethos_ops[0]),
            ("last", ethos_ops[-1]),
        ):
            print(f"{label} Ethos-U operator:")
            for index in op["inputs"]:
                print("  INPUT ", tensor_description(index, tensor_map))
            for index in op["outputs"]:
                print("  OUTPUT", tensor_description(index, tensor_map))

    print("\n=== TFLITE INVOKE ===")
    interpreter.reset_all_variables()
    interpreter.invoke()
    print("TFLite invoke(): PASS")

    tflite_rpe = interpreter.get_tensor(
        output_map["rpe_logits"]["index"]
    )
    tflite_psi = interpreter.get_tensor(
        output_map["psi_logits"]["index"]
    )

    print("\n=== STATIC FP32 VS VELA TFLITE ===")
    for name, reference, actual in (
        ("RPE", static_rpe, tflite_rpe),
        ("PSI", static_psi, tflite_psi),
    ):
        if not np.isfinite(actual).all():
            raise RuntimeError(f"{name} TFLite output contains non-finite values")
        print(f"{name} FP32 reference: {reference}")
        print(f"{name} TFLite output:  {actual}")
        print(f"{name} max_abs_error: {max_abs(reference, actual):.10g}")
        print(
            f"{name} class_match:",
            bool(np.array_equal(reference.argmax(1), actual.argmax(1)))
        )

    print("\nONE-SAMPLE VELA TFLITE RUNTIME SMOKE: PASS")


if __name__ == "__main__":

