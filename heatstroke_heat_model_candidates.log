message(STATUS "Using INC_GEN_DIR:    ${INC_GEN_DIR}")

# Determine NPU config ID based on Zephyr Kconfig.
# If ETHOSU_TARGET_NPU_CONFIG was supplied on the command line, ETHOS_U_NPU_CONFIG_ID
# has already been computed above. Otherwise fall back to the board Kconfig defaults.
if (NOT DEFINED ETHOS_U_NPU_CONFIG_ID)
    if (CONFIG_ARM_ETHOS_U85_256)
        set(ETHOS_U_NPU_CONFIG_ID "Z256")
    elseif (CONFIG_ARM_ETHOS_U55_256)
        set(ETHOS_U_NPU_CONFIG_ID "H256")
    else()
        set(ETHOS_U_NPU_CONFIG_ID "H128")
    endif()
endif()

# Model file path
# set(POLYU_MODEL_PATH ${CMAKE_CURRENT_SOURCE_DIR}/../PolyU/ai-models/model1_pipeline_dynamic_range.tflite
# set(POLYU_MODEL_PATH ${CMAKE_CURRENT_SOURCE_DIR}/../PolyU/ai-models/model1_static_dynamic_range_quant.tflite
# set(POLYU_MODEL_PATH ${CMAKE_CURRENT_SOURCE_DIR}/../PolyU/ai-models/model1_static_quant_int8.tflite
set(POLYU_MODEL_PATH ${CMAKE_CURRENT_SOURCE_DIR}/../PolyU/ai-models/cla_quant_uint8_vela.tflite
    CACHE FILEPATH "Path to the PolyU TFLite model (Vela-compiled)")

if (NOT EXISTS ${POLYU_MODEL_PATH})
    message(FATAL_ERROR
        "PolyU model not found at ${POLYU_MODEL_PATH}\n")
endif()

set(EXTRA_MODEL_CODE
	"/* Model parameters for ${use_case} */"
	"extern const int   g_FrameLength    = 512"
	"extern const int   g_FrameStride    = 160"
	"extern const int   g_ctxLen         = 98"
	"extern const float g_ScoreThreshold = 0.5"
	)

# Generate model file
generate_model_code(
    MODEL_PATH  ${POLYU_MODEL_PATH}
    DESTINATION ${SRC_GEN_DIR}
    EXPRESSIONS ${EXTRA_MODEL_CODE}
    NAMESPACE   "arm" "app" "asr")

# Generate labels C++ code
set(ASR_LABELS_FILE ${MLEK_ROOT}/resources/asr/labels/labels_wav2letter.txt)

# Generate labels file
set(ASR_LABELS_CPP_FILE Labels)
generate_labels_code(
    INPUT           "${ASR_LABELS_FILE}"
    DESTINATION_SRC ${SRC_GEN_DIR}
    DESTINATION_HDR ${INC_GEN_DIR}

