   591	                non_missing_mask = (batch_x1_2_copy != -9997) & (batch_x1_2_copy != -9998) & (batch_x1_2_copy != -9999)
   592	                batch_x1_1 = batch_x1_1.float().to(device)
   593	                batch_x1_2 = batch_x1_2.float().to(device)
   594	                batch_x_mark = batch_x_mark.float().to(device)
   595	                batch_x2 = batch_x2.float().to(device)
   596	
   597	                b, l, n = batch_x1_1.size()
   598	                mr_1 = len(batch_x1_2_copy[manual_missing_mask]) / (b * l * n)
   599	                mr_2 = len(batch_x1_2_copy[~non_missing_mask]) / (b * l * n)
   600	                manual_missing_rate.append(mr_1)
   601	                total_missing_rate.append(mr_2)
   602	
   603	                # batch_x1_2 is the main input: (batch_size, seq_len, feature_num) = (1, 900, 7), including {core_temp, acc_x, acc_y, acc_z, wbgt_humidity, wbgt_index}
   604	                # batch_x_mark is the time feature: (batch_size, seq_len, feature_num) = (1, 900, 3)
   605	                # one_hot_x is other features of workers: (batch_size, feature_num), e.g., 'worker_type1', 'age', 'gender', 'height', 'diseases', 'smoke', 'alcohol', etc.
   606	                reg_out = reg_model(batch_x1_2, x_mark_enc=batch_x_mark, one_hot_x=batch_x2[:, 0: configs['reg_non_seq_len']], device=device)
   607	                reg_out[non_missing_mask] = batch_x1_1[non_missing_mask]
   608	                rpe_pred, psi_pred = cla_model(reg_out, x_mark_enc=batch_x_mark, one_hot_x=batch_x2[:, 0: configs['cla_non_seq_len']], device=device)
   609	                if rpe_pred is not None:
   610	                    rpe_preds.extend(rpe_pred.argmax(dim=1, keepdim=False).cpu().numpy())
   611	                if psi_pred is not None:
   612	                    psi_preds.extend(psi_pred.argmax(dim=1, keepdim=False).cpu().numpy())
   613	
   614	            # calculate precision/recall/f1-score
   615	            rpe_prf = cal_prf_metrics(rpe_labels, rpe_preds)
   616	            psi_prf = cal_prf_metrics(psi_labels, psi_preds)
   617	            final_metrics['rpe_p'][str(t)] = rpe_prf['weighted']['p']
   618	            final_metrics['rpe_r'][str(t)] = rpe_prf['weighted']['r']
   619	            final_metrics['rpe_f1'][str(t)] = rpe_prf['weighted']['f1']
   620	            final_metrics['psi_p'][str(t)] = psi_prf['weighted']['p']
   621	            final_metrics['psi_r'][str(t)] = psi_prf['weighted']['r']
   622	            final_metrics['psi_f1'][str(t)] = psi_prf['weighted']['f1']
   623	            final_metrics['manual_missing_rate'][str(t)] = np.average(manual_missing_rate)
   624	            final_metrics['total_missing_rate'][str(t)] = np.average(total_missing_rate)
   625	            print(f"\t round-{t} rpe_cla_f1: {rpe_prf['weighted']['f1']}, psi_cla_f1: {psi_prf['weighted']['f1']}")

