   343	class Heat_Stress_Dataset(Dataset):
   344	    def __init__(self, data_root_path, flag='test', seq_input_len=900, seq_pred_len=900, target='psi', seq_random_missing=True):
   345	        self.data_root_path = data_root_path
   346	        assert flag in ['test', 'val']
   347	        self.flag = flag
   348	        self.seq_input_len = seq_input_len
   349	        self.seq_pred_len = seq_pred_len
   350	        self.target = target
   351	        self.seq_random_missing = seq_random_missing
   352	        self.mr_last_5 = 0.1
   353	        self.mr_thr = 0.3
   354	
   355	        self.seq_cols = [
   356	            'cb_cbt',
   357	            'wbgt_hum', 'wbgt_outdoor',
   358	            'helmet_acc_x_mean', 'helmet_acc_y_mean', 'helmet_acc_z_mean',
   359	        ]
   360	        self.non_seq_cols = [
   361	            'session', 'worker_type1', 'age', 'gender', 'height', 'diseases', 'smoke', 'alcohol',   # 18
   362	            'prev_rpe_0', 'prev_rpe_1', 'prev_rpe_2',                                               # 30
   363	        ]
   364	        self.one_hot_cols = [
   365	            'prev_rpe_0', 'prev_rpe_1', 'prev_rpe_2',
   366	            'worker_type1', 'diseases', 'smoke', 'alcohol',
   367	        ]
   368	        self.__read_data__()
   369	
   370	    def __read_data__(self):
   371	        df_seq = pd.read_feather(self.data_root_path + f'{self.flag}_seq.feather')
   372	        df_non_seq = pd.read_csv(self.data_root_path + f'{self.flag}_non_seq.csv')
   373	        df_non_seq['time'] = pd.to_datetime(df_non_seq['time'])
   374	
   375	        # convert rpe/psi(0-10) to new categories: [0, 1, 2, 3]
   376	        if 'psi' in self.target:
   377	            # df_non_seq = df_non_seq[~df_non_seq['psi'].isna()]
   378	            df_non_seq['psi'] = df_non_seq['psi'].fillna(-1)
   379	            df_non_seq['psi'] = df_non_seq['psi'].map(PSI_MAP)
   380	        if 'rpe' in self.target:
   381	            df_non_seq['rpe'] = df_non_seq['rpe'].map(RPE_MAP)
   382	
   383	        self.sample_indices = list(df_non_seq['sample_index'])
   384	        self.df_non_seq = df_non_seq.copy()
   385	        self.df_seq = df_seq.copy()
   386	
   387	    def data_post_process(self, df_x, pad_value=-9998, pad_value2=-9997):
   388	        mr = df_x.isna().mean()
   389	        df_len = df_x.shape[0]
   390	        r1 = np.random.random()
   391	
   392	        if r1 < self.mr_last_5:
   393	            # Method 1: Last 5-minute patch missing
   394	            miss_len = min(int(df_len / 3), 300)
   395	
   396	            miss_mask = np.zeros(df_len, dtype=bool)
   397	            miss_mask[df_len - miss_len:] = True
   398	
   399	            for col in df_x.columns:
   400	                if mr[col] == 0.:
   401	                    nan_mask = df_x[col].isna().to_numpy()
   402	                    mask = miss_mask & ~nan_mask
   403	
   404	                    # Use .loc to avoid chained assignment
   405	                    df_x.loc[mask, col] = pad_value
   406	
   407	        else:
   408	            for col in df_x.columns:
   409	                nan_mask = df_x[col].isna().to_numpy()
   410	                r2 = np.random.random()
   411	
   412	                if r2 < 0.5:
   413	                    # Method 2: Random missing
   414	                    random_mask = np.random.choice(
   415	                        [True, False],
   416	                        size=df_len,
   417	                        p=[self.mr_thr, 1 - self.mr_thr]
   418	                    )
   419	
   420	                    mask = random_mask & ~nan_mask
   421	                    df_x.loc[mask, col] = pad_value
   422	
   423	                else:
   424	                    # Method 3: Random patch missing
   425	                    miss_len = int(df_len * self.mr_thr)
   426	
   427	                    start = np.random.randint(10, df_len - miss_len)
   428	                    end = min(start + miss_len, df_len)
   429	
   430	                    miss_mask = np.zeros(df_len, dtype=bool)
   431	                    miss_mask[start:end] = True
   432	
   433	                    mask = miss_mask & ~nan_mask
   434	                    df_x.loc[mask, col] = pad_value2
   435	
   436	        return df_x
   437	    def __getitem__(self, index):
   438	        sample_index = self.sample_indices[index]
   439	        df_non_seq = self.df_non_seq.query(f'sample_index == {sample_index}')
   440	        start_time = df_non_seq['time'].values[0] - pd.Timedelta(seconds=self.seq_input_len)
   441	        end_time = df_non_seq['time'].values[0] - pd.Timedelta(seconds=1)
   442	        df_seq = self.df_seq.query(f"sample_index == {sample_index} and time >= '{start_time}' and time <= '{end_time}'")
   443	        df_seq = df_seq.reset_index(drop=True)
   444	
   445	        # set unreliable seq_data to nan
   446	        missing_cols = df_non_seq['missing_col'].values[0]
   447	        if pd.isna(missing_cols):
   448	            missing_cols = []
   449	        else:
   450	            missing_cols = missing_cols.split(';')
   451	        for c in missing_cols:
   452	            df_seq[c] = np.nan
   453	
   454	        # time features
   455	        time_stamp = time_features(pd.to_datetime(df_seq['time'].values))
   456	        seq_x_mark = time_stamp.transpose(1, 0)[:self.seq_input_len, :]
   457	        seq_y_mark = seq_x_mark
   458	
   459	        # apply manual missing for seq_data
   460	        df_seq_x = df_seq[self.seq_cols]
   461	        df_seq_x_1 = df_seq_x.copy()
   462	        if self.seq_random_missing:
   463	            df_seq_x_2 = self.data_post_process(df_seq_x_1.copy(), pad_value=-9998)
   464	        else:
   465	            df_seq_x_2 = df_seq_x_1.copy()
   466	        df_seq_x_1 = df_seq_x_1.fillna(-9999)
   467	        df_seq_x_2 = df_seq_x_2.fillna(-9999)
   468	        x1_1 = df_seq_x_1.values[:self.seq_input_len]
   469	        x1_2 = df_seq_x_2.values[:self.seq_input_len]
   470	
   471	        # non_seq input
   472	        x2 = []
   473	        df_temp = df_non_seq[self.non_seq_cols]
   474	        for col in self.non_seq_cols:
   475	            v = df_temp[col].values[-1]
   476	            if col in self.one_hot_cols:
   477	                if 'prev' in col:
   478	                    col = 'prev_rpe_rpt'
   479	                x2 += ONE_HOT_MAP[col][v]
   480	            else:
   481	                x2.append(v)
   482	        x2 = np.asarray(x2)
   483	
   484	        # targets
   485	        y = df_non_seq[self.target].values[-1]
   486	
   487	        return x1_1, x1_2, x2, y, seq_x_mark, seq_y_mark
   488	
   489	    def __len__(self):
   490	        return len(self.sample_indices)

