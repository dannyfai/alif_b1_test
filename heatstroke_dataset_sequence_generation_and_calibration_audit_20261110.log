   140	def run_onnx2tf(onnx_path, output_dir, log_path):
   141	    executable = shutil.which("onnx2tf")
   142	    if executable is None:
   143	        raise RuntimeError(
   144	            "Cannot find the 'onnx2tf' command in PATH. Activate the same "
   145	            "onnx2tflite_env used for your ONNX-to-TFLite conversion and "
   146	            "install/activate onnx2tf there."
   147	        )
   148	
   149	    output_dir.mkdir(parents=True, exist_ok=True)
   150	    command = [
   151	        executable,
   152	        "-i", str(onnx_path.resolve()),
   153	        "-o", str(output_dir.resolve()),
   154	    ]
   155	
   156	    print("\nRunning ONNX -> TensorFlow SavedModel:")
   157	    print(" ".join(command))
   158	    print(f"Full onnx2tf log: {log_path}")
   159	
   160	    with log_path.open("w", encoding="utf-8") as log_file:
   161	        completed = subprocess.run(
   162	            command,
   163	            stdout=log_file,
   164	            stderr=subprocess.STDOUT,
   165	            text=True,
   166	            check=False,
   167	        )
   168	
   169	    if completed.returncode != 0:
   170	        raise RuntimeError(
   171	            f"onnx2tf failed with exit code {completed.returncode}. "
   172	            f"Inspect: {log_path}"
   173	        )
   174	
   175	    candidates = list(output_dir.rglob("saved_model.pb"))
   176	    if not candidates:
   177	        raise RuntimeError(
   178	            "onnx2tf completed, but no saved_model.pb was found under "
   179	            f"{output_dir}. Inspect the log: {log_path}"
   180	        )
   181	
   182	    # Prefer the shallowest SavedModel directory.
   183	    candidates.sort(key=lambda p: len(p.parts))
   184	    saved_model_dir = candidates[0].parent
   185	    print("SavedModel directory:", saved_model_dir)
   186	    return saved_model_dir
