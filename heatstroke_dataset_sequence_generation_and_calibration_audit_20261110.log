   121	def iter_model_samples(dataset, num_workers=0):
   122	    loader = DataLoader(
   123	        dataset,
   124	        batch_size=1,
   125	        shuffle=False,
   126	        drop_last=False,
   127	        num_workers=num_workers,
   128	    )
   129	    for batch in loader:
   130	        if len(batch) != 6:
   131	            raise RuntimeError(
   132	                f"Expected 6 dataset outputs, received {len(batch)}."
   133	            )
   134	        _, batch_x1_2, batch_x2, batch_y, batch_x_mark, _ = batch
   135	        inputs = prepare_inputs(batch_x1_2, batch_x2, batch_x_mark)
   136	        labels = to_numpy(batch_y).reshape(-1)
   137	        yield inputs, labels
