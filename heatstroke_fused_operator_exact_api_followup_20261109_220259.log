    29	const tflite::MicroOpResolver&
    30	arm::app::fwk::tflm::PolyUModel1::GetOpResolver()
    31	{
    32	    return this->m_opResolver;
    33	}
    34	
    35	namespace
    36	{
    37	
    38	/*
    39	 * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
    40	 * required by this implementation. Validate its options type and leave
    41	 * builtin_data null.
    42	 */
    43	TfLiteStatus ParseHeatstrokeSign(
    44	    const tflite::Operator* op,
    45	    tflite::ErrorReporter*,
    46	    tflite::BuiltinDataAllocator*,
    47	    void** builtin_data)
    48	{
    49	    if (builtin_data != nullptr) {
    50	        *builtin_data = nullptr;
    51	    }
    52	
    53	    if (op == nullptr ||
    54	        op->builtin_options_type() !=
    55	            tflite::BuiltinOptions_SignOptions) {
    56	        return kTfLiteError;
    57	    }
    58	
    59	    return kTfLiteOk;
    60	}
    61	
    62	/*
    63	 * Application-local INT32 SIGN implementation.
    64	 *
    65	 * y = -1 when x < 0
    66	 * y =  0 when x = 0
    67	 * y =  1 when x > 0
    68	 *
    69	 * No temporary buffer or scratch allocation is required.
    70	 */
    71	TfLiteStatus HeatstrokeSignEval(
    72	    TfLiteContext* context,
    73	    TfLiteNode* node)
    74	{
    75	    if (context == nullptr || node == nullptr) {
    76	        return kTfLiteError;
    77	    }
    78	
    79	    const TfLiteEvalTensor* input =
    80	        tflite::micro::GetEvalInput(context, node, 0);
    81	
    82	    TfLiteEvalTensor* output =
    83	        tflite::micro::GetEvalOutput(context, node, 0);
    84	
    85	    if (input == nullptr || output == nullptr) {
    86	        return kTfLiteError;
    87	    }
    88	
    89	    if (input->type != kTfLiteInt32 ||
    90	        output->type != kTfLiteInt32) {
    91	        MicroPrintf(
    92	            "Heatstroke SIGN requires INT32 input/output. "
    93	            "Input=%d Output=%d",
    94	            input->type,
    95	            output->type);
   590	        builtin_data);
   591	}
   592	
   593	bool arm::app::fwk::tflm::PolyUModel1::EnlistOperations()
   594	{
   595	#define HS_ADD_REQUIRED(method)                                      \
   596	    do {                                                              \
   597	        const TfLiteStatus status = this->m_opResolver.method();      \
   598	        if (status != kTfLiteOk) {                                    \
   599	            printf_err(                                               \
   600	                "Failed to register heat-stress operator: %s\n",     \
   601	                #method);                                             \
   602	            return false;                                             \
   603	        }                                                             \
   604	    } while (0)
   605	
   606	    /*
   607	     * 28 stock ordinary built-in operators; GATHER is registered separately below.
   608	     * These CPU registrations must remain available with Ethos-U enabled.
   609	     */
   610	    HS_ADD_REQUIRED(AddAdd);
   611	    HS_ADD_REQUIRED(AddBroadcastArgs);
   612	    HS_ADD_REQUIRED(AddBroadcastTo);
   613	    HS_ADD_REQUIRED(AddCast);
   614	    HS_ADD_REQUIRED(AddConcatenation);
   615	    HS_ADD_REQUIRED(AddCumSum);
   616	    HS_ADD_REQUIRED(AddDequantize);
   617	    HS_ADD_REQUIRED(AddDiv);
   618	    HS_ADD_REQUIRED(AddEqual);
   619	    HS_ADD_REQUIRED(AddFloorMod);
   620	    /*
   621	     * Application-local GATHER replacement supporting INT32 and INT64
   622	     * indices. It reuses the existing output tensor and allocates no
   623	     * index-conversion or scratch buffer.
   624	     */
   625	    {
   626	        const TFLMRegistration registration =
   627	            tflite::RegisterHeatstrokeGatherKernel();
   628	
   629	        if (this->m_opResolver.AddBuiltin(
   630	                tflite::BuiltinOperator_GATHER,
   631	                registration,
   632	                tflite::ParseGather) != kTfLiteOk) {
   633	            printf_err(
   634	                "Failed to register heat-stress INT64 GATHER.\n");
   635	            return false;
   636	        }
   637	    }
   638	    HS_ADD_REQUIRED(AddGreater);
   639	    HS_ADD_REQUIRED(AddLogicalAnd);
   640	    HS_ADD_REQUIRED(AddLogicalNot);
   641	    HS_ADD_REQUIRED(AddMaximum);
   642	    HS_ADD_REQUIRED(AddMean);
   643	    HS_ADD_REQUIRED(AddMul);
   644	    HS_ADD_REQUIRED(AddNeg);
   645	    HS_ADD_REQUIRED(AddQuantize);
   646	    HS_ADD_REQUIRED(AddReshape);
   647	    HS_ADD_REQUIRED(AddRsqrt);
   648	    HS_ADD_REQUIRED(AddSelectV2);
   649	    HS_ADD_REQUIRED(AddSoftmax);
   650	    HS_ADD_REQUIRED(AddSplitV);
   651	    HS_ADD_REQUIRED(AddSqrt);
   652	    HS_ADD_REQUIRED(AddSquare);
   653	    HS_ADD_REQUIRED(AddSub);
   654	    HS_ADD_REQUIRED(AddSum);
   655	    HS_ADD_REQUIRED(AddTopKV2);
   656	
   657	#undef HS_ADD_REQUIRED
   658	
   659	    /*
   660	     * Custom SIGN registration under the built-in SIGN opcode.
   661	     */
   662	    {
   663	        const TFLMRegistration registration =
   664	            RegisterHeatstrokeSignKernel();
   665	
   666	        if (this->m_opResolver.AddBuiltin(
