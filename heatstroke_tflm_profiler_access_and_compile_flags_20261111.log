    27	namespace arm::app::fwk::tflm {
    28	namespace {
    29	/**
    30	 * @brief   Infer Arm Ethos-U NPU memory mode from Ethos-U operator inputs.
    31	 * @param[in] model     Pointer the the model object.
    32	 * @return  Memory mode string if detected, or empty string otherwise.
    33	 */
    34	std::string InferNpuMemoryModeFromEthosUOp(const tflite::Model* model)
    35	{
    36	    if (!model || !model->subgraphs() || model->subgraphs()->size() == 0 ||
    37	        !model->operator_codes()) {
    38	        return {};
    39	    }
    40	
    41	    const tflite::SubGraph* subgraph = model->subgraphs()->Get(0);
    42	    if (!subgraph || !subgraph->operators()) {
    43	        return {};
    44	    }
    45	
    46	    int ethos_u_opcode = -1;
    47	    for (uint32_t i = 0; i < model->operator_codes()->size(); ++i) {
    48	        const tflite::OperatorCode* opcode = model->operator_codes()->Get(i);
    49	        if (!opcode || opcode->builtin_code() != tflite::BuiltinOperator_CUSTOM) {
    50	            continue;
    51	        }
    52	        const auto* custom = opcode->custom_code();
    53	        if (custom && (std::strcmp(custom->c_str(), "ethos-u") == 0)) {
    54	            ethos_u_opcode = static_cast<int>(i);
    55	            break;
    56	        }
    57	    }
    58	
    59	    if (ethos_u_opcode < 0) {
    60	        return {};
    61	    }
    62	
    63	    for (uint32_t i = 0; i < subgraph->operators()->size(); ++i) {
    64	        const tflite::Operator* op = subgraph->operators()->Get(i);
    65	        if (!op || op->opcode_index() != ethos_u_opcode) {
    66	            continue;
    67	        }
    68	        const auto* inputs = op->inputs();
    69	        if (!inputs || inputs->size() <= 3) {
    70	            continue;
    71	        }
    72	
    73	        /* Vela places tensor arena at index 2 and fast scratch buffer at index 3. */
    74	        const int32_t arena_idx = inputs->Get(2);
    75	        const int32_t scratch_idx = inputs->Get(3);
    76	        if (arena_idx < 0 || scratch_idx < 0) {
    77	            continue;
    78	        }
    79	
    80	        const tflite::Tensor* arena = subgraph->tensors()->Get(arena_idx);
    81	        const tflite::Tensor* scratch = subgraph->tensors()->Get(scratch_idx);
    82	        if (!arena || !scratch) {
    83	            continue;
    84	        }
    85	
    86	        const auto arena_shape = arena->shape();
    87	        const auto scratch_shape = scratch->shape();
    88	        if (!arena_shape || !scratch_shape || arena_shape->size() < 1 ||
    89	            scratch_shape->size() < 1 || arena_shape->Get(0) < 1) {
    90	            continue;
    91	        }
    92	
    93	        if (arena_shape->Get(0) == scratch_shape->Get(0)) {
    94	            return "Sram_Only/Shared_Sram";
    95	        }
    96	        return "Dedicated_Sram";
    97	    }
    98	
    99	    return {};
   100	}
   101	} /* anonymous namespace */
