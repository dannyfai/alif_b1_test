     8	#include "stdint.h"
     9	#include "soc.h"
    10	#include "sau_tcm_ns_setup.h"
    11	#include "tgu.h"
    12	
    13	#if !(defined(__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U))
    14	
    15	typedef struct {
    16		__IOM uint32_t CTRL;       /*!< Offset: 0x000 (R/W)  SAU Control Register */
    17	
    18		__IM  uint32_t TYPE;       /*!< Offset: 0x004 (R/ )  SAU Type Register */
    19	
    20		__IOM uint32_t RNR;        /*!< Offset: 0x008 (R/W)  SAU Region Number Register */
    21		__IOM uint32_t RBAR;       /*!< Offset: 0x00C (R/W)  SAU Region Base Address Register */
    22		__IOM uint32_t RLAR;       /*!< Offset: 0x010 (R/W)  SAU Region Limit Address Register */
    23		__IOM uint32_t SFSR;       /*!< Offset: 0x014 (R/W)  Secure Fault Status Register */
    24		__IOM uint32_t SFAR;       /*!< Offset: 0x018 (R/W)  Secure Fault Address Register */
    25	} SAU_Type;
    26	
    27	#define SAU_CTRL_ENABLE_Pos   0U                                   /*!< SAU CTRL: ENABLE Position */
    28	#define SAU_CTRL_ENABLE_Msk   (1UL /*<< SAU_CTRL_ENABLE_Pos*/)     /*!< SAU CTRL: ENABLE Mask */
    29	
    30	/* SAU Region Base Address Register Definitions */
    31	#define SAU_RBAR_BADDR_Pos    5U                                   /*!< SAU RBAR: BADDR Position */
    32	#define SAU_RBAR_BADDR_Msk    (0x7FFFFFFUL << SAU_RBAR_BADDR_Pos)  /*!< SAU RBAR: BADDR Mask */
    33	
    34	/* SAU Region Limit Address Register Definitions */
    35	#define SAU_RLAR_LADDR_Pos    5U                                   /*!< SAU RLAR: LADDR Position */
    36	#define SAU_RLAR_LADDR_Msk    (0x7FFFFFFUL << SAU_RLAR_LADDR_Pos)  /*!< SAU RLAR: LADDR Mask */
    37	
    38	#define SAU_RLAR_ENABLE_Pos   0U                                   /*!< SAU RLAR: ENABLE Position */
    39	#define SAU_RLAR_ENABLE_Msk   (1UL /*<< SAU_RLAR_ENABLE_Pos*/)     /*!< SAU RLAR: ENABLE Mask */
    40	
    41	#define SAU_BASE              (SCS_BASE +  0x0DD0UL)               /*!< Security Attribution Unit */
    42	#define SAU                   ((SAU_Type       *)     SAU_BASE)    /*!< Security Attribution Unit */
    43	
    44	__STATIC_INLINE void SAU_TCM_NS_Setup(void)
    45	{
    46		SAU->RNR = 0;
    47		SAU->RBAR = (uint32_t)NS_REGION_0_BASE & SAU_RBAR_BADDR_Msk;
    48		SAU->RLAR = (((uint32_t)NS_REGION_0_END - 1) & SAU_RLAR_LADDR_Msk) | SAU_RLAR_ENABLE_Msk;
    49	
    50		SAU->CTRL = ((1U << SAU_CTRL_ENABLE_Pos) & SAU_CTRL_ENABLE_Msk);
    51	}
    52	
    53	void sau_tcm_ns_setup(void)
    54	{
    55		/* SAU and TGU Setup */
    56		SAU_TCM_NS_Setup();
    57		TGU_Setup();
    58	}
    59	#endif

