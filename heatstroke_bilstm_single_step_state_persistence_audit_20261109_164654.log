440-  for (int t = 0; t < time_steps; ++t) {
441-    std::memcpy(
442-        output_data + t * (2 * hidden) + hidden,
443-        staged_output + (time_steps - 1 - t) * hidden,
444-        hidden * sizeof(float));
445-  }
446-
447-  return kTfLiteOk;
