    26	/**
    27	 * Backend data for TensorFlow Lite Micro framework.
    28	 */
    29	struct TflmBackendData {
    30	    const tflite::Model* m_pModel{nullptr};        /**< Tflite model pointer. */
    31	    tflite::MicroAllocator* m_pAllocator{nullptr}; /**< Tflite micro allocator. */
    32	
    33	    /** Tflite interpreter. */
    34	    std::unique_ptr<tflite::MicroInterpreter> m_pInterpreter{nullptr};
    35	};
    36	
    37	/**
    38	 * @brief   NN model class wrapping the underlying TensorFlow-Lite-Micro API.
    39	 */
    40	class TflmModel : public iface::Model {
    41	public:
    42	    /** @brief Constructor. */
    43	    TflmModel();
    44	
    45	    /** @brief Destructor. */
    46	    virtual ~TflmModel() = default;
    47	
    48	    /** @brief  Gets the pointer to the model's input tensor at given input index. */
    49	    std::shared_ptr<iface::TensorIface> GetInputTensor(size_t index) const override;
    50	
    51	    /** @brief  Gets the pointer to the model's output tensor at given output index. */
    52	    std::shared_ptr<iface::TensorIface> GetOutputTensor(size_t index) const override;
    53	
    54	    /** @brief  Gets the model's data type. */
    55	    iface::TensorType GetType() const override;
    56	
    57	    /** @brief  Gets the pointer to the model's input shape. */
    58	    std::vector<size_t> GetInputShape(size_t index) const override;
    59	
    60	    /** @brief  Gets the pointer to the model's output shape at given output index. */
    61	    std::vector<size_t> GetOutputShape(size_t index) const override;
    62	
    63	    /** @brief  Gets the number of input tensors the model has. */
    64	    size_t GetNumInputs() const override;
    65	
    66	    /** @brief  Gets the number of output tensors the model has. */
    67	    size_t GetNumOutputs() const override;
    68	
    69	    /** @brief  Logs the tensor information to stdout. */
    70	    void LogTensorInfo(std::shared_ptr<iface::TensorIface> tensor) override;
    71	
    72	    /** @brief  Logs the interpreter information to stdout. */
    73	    void LogInterpreterInfo() override;
    74	
    75	    /** @brief      Initialise the model class object.
    76	     *  @return     true if initialisation succeeds, false otherwise.
    77	     **/
    78	    bool Init(iface::MemoryRegion& computeBuffer,
    79	              iface::MemoryRegion& nnModel,
    80	              const void* backendData = nullptr) override;
    81	
    82	    /** @brief  Checks if this object has been initialised. */
    83	    bool IsInited() const override;
    84	
    85	    /** @brief  Checks if the model uses signed data. */
    86	    bool IsDataSigned() const override;
    87	
    88	    /** @brief Checks if the model uses Ethos-U operator */
    89	    bool ContainsEthosUOperator() const override;
    90	
    91	    /** @brief  Runs the inference (invokes the interpreter). */
    92	    bool RunInference() override;
    93	
    94	    /**
    95	     * @brief   Gets memory region information for the backend's compute buffer.
    96	     * @return  Const reference to MemoryRegion object.
    97	     */
    98	    const iface::MemoryRegion& GetComputeBuffer() const override;
    99	
   100	    /**
   101	     * @brief   Gets memory region information for neural network model.
   102	     * @return  Const reference to MemoryRegion object.
   103	     */
   104	    const iface::MemoryRegion& GetModelBuffer() const override;
   105	
   106	    /**
   107	     * @brief       Gets TensorFlow Lite Micro backend data.
   108	     * @return      Backend data, with pointers to the model, memory allocator and interpreter.
   109	     **/
   110	    const TflmBackendData& GetBackendData() const;
   111	
   112	protected:
   113	    /**
   114	     * @brief       Gets the op resolver for the model instance.
   115	     * @return      const reference to a tflite::MicroOpResolver object.
   116	     **/
   117	    virtual const tflite::MicroOpResolver& GetOpResolver() = 0;
   118	
   119	    /**
   120	     * @brief       Add all the operators required for the given model.
   121	     *              Implementation of this should come from the use case.
   122	     * @return      true is ops are successfully added, false otherwise.
   123	     **/
   124	    virtual bool EnlistOperations() = 0;
   125	
   126	private:
   127	    TflmBackendData m_backendData{};
   128	    bool m_inited{false}; /* Indicates whether this object has been initialised. */
   129	    iface::MemoryRegion m_computeBuffer{};
   130	    iface::MemoryRegion m_modelBuffer{};
   131	
   132	    std::vector<std::shared_ptr<iface::TensorIface>> m_input{}; /* Model's input tensor pointers. */
   133	    std::vector<std::shared_ptr<iface::TensorIface>>
   134	        m_output{};                                       /* Model's output tensor pointers. */
   135	    iface::TensorType m_type{iface::TensorType::INVALID}; /* Model's data type. */
   136	};
   137	} /* namespace arm::app::fwk::tflm */
   138	
   139	#endif /* MLEK_TFLM_MODEL_HPP */

