   330	
   331	bool TflmModel::ContainsEthosUOperator() const
   332	{
   333	    /* We expect there to be only one subgraph. */
   334	    const uint32_t nOperators = tflite::NumSubgraphOperators(this->m_backendData.m_pModel, 0);
   335	    const tflite::SubGraph* subgraph = this->m_backendData.m_pModel->subgraphs()->Get(0);
   336	    const auto* opcodes              = this->m_backendData.m_pModel->operator_codes();
   337	
   338	    /* check for custom operators */
   339	    for (size_t i = 0; (i < nOperators); ++i) {
   340	        const tflite::Operator* op         = subgraph->operators()->Get(i);
   341	        const tflite::OperatorCode* opcode = opcodes->Get(op->opcode_index());
   342	
   343	        auto builtin_code = tflite::GetBuiltinCode(opcode);
   344	        if ((builtin_code == tflite::BuiltinOperator_CUSTOM) &&
   345	            (nullptr != opcode->custom_code()) &&
   346	            ("ethos-u" == std::string(opcode->custom_code()->c_str()))) {
   347	            return true;
   348	        }
   349	    }
   350	    return false;
   351	}
   352	
   353	bool TflmModel::RunInference()
   354	{
   355	    bool inference_state = false;
   356	    if (this->m_backendData.m_pModel && this->m_backendData.m_pInterpreter) {
   357	        if (kTfLiteOk != this->m_backendData.m_pInterpreter->Invoke()) {
   358	            printf_err("Invoke failed.\n");
   359	        } else {
   360	            inference_state = true;
   361	        }
   362	    } else {
   363	        printf_err("Error: No interpreter!\n");
   364	    }
   365	    return inference_state;
   366	}
