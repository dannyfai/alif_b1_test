   190	    this->m_output.resize(this->GetNumOutputs());
   191	    for (size_t outIndex = 0; outIndex < this->GetNumOutputs(); outIndex++) {
   192	        this->m_output[outIndex] =
   193	            std::make_shared<TflmTensor>(this->m_backendData.m_pInterpreter->output(outIndex));
   194	    }
   195	
   196	    if (this->m_input.empty() || this->m_output.empty()) {
   197	        printf_err("failed to get tensors\n");
   198	        return false;
   199	    } else {
   200	        this->m_type = this->m_input[0]->Type(); /* Input 0 should be the main input */
   201	
   202	        /* Clear the input & output tensors */
   203	        for (size_t inIndex = 0; inIndex < this->GetNumInputs(); inIndex++) {
   204	            std::memset(this->m_input[inIndex]->GetData(), 0, this->m_input[inIndex]->Bytes());
   205	        }
   206	        for (size_t outIndex = 0; outIndex < this->GetNumOutputs(); outIndex++) {
   207	            std::memset(this->m_output[outIndex]->GetData(), 0, this->m_output[outIndex]->Bytes());
   208	        }
   209	
   210	        this->LogInterpreterInfo();
   211	    }
   212	
   213	    this->m_inited = true;
   214	    return true;
   215	}
