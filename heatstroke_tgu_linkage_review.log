     7	#include "stdint.h"
     8	#include "soc.h"
     9	#include "tgu.h"
    10	#include "sau_tcm_ns_setup.h"
    11	
    12	/* DTCM_BASE and ITCM_BASE defines denote memory regions that might be
    13	 * offset in the actual TCM - we need to refer to the actual physical base.
    14	 */
    15	#define ITCM_PHYSICAL_BASE 0x00000000
    16	#define DTCM_PHYSICAL_BASE 0x20000000
    17	
    18	/*
    19	 * Array of NS memory regions. Add new regions to this list.
    20	 * The start and end address of the non-secure region in updated
    21	 * from the linker scripts.
    22	 */
    23	static const struct mem_region ns_regions[] = {
    24		{(uint32_t)NS_REGION_0_BASE, (uint32_t)NS_REGION_0_END - 1, DTCM},
    25	};
    26	
    27	/*----------------------------------------------------------------------------
    28	 * TGU setup function. Marks single memory region starting at NS_REGION_1_BASE
    29	 * and ending at NS_REGION_1_END as Non Secure in the TGU look up tables. The
    30	 * region should be in the DTCM area. Can be extended to include the ITCM region
    31	 * and multiple discontigous regions if needed.
    32	 *----------------------------------------------------------------------------
    33	 */
    34	void TGU_Setup(void)
    35	{
    36		uint32_t start_block, end_block, start_lut, end_lut;
    37		uint32_t start_offset, end_offset, lut_val_l, lut_val_h;
    38		uint32_t base, itcm_blksize, dtcm_blksize, blksize;
    39		uint32_t i;
    40	
    41		/* Find out the TGU block size for ITCM */
    42		blksize = *((volatile unsigned int *) ITGU_CFG) & ITGU_CFG_BLKSZ;
    43		/* ITCM blksize is 2^(blksize + 5)*/
    44		itcm_blksize = 1 << (blksize + 5);
    45	
    46		/* Find out the TGU block size for DTCM */
    47		blksize = *((volatile unsigned int *) DTGU_CFG) & DTGU_CFG_BLKSZ;
    48		/* DTCM block size is 2^(blksize + 5) */
    49		dtcm_blksize = 1 << (blksize + 5);
    50	
    51		for (i = 0; i < ARRAY_SIZE(ns_regions); i++) {
    52			if (ns_regions[i].type == DTCM) {
    53				start_block =  (ns_regions[i].start - DTCM_PHYSICAL_BASE) / dtcm_blksize;
    54				end_block = (ns_regions[i].end - DTCM_PHYSICAL_BASE) / dtcm_blksize;
    55				base = DTGU_BASE;
    56			} else {
    57				start_block =  (ns_regions[i].start - ITCM_PHYSICAL_BASE) / itcm_blksize;
    58				end_block = (ns_regions[i].end - ITCM_PHYSICAL_BASE) / itcm_blksize;
    59				base = ITGU_BASE;
    60			}
    61	
    62			start_lut = start_block / 32;
    63			end_lut = end_block / 32;
    64	
    65			start_offset = start_block % 32;
    66			end_offset = end_block % 32;
    67	
    68			if (start_lut == end_lut) {
    69				/* same LUT register */
    70				lut_val_l = SET_BIT_RANGE(start_offset, end_offset);
    71				*((volatile uint32_t *) TGU_LUT(base, start_lut)) |= lut_val_l;
    72			} else {
    73				/* the range spans multiple LUT registers */
    74				lut_val_l = SET_BIT_RANGE(start_offset, 31);
    75				lut_val_h = SET_BIT_RANGE(0, end_offset);
    76	
    77				/* Write into the first LUT register */
    78				*((volatile uint32_t *) TGU_LUT(base, start_lut)) = lut_val_l;
    79	
    80				/* Now write to all the intermediate LUT registers */
    81				while (start_lut != (end_lut - 1)) {
    82					start_lut++;
    83					*((volatile uint32_t *) TGU_LUT(base, start_lut)) = 0xFFFFFFFFU;
    84				}
    85	
    86				/* Write into the last LUT register*/
    87				*((volatile uint32_t *) TGU_LUT(base, end_lut)) |= lut_val_h;
    88			}
    89		}
    90	}

