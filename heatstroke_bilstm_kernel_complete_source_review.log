   461	TFLMRegistration RegisterHeatstrokeBidirectionalSequenceLstm() {
   462	  return micro::RegisterOp(
   463	      HeatstrokeBidirectionalLstmInit,
   464	      HeatstrokeBidirectionalLstmPrepare,
   465	      HeatstrokeBidirectionalLstmEval);
   466	}
