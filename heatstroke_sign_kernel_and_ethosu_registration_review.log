   687	 public:
   688	  TfLiteStatus AddBuiltin(tflite::BuiltinOperator op,
   689	                          const TFLMRegistration& registration,
   690	                          TfLiteBridgeBuiltinParseFunction parser) {
   691	    if (op == BuiltinOperator_CUSTOM) {
   692	      MicroPrintf("Invalid parameter BuiltinOperator_CUSTOM to the ");
   693	      MicroPrintf("AddBuiltin function.");
   694	      return kTfLiteError;
   695	    }
   696	
   697	    if (FindOp(op) != nullptr) {
   698	      MicroPrintf("Calling AddBuiltin with the same op more than ");
   699	      MicroPrintf("once is not supported (Op: #%d).", op);
   700	      return kTfLiteError;
   701	    }
   702	
   703	    if (registrations_len_ >= tOpCount) {
   704	      MicroPrintf("Couldn't register builtin op #%d, resolver size ", op);
   705	      MicroPrintf("is too small (%d).", tOpCount);
   706	      return kTfLiteError;
   707	    }
   708	
   709	    registrations_[registrations_len_] = registration;
   710	    // Strictly speaking, the builtin_code is not necessary for TFLM but
   711	    // filling it in regardless.
   712	    registrations_[registrations_len_].builtin_code = op;
   713	    registrations_len_++;
   714	
   715	    builtin_codes_[num_buitin_ops_] = op;
   716	    builtin_parsers_[num_buitin_ops_] = parser;
   717	    num_buitin_ops_++;
   718	
   719	    return kTfLiteOk;
   720	  }
   721	
   722	  TFLMRegistration registrations_[tOpCount];
   723	  unsigned int registrations_len_ = 0;
   724	
   725	  // Arrays (and counter) to store the builtin codes and their corresponding
   726	  // parse functions as these are registered with the Op Resolver.
   727	  BuiltinOperator builtin_codes_[tOpCount];
   728	  TfLiteBridgeBuiltinParseFunction builtin_parsers_[tOpCount];
   729	  unsigned int num_buitin_ops_ = 0;
   730	};
