   139	 * Keep its existing parser and implementation unchanged.
   140	 */
   141	TfLiteStatus ParseHeatstrokeBidirectionalSequenceLstm(
   142	    const tflite::Operator* op,
   143	    tflite::ErrorReporter* error_reporter,
   144	    tflite::BuiltinDataAllocator* allocator,
   145	    void** builtin_data)
   146	{
   147	    return tflite::ParseOpData(
   148	        op,
   149	        tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
   150	        error_reporter,
   151	        allocator,
   152	        builtin_data);
   153	}
