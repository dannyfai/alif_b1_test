    31	
    32	const int kSubInputTensor1 = 0;
    33	const int kSubInputTensor2 = 1;
    34	const int kSubOutputTensor = 0;
    35	
    36	TfLiteStatus CalculateOpDataSub(TfLiteContext* context, TfLiteSubParams* params,
    37	                                const TfLiteTensor* input1,
    38	                                const TfLiteTensor* input2,
    39	                                TfLiteTensor* output, OpDataSub* data) {
    40	  data->requires_broadcast = !HaveSameShapes(input1, input2);
    41	
    42	  if (output->type == kTfLiteInt8 || output->type == kTfLiteInt16) {
    43	    // 8bit -> 8bit general quantized path, with general rescalings
    44	    data->input1_offset = -input1->params.zero_point;
    45	    data->input2_offset = -input2->params.zero_point;
    46	    data->output_offset = output->params.zero_point;
    47	
    48	    // The shift is set to 15 in case of 16-bit and 20 in case of 8-bit,
    49	    // accordingly. In case of 16-bit we have 65535 << 15 which is less than 1
    50	    // << 31, therefore the addition will still fit in a 32 bit accumulator.
    51	    data->left_shift = output->type == kTfLiteInt16 ? 15 : 20;
    52	    const float twice_max_input_scale =
    53	        2 * std::max(input1->params.scale, input2->params.scale);
    54	    const double real_input1_multiplier =
    55	        static_cast<double>(input1->params.scale / twice_max_input_scale);
    56	    const double real_input2_multiplier =
    57	        static_cast<double>(input2->params.scale / twice_max_input_scale);
    58	    const double real_output_multiplier =
    59	        static_cast<double>(twice_max_input_scale /
    60	                            ((1 << data->left_shift) * output->params.scale));
    61	
    62	    QuantizeMultiplierSmallerThanOneExp(
    63	        real_input1_multiplier, &data->input1_multiplier, &data->input1_shift);
    64	
    65	    QuantizeMultiplierSmallerThanOneExp(
    66	        real_input2_multiplier, &data->input2_multiplier, &data->input2_shift);
    67	
    68	    QuantizeMultiplierSmallerThanOneExp(
    69	        real_output_multiplier, &data->output_multiplier, &data->output_shift);
    70	
    71	    TF_LITE_ENSURE_STATUS(CalculateActivationRangeQuantized(
    72	        context, params->activation, output, &data->output_activation_min,
    73	        &data->output_activation_max));
    74	  }
    75	
    76	  return kTfLiteOk;
    77	}
    78	
    79	TfLiteStatus SubPrepare(TfLiteContext* context, TfLiteNode* node) {
    80	  TFLITE_DCHECK(node->user_data != nullptr);
    81	  TFLITE_DCHECK(node->builtin_data != nullptr);
    82	
    83	  OpDataSub* data = static_cast<OpDataSub*>(node->user_data);
    84	  auto* params = reinterpret_cast<TfLiteSubParams*>(node->builtin_data);
    85	
    86	  MicroContext* micro_context = GetMicroContext(context);
    87	
    88	  TfLiteTensor* input1 =
    89	      micro_context->AllocateTempInputTensor(node, kSubInputTensor1);
    90	  TF_LITE_ENSURE(context, input1 != nullptr);
    91	  TfLiteTensor* input2 =
    92	      micro_context->AllocateTempInputTensor(node, kSubInputTensor2);
    93	  TF_LITE_ENSURE(context, input2 != nullptr);
    94	  TfLiteTensor* output =
    95	      micro_context->AllocateTempOutputTensor(node, kSubOutputTensor);
    96	  TF_LITE_ENSURE(context, output != nullptr);
    97	
    98	  TF_LITE_ENSURE_STATUS(
    99	      CalculateOpDataSub(context, params, input1, input2, output, data));
   100	
   101	  micro_context->DeallocateTempTfLiteTensor(input1);
   102	  micro_context->DeallocateTempTfLiteTensor(input2);
   103	  micro_context->DeallocateTempTfLiteTensor(output);
   104	  return kTfLiteOk;
   105	}
