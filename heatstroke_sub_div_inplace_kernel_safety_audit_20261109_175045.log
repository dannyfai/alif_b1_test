    34	void* SubInit(TfLiteContext* context, const char* buffer, size_t length) {
    35	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
    36	  return context->AllocatePersistentBuffer(context, sizeof(OpDataSub));
    37	}
    38	
    39	void EvalSub(TfLiteContext* context, TfLiteNode* node, TfLiteSubParams* params,
    40	             const OpDataSub* data, const TfLiteEvalTensor* input1,
    41	             const TfLiteEvalTensor* input2, TfLiteEvalTensor* output) {
    42	  float output_activation_min, output_activation_max;
    43	  CalculateActivationRange(params->activation, &output_activation_min,
    44	                           &output_activation_max);
    45	  tflite::ArithmeticParams op_params;
    46	  SetActivationParams(output_activation_min, output_activation_max, &op_params);
    47	  if (data->requires_broadcast) {
    48	    tflite::reference_ops::BroadcastSubSlow(
    49	        op_params, tflite::micro::GetTensorShape(input1),
    50	        tflite::micro::GetTensorData<float>(input1),
    51	        tflite::micro::GetTensorShape(input2),
    52	        tflite::micro::GetTensorData<float>(input2),
    53	        tflite::micro::GetTensorShape(output),
    54	        tflite::micro::GetTensorData<float>(output));
    55	  } else {
    56	    tflite::reference_ops::SubWithActivation(
    57	        op_params, tflite::micro::GetTensorShape(input1),
    58	        tflite::micro::GetTensorData<float>(input1),
    59	        tflite::micro::GetTensorShape(input2),
    60	        tflite::micro::GetTensorData<float>(input2),
    61	        tflite::micro::GetTensorShape(output),
    62	        tflite::micro::GetTensorData<float>(output));
    63	  }
    64	}
    65	
    66	TfLiteStatus EvalSubQuantized(TfLiteContext* context, TfLiteNode* node,
    67	                              TfLiteSubParams* params, const OpDataSub* data,
    68	                              const TfLiteEvalTensor* input1,
    69	                              const TfLiteEvalTensor* input2,
    70	                              TfLiteEvalTensor* output) {
    71	  tflite::ArithmeticParams op_params;
    72	  op_params.left_shift = data->left_shift;
    73	  op_params.input1_offset = data->input1_offset;
    74	  op_params.input1_multiplier = data->input1_multiplier;
    75	  op_params.input1_shift = data->input1_shift;
    76	  op_params.input2_offset = data->input2_offset;
    77	  op_params.input2_multiplier = data->input2_multiplier;
    78	  op_params.input2_shift = data->input2_shift;
    79	  op_params.output_offset = data->output_offset;
    80	  op_params.output_multiplier = data->output_multiplier;
    81	  op_params.output_shift = data->output_shift;
    82	  SetActivationParams(data->output_activation_min, data->output_activation_max,
    83	                      &op_params);
    84	  bool need_broadcast = reference_ops::ProcessBroadcastShapes(
    85	      tflite::micro::GetTensorShape(input1),
    86	      tflite::micro::GetTensorShape(input2), &op_params);
    87	
    88	  switch (output->type) {
    89	    case kTfLiteInt8: {
    90	      if (need_broadcast) {
    91	        tflite::reference_ops::BroadcastQuantSubSlow(
    92	            op_params, tflite::micro::GetTensorShape(input1),
    93	            tflite::micro::GetTensorData<int8_t>(input1),
    94	            tflite::micro::GetTensorShape(input2),
    95	            tflite::micro::GetTensorData<int8_t>(input2),
    96	            tflite::micro::GetTensorShape(output),
    97	            tflite::micro::GetTensorData<int8_t>(output));
    98	      } else {
    99	        tflite::reference_ops::Sub(
   100	            op_params, tflite::micro::GetTensorShape(input1),
   101	            tflite::micro::GetTensorData<int8_t>(input1),
   102	            tflite::micro::GetTensorShape(input2),
   103	            tflite::micro::GetTensorData<int8_t>(input2),
   104	            tflite::micro::GetTensorShape(output),
   105	            tflite::micro::GetTensorData<int8_t>(output));
   106	      }
   107	      break;
   108	    }
   109	    case kTfLiteInt16: {
   110	      if (need_broadcast) {
   111	        tflite::reference_ops::BroadcastQuantSubSlow(
   112	            op_params, tflite::micro::GetTensorShape(input1),
   113	            tflite::micro::GetTensorData<int16_t>(input1),
   114	            tflite::micro::GetTensorShape(input2),
   115	            tflite::micro::GetTensorData<int16_t>(input2),
   116	            tflite::micro::GetTensorShape(output),
   117	            tflite::micro::GetTensorData<int16_t>(output));
   118	      } else {
   119	        tflite::reference_ops::Sub(
   120	            op_params, tflite::micro::GetTensorShape(input1),
   121	            tflite::micro::GetTensorData<int16_t>(input1),
   122	            tflite::micro::GetTensorShape(input2),
   123	            tflite::micro::GetTensorData<int16_t>(input2),
   124	            tflite::micro::GetTensorShape(output),
   125	            tflite::micro::GetTensorData<int16_t>(output));
   126	      }
   127	      break;
   128	    }
   129	    default:
   130	      MicroPrintf("Quantized type %s not currently supported.",
   131	                  TfLiteTypeGetName(output->type));
   132	      return kTfLiteError;
   133	  }
   134	  return kTfLiteOk;
   135	}
   136	
   137	TfLiteStatus SubEval(TfLiteContext* context, TfLiteNode* node) {
   138	  auto* params = reinterpret_cast<TfLiteSubParams*>(node->builtin_data);
   139	
   140	  const TfLiteEvalTensor* input1 =
   141	      tflite::micro::GetEvalInput(context, node, kSubInputTensor1);
   142	  const TfLiteEvalTensor* input2 =
   143	      tflite::micro::GetEvalInput(context, node, kSubInputTensor2);
   144	  TfLiteEvalTensor* output =
   145	      tflite::micro::GetEvalOutput(context, node, kSubOutputTensor);
   146	
   147	  TFLITE_DCHECK(node->user_data != nullptr);
   148	  const OpDataSub& data = *(static_cast<const OpDataSub*>(node->user_data));
   149	
   150	  if (output->type == kTfLiteFloat32) {
   151	    EvalSub(context, node, params, &data, input1, input2, output);
   152	  } else if (output->type == kTfLiteInt8 || output->type == kTfLiteInt16) {
   153	    TF_LITE_ENSURE_OK(context, EvalSubQuantized(context, node, params, &data,
   154	                                                input1, input2, output));
   155	  } else {
   156	    MicroPrintf("Type %s (%d) not supported.", TfLiteTypeGetName(output->type),
   157	                output->type);
   158	    return kTfLiteError;
   159	  }
   160	
   161	  return kTfLiteOk;
   162	}
   163	
   164	TFLMRegistration Register_SUB() {
   165	  return tflite::micro::RegisterOp(SubInit, SubPrepare, SubEval);
   166	}
