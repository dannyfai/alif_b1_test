     1	#!/usr/bin/env python3
     2	
     3	from pathlib import Path
     4	import onnx
     5	from onnx import checker
     6	
     7	SOURCE = Path(
     8	    "export/layernorm_variance_eps_variants/"
     9	    "qdq_both_variance_eps_preprocess_fp32_v2.onnx"
    10	)
    11	
    12	OUTPUT = Path(
    13	    "export/layernorm_variance_eps_variants/"
    14	    "qdq_both_variance_eps_preprocess_fp32_v2_conv1_output_bypass.onnx"
    15	)
    16	
    17	BYPASS = {
    18	    "conv1d_1_DequantizeLinear_Output_1": "conv1d_1",
    19	    "conv1d_1_DequantizeLinear_Output_2": "conv1d_1",
    20	}
    21	
    22	REMOVE_NODES = {
    23	    "conv1d_1_QuantizeLinear_1",
    24	    "conv1d_1_DequantizeLinear_1",
    25	    "conv1d_1_QuantizeLinear_2",
    26	    "conv1d_1_DequantizeLinear_2",
    27	}
    28	
    29	
    30	def main():
    31	    if not SOURCE.exists():
    32	        raise FileNotFoundError(SOURCE)
    33	
    34	    if OUTPUT.exists():
    35	        raise FileExistsError(
    36	            f"Refusing to overwrite existing diagnostic model: {OUTPUT}"
    37	        )
    38	
    39	    model = onnx.load(str(SOURCE))
    40	    graph = model.graph
    41	
    42	    node_names = {node.name for node in graph.node}
    43	    missing_nodes = REMOVE_NODES - node_names
    44	    if missing_nodes:
    45	        raise RuntimeError(
    46	            f"Expected QDQ nodes not found: {sorted(missing_nodes)}"
    47	        )
    48	
    49	    # Verify the two DQ outputs are produced by the expected nodes.
    50	    dq_producers = {}
    51	    for node in graph.node:
    52	        for output in node.output:
    53	            dq_producers[output] = node
    54	
    55	    for dq_output in BYPASS:
    56	        producer = dq_producers.get(dq_output)
    57	        if producer is None:
    58	            raise RuntimeError(f"No producer found for {dq_output}")
    59	        if producer.op_type != "DequantizeLinear":
    60	            raise RuntimeError(
    61	                f"{dq_output} is produced by {producer.op_type}, "
    62	                "not DequantizeLinear"
    63	            )
    64	
    65	    # Rewire every consumer of each DQ output to the original FP32 Conv1 output.
    66	    rewired = {}
    67	    for node in graph.node:
    68	        if node.name in REMOVE_NODES:
    69	            continue
    70	
    71	        for i, input_name in enumerate(node.input):
    72	            if input_name in BYPASS:
    73	                replacement = BYPASS[input_name]
    74	                node.input[i] = replacement
    75	                rewired.setdefault(input_name, []).append(
    76	                    (node.name, i, replacement)
    77	                )
    78	
    79	    # Confirm both branches were actually connected to downstream consumers.
    80	    for dq_output in BYPASS:
    81	        if dq_output not in rewired:
    82	            raise RuntimeError(
    83	                f"No downstream consumer was rewired for {dq_output}"
    84	            )
    85	
    86	    # Remove the two QuantizeLinear and two DequantizeLinear nodes.
    87	    kept_nodes = [
    88	        node for node in graph.node
    89	        if node.name not in REMOVE_NODES
    90	    ]
    91	
    92	    removed_count = len(graph.node) - len(kept_nodes)
    93	    if removed_count != 4:
    94	        raise RuntimeError(
    95	            f"Expected to remove 4 QDQ nodes, removed {removed_count}"
    96	        )
    97	
    98	    del graph.node[:]
    99	    graph.node.extend(kept_nodes)
   100	
   101	    checker.check_model(model, full_check=True)
   102	    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
   103	    onnx.save(model, str(OUTPUT))
   104	
   105	    # Reload and check the saved artifact.
   106	    saved = onnx.load(str(OUTPUT))
   107	    checker.check_model(saved, full_check=True)
   108	
   109	    print("=" * 80)
   110	    print("CONV1 OUTPUT QDQ BYPASS")
   111	    print("=" * 80)
   112	    print(f"Source: {SOURCE}")
   113	    print(f"Output: {OUTPUT}")
   114	    print("\nRewired consumers:")
   115	    for dq_output, consumers in rewired.items():
   116	        print(f"\n  {dq_output} -> {BYPASS[dq_output]}")
   117	        for node_name, input_index, replacement in consumers:
   118	            print(
   119	                f"    {node_name}, input[{input_index}] -> {replacement}"
   120	            )
   121	
   122	    print("\nRemoved nodes:")
   123	    for name in sorted(REMOVE_NODES):
   124	        print(f"  {name}")
   125	
   126	    print(f"\nRemoved node count: {removed_count}")
   127	    print("ONNX checker: PASSED")
   128	    print("Saved diagnostic model successfully.")
   129	
   130	
   131	if __name__ == "__main__":
   132	    main()

=== LAYERNORM QDQ VARIANT GENERATION ===
