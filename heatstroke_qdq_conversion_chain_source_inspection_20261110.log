     2	#!/usr/bin/env python3
     3	
     4	from pathlib import Path
     5	
     6	import onnx
     7	
     8	
     9	SOURCE = Path(
    10	    "export/layernorm_variance_eps_variants/"
    11	    "qdq_both_variance_eps_fp32.onnx"
    12	)
    13	
    14	OUTPUT_DIR = Path(
    15	    "export/first_layernorm_qdq_variants"
    16	)
    17	
    18	TARGETS = {
    19	    "variance": "node_layer_norm_variance",
    20	    "normalized": "node_layer_norm_normalized",
    21	}
    22	
    23	VARIANTS = {
    24	    "variance_fp32": ["variance"],
    25	    "normalized_fp32": ["normalized"],
    26	    "variance_normalized_fp32": [
    27	        "variance",
    28	        "normalized",
    29	    ],
    30	}
    31	
    32	
    33	def bypass_qdq(model, tensor_name):
    34	    nodes = list(model.graph.node)
    35	
    36	    quantize_node = None
    37	    dequantize_node = None
    38	
    39	    for node in nodes:
    40	        if (
    41	            node.op_type == "QuantizeLinear"
    42	            and len(node.input) >= 1
    43	            and node.input[0] == tensor_name
    44	        ):
    45	            quantize_node = node
    46	            break
    47	
    48	    if quantize_node is None:
    49	        raise RuntimeError(
    50	            f"QuantizeLinear not found for {tensor_name}"
    51	        )
    52	
    53	    quantized_tensor = quantize_node.output[0]
    54	
    55	    for node in nodes:
    56	        if (
    57	            node.op_type == "DequantizeLinear"
    58	            and len(node.input) >= 1
    59	            and node.input[0] == quantized_tensor
    60	        ):
    61	            dequantize_node = node
    62	            break
    63	
    64	    if dequantize_node is None:
    65	        raise RuntimeError(
    66	            f"Matching DequantizeLinear not found "
    67	            f"for {tensor_name}"
    68	        )
    69	
    70	    dequantized_tensor = dequantize_node.output[0]
    71	
    72	    # Replace consumers of the DQ output with the original
    73	    # floating-point tensor.
    74	    rewired = 0
    75	
    76	    for node in model.graph.node:
    77	        if node is quantize_node or node is dequantize_node:
    78	            continue
    79	
    80	        for index, input_name in enumerate(node.input):
    81	            if input_name == dequantized_tensor:
    82	                node.input[index] = tensor_name
    83	                rewired += 1
    84	
    85	    # Also handle graph outputs, if applicable.
    86	    for output in model.graph.output:
    87	        if output.name == dequantized_tensor:
    88	            output.name = tensor_name
    89	
    90	    if rewired == 0:
    91	        raise RuntimeError(
