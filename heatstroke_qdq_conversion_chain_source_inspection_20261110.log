   117	    model.graph.initializer.append(
   118	        numpy_helper.from_array(
   119	            np.asarray(1.0, dtype=np.float32),
   120	            name=clip_min_name,
   121	        )
   122	    )
   123	
   124	    print("\nClip minimum restored:")
   125	    print(f"  {clip_min_name} = 1.0 (FP32)")
   126	
   127	    # ------------------------------------------------------------
   128	    # 3. Remove only the QDQ nodes belonging to this branch.
   129	    #
   130	    # Binary mask QDQ is intentionally retained.
   131	    # ------------------------------------------------------------
