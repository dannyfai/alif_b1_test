     1	import onnx
     2	import numpy as np
     3	from onnx import numpy_helper
     4	
     5	
     6	SOURCE = (
     7	    "export/layernorm_variance_eps_variants/"
     8	    "qdq_both_variance_eps_fp32.onnx"
     9	)
    10	
    11	OUTPUT = (
    12	    "export/layernorm_variance_eps_variants/"
    13	    "qdq_both_variance_eps_preprocess_fp32_v2.onnx"
    14	)
    15	
    16	
    17	def main():
    18	    print("=" * 90)
    19	    print("CREATE FP32 PREPROCESSING BRANCH VARIANT")
    20	    print("=" * 90)
    21	
    22	    model = onnx.load(SOURCE)
    23	
    24	    # ------------------------------------------------------------
    25	    # 1. Rewire QDQ outputs to their original FP32 tensors.
    26	    # ------------------------------------------------------------
    27	
    28	    rewires = {
    29	        "x_values_DequantizeLinear_Output_1": "x_values",
    30	        "x_values_DequantizeLinear_Output_2": "x_values",
    31	        "mul_3_DequantizeLinear_Output": "mul_3",
    32	        "sum_2_DequantizeLinear_Output": "sum_2",
    33	        "clamp_2_DequantizeLinear_Output": "clamp_2",
    34	        "sum_3_DequantizeLinear_Output": "sum_3",
    35	        "div_1_DequantizeLinear_Output": "div_1",
    36	        "expand_3_DequantizeLinear_Output": "expand_3",
    37	    }
    38	
    39	    all_names = set()
    40	
    41	    for node in model.graph.node:
    42	        all_names.update(node.input)
    43	        all_names.update(node.output)
    44	
    45	    for old, new in rewires.items():
    46	        if old not in all_names:
    47	            raise RuntimeError(
    48	                f"Expected tensor not found: {old}"
    49	            )
    50	
    51	        if new not in all_names:
    52	            raise RuntimeError(
    53	                f"Replacement tensor not found: {new}"
    54	            )
    55	
    56	    replacement_counts = {}
    57	
    58	    for node in model.graph.node:
    59	        for i, name in enumerate(node.input):
    60	            if name in rewires:
    61	                node.input[i] = rewires[name]
    62	
    63	                replacement_counts[name] = (
    64	                    replacement_counts.get(name, 0) + 1
    65	                )
    66	
    67	    print("\nRewired tensors:")
    68	
    69	    for old, new in rewires.items():
    70	        count = replacement_counts.get(old, 0)
    71	
    72	        if count == 0:
    73	            raise RuntimeError(
    74	                f"No consumer was rewired for {old}"
    75	            )
    76	
    77	        print(f"  {old} -> {new}: {count} consumer(s)")
    78	
    79	    # ------------------------------------------------------------
    80	    # 2. Restore the original FP32 Clip minimum.
    81	    #
    82	    # val_110_quantized = 127
    83	    # zero_point = -128
    84	    # scale = 0.003921569
    85	    #
    86	    # Therefore, the original value is approximately 1.0.
    87	    # ------------------------------------------------------------
    88	
    89	    clip_nodes = [
    90	        node
    91	        for node in model.graph.node
    92	        if node.name == "node_clamp_2"
    93	    ]
    94	
    95	    if len(clip_nodes) != 1:
    96	        raise RuntimeError(
    97	            f"Expected one node_clamp_2, found {len(clip_nodes)}"
    98	        )
    99	
   100	    clip = clip_nodes[0]
   101	
   102	    if len(clip.input) < 2:
   103	        raise RuntimeError("Unexpected Clip input count")
   104	
   105	    clip_min_name = "preprocess_clip_min_fp32"
   106	
   107	    if any(
   108	        item.name == clip_min_name
   109	        for item in model.graph.initializer
   110	    ):
   111	        raise RuntimeError(
   112	            f"Initializer already exists: {clip_min_name}"
   113	        )
   114	
   115	    clip.input[1] = clip_min_name
