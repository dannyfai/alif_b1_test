   174	void* HeatstrokeBidirectionalLstmInit(TfLiteContext* context,
   175	                                      const char* buffer,
   176	                                      size_t length) {
   177	  (void)buffer;
   178	  (void)length;
   179	
   180	  auto* data = static_cast<HeatstrokeBidirectionalLstmOpData*>(
   181	      context->AllocatePersistentBuffer(
   182	          context, sizeof(HeatstrokeBidirectionalLstmOpData)));
   183	
   184	  if (data != nullptr) {
   185	    std::memset(data, 0, sizeof(*data));
   186	  }
   187	  return data;
   188	}
