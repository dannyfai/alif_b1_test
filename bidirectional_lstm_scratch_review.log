   357	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   358	                                             TfLiteNode* node) {
   359	  if (node == nullptr || node->user_data == nullptr) {
   360	    return kTfLiteError;
   361	  }
   362	
   363	  const auto* op_data =
   364	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   365	
   366	  const TfLiteEvalTensor* input =
   367	      GetInputEvalTensor(context, node, 0);
   368	
   369	  TfLiteEvalTensor* output =
   370	      context->GetEvalTensor(context, node->outputs->data[0]);
   371	
   372	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   373	    return kTfLiteError;
   374	  }
   375	
   376	  const int time_steps = op_data->forward.size_info.time_steps;
   377	  const int input_dimension = op_data->forward.size_info.input_dimension;
   378	  const int hidden = op_data->forward.size_info.state_dimension;
   379	
   380	  auto* reversed_input = static_cast<float*>(
   381	      context->GetScratchBuffer(
   382	          context, op_data->reverse_input_buffer));
   383	
   384	  auto* staged_output = static_cast<float*>(
   385	      context->GetScratchBuffer(
   386	          context, op_data->stage_output_buffer));
   387	
   388	  if (reversed_input == nullptr || staged_output == nullptr) {
   389	    MicroPrintf("Heatstroke BiLSTM: scratch buffer unavailable");
   390	    return kTfLiteError;
   391	  }
   392	
   393	  const float* input_data = input->data.f;
   394	  float* output_data = output->data.f;
   395	
   396	  // Reverse the time dimension for the backward direction.
   397	  for (int t = 0; t < time_steps; ++t) {
   398	    std::memcpy(
   399	        reversed_input + t * input_dimension,
   400	        input_data + (time_steps - 1 - t) * input_dimension,
   401	        input_dimension * sizeof(float));
   402	  }
   403	
   404	  TfLiteEvalTensor reversed_input_tensor = *input;
   405	  reversed_input_tensor.data.f = reversed_input;
   406	
   407	  TfLiteEvalTensor staged_output_tensor = *output;
   408	  staged_output_tensor.data.f = staged_output;
   409	  staged_output_tensor.dims = op_data->staged_output_dims;
   410	
   411	  LSTMKernelContents forward_contents{};
   412	  PopulateDirectionContents(
   413	      context, node, 0, 35, 36,
   414	      input, &staged_output_tensor, &forward_contents);
   415	
   416	  LSTMBuffers<float> buffers =
   417	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   418	
   419	  TF_LITE_ENSURE_STATUS(
   420	      EvalLstm<float, float, float, float>(
   421	          op_data->forward, forward_contents, buffers));
   422	
   423	  // Copy forward outputs into the first half of the merged output.
   424	  for (int t = 0; t < time_steps; ++t) {
   425	    std::memcpy(
   426	        output_data + t * (2 * hidden),
   427	        staged_output + t * hidden,
   428	        hidden * sizeof(float));
   429	  }
   430	
   431	  LSTMKernelContents backward_contents{};
   432	  PopulateDirectionContents(
   433	      context, node, 17, 37, 38,
   434	      &reversed_input_tensor, &staged_output_tensor,
   435	      &backward_contents);
   436	
   437	  TF_LITE_ENSURE_STATUS(
   438	      EvalLstm<float, float, float, float>(
   439	          op_data->backward, backward_contents, buffers));
   440	
   441	  // Restore backward outputs to original time order and copy them
   442	  // into the second half of the merged output.
   443	  for (int t = 0; t < time_steps; ++t) {
   444	    std::memcpy(
   445	        output_data + t * (2 * hidden) + hidden,
   446	        staged_output + (time_steps - 1 - t) * hidden,
   447	        hidden * sizeof(float));
   448	  }
   449	
   450	  return kTfLiteOk;
   451	}
