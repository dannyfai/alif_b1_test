   143	void InitializeFloatLstmParameters(
   144	    OpDataLSTM* op_data,
   145	    bool time_major,
   146	    int batch_size,
   147	    int time_steps,
   148	    int input_dimension,
   149	    int hidden_dimension,
   150	    TfLiteFusedActivation activation,
   151	    float cell_clip) {
   152	  op_data->size_info.time_major = time_major;
   153	  op_data->size_info.batch_size = batch_size;
   154	  op_data->size_info.time_steps = time_steps;
   155	  op_data->size_info.input_dimension = input_dimension;
   156	  op_data->size_info.state_dimension = hidden_dimension;
   157	
   158	  op_data->cell_gate_nonlinear_type = activation;
   159	  op_data->cell_state_info = CreateLstmCellStateInfoFloat(cell_clip);
   160	
   161	  op_data->forget_gate_parameters = CreateGateParamsFloat();
   162	  op_data->input_gate_parameters = CreateGateParamsFloat();
   163	  op_data->cell_gate_parameters = CreateGateParamsFloat();
   164	  op_data->output_gate_parameters = CreateGateParamsFloat();
   165	
   166	  op_data->inter_gate_parameters.forget_cell_mul_params =
   167	      CreateInterGateMulParamsFloat();
   168	  op_data->inter_gate_parameters.input_mul_params =
   169	      CreateInterGateMulParamsFloat();
   170	  op_data->inter_gate_parameters.output_mul_params =
   171	      CreateInterGateMulParamsFloat();
   172	}
