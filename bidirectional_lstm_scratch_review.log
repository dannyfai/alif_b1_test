   455	TFLMRegistration RegisterHeatstrokeBidirectionalSequenceLstm() {
   456	  return micro::RegisterOp(
   457	      HeatstrokeBidirectionalLstmInit,
   458	      HeatstrokeBidirectionalLstmPrepare,
   459	      HeatstrokeBidirectionalLstmEval);
