   329	void PopulateDirectionContents(TfLiteContext* context,
   330	                               TfLiteNode* node,
   331	                               int parameter_base,
   332	                               int hidden_state_position,
   333	                               int cell_state_position,
   334	                               const TfLiteEvalTensor* input,
   335	                               TfLiteEvalTensor* staged_output,
   336	                               LSTMKernelContents* contents) {
   337	  for (int i = 0; i < 24; ++i) {
   338	    contents->internal_tensors[i] = nullptr;
   339	  }
   340	
   341	  contents->internal_tensors[0] =
   342	      const_cast<TfLiteEvalTensor*>(input);
   343	
   344	  for (int i = 1; i <= 17; ++i) {
   345	    contents->internal_tensors[i] =
   346	        GetInputEvalTensor(context, node, parameter_base + i);
   347	  }
   348	
   349	  contents->internal_tensors[18] =
   350	      GetInputEvalTensor(context, node, hidden_state_position);
   351	  contents->internal_tensors[19] =
   352	      GetInputEvalTensor(context, node, cell_state_position);
   353	
   354	  contents->output_tensor = staged_output;
   355	}
