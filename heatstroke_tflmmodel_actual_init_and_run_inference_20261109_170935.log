   232	
   233	void TflmModel::LogTensorInfo(std::shared_ptr<iface::TensorIface> tensor)
   234	{
   235	    if (!tensor) {
   236	        printf_err("Invalid tensor\n");
   237	        assert(tensor);
   238	        return;
   239	    }
   240	
   241	    debug("\ttensor is assigned to 0x%p\n", tensor.get());
   242	    info("\ttensor type is %s\n", GetTensorDataTypeName(tensor->Type()));
   243	    info("\ttensor occupies %zu bytes with dimensions\n", tensor->Bytes());
   244	    const auto shape = tensor->Shape();
   245	    for (size_t i = 0; i < shape.size(); ++i) {
   246	        info("\t\t%zu: %3d\n", i, static_cast<int>(shape[i]));
   247	    }
   248	
   249	    const auto quant = tensor->GetQuantParams();
   250	    info("Scale = %f\n", quant.scale);
   251	    info("ZeroPoint = %d\n", quant.offset);
   252	}
   253	
   254	void TflmModel::LogInterpreterInfo()
   255	{
   256	    if (!this->m_backendData.m_pInterpreter) {
   257	        printf_err("Invalid interpreter\n");
   258	        return;
   259	    }
   260	
   261	    info("Model INPUT tensors: \n");
   262	    for (auto& input : this->m_input) {
   263	        this->LogTensorInfo(input);
   264	    }
   265	
   266	    info("Model OUTPUT tensors: \n");
   267	    for (auto& output : this->m_output) {
   268	        this->LogTensorInfo(output);
   269	    }
   270	
   271	    info("Activation buffer (a.k.a tensor arena) size used: %zu\n",
   272	         this->m_backendData.m_pInterpreter->arena_used_bytes());
   273	
   274	    /* We expect there to be only one subgraph. */
   275	    const uint32_t nOperators = tflite::NumSubgraphOperators(this->m_backendData.m_pModel, 0);
   276	    info("Number of operators: %" PRIu32 "\n", nOperators);
   277	
   278	    const tflite::SubGraph* subgraph = this->m_backendData.m_pModel->subgraphs()->Get(0);
   279	
   280	    auto* opcodes = this->m_backendData.m_pModel->operator_codes();
   281	
   282	    /* For each operator, display registration information. */
   283	    for (size_t i = 0; i < nOperators; ++i) {
   284	        const tflite::Operator* op         = subgraph->operators()->Get(i);
   285	        const tflite::OperatorCode* opcode = opcodes->Get(op->opcode_index());
   286	        const TFLMRegistration* reg        = nullptr;
   287	
   288	        tflite::GetRegistrationFromOpCode(opcode, this->GetOpResolver(), &reg);
   289	        std::string opName;
   290	
   291	        if (reg) {
   292	            if (tflite::BuiltinOperator_CUSTOM == reg->builtin_code) {
   293	                opName = std::string(reg->custom_name);
   294	            } else {
   295	                opName = std::string(
   296	                    EnumNameBuiltinOperator(tflite::BuiltinOperator(reg->builtin_code)));
   297	            }
   298	        }
   299	        info("\tOperator %zu: %s\n", i, opName.c_str());
   300	    }
   301	
   302	    if (this->ContainsEthosUOperator()) {
   303	        const std::string mode = InferNpuMemoryModeFromEthosUOp(this->m_backendData.m_pModel);
   304	        if (!mode.empty()) {
   305	            info("NPU memory mode likely to be: %s\n", mode.c_str());
   306	        } else {
   307	            warn("Unable to infer NPU memory mode.\n");
   308	        }
   309	    }
   310	}
