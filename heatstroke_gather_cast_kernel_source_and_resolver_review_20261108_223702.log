    28	TfLiteStatus CastPrepare(TfLiteContext* context, TfLiteNode* node) {
    29	  TF_LITE_ENSURE_EQ(context, NumInputs(node), 1);
    30	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
    31	
    32	  MicroContext* micro_context = GetMicroContext(context);
    33	
    34	  TfLiteTensor* input =
    35	      micro_context->AllocateTempInputTensor(node, kInputTensor);
    36	  TF_LITE_ENSURE(context, input != nullptr);
    37	  TfLiteTensor* output =
    38	      micro_context->AllocateTempOutputTensor(node, kOutputTensor);
    39	  TF_LITE_ENSURE(context, output != nullptr);
    40	
    41	  micro_context->DeallocateTempTfLiteTensor(input);
    42	  micro_context->DeallocateTempTfLiteTensor(output);
    43	
    44	  return kTfLiteOk;
    45	}
    46	
    47	template <typename FromT, typename ToT>
    48	void copyCast(const FromT* in, ToT* out, int num_elements) {
    49	  std::transform(in, in + num_elements, out,
    50	                 [](FromT a) { return static_cast<ToT>(a); });
    51	}
    52	
    53	template <typename FromT>
    54	TfLiteStatus copyToTensor(TfLiteContext* context, const FromT* in,
    55	                          TfLiteEvalTensor* out, int num_elements) {
    56	  switch (out->type) {
    57	    case kTfLiteInt8:
    58	      copyCast(in, out->data.int8, num_elements);
    59	      break;
    60	    case kTfLiteInt16:
    61	      copyCast(in, out->data.i16, num_elements);
    62	      break;
    63	    case kTfLiteInt32:
    64	      copyCast(in, out->data.i32, num_elements);
    65	      break;
    66	    case kTfLiteUInt32:
    67	      copyCast(in, out->data.u32, num_elements);
    68	      break;
    69	    case kTfLiteFloat32:
    70	      copyCast(in, tflite::micro::GetTensorData<float>(out), num_elements);
    71	      break;
    72	    default:
    73	      // Unsupported type.
    74	      MicroPrintf("Output type %s (%d) not supported.",
    75	                  TfLiteTypeGetName(out->type), out->type);
    76	  }
    77	  return kTfLiteOk;
    78	}
    79	
    80	TfLiteStatus CastEval(TfLiteContext* context, TfLiteNode* node) {
    81	  const TfLiteEvalTensor* input =
    82	      tflite::micro::GetEvalInput(context, node, kInputTensor);
    83	  TfLiteEvalTensor* output =
    84	      tflite::micro::GetEvalOutput(context, node, kOutputTensor);
    85	  int num_elements = MatchingFlatSize(tflite::micro::GetTensorShape(input),
    86	                                      tflite::micro::GetTensorShape(output));
    87	
    88	  switch (input->type) {
    89	    case kTfLiteInt8:
    90	      return copyToTensor(context, input->data.int8, output, num_elements);
    91	    case kTfLiteInt16:
    92	      return copyToTensor(context, tflite::micro::GetTensorData<int16_t>(input),
    93	                          output, num_elements);
    94	    case kTfLiteInt32:
    95	      return copyToTensor(context, tflite::micro::GetTensorData<int32_t>(input),
    96	                          output, num_elements);
    97	    case kTfLiteUInt32:
    98	      return copyToTensor(context,
    99	                          tflite::micro::GetTensorData<uint32_t>(input), output,
   100	                          num_elements);
   101	    case kTfLiteFloat32:
   102	      return copyToTensor(context, tflite::micro::GetTensorData<float>(input),
   103	                          output, num_elements);
   104	    case kTfLiteBool:
   105	      return copyToTensor(context, tflite::micro::GetTensorData<bool>(input),
   106	                          output, num_elements);
   107	    default:
   108	      // Unsupported type.
   109	      MicroPrintf("Input type %s (%d) not supported.",
   110	                  TfLiteTypeGetName(input->type), input->type);
   111	  }
   112	  return kTfLiteOk;
   113	}
   114	}  // namespace
