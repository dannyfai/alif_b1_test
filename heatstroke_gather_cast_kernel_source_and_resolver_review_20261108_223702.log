   100	TfLiteStatus GatherPrepare(TfLiteContext* context, TfLiteNode* node) {
   101	  MicroContext* micro_context = GetMicroContext(context);
   102	
   103	  TF_LITE_ENSURE_EQ(context, NumInputs(node), 2);
   104	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
   105	
   106	  const auto* params =
   107	      reinterpret_cast<const TfLiteGatherParams*>(node->builtin_data);
   108	  TfLiteTensor* input =
   109	      micro_context->AllocateTempInputTensor(node, kInputTensor);
   110	  TF_LITE_ENSURE(context, input != nullptr);
   111	  TfLiteTensor* coords =
   112	      micro_context->AllocateTempInputTensor(node, kInputPositions);
   113	  TF_LITE_ENSURE(context, coords != nullptr);
   114	  TfLiteTensor* output =
   115	      micro_context->AllocateTempOutputTensor(node, kOutputTensor);
   116	  TF_LITE_ENSURE(context, output != nullptr);
   117	
   118	  switch (coords->type) {
   119	    case kTfLiteInt32:
   120	      break;
   121	    default:
   122	      MicroPrintf("Positions of type '%s' are not supported by gather.",
   123	                  TfLiteTypeGetName(coords->type));
   124	      return kTfLiteError;
   125	      break;
   126	  }
   127	
   128	  // Assign to output the input type.
   129	  output->type = input->type;
   130	
   131	  // Check conditions for different types.
   132	  switch (input->type) {
   133	    case kTfLiteFloat32:
   134	    case kTfLiteInt8:
   135	      break;
   136	    default:
   137	      MicroPrintf("Type '%s' is not supported by gather.",
   138	                  TfLiteTypeGetName(input->type));
   139	      return kTfLiteError;
   140	      break;
   141	  }
   142	
   143	  int axis = params->axis;
   144	  if (axis < 0) {
   145	    axis += NumDimensions(input);
   146	  }
   147	  TF_LITE_ENSURE(context, 0 <= axis && axis < NumDimensions(input));
   148	
   149	  int batch_dims = params->batch_dims;
   150	  // batch_dims should be in range: [-rank(coords), rank(coords)].
   151	  // Negative batch_dims is added with rank of coords.
   152	  if (batch_dims < 0) {
   153	    batch_dims += NumDimensions(coords);
   154	  }
   155	  TF_LITE_ENSURE(context, batch_dims <= axis);
   156	  TF_LITE_ENSURE(context, 0 <= batch_dims && batch_dims < NumDimensions(input));
   157	  TF_LITE_ENSURE(context, batch_dims <= NumDimensions(coords));
   158	  for (int i = 0; i < batch_dims; ++i) {
   159	    TF_LITE_ENSURE_EQ(context, input->dims->data[i], coords->dims->data[i]);
   160	  }
   161	
   162	  // GATHER updates the output tensor dimensions, but TfLiteTensor in the
   163	  // MicroInterpreter is a temporary allocation. We must therefore relocate the
   164	  // dims from the FlatBuffer to the persistent storage arena.
   165	  TfLiteEvalTensor* output_eval =
   166	      tflite::micro::GetEvalOutput(context, node, kOutputTensor);
   167	  TF_LITE_ENSURE_OK(context, tflite::micro::CreateWritableTensorDimsWithCopy(
   168	                                 context, output, output_eval));
   169	
   170	  TfLiteIntArray* output_shape = output->dims;
   171	  output_shape->size =
   172	      NumDimensions(input) + NumDimensions(coords) - 1 - batch_dims;
   173	  int output_index = 0;
   174	  for (int i = 0; i < axis; ++i) {
   175	    output_shape->data[output_index++] = input->dims->data[i];
   176	  }
   177	  for (int i = batch_dims; i < coords->dims->size; ++i) {
   178	    output_shape->data[output_index++] = coords->dims->data[i];
   179	  }
   180	  for (int i = axis + 1; i < input->dims->size; ++i) {
   181	    output_shape->data[output_index++] = input->dims->data[i];
   182	  }
   183	
   184	  micro_context->DeallocateTempTfLiteTensor(input);
   185	  micro_context->DeallocateTempTfLiteTensor(coords);
   186	  micro_context->DeallocateTempTfLiteTensor(output);
   187	
   188	  return kTfLiteOk;
   189	}
   190	
   191	TfLiteStatus GatherEval(TfLiteContext* context, TfLiteNode* node) {
   192	  const auto* params =
   193	      reinterpret_cast<const TfLiteGatherParams*>(node->builtin_data);
   194	  const TfLiteEvalTensor* input =
   195	      tflite::micro::GetEvalInput(context, node, kInputTensor);
   196	  const TfLiteEvalTensor* coords =
   197	      tflite::micro::GetEvalInput(context, node, kInputPositions);
   198	  TfLiteEvalTensor* output =
   199	      tflite::micro::GetEvalOutput(context, node, kOutputTensor);
   200	
   201	  if (coords->type == kTfLiteInt32) {
   202	    switch (input->type) {
   203	      case kTfLiteFloat32:
   204	        return Gather<float, int32_t>(params, input, coords, output);
   205	        break;
   206	      case kTfLiteInt8:
   207	        return Gather<int8_t, int32_t>(params, input, coords, output);
   208	        break;
   209	      default:
   210	        MicroPrintf("Type '%s' is not supported by gather.",
   211	                    TfLiteTypeGetName(input->type));
   212	        return kTfLiteError;
   213	        break;
   214	    }
   215	  }
   216	  return kTfLiteOk;
   217	}
   218	}  // namespace
   219	
   220	TFLMRegistration Register_GATHER() {
   221	  return tflite::micro::RegisterOp(nullptr, GatherPrepare, GatherEval);
   222	}
   223	
   224	}  // namespace tflite
