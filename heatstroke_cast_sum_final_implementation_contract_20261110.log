   99: # Source generation output directories
  100: set(SRC_GEN_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated/src)
  101: set(INC_GEN_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated/include)
  102: file(MAKE_DIRECTORY ${SRC_GEN_DIR} ${INC_GEN_DIR})
  103: 
  104: message(STATUS "Using SRC_GEN_DIR:    ${SRC_GEN_DIR}")
  105: message(STATUS "Using INC_GEN_DIR:    ${INC_GEN_DIR}")
  106: 
  107: # Determine NPU config ID based on Zephyr Kconfig.
  108: # If ETHOSU_TARGET_NPU_CONFIG was supplied on the command line, ETHOS_U_NPU_CONFIG_ID
  109: # has already been computed above. Otherwise fall back to the board Kconfig defaults.
  110: if (NOT DEFINED ETHOS_U_NPU_CONFIG_ID)
  111:     if (CONFIG_ARM_ETHOS_U85_256)
  112:         set(ETHOS_U_NPU_CONFIG_ID "Z256")
  113:     elseif (CONFIG_ARM_ETHOS_U55_256)
  114:         set(ETHOS_U_NPU_CONFIG_ID "H256")
  115:     else()
  116:         set(ETHOS_U_NPU_CONFIG_ID "H128")
  117:     endif()
  118: endif()
