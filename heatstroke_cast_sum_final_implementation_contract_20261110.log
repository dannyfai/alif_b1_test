   83: # Silence "changed in GCC 7.1" warnigns from C++ headers
   84: set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wno-psabi")
   85: set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-psabi")
