  142: endif()
  143: 
  144: if (HEATSTROKE_SINGLE_STEP_EXPERIMENT)
  145:     set(POLYU_MODEL_SHA256_EXPECTED
  146:         "72bf7dba9d0234458108fc413915cdb161050edccf4327dd6cf34597e1cb556a")
  147: else()
  148:     set(POLYU_MODEL_SHA256_EXPECTED
  149:         "b8056848e68ecdb1fc1cd35f65639db6f836b53abf603033f58f90ec7f1003b3")
  150: endif()
  151: if (HEATSTROKE_LAYER_NORM_FUSION_EXPERIMENT)
  152:     set(POLYU_MODEL_SHA256_EXPECTED "06455fa9d1b41e2b920485b9bfd4a1a48d68ae0474d1aa7d9558c0a0afd02125")
  153: endif()
  154: 
  155: file(SHA256 "${POLYU_MODEL_PATH}" POLYU_MODEL_SHA256_ACTUAL)
  156: if (NOT "${POLYU_MODEL_SHA256_ACTUAL}" STREQUAL "${POLYU_MODEL_SHA256_EXPECTED}")
