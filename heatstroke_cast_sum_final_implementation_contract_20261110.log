  293: TfLiteStatus EvalSumHelper(TfLiteContext* context, TfLiteNode* node,
  294:                            OpDataReduce* op_data) {
  295:   const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
  296:   const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 1);
  297:   TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
  298:   TF_LITE_ENSURE_TYPES_EQ(context, input->type, output->type);
  299:   TfLiteReducerParams* params =
  300:       static_cast<TfLiteReducerParams*>(node->builtin_data);
  301: 
  302:   // Interpret an axis tensor with null dimensions as a scalar.
  303:   int num_axis = static_cast<int>(ElementCount(*axis->dims));
  304:   int temp_index[kMaxNumberOfAxis];
  305:   int resolved_axis[kMaxNumberOfReducedAxis];
  306: 
  307:   switch (input->type) {
  308:     case kTfLiteFloat32: {
  309:       TF_LITE_ENSURE(
  310:           context,
  311:           reference_ops::ReduceGeneric<float>(
  312:               tflite::micro::GetTensorData<float>(input), input->dims->data,
  313:               input->dims->size, tflite::micro::GetTensorData<float>(output),
  314:               output->dims->data, output->dims->size,
  315:               tflite::micro::GetTensorData<int>(axis), num_axis,
  316:               params->keep_dims, temp_index, resolved_axis, /*init_value=*/0.f,
  317:               [](const float current, const float in) -> float {
  318:                 return in + current;
  319:               }));
  320:     } break;
  321:     case kTfLiteInt8: {
  322:       int32_t* temp_sum = static_cast<int32_t*>(
  323:           context->GetScratchBuffer(context, op_data->temp_buffer_idx));
  324:       QuantizedMeanOrSum<int8_t>(context, node, temp_index, resolved_axis,
  325:                                  temp_sum, op_data, /*compute_sum=*/true);
  326:     } break;
  327:     case kTfLiteInt16: {
  328:       int32_t* temp_sum = static_cast<int32_t*>(
  329:           context->GetScratchBuffer(context, op_data->temp_buffer_idx));
  330:       QuantizedMeanOrSum<int16_t>(context, node, temp_index, resolved_axis,
  331:                                   temp_sum, op_data, /*compute_sum=*/true);
  332:     } break;
  333:     default:
  334:       MicroPrintf("Only float32, int8, and int16 types are supported.");
  335:       return kTfLiteError;
  336:   }
  337:   return kTfLiteOk;
  338: }
