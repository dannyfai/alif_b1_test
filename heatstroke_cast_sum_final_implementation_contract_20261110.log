  127:         CACHE FILEPATH "Experimental PolyU heat-stress model" FORCE)
  128: else()
  129:     set(POLYU_MODEL_PATH
  130:         "${CMAKE_CURRENT_SOURCE_DIR}/../PolyU/Heat_Stress_Model_1_v20260514/export/vela_h128_performance_broadcast_shape_fold/qdq_both_variance_eps_preprocess_fp32_v2_concat_fp32_broadcast_shape_fold_vela.tflite"
  131:         CACHE FILEPATH "Production PolyU heat-stress model" FORCE)
