   216	  const int time_steps = input->dims->data[0];
   217	  const int batch_size = input->dims->data[1];
   218	  const int input_dimension = input->dims->data[2];
   219	
   220	  // The supplied heat-stress model uses time-major, single-batch sequences.
   221	  if (time_steps <= 0 || batch_size != 1 || input_dimension <= 0) {
