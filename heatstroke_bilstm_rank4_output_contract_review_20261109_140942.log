    32	TfLiteStatus EvalReshapeReference(TfLiteContext* context, TfLiteNode* node) {
    33	  const TfLiteEvalTensor* input =
    34	      tflite::micro::GetEvalInput(context, node, kReshapeInputTensor);
    35	  TfLiteEvalTensor* output =
    36	      tflite::micro::GetEvalOutput(context, node, kReshapeOutputTensor);
    37	
    38	  // TODO(b/162522304): storing input bytes in OpData increases some models
    39	  // significantly, possibly due to alignment issues.
    40	  size_t input_bytes;
    41	  TF_LITE_ENSURE_STATUS(TfLiteTypeSizeOf(input->type, &input_bytes));
    42	  input_bytes *= ElementCount(*input->dims);
    43	
    44	  // Do nothing for in-place reshape.
    45	  if (input->data.raw != output->data.raw) {
    46	    // Otherwise perform reshape with copy.
    47	    memcpy(output->data.raw, input->data.raw, input_bytes);
    48	  }
    49	  return kTfLiteOk;
    50	}
    51	
    52	}  // namespace
    53	
    54	TFLMRegistration Register_RESHAPE() {
    55	  return tflite::micro::RegisterOp(nullptr, PrepareReshapeReference,
    56	                                   EvalReshapeReference);
    57	}
    58	
    59	}  // namespace tflite
