    32	TfLiteStatus ReshapeOutput(TfLiteContext* context, TfLiteNode* node) {
    33	  MicroContext* micro_context = GetMicroContext(context);
    34	
    35	  TfLiteTensor* input =
    36	      micro_context->AllocateTempInputTensor(node, kReshapeInputTensor);
    37	  TF_LITE_ENSURE(context, input != nullptr);
    38	  TfLiteTensor* output =
    39	      micro_context->AllocateTempOutputTensor(node, kReshapeOutputTensor);
    40	  TF_LITE_ENSURE(context, output != nullptr);
    41	  // Tensorflow's Reshape allows one of the shape components to have the
    42	  // special -1 value, meaning it will be calculated automatically based on the
    43	  // input. Here we calculate what that dimension should be so that the number
    44	  // of output elements in the same as the number of input elements.
    45	  int num_input_elements = NumElements(input);
    46	  TfLiteIntArray* output_shape = output->dims;
    47	
    48	  if (NumInputs(node) == 1 &&  // Legacy scalar supported with params.
    49	      output_shape->size == 1 && output_shape->data[0] == 0) {
    50	    // Legacy tflite models use a shape parameter of [0] to indicate scalars,
    51	    // so adjust accordingly. TODO(b/111614235): Allow zero-sized buffers during
    52	    // toco conversion.
    53	    output_shape->size = 0;
    54	  }
    55	
    56	  int num_output_elements = 1;
    57	  int stretch_dim = -1;
    58	  for (int i = 0; i < output_shape->size; ++i) {
    59	    int value = output_shape->data[i];
    60	    if (value == -1) {
    61	      TF_LITE_ENSURE_EQ(context, stretch_dim, -1);
    62	      stretch_dim = i;
    63	    } else {
    64	      num_output_elements *= value;
    65	    }
    66	  }
    67	  if (stretch_dim != -1) {
    68	    TfLiteEvalTensor* output_eval =
    69	        tflite::micro::GetEvalOutput(context, node, kReshapeOutputTensor);
    70	    TF_LITE_ENSURE_STATUS(tflite::micro::CreateWritableTensorDimsWithCopy(
    71	        context, output, output_eval));
    72	    output_shape = output->dims;  // output tensor dims were moved
    73	    output_shape->data[stretch_dim] = num_input_elements / num_output_elements;
    74	    num_output_elements *= output_shape->data[stretch_dim];
    75	  }
    76	
    77	  TF_LITE_ENSURE_TYPES_EQ(context, input->type, output->type);
    78	  TF_LITE_ENSURE_EQ(context, num_input_elements, num_output_elements);
    79	
    80	  micro_context->DeallocateTempTfLiteTensor(input);
    81	  micro_context->DeallocateTempTfLiteTensor(output);
    82	  return kTfLiteOk;
    83	}
    84	
    85	}  // namespace
    86	
    87	TfLiteStatus PrepareReshapeReference(TfLiteContext* context, TfLiteNode* node) {
    88	  TF_LITE_ENSURE(context, NumInputs(node) == 1 || NumInputs(node) == 2);
    89	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
    90	  TF_LITE_ENSURE_EQ(context, ReshapeOutput(context, node), kTfLiteOk);
    91	  return kTfLiteOk;
    92	}
    93	
    94	}  // namespace tflite
