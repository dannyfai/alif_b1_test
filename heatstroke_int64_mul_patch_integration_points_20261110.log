=== MUL REGISTRATION AND EXPERIMENTAL RESOLVER BLOCK ===
    size_t batch_size = 1U;
    size_t outer_size = 1U;
    size_t inner_size = 1U;
    size_t coord_size = 1U;

    for (int i = 0; i < batch_dims; ++i) {
        if (!HeatstrokeGatherCheckedMultiply(
                batch_size,
                static_cast<size_t>(input_dims->data[i]),
                &batch_size)) {
            MicroPrintf("Heatstroke GATHER batch size overflow.");
            return kTfLiteError;
        }
    }

    for (int i = batch_dims; i < axis; ++i) {
        if (!HeatstrokeGatherCheckedMultiply(
                outer_size,
                static_cast<size_t>(input_dims->data[i]),
                &outer_size)) {
            MicroPrintf("Heatstroke GATHER outer size overflow.");
            return kTfLiteError;
        }
    }

    for (int i = axis + 1; i < input_rank; ++i) {
        if (!HeatstrokeGatherCheckedMultiply(
                inner_size,
                static_cast<size_t>(input_dims->data[i]),
                &inner_size)) {
            MicroPrintf("Heatstroke GATHER inner size overflow.");
            return kTfLiteError;
        }
    }

    for (int i = batch_dims; i < index_rank; ++i) {
        if (!HeatstrokeGatherCheckedMultiply(
                coord_size,
                static_cast<size_t>(index_dims->data[i]),
                &coord_size)) {
            MicroPrintf("Heatstroke GATHER coordinate size overflow.");
            return kTfLiteError;
        }
    }

    size_t input_elements = batch_size;
    size_t output_elements = batch_size;
    size_t index_count = 0U;
    size_t copy_bytes = 0U;

    if (!HeatstrokeGatherCheckedMultiply(
            input_elements, outer_size, &input_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            input_elements, static_cast<size_t>(axis_size),
            &input_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            input_elements, inner_size, &input_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            output_elements, outer_size, &output_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            output_elements, coord_size, &output_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            output_elements, inner_size, &output_elements) ||
        !HeatstrokeGatherCheckedMultiply(
            batch_size, coord_size, &index_count) ||
        !HeatstrokeGatherCheckedMultiply(
            inner_size, sizeof(InputT), &copy_bytes)) {
        MicroPrintf("Heatstroke GATHER tensor size overflow.");
        return kTfLiteError;
    }

    const InputT* input_data =
        tflite::micro::GetTensorData<InputT>(input);

    const IndexT* index_data =
        tflite::micro::GetTensorData<IndexT>(indices);

    InputT* output_data =
        tflite::micro::GetTensorData<InputT>(output);

    if ((input_elements != 0U && input_data == nullptr) ||
        (index_count != 0U && index_data == nullptr) ||
        (output_elements != 0U && output_data == nullptr)) {
        MicroPrintf("Heatstroke GATHER received a null tensor data pointer.");
        return kTfLiteError;
    }

