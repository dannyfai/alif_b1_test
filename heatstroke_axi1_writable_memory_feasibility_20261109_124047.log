  1446	def _update_memory_snapshot_for_all_npu_graphs(
  1447	    nng: Graph, arch: ArchitectureFeatures, schedulers, verbose_progress: bool = False
  1448	):
  1449	    mem_area = arch.fast_storage_mem_area
  1450	    mem_type_set = set((MemType.Scratch, MemType.Scratch_fast))
  1451	
  1452	    # Collect live ranges for the full graph
  1453	    # extract_live_ranges_from_cascaded_passes will start from the root sg and
  1454	    # all sub graphs/cascaded passes will be visited and the correct time_index
  1455	    # will be set for all the tensors.
  1456	    lr_graph = live_range.LiveRangeGraph()
  1457	    live_range.extract_live_ranges_from_cascaded_passes(
  1458	        nng.get_root_subgraph(), mem_area, mem_type_set, lr_graph, Tensor.AllocationQuantum, verbose_progress
  1459	    )
  1460	    # Populate time-array with memory used by live ranges
  1461	    temporal_usage = lr_graph.get_temporal_memory_usage(arch.fast_storage_mem_area)
  1462	
  1463	    # Update snapshot for all the npu sub graphs
  1464	    # Not needed for the scheduler any longer but npu_performance
  1465	    # is using this information so it must have the correct state
  1466	    for sg in schedulers:
  1467	        sg.schedule.memory_snapshot = temporal_usage
  1468	        sg.schedule.fast_storage_peak_usage = max(temporal_usage, default=0)
