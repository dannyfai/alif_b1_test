   158	    def assign_buffers_to_tensors(self, tensors, scratch_tensor):
   159	        if scratch_tensor is not None:
   160	            scratch_tensor_mem_area = scratch_tensor.mem_area
   161	        else:
   162	            scratch_tensor_mem_area = None  # all tensors are initialised to MemArea.Unknown
   163	
   164	        buffer_map = {}
   165	
   166	        for tens in tensors:
   167	            # Set buffer ids depending on allocation
   168	            if tens.is_allocated_in_tensor_arena(scratch_tensor_mem_area) or tens.mem_type == MemType.Scratch_fast:
   169	                # Tensor allocated in the scratch areas, does not have any constant data and can
   170	                # therefore all point to the empty buffer (zero)
   171	                buffer_map[tens] = TFLiteSerialiser.BUF_IDX_ZERO
   172	            else:
   173	                buffer_map[tens] = self.buf_idx
   174	                self.buf_idx += 1
   175	
   176	        # Initialize/extend buffers_to_write to a length equal to number of buffers so
   177	        # they can be appended at the correct index during tensor serialization
   178	        self.buffers_to_write += [None] * (self.buf_idx)
   179	
   180	        return buffer_map
