    50	def copy_ifm_values_to_memory_tensor(memory_tensor, src_tensor):
    51	    start_addr = src_tensor.address
    52	    values = src_tensor.values.flatten()
    53	    if src_tensor.dtype.size_in_bytes() > 1:
    54	        values = np.frombuffer(values.tobytes(), dtype=np.uint8)
    55	    end_addr = start_addr + values.size
    56	    memory_tensor.values[start_addr:end_addr] = values
