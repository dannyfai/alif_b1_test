   210	
   211	        if (this->m_opResolver.AddBuiltin(
   212	                tflite::BuiltinOperator_SIGN,
   213	                registration,
   214	                ParseHeatstrokeSign) != kTfLiteOk) {
   215	            printf_err("Failed to register heat-stress SIGN.\n");
   216	            return false;
   217	        }
   218	    }
   219	
