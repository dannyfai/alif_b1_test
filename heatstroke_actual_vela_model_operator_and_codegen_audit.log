    47	
    48	bool arm::app::fwk::tflm::PolyUModel1::EnlistOperations()
    49	{
    50	#ifndef ETHOS_U_NPU_ASSUMED
    51	    
    52	    this->m_opResolver.AddStridedSlice();
    53	    this->m_opResolver.AddFullyConnected();
    54	    this->m_opResolver.AddReshape();
    55	    this->m_opResolver.AddAveragePool2D();
    56	    this->m_opResolver.AddUnpack();
    57	    this->m_opResolver.AddAdd();
    58	    this->m_opResolver.AddSplit();
    59	    this->m_opResolver.AddTanh();
    60	    this->m_opResolver.AddLogistic();
    61	    this->m_opResolver.AddMul();
    62	    this->m_opResolver.AddPack();
    63	    this->m_opResolver.AddConcatenation();
    64	    this->m_opResolver.AddTranspose();
    65	    this->m_opResolver.AddGather();
    66	    this->m_opResolver.AddMean();
    67	    this->m_opResolver.AddSquaredDifference();
    68	    this->m_opResolver.AddRsqrt();
    69	    this->m_opResolver.AddSub();
    70	    this->m_opResolver.AddPad();
    71	    this->m_opResolver.AddConv2D();
    72	    this->m_opResolver.AddSoftmax();
    73	    //this->m_opResolver.AddCustom("ReverseV2", tflite::Register_REVERSE_V2());
    74	    const TFLMRegistration& registration = tflite::Register_REVERSE_V2();
    75	    this->m_opResolver.AddBuiltin(tflite::BuiltinOperator_REVERSE_V2, registration,
    76	                      ParseReverseV2);
    77	
    78	#endif
    79	
    80	    
    81	    {
    82	        const TFLMRegistration registration =
    83	            tflite::RegisterHeatstrokeBidirectionalSequenceLstm();
    84	
    85	        if (this->m_opResolver.AddBuiltin(
    86	                tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
    87	                registration, ParseHeatstrokeBidirectionalSequenceLstm) != kTfLiteOk) {
    88	            return false;
    89	        }
    90	    }
    91	
    92	if (kTfLiteOk == this->m_opResolver.AddEthosU()) {
    93	        info("Added %s support to op resolver\n", tflite::GetString_ETHOSU());
    94	    } else {
    95	        printf_err("Failed to add Arm NPU support to op resolver.");
    96	        return false;
    97	    }
    98	    return true;
    99	}

