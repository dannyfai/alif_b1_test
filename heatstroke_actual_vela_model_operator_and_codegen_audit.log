    33	
    34	TfLiteStatus ParseHeatstrokeBidirectionalSequenceLstm(
    35	    const tflite::Operator* op,
    36	    tflite::ErrorReporter* error_reporter,
    37	    tflite::BuiltinDataAllocator* allocator,
    38	    void** builtin_data) {
    39	    return tflite::ParseOpData(
    40	        op,
    41	        tflite::BuiltinOperator_BIDIRECTIONAL_SEQUENCE_LSTM,
