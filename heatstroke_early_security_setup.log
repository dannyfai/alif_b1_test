     7	#ifndef TGU_H
     8	#define TGU_H
     9	#include <stdint.h>
    10	#include <limits.h>
    11	
    12	#define ITGU_BASE                 (0xE001E500UL)
    13	#define ITGU_CTRL                 (ITGU_BASE + 0x0)
    14	#define ITGU_CFG                  (ITGU_BASE + 0x4)
    15	#define ITGU_LUT(n)               (ITGU_BASE + 0x10 + 4 * n)
    16	
    17	#define DTGU_BASE                 (0xE001E600UL)
    18	#define DTGU_CTRL                 (DTGU_BASE + 0x0)
    19	#define DTGU_CFG                  (DTGU_BASE + 0x4)
    20	#define DTGU_LUT(n)               (DTGU_BASE + 0x10 + 4 * n)
    21	#define TGU_LUT(base, n)          ((base) + 0x10 + 4 * (n))
    22	
    23	#define DTGU_CFG_BLKSZ            (0xFU << 0)
    24	#define ITGU_CFG_BLKSZ            (0xFU << 0)
    25	
    26	#define SET_BIT_RANGE(from, to) (~0U >> ((CHAR_BIT * sizeof(unsigned int)) - (to) - 1)) \
    27									& (~0U << (from))
    28	
    29	enum tcm_type {ITCM, DTCM};
    30	
    31	struct mem_region {
    32		uint32_t start;
    33		uint32_t end;
    34		enum tcm_type type;
    35	};
    36	
    37	/*
    38	 * TGU_Setup()
    39	 * Set up the TGU look up tables as per the information provided by
    40	 * the platform in ns_regions array.
    41	 */
    42	void TGU_Setup(void);
    43	#endif /* TGU_H */
     1	/*
