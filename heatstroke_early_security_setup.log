     6	
     7	#ifndef SAU_TCM_NS_SETUP_H
     8	#define SAU_TCM_NS_SETUP_H
     9	
    10	#ifdef __cplusplus
    11	extern "C" {
    12	#endif
    13	
    14	#define DTCM_BASE DT_REG_ADDR(DT_NODELABEL(dtcm))
    15	#define DTCM_END (DTCM_BASE + DT_REG_SIZE(DT_NODELABEL(dtcm)))
    16	
    17	#define ITCM_BASE DT_REG_ADDR(DT_NODELABEL(itcm))
    18	#define ITCM_END (DTCM_BASE + DT_REG_SIZE(DT_NODELABEL(itcm)))
    19	
    20	/* NS REGIONs, should be TGU Block size aligned */
    21	#if DT_NODE_EXISTS(DT_NODELABEL(ns))
    22	#define NS_REGION_0_BASE DT_REG_ADDR(DT_NODELABEL(ns))
    23	#define NS_REGION_0_SIZE DT_REG_SIZE(DT_NODELABEL(ns))
    24	#define NS_REGION_0_END  (NS_REGION_0_BASE + NS_REGION_0_SIZE)
    25	#else
    26	#error "Non-secure DTS node not found."
    27	#endif /* DT_NODE_EXISTS(DT_NODELABEL(ns)) */
    28	
    29	
    30	/*
    31	 * sau_tcm_ns_setup ()
    32	 * Set up the TCM Nonsecure partitioning in SAU and TGU
    33	 */
    34	void sau_tcm_ns_setup(void);
    35	
    36	#ifdef __cplusplus
    37	}
    38	#endif
    39	
    40	#endif /* SAU_TCM_NS_SETUP_H */

