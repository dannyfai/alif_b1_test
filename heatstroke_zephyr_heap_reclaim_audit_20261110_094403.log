    27	namespace arm::app::fwk::tflm {
    28	namespace {
    29	/**
    30	 * @brief   Infer Arm Ethos-U NPU memory mode from Ethos-U operator inputs.
    31	 * @param[in] model     Pointer the the model object.
    32	 * @return  Memory mode string if detected, or empty string otherwise.
    33	 */
    34	std::string InferNpuMemoryModeFromEthosUOp(const tflite::Model* model)
    35	{
    36	    if (!model || !model->subgraphs() || model->subgraphs()->size() == 0 ||
    37	        !model->operator_codes()) {
    38	        return {};
    39	    }
    40	
    41	    const tflite::SubGraph* subgraph = model->subgraphs()->Get(0);
    42	    if (!subgraph || !subgraph->operators()) {
    43	        return {};
    44	    }
    45	
    46	    int ethos_u_opcode = -1;
    47	    for (uint32_t i = 0; i < model->operator_codes()->size(); ++i) {
    48	        const tflite::OperatorCode* opcode = model->operator_codes()->Get(i);
    49	        if (!opcode || opcode->builtin_code() != tflite::BuiltinOperator_CUSTOM) {
    50	            continue;
    51	        }
    52	        const auto* custom = opcode->custom_code();
    53	        if (custom && (std::strcmp(custom->c_str(), "ethos-u") == 0)) {
    54	            ethos_u_opcode = static_cast<int>(i);
    55	            break;
    56	        }
    57	    }
    58	
    59	    if (ethos_u_opcode < 0) {
    60	        return {};
    61	    }
    62	
    63	    for (uint32_t i = 0; i < subgraph->operators()->size(); ++i) {
    64	        const tflite::Operator* op = subgraph->operators()->Get(i);
    65	        if (!op || op->opcode_index() != ethos_u_opcode) {
    66	            continue;
    67	        }
    68	        const auto* inputs = op->inputs();
    69	        if (!inputs || inputs->size() <= 3) {
    70	            continue;
    71	        }
    72	
    73	        /* Vela places tensor arena at index 2 and fast scratch buffer at index 3. */
    74	        const int32_t arena_idx = inputs->Get(2);
    75	        const int32_t scratch_idx = inputs->Get(3);
    76	        if (arena_idx < 0 || scratch_idx < 0) {
    77	            continue;
    78	        }
    79	
    80	        const tflite::Tensor* arena = subgraph->tensors()->Get(arena_idx);
    81	        const tflite::Tensor* scratch = subgraph->tensors()->Get(scratch_idx);
    82	        if (!arena || !scratch) {
    83	            continue;
    84	        }
    85	
    86	        const auto arena_shape = arena->shape();
    87	        const auto scratch_shape = scratch->shape();
    88	        if (!arena_shape || !scratch_shape || arena_shape->size() < 1 ||
    89	            scratch_shape->size() < 1 || arena_shape->Get(0) < 1) {
    90	            continue;
    91	        }
    92	
    93	        if (arena_shape->Get(0) == scratch_shape->Get(0)) {
    94	            return "Sram_Only/Shared_Sram";
    95	        }
    96	        return "Dedicated_Sram";
    97	    }
    98	
    99	    return {};
   100	}
   101	} /* anonymous namespace */
   102	
   103	TflmModel::TflmModel() {}
   104	
   105	/* Initialise the model */
   106	bool TflmModel::Init(iface::MemoryRegion& computeBuffer,
   107	                     iface::MemoryRegion& nnModel,
   108	                     const void* backendData)
   109	{
   110	    /* Following tf lite micro example:
   111	     * Map the model into a usable data structure. This doesn't involve any
   112	     * copying or parsing, it's a very lightweight operation. */
   113	    debug("loading model from @ 0x%p\n", nnModel.data);
   114	    debug("model size: %" PRIu32 " bytes.\n", nnModel.size);
   115	
   116	    /* Enable logging before we start interacting with the framework. */
   117	    EnableTFLMLog();
   118	
   119	    this->m_backendData.m_pModel = ::tflite::GetModel(nnModel.data);
   120	
   121	    if (this->m_backendData.m_pModel->version() != TFLITE_SCHEMA_VERSION) {
   122	        printf_err("Model's schema version %" PRIu32 " is not equal "
   123	                   "to supported version %d.",
   124	                   this->m_backendData.m_pModel->version(),
   125	                   TFLITE_SCHEMA_VERSION);
   126	        return false;
   127	    }
   128	
   129	    this->m_computeBuffer = computeBuffer;
   130	    this->m_modelBuffer   = nnModel;
   131	
   132	    /* Pull in only the operation implementations we need.
   133	     * This relies on a complete list of all the ops needed by this graph.
   134	     * An easier approach is to just use the AllOpsResolver, but this will
   135	     * incur some penalty in code space for op implementations that are not
   136	     * needed by this graph.
   137	     * static ::tflite::ops::micro::AllOpsResolver resolver; */
   138	    /* NOLINTNEXTLINE(runtime-global-variables) */
   139	    debug("loading op resolver\n");
   140	
   141	    this->EnlistOperations();
   142	
   143	    /** If backend data has been provided, re-use the allocator */
   144	    if (backendData) {
   145	        this->m_backendData.m_pAllocator =
   146	            reinterpret_cast<const TflmBackendData*>(backendData)->m_pAllocator;
   147	    }
   148	
   149	    /* Create allocator instance, if it doesn't exist */
   150	    if (!this->m_backendData.m_pAllocator) {
   151	        /* Create an allocator instance */
   152	        info("Creating allocator using tensor arena at 0x%p\n", computeBuffer.data);
   153	
   154	        this->m_backendData.m_pAllocator =
   155	            tflite::MicroAllocator::Create(computeBuffer.data, computeBuffer.size);
   156	
   157	        if (!this->m_backendData.m_pAllocator) {
   158	            printf_err("Failed to create allocator\n");
   159	            return false;
   160	        }
   161	        debug("Created new allocator @ 0x%p\n", this->m_backendData.m_pAllocator);
   162	    } else {
   163	        debug("Using existing allocator @ 0x%p\n", this->m_backendData.m_pAllocator);
   164	    }
   165	
   166	    this->m_backendData.m_pInterpreter = std::make_unique<tflite::MicroInterpreter>(
   167	        this->m_backendData.m_pModel, this->GetOpResolver(), this->m_backendData.m_pAllocator);
   168	
   169	    if (!this->m_backendData.m_pInterpreter) {
   170	        printf_err("Failed to allocate interpreter\n");
   171	        return false;
   172	    }
   173	
   174	    /* Allocate memory from the tensor_arena for the model's tensors. */
   175	    info("Allocating tensors\n");
   176	    TfLiteStatus allocate_status = this->m_backendData.m_pInterpreter->AllocateTensors();
   177	
   178	    if (allocate_status != kTfLiteOk) {
   179	        printf_err("tensor allocation failed!\n");
   180	        return false;
   181	    }
   182	
   183	    /* Get information about the memory area to use for the model's input. */
   184	    this->m_input.resize(this->GetNumInputs());
   185	    for (size_t inIndex = 0; inIndex < this->GetNumInputs(); inIndex++) {
   186	        this->m_input[inIndex] =
   187	            std::make_shared<TflmTensor>(this->m_backendData.m_pInterpreter->input(inIndex));
   188	    }
   189	
   190	    this->m_output.resize(this->GetNumOutputs());
   191	    for (size_t outIndex = 0; outIndex < this->GetNumOutputs(); outIndex++) {
   192	        this->m_output[outIndex] =
   193	            std::make_shared<TflmTensor>(this->m_backendData.m_pInterpreter->output(outIndex));
   194	    }
   195	
   196	    if (this->m_input.empty() || this->m_output.empty()) {
   197	        printf_err("failed to get tensors\n");
   198	        return false;
   199	    } else {
   200	        this->m_type = this->m_input[0]->Type(); /* Input 0 should be the main input */
   201	
   202	        /* Clear the input & output tensors */
   203	        for (size_t inIndex = 0; inIndex < this->GetNumInputs(); inIndex++) {
   204	            std::memset(this->m_input[inIndex]->GetData(), 0, this->m_input[inIndex]->Bytes());
   205	        }
   206	        for (size_t outIndex = 0; outIndex < this->GetNumOutputs(); outIndex++) {
   207	            std::memset(this->m_output[outIndex]->GetData(), 0, this->m_output[outIndex]->Bytes());
   208	        }
   209	
   210	        this->LogInterpreterInfo();
   211	    }
   212	
   213	    this->m_inited = true;
   214	    return true;
   215	}
   216	
   217	std::shared_ptr<iface::TensorIface> TflmModel::GetInputTensor(size_t index) const
   218	{
   219	    if (index < this->GetNumInputs()) {
   220	        return this->m_input.at(index);
   221	    }
   222	    return {};
   223	}
   224	
   225	std::shared_ptr<iface::TensorIface> TflmModel::GetOutputTensor(size_t index) const
   226	{
   227	    if (index < this->GetNumOutputs()) {
   228	        return this->m_output.at(index);
   229	    }
   230	    return nullptr;
   231	}
   232	
   233	void TflmModel::LogTensorInfo(std::shared_ptr<iface::TensorIface> tensor)
   234	{
   235	    if (!tensor) {
   236	        printf_err("Invalid tensor\n");
   237	        assert(tensor);
   238	        return;
   239	    }
   240	
   241	    debug("\ttensor is assigned to 0x%p\n", tensor.get());
   242	    info("\ttensor type is %s\n", GetTensorDataTypeName(tensor->Type()));
   243	    info("\ttensor occupies %zu bytes with dimensions\n", tensor->Bytes());
   244	    const auto shape = tensor->Shape();
   245	    for (size_t i = 0; i < shape.size(); ++i) {
   246	        info("\t\t%zu: %3d\n", i, static_cast<int>(shape[i]));
   247	    }
   248	
   249	    const auto quant = tensor->GetQuantParams();
   250	    info("Scale = %f\n", quant.scale);
   251	    info("ZeroPoint = %d\n", quant.offset);
   252	}
   253	
   254	void TflmModel::LogInterpreterInfo()
   255	{
   256	    if (!this->m_backendData.m_pInterpreter) {
   257	        printf_err("Invalid interpreter\n");
   258	        return;
   259	    }
