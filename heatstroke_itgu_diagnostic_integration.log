    39	
    40	/* Print application information. */
    41	static void PrintApplicationIntro()
    42	{
    43	    #define PRJ_DES_STR     "BeeInventor - PolyU Model1 Test"
    44	    LOG_INF("%s\n", PRJ_DES_STR);
    45	    LOG_INF("Version %s Build date: " __DATE__ " @ " __TIME__ "\n", PRJ_VER_STR);
    46	    //LOG_INF("Compiler: %s\n", PRJ_COMPILER);
    47	    // LOG_INF("Copyright 2021-2026 Arm Limited and/or "
    48	    //      "its affiliates <open-source-office@arm.com>\n\n");
    49	}
    50	
    51	static void out_of_heap()
    52	{
    53	    LOG_WRN("Out of heap\n");
    54	    std::terminate();
    55	}
    56	
    57	int main ()
    58	{
    59		console_getline_init();
    60	
    61		/* Application information, UART should have been initialised. */
    62		PrintApplicationIntro();
    63	
    64		std::set_new_handler(out_of_heap);
    65	
    66		/* Run the application. */
    67		MainLoop();
    68	
    69	    /* This is unreachable without errors. */
    70	    LOG_INF("program terminating...\n");
    71	
    72	    return 0;
    73	}

