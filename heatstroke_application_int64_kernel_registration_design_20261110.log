  168: template <typename InputT, typename IndexT>
  169: TfLiteStatus HeatstrokeGatherCopy(
  170:     const TfLiteGatherParams* params,
  171:     const TfLiteEvalTensor* input,
  172:     const TfLiteEvalTensor* indices,
  173:     TfLiteEvalTensor* output)
  174: {
  175:     if (params == nullptr || input == nullptr ||
  176:         indices == nullptr || output == nullptr ||
  177:         input->dims == nullptr || indices->dims == nullptr ||
  178:         output->dims == nullptr) {
  179:         MicroPrintf("Heatstroke GATHER received invalid tensor metadata.");
  180:         return kTfLiteError;
  181:     }
  182: 
  183:     const TfLiteIntArray* input_dims = input->dims;
  184:     const TfLiteIntArray* index_dims = indices->dims;
  185: 
  186:     const int input_rank = input_dims->size;
  187:     const int index_rank = index_dims->size;
  188: 
  189:     if (input_rank <= 0 || index_rank < 0) {
  190:         MicroPrintf("Heatstroke GATHER received an invalid tensor rank.");
  191:         return kTfLiteError;
  192:     }
  193: 
  194:     int axis = params->axis;
  195:     if (axis < 0) {
  196:         axis += input_rank;
  197:     }
  198: 
  199:     if (axis < 0 || axis >= input_rank) {
  200:         MicroPrintf("Heatstroke GATHER axis is out of range.");
  201:         return kTfLiteError;
  202:     }
  203: 
  204:     int batch_dims = params->batch_dims;
  205:     if (batch_dims < 0) {
  206:         batch_dims += index_rank;
  207:     }
  208: 
  209:     if (batch_dims < 0 ||
  210:         batch_dims > axis ||
  211:         batch_dims >= input_rank ||
  212:         batch_dims > index_rank) {
  213:         MicroPrintf("Heatstroke GATHER batch_dims is invalid.");
  214:         return kTfLiteError;
  215:     }
  216: 
  217:     for (int i = 0; i < input_rank; ++i) {
  218:         if (input_dims->data[i] < 0) {
  219:             MicroPrintf("Heatstroke GATHER has a negative input dimension.");
  220:             return kTfLiteError;
  221:         }
  222:     }
  223: 
  224:     for (int i = 0; i < index_rank; ++i) {
  225:         if (index_dims->data[i] < 0) {
  226:             MicroPrintf("Heatstroke GATHER has a negative index dimension.");
  227:             return kTfLiteError;
  228:         }
  229:     }
  230: 
  231:     for (int i = 0; i < batch_dims; ++i) {
  232:         if (input_dims->data[i] != index_dims->data[i]) {
  233:             MicroPrintf("Heatstroke GATHER batch dimensions do not match.");
  234:             return kTfLiteError;
  235:         }
  236:     }
  237: 
  238:     const int axis_size = input_dims->data[axis];
  239: 
  240:     size_t batch_size = 1U;
  241:     size_t outer_size = 1U;
  242:     size_t inner_size = 1U;
  243:     size_t coord_size = 1U;
  244: 
  245:     for (int i = 0; i < batch_dims; ++i) {
  246:         if (!HeatstrokeGatherCheckedMultiply(
  247:                 batch_size,
  248:                 static_cast<size_t>(input_dims->data[i]),
  249:                 &batch_size)) {
  250:             MicroPrintf("Heatstroke GATHER batch size overflow.");
  251:             return kTfLiteError;
  252:         }
  253:     }
  254: 
  255:     for (int i = batch_dims; i < axis; ++i) {
  256:         if (!HeatstrokeGatherCheckedMultiply(
  257:                 outer_size,
  258:                 static_cast<size_t>(input_dims->data[i]),
  259:                 &outer_size)) {
  260:             MicroPrintf("Heatstroke GATHER outer size overflow.");
  261:             return kTfLiteError;
  262:         }
  263:     }
  264: 
  265:     for (int i = axis + 1; i < input_rank; ++i) {
  266:         if (!HeatstrokeGatherCheckedMultiply(
  267:                 inner_size,
  268:                 static_cast<size_t>(input_dims->data[i]),
  269:                 &inner_size)) {
  270:             MicroPrintf("Heatstroke GATHER inner size overflow.");
  271:             return kTfLiteError;
  272:         }
  273:     }
  274: 
  275:     for (int i = batch_dims; i < index_rank; ++i) {
  276:         if (!HeatstrokeGatherCheckedMultiply(
  277:                 coord_size,
  278:                 static_cast<size_t>(index_dims->data[i]),
  279:                 &coord_size)) {
  280:             MicroPrintf("Heatstroke GATHER coordinate size overflow.");
  281:             return kTfLiteError;
  282:         }
  283:     }
  284: 
  285:     size_t input_elements = batch_size;
  286:     size_t output_elements = batch_size;
  287:     size_t index_count = 0U;
  288:     size_t copy_bytes = 0U;
  289: 
  290:     if (!HeatstrokeGatherCheckedMultiply(
  291:             input_elements, outer_size, &input_elements) ||
  292:         !HeatstrokeGatherCheckedMultiply(
  293:             input_elements, static_cast<size_t>(axis_size),
  294:             &input_elements) ||
  295:         !HeatstrokeGatherCheckedMultiply(
  296:             input_elements, inner_size, &input_elements) ||
  297:         !HeatstrokeGatherCheckedMultiply(
  298:             output_elements, outer_size, &output_elements) ||
  299:         !HeatstrokeGatherCheckedMultiply(
  300:             output_elements, coord_size, &output_elements) ||
  301:         !HeatstrokeGatherCheckedMultiply(
  302:             output_elements, inner_size, &output_elements) ||
  303:         !HeatstrokeGatherCheckedMultiply(
  304:             batch_size, coord_size, &index_count) ||
  305:         !HeatstrokeGatherCheckedMultiply(
  306:             inner_size, sizeof(InputT), &copy_bytes)) {
  307:         MicroPrintf("Heatstroke GATHER tensor size overflow.");
  308:         return kTfLiteError;
  309:     }
  310: 
  311:     const InputT* input_data =
  312:         tflite::micro::GetTensorData<InputT>(input);
  313: 
  314:     const IndexT* index_data =
  315:         tflite::micro::GetTensorData<IndexT>(indices);
  316: 
  317:     InputT* output_data =
  318:         tflite::micro::GetTensorData<InputT>(output);
  319: 
  320:     if ((input_elements != 0U && input_data == nullptr) ||
  321:         (index_count != 0U && index_data == nullptr) ||
  322:         (output_elements != 0U && output_data == nullptr)) {
  323:         MicroPrintf("Heatstroke GATHER received a null tensor data pointer.");
  324:         return kTfLiteError;
  325:     }
  326: 
  327:     for (size_t batch = 0; batch < batch_size; ++batch) {
  328:         for (size_t outer = 0; outer < outer_size; ++outer) {
  329:             for (size_t coord = 0; coord < coord_size; ++coord) {
  330:                 const int64_t selected_index =
  331:                     static_cast<int64_t>(
  332:                         index_data[batch * coord_size + coord]);
  333: 
  334:                 if (selected_index < 0 ||
  335:                     selected_index >= static_cast<int64_t>(axis_size)) {
  336:                     MicroPrintf(
  337:                         "Heatstroke GATHER index is out of bounds.");
  338:                     return kTfLiteError;
  339:                 }
  340: 
  341:                 if (copy_bytes == 0U) {
  342:                     continue;
  343:                 }
  344: 
  345:                 const size_t destination_offset =
  346:                     (((batch * outer_size) + outer) * coord_size + coord) *
  347:                     inner_size;
  348: 
  349:                 const size_t source_offset =
  350:                     (((batch * outer_size) + outer) *
  351:                          static_cast<size_t>(axis_size) +
  352:                      static_cast<size_t>(selected_index)) *
  353:                     inner_size;
  354: 
  355:                 std::memcpy(
  356:                     output_data + destination_offset,
  357:                     input_data + source_offset,
  358:                     copy_bytes);
  359:             }
  360:         }

