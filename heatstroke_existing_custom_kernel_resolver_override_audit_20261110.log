   492	TfLiteStatus HeatstrokeGatherEval(
   493	    TfLiteContext* context,
   494	    TfLiteNode* node)
   495	{
   496	    if (context == nullptr || node == nullptr ||
   497	        node->builtin_data == nullptr) {
   498	        return kTfLiteError;
   499	    }
   500	
   501	    const TfLiteGatherParams* params =
   502	        reinterpret_cast<const TfLiteGatherParams*>(node->builtin_data);
   503	
   504	    const TfLiteEvalTensor* input =
   505	        tflite::micro::GetEvalInput(
   506	            context, node, kHsGatherInput);
   507	
   508	    const TfLiteEvalTensor* indices =
   509	        tflite::micro::GetEvalInput(
   510	            context, node, kHsGatherIndices);
   511	
   512	    TfLiteEvalTensor* output =
   513	        tflite::micro::GetEvalOutput(
   514	            context, node, kHsGatherOutput);
   515	
   516	    if (input == nullptr || indices == nullptr || output == nullptr) {
   517	        MicroPrintf("Heatstroke GATHER could not retrieve eval tensors.");
   518	        return kTfLiteError;
   519	    }
   520	
   521	    if (indices->type == kTfLiteInt32) {
   522	        switch (input->type) {
   523	            case kTfLiteFloat32:
   524	                return HeatstrokeGatherCopy<float, int32_t>(
   525	                    params, input, indices, output);
   526	
   527	            case kTfLiteInt8:
   528	                return HeatstrokeGatherCopy<int8_t, int32_t>(
   529	                    params, input, indices, output);
   530	
   531	            default:
   532	                break;
   533	        }
   534	    } else if (indices->type == kTfLiteInt64) {
   535	        switch (input->type) {
   536	            case kTfLiteFloat32:
   537	                return HeatstrokeGatherCopy<float, int64_t>(
   538	                    params, input, indices, output);
   539	
   540	            case kTfLiteInt8:
   541	                return HeatstrokeGatherCopy<int8_t, int64_t>(
   542	                    params, input, indices, output);
   543	
   544	            default:
   545	                break;
   546	        }
   547	    }
   548	
   549	    MicroPrintf(
   550	        "Heatstroke GATHER unsupported data/index type combination: "
   551	        "data=%s indices=%s.",
   552	        TfLiteTypeGetName(input->type),
   553	        TfLiteTypeGetName(indices->type));
   554	
   555	    return kTfLiteError;
   556	}
   557	
   558	}  // namespace
