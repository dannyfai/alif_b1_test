   366	TfLiteStatus HeatstrokeGatherPrepare(
   367	    TfLiteContext* context,
   368	    TfLiteNode* node)
   369	{
   370	    if (context == nullptr || node == nullptr ||
   371	        node->builtin_data == nullptr) {
   372	        return kTfLiteError;
   373	    }
   374	
   375	    TF_LITE_ENSURE_EQ(context, NumInputs(node), 2);
   376	    TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
   377	
   378	    MicroContext* micro_context = GetMicroContext(context);
   379	
   380	    TfLiteTensor* input =
   381	        micro_context->AllocateTempInputTensor(node, kHsGatherInput);
   382	    TF_LITE_ENSURE(context, input != nullptr);
   383	
   384	    TfLiteTensor* indices =
   385	        micro_context->AllocateTempInputTensor(node, kHsGatherIndices);
   386	    TF_LITE_ENSURE(context, indices != nullptr);
   387	
   388	    TfLiteTensor* output =
   389	        micro_context->AllocateTempOutputTensor(node, kHsGatherOutput);
   390	    TF_LITE_ENSURE(context, output != nullptr);
   391	
   392	    if (input->dims == nullptr || indices->dims == nullptr ||
   393	        output->dims == nullptr) {
   394	        MicroPrintf("Heatstroke GATHER has missing tensor dimensions.");
   395	        return kTfLiteError;
   396	    }
   397	
   398	    if (indices->type != kTfLiteInt32 &&
   399	        indices->type != kTfLiteInt64) {
   400	        MicroPrintf(
   401	            "Heatstroke GATHER indices must be INT32 or INT64; got %s.",
   402	            TfLiteTypeGetName(indices->type));
   403	        return kTfLiteError;
   404	    }
   405	
   406	    if (input->type != kTfLiteFloat32 &&
   407	        input->type != kTfLiteInt8) {
   408	        MicroPrintf(
   409	            "Heatstroke GATHER data type is unsupported: %s.",
   410	            TfLiteTypeGetName(input->type));
   411	        return kTfLiteError;
   412	    }
   413	
   414	    output->type = input->type;
   415	
   416	    const TfLiteGatherParams* params =
   417	        reinterpret_cast<const TfLiteGatherParams*>(node->builtin_data);
   418	
   419	    int axis = params->axis;
   420	    if (axis < 0) {
   421	        axis += NumDimensions(input);
   422	    }
   423	
   424	    TF_LITE_ENSURE(
   425	        context, 0 <= axis && axis < NumDimensions(input));
   426	
   427	    int batch_dims = params->batch_dims;
   428	    if (batch_dims < 0) {
   429	        batch_dims += NumDimensions(indices);
   430	    }
   431	
   432	    TF_LITE_ENSURE(context, batch_dims <= axis);
   433	    TF_LITE_ENSURE(
   434	        context,
   435	        0 <= batch_dims && batch_dims < NumDimensions(input));
   436	    TF_LITE_ENSURE(
   437	        context, batch_dims <= NumDimensions(indices));
   438	
   439	    for (int i = 0; i < batch_dims; ++i) {
   440	        TF_LITE_ENSURE_EQ(
   441	            context, input->dims->data[i], indices->dims->data[i]);
   442	    }
   443	
   444	    TfLiteEvalTensor* output_eval =
   445	        tflite::micro::GetEvalOutput(
   446	            context, node, kHsGatherOutput);
   447	
   448	    TF_LITE_ENSURE(context, output_eval != nullptr);
   449	
   450	    TF_LITE_ENSURE_OK(
   451	        context,
   452	        tflite::micro::CreateWritableTensorDimsWithCopy(
   453	            context, output, output_eval));
   454	
   455	    TfLiteIntArray* output_shape = output->dims;
   456	
   457	    const int output_rank =
   458	        NumDimensions(input) + NumDimensions(indices) -
   459	        1 - batch_dims;
   460	
   461	    TF_LITE_ENSURE(context, output_shape != nullptr);
   462	    TF_LITE_ENSURE(context, output_rank >= 0);
   463	
   464	    output_shape->size = output_rank;
   465	
   466	    int output_index = 0;
   467	
   468	    for (int i = 0; i < axis; ++i) {
   469	        output_shape->data[output_index++] = input->dims->data[i];
   470	    }
   471	
   472	    for (int i = batch_dims; i < indices->dims->size; ++i) {
   473	        output_shape->data[output_index++] = indices->dims->data[i];
   474	    }
   475	
   476	    for (int i = axis + 1; i < input->dims->size; ++i) {
   477	        output_shape->data[output_index++] = input->dims->data[i];
   478	    }
   479	
   480	    if (output_index != output_rank) {
   481	        MicroPrintf("Heatstroke GATHER output-rank calculation failed.");
   482	        return kTfLiteError;
   483	    }
   484	
   485	    micro_context->DeallocateTempTfLiteTensor(input);
   486	    micro_context->DeallocateTempTfLiteTensor(indices);
   487	    micro_context->DeallocateTempTfLiteTensor(output);
   488	
   489	    return kTfLiteOk;
   490	}
