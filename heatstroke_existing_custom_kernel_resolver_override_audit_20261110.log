   560	TFLMRegistration RegisterHeatstrokeGatherKernel()
   561	{
   562	    return micro::RegisterOp(
   563	        nullptr,
   564	        HeatstrokeGatherPrepare,
   565	        HeatstrokeGatherEval);
   566	}
