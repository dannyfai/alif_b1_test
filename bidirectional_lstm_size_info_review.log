    16	// Integer version of unidirectional sequence lstm. Only the standard LSTM
    17	// (defined in the keras LSTM layer, e.g., no peephole etc.) is supported here.
    18	// Currently used by the 16 bits activation case only
    19	
    20	#include <algorithm>
    21	#include <limits>
    22	
