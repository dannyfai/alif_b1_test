    37	void* UnidirectionalSequenceLstmInit(TfLiteContext* context, const char* buffer,
    38	                                     size_t length) {
    39	  TFLITE_DCHECK(context->AllocatePersistentBuffer != nullptr);
    40	  return context->AllocatePersistentBuffer(context, sizeof(OpDataLSTM));
    41	}
    42	
    43	TfLiteStatus UnidirectionalSequenceLstmPrepare(TfLiteContext* context,
    44	                                               TfLiteNode* node) {
    45	  TF_LITE_ENSURE_EQ(context, node->outputs->size, 1);
    46	  TF_LITE_ENSURE_EQ(context, node->inputs->size, 24);
    47	
    48	  TFLITE_DCHECK(node->builtin_data != nullptr);
    49	  TFLITE_DCHECK(node->user_data != nullptr);
    50	
    51	  OpDataLSTM* op_data = reinterpret_cast<OpDataLSTM*>(node->user_data);
    52	  const auto* builtin_data =
    53	      static_cast<TfLiteUnidirectionalSequenceLSTMParams*>(node->builtin_data);
    54	  // All TempTfLiteTensors will be deallocated through the destructor.
    55	  LstmTensors lstm_tensors(context, node);
    56	  TF_LITE_ENSURE_OK(context, lstm_tensors.ValidateTensorStatus(context));
    57	
    58	  op_data->cell_gate_nonlinear_type = builtin_data->activation;
    59	  op_data->size_info =
    60	      CreateLstmSizeInfo(builtin_data->time_major,
    61	                         lstm_tensors.GetInternalTensor(kLstmInputTensor)->dims,
    62	                         lstm_tensors.HiddenStateTensor()->dims);
    63	  TF_LITE_ENSURE_OK(
    64	      context, ValidateTensorSize(context, lstm_tensors, op_data->size_info));
    65	
    66	  // Create cell state information and gate parameters (Fully Connected and Mul)
    67	  auto cell_state_type =
    68	      lstm_tensors.GetInternalTensor(kLstmCellStateTensor)->type;
    69	  if (cell_state_type == kTfLiteFloat32) {
    70	    op_data->cell_state_info =
    71	        CreateLstmCellStateInfoFloat(builtin_data->cell_clip);
    72	    TF_LITE_ENSURE_OK(
    73	        context, PrepareGateParametersFloat(context, lstm_tensors, op_data));
    74	  } else if (cell_state_type == kTfLiteInt16) {
    75	    op_data->cell_state_info = CreateLstmCellStateInfo(
    76	        lstm_tensors.CellStateTensor()->params.scale, builtin_data->cell_clip);
    77	    TF_LITE_ENSURE_OK(
    78	        context, PrepareGateParametersInteger(context, lstm_tensors, op_data));
    79	  } else {
    80	    MicroPrintf(
    81	        "Cell state type %s (%d) not supported. The quantized Unidirectional "
    82	        "Sequence LSTM Op only support int16 cell state",
    83	        TfLiteTypeGetName(cell_state_type), cell_state_type);
    84	    return kTfLiteError;
    85	  }
    86	  // request buffers (four buffers)
    87	  for (size_t i = 0; i < 4; i++) {
    88	    TF_LITE_ENSURE_OK(context, context->RequestScratchBufferInArena(
    89	                                   context,
    90	                                   op_data->size_info.batch_size *
    91	                                       op_data->size_info.state_dimension *
    92	                                       TfLiteTypeGetSize(cell_state_type),
    93	                                   &(op_data->buffer_indices[i])));
    94	  }
    95	  return kTfLiteOk;
    96	}
    97	
    98	TfLiteStatus UnidirectionalSequenceLstmEval(TfLiteContext* context,
    99	                                            TfLiteNode* node) {
   100	  TFLITE_DCHECK(node->user_data != nullptr);
   101	  const OpDataLSTM& op_data = *reinterpret_cast<OpDataLSTM*>(node->user_data);
   102	  auto kernel_content = CreateLSTMKernelContent(context, node);
   103	
   104	  const auto activation_type =
   105	      kernel_content.internal_tensors[kLstmInputTensor]->type;
   106	  const auto weight_type =
   107	      kernel_content.internal_tensors[kLstmInputToInputWeightsTensor]->type;
   108	
   109	  switch (activation_type) {
   110	    case kTfLiteFloat32: {
   111	      LSTMBuffers<float> buffers =
   112	          CreateLSTMBuffers<float>(context, op_data.buffer_indices);
   113	      EvalLstm<float, float, float, float>(op_data, kernel_content, buffers);
   114	      break;
   115	    }

