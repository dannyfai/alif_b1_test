   31: class CombinedModel(nn.Module):
   32:     """
   33:     End-to-end pipeline:
   34:       x_reg -> Reg_Model -> restore observed values -> Cla_Model
   35:     """
   36: 
   37:     def __init__(self, reg_model: nn.Module, cla_model: nn.Module):
   38:         super().__init__()
   39:         self.reg_model = reg_model
   40:         self.cla_model = cla_model
   41: 
   42:     def forward(self, x_original, x_reg, x_mark, worker_features):
   43:         """
   44:         Args:
   45:             x_original:
   46:                 Original sequence before artificial missing-value masking,
   47:                 shape [B, 900, 6]. This corresponds to batch_x1_1.
   48:             x_reg:
   49:                 Sequence containing missing-value markers, shape [B, 900, 6].
   50:                 This corresponds to batch_x1_2.
   51:             x_mark:
   52:                 Time features, shape [B, 900, 3].
   53:             worker_features:
   54:                 Encoded worker features, shape [B, 30]. The first 18 values
   55:                 are used by Reg_Model and all 30 by Cla_Model.
   56: 
   57:         Returns:
   58:             rpe_logits: [B, 4]
   59:             psi_logits: [B, 4]
   60:         """
   61:         if x_original.shape != x_reg.shape:
   62:             raise ValueError(
   63:                 f"x_original and x_reg must have identical shapes; "
   64:                 f"got {tuple(x_original.shape)} and {tuple(x_reg.shape)}"
   65:             )
   66:         if x_reg.ndim != 3 or x_reg.shape[1:] != (900, 6):
   67:             raise ValueError(
   68:                 f"Expected x_reg shape [B, 900, 6], got {tuple(x_reg.shape)}"
   69:             )
   70:         if x_mark.shape != (x_reg.shape[0], 900, 3):
   71:             raise ValueError(
   72:                 f"Expected x_mark shape [B, 900, 3], got {tuple(x_mark.shape)}"
   73:             )
   74:         if worker_features.ndim != 2 or worker_features.shape[1] < 30:
   75:             raise ValueError(
   76:                 "worker_features must have shape [B, >=30]; "
   77:                 f"got {tuple(worker_features.shape)}"
   78:             )
   79: 
   80:         # Regression model uses the first 18 encoded worker features.
   81:         # Pass the input device explicitly because Reg_Model creates a zero
   82:         # tensor on the supplied device for a completely missing channel.
   83:         reg_prediction = self.reg_model(
   84:             x_reg,
   85:             x_mark_enc=x_mark,
   86:             one_hot_x=worker_features[:, :18],
   87:             device=x_reg.device,
   88:         )
   89: 
   90:         # Match the original run.py behavior:
   91:         # retain original values wherever x_reg is not a missing marker;
   92:         # use regression predictions only at -9997/-9998/-9999 positions.
   93:         missing_mask = (
   94:             (x_reg == -9997)
   95:             | (x_reg == -9998)
   96:             | (x_reg == -9999)
   97:         )
   98:         restored_sequence = torch.where(
   99:             missing_mask, reg_prediction, x_original
  100:         )
  101: 
  102:         # Classification model uses all 30 encoded worker features.
  103:         rpe_logits, psi_logits = self.cla_model(
  104:             restored_sequence,
  105:             x_mark_enc=x_mark,
  106:             one_hot_x=worker_features[:, :30],
  107:             device=x_reg.device,
  108:         )
  109:         return rpe_logits, psi_logits
  110: 
  111: 

