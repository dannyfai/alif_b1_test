   88: class Reg_Model(nn.Module):
   89:     def __init__(self):
   90:         super(Reg_Model, self).__init__()
   91:         self.seq_len = 900
   92:         # self.target_length = configs.seq_len
   93:         self.non_seq_len = 18
   94:         self.seq_feature_num = 6
   95:         self.time_feature_num = 3
   96:         self.hidden_dim1 = 256
   97:         self.e_layers = 1
   98:         self.dropout = 0.1
   99:         self.batch_first = True
  100:         self.rnn_type = 'BiLSTM'
  101:         bidirectional = True if 'Bi' in self.rnn_type else False
  102:         if self.non_seq_len > 0:
  103:             self.non_seq_enc = torch.nn.Linear(self.non_seq_len, self.seq_len)
  104: 
  105:         # single variate feature
  106:         self.compact_seq_len = self.seq_len * 2
  107:         svf = []
  108:         for i in range(self.seq_feature_num):
  109:             svf.append(nn.Linear(self.compact_seq_len, self.seq_len, bias=True))
  110:         self.svf = nn.ModuleList(svf)
  111: 
  112:         # cross-variate features
  113:         self.cvf = nn.Sequential(
  114:             nn.Conv1d(self.seq_feature_num, 16, kernel_size=3, stride=1, padding=1, padding_mode='reflect', bias=True),
  115:             nn.Conv1d(16, 32, kernel_size=5, stride=1, padding=2, padding_mode='reflect', bias=True),
  116:             nn.LayerNorm(self.seq_len),
  117:             nn.GELU(),
  118:             nn.Conv1d(32, 64, kernel_size=7, stride=1, padding=3, padding_mode='reflect', bias=True),
  119:             nn.Conv1d(64, 128, kernel_size=9, stride=1, padding=4, padding_mode='reflect', bias=True),
  120:             nn.LayerNorm(self.seq_len),
  121:             nn.GELU(),
  122:             nn.Conv1d(128, self.seq_feature_num, kernel_size=11, stride=1, padding=5, padding_mode='reflect', bias=True),
  123:         )
  124: 
  125:         # rnn encoder
  126:         rnn_input_size = self.seq_feature_num * 2 + self.time_feature_num + (1 if self.non_seq_len > 0 else 0)
  127:         if 'GRU' in self.rnn_type:
  128:             RNN = nn.GRU
  129:         else:
  130:             RNN = nn.LSTM
  131:         self.rnn = RNN(rnn_input_size, int(self.hidden_dim1 / 2), self.e_layers, batch_first=self.batch_first, bidirectional=bidirectional, bias=True)
  132: 
  133:         # projector
  134:         dim_in = self.hidden_dim1 if bidirectional else int(self.hidden_dim1 / 2)
  135:         proj = []
  136:         for i in range(self.seq_feature_num):
  137:             proj.append(
  138:                 nn.Sequential(
  139:                     nn.Linear(dim_in, int(self.hidden_dim1 / 2)),
  140:                     nn.LayerNorm(int(self.hidden_dim1 / 2)),
  141:                     nn.GELU(),
  142:                     nn.Dropout(self.dropout),
  143:                     nn.Linear(int(self.hidden_dim1 / 2), 1)
  144:                 )
  145:             )
  146:         self.proj = nn.ModuleList(proj)
  147: 
  148:     def forward(self, x, x_mark_enc=None, one_hot_x=None, device='cpu'):
  149:         B, L, N = x.shape
  150:         missing_mask = (x == -9997) | (x == -9998) | (x == -9999)
  151:         
  152:         if self.non_seq_len > 0:
  153:             non_seq_enc_out = self.non_seq_enc(one_hot_x)
  154:         else:
  155:             non_seq_enc_out = None
  156:         if x_mark_enc is not None and non_seq_enc_out is not None:
  157:             x_mark_enc = torch.cat((x_mark_enc, non_seq_enc_out.view(B, -1, 1)), dim=2)
  158: 
  159:         # --- Vectorized Single Variate Feature (SVF) processing ---
  160:         # Use torch.where instead of in-place boolean indexing to avoid JAX non-concrete index errors
  161:         x_masked = torch.where(missing_mask, torch.zeros_like(x), x)
  162:         
  163:         # Reshape to (B * N, 1, L) for batch-wise 1D adaptive average pooling
  164:         x_pooled_input = x_masked.permute(0, 2, 1).reshape(B * N, 1, L)
  165:         x_pooled = nn.functional.adaptive_avg_pool1d(x_pooled_input, self.compact_seq_len)
  166:         
  167:         # Reshape back to (B, compact_seq_len, N)
  168:         a = x_pooled.reshape(B, N, self.compact_seq_len).permute(0, 2, 1)
  169: 
  170:         svf_out = []
  171:         for i, l in enumerate(self.svf):
  172:             svf_out.append(l(a[:, :, i]))
  173:         svf_enc = torch.stack(svf_out, dim=2)
  174:         
  175:         # Also replace subsequent conditional assignments using torch.where for safety
  176:         svf_enc = torch.where(missing_mask, torch.zeros_like(svf_enc), svf_enc)
  177: 
  178:         # cross-variate features
  179:         b = x.clone()
  180:         b = torch.where(missing_mask, torch.full_like(b, float('nan')), b)
  181:         means = torch.tile(torch.nanmean(b, dim=1).unsqueeze(1), (1, self.seq_len, 1))
  182:         b = torch.where(missing_mask, means, b)
  183:         b = torch.nan_to_num(b, nan=0.0)
  184:         cvf_enc = self.cvf(b.permute(0, 2, 1)).permute(0, 2, 1)
  185:         cvf_enc = torch.where(missing_mask, torch.zeros_like(cvf_enc), cvf_enc)
  186: 
  187:         # rnn features
  188:         c = torch.where(missing_mask, torch.zeros_like(x), x)
  189:         emb = torch.cat(((svf_enc + cvf_enc) / 2, c), dim=2)
  190:         if x_mark_enc is not None:
  191:             emb = torch.cat((emb, x_mark_enc), dim=2)
  192:         enc, _ = self.rnn(emb)
  193: 
  194:         # projector
  195:         out = []
  196:         for i, l in enumerate(self.proj):
  197:             out.append(l(enc).reshape(B, L))
  198:         out = torch.stack(out, dim=2)
  199: 
  200:         return out
  201: 

