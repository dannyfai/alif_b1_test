#include <cstdint>
#include <fstream>
#include <iostream>
#include <iterator>
#include <vector>

#include "lite/schema/schema_generated.h"

int main(int argc, char** argv) {
    if (argc != 2) {
        std::cerr << "Usage: inspect_bilstm_state MODEL.tflite\n";
        return 2;
    }

    std::ifstream file(argv[1], std::ios::binary);
    if (!file) {
        std::cerr << "Cannot open model\n";
        return 3;
    }

    std::vector<uint8_t> data(
        (std::istreambuf_iterator<char>(file)),
        std::istreambuf_iterator<char>());

    const tflite::Model* model = tflite::GetModel(data.data());

    if (!model || !model->subgraphs() ||
        model->subgraphs()->size() == 0) {
        std::cerr << "Invalid model or no subgraphs\n";
        return 4;
    }

    const tflite::SubGraph* sg = model->subgraphs()->Get(0);
    const auto* tensors = sg->tensors();
    const auto* operators = sg->operators();
    const auto* opcodes = model->operator_codes();

    std::cout << "MODEL_VERSION: " << model->version() << "\n";
    std::cout << "TENSOR_COUNT: " << tensors->size() << "\n";
    std::cout << "OPERATOR_COUNT: " << operators->size() << "\n";

    std::cout << "\n===== ALL VARIABLE TENSORS =====\n";
    int variable_count = 0;

    for (uint32_t i = 0; i < tensors->size(); ++i) {
        const auto* t = tensors->Get(i);

        if (!t->is_variable()) continue;

        ++variable_count;

        std::cout << "INDEX: " << i
                  << " NAME: "
                  << (t->name() ? t->name()->c_str() : "(unnamed)")
                  << " SHAPE: ";

        if (t->shape()) {
            for (uint32_t j = 0; j < t->shape()->size(); ++j)
                std::cout << t->shape()->Get(j) << " ";
        }

        std::cout << " TYPE: " << static_cast<int>(t->type())
                  << " IS_VARIABLE: " << t->is_variable() << "\n";
    }

    std::cout << "VARIABLE_TENSOR_COUNT: "
              << variable_count << "\n";

    std::cout << "\n===== BIDIRECTIONAL LSTM OPERATORS =====\n";

    int found = 0;

    for (uint32_t oi = 0; oi < operators->size(); ++oi) {
        const auto* op = operators->Get(oi);
        const auto* opcode = opcodes->Get(op->opcode_index());

        if (static_cast<int>(opcode->builtin_code()) != 52)
            continue;

        ++found;

        const auto* inputs = op->inputs();

        std::cout << "\nOPERATOR_INDEX: " << oi << "\n";
        std::cout << "INPUT_COUNT: " << inputs->size() << "\n";

        for (int slot : {25, 26, 27, 28}) {
            if (slot >= static_cast<int>(inputs->size())) {
                std::cout << "ERROR: MISSING SLOT " << slot << "\n";
                continue;
            }

            int tensor_index = inputs->Get(slot);

            if (tensor_index < 0 ||
                tensor_index >= static_cast<int>(tensors->size())) {
                std::cout << "ERROR: INVALID STATE SLOT "
                          << slot << " INDEX " << tensor_index << "\n";
                continue;
            }

            const auto* t = tensors->Get(tensor_index);

            std::cout << "STATE_SLOT: " << slot
                      << " TENSOR_INDEX: " << tensor_index
                      << " NAME: "
                      << (t->name() ? t->name()->c_str() : "(unnamed)")
                      << " SHAPE: ";

            if (t->shape()) {
                for (uint32_t j = 0; j < t->shape()->size(); ++j)
                    std::cout << t->shape()->Get(j) << " ";
            }

            std::cout << " TYPE: " << static_cast<int>(t->type())
                      << " IS_VARIABLE: " << t->is_variable()
                      << "\n";
        }
    }

    std::cout << "\nBIDIRECTIONAL_LSTM_COUNT: " << found << "\n";

    return found == 2 ? 0 : 5;
}

