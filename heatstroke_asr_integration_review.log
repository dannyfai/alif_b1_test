    92	extern volatile uint8_t button_pressed;
    93	static struct gpio_callback button_cb_data;
    94	static bool por_boot;
    95	static struct k_sem button_wait_sem;
    96	
    97	static void button_callback(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
    98	{
    99		ARG_UNUSED(dev);
   100		ARG_UNUSED(cb);
   101		ARG_UNUSED(pins);
   102	
   103		if (por_boot) {
   104			/* Ignore button press event if it's from POR boot, as the button state may be unstable during POR. */
   105			return;
   106		}
   107	
   108		int val = gpio_pin_get_dt(&lpgpio_config);  // 1 = pressed, 0 = released
   109	    if (val < 0) {
   110	        LOG_ERR("Failed to read pin: %d", val);
   111	        return;
   112	    }
   113	
   114	    button_pressed = (val == 1);
   115	    LOG_INF("Button %s", button_pressed ? "pressed" : "released");
   116	
   117		if (!k_sem_count_get(&button_wait_sem) && button_pressed) {
   118			k_sem_give(&button_wait_sem);
   119		}
   120	}
   121	
   122	/**
   123	 * Configure LPGPIO0 and LPGPIO1 as inputs with interrupts
   124	 * With B1/E1C need to connect wire between SW5 (P5_7) and P15_0 to use button as Push-to-talk button.
   125	 * With B1/E1C devkit you need to also remove resistor R64. */
   126	static int configure_lpgpio(void)
   127	{
   128		int ret;
   129		const struct gpio_dt_spec *spec = &lpgpio_config;
   130	
   131		if (!spec || !spec->port) {
   132			/* Just ignore */
   133			LOG_ERR("lpgpio invalid");
   134			return -ENODEV;
   135		}
   136	
   137		/* Configure LPGPIO0 for wakeup */
   138		if (!gpio_is_ready_dt(spec)) {
   139			LOG_ERR("LPGPIO0 device is not ready");
   140			return -ENODEV;
   141		}
   142	
   143		ret = gpio_pin_configure_dt(spec, GPIO_INPUT | spec->dt_flags);
   144		if (ret != 0) {
   145			LOG_ERR("Failed to configure LPGPIO as input: %d", ret);
   146			return ret;
   147		}
   148	
   149		ret = gpio_pin_interrupt_configure_dt(spec,
   150						      GPIO_INT_EDGE_BOTH);
   151		if (ret != 0) {
   152			LOG_ERR("Failed to configure LPGPIO interrupt: %d", ret);
   153			return ret;
   154		}
   155	
   156		gpio_init_callback(&button_cb_data, button_callback, BIT(spec->pin));
   157		ret = gpio_add_callback(spec->port, &button_cb_data);
   158		if (ret != 0) {
   159			LOG_ERR("Failed to add button callback: %d", ret);
   160			return ret;
   161		}
   162	
   163		LOG_INF("LPGPIO%d configured", spec->pin);
   164	
   165		return 0;
   166	}
