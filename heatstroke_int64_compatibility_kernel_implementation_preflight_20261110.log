   28: template <typename T>
   29: TfLiteStatus SplitImpl(TfLiteContext* context, TfLiteNode* node,
   30:                        const TfLiteEvalTensor* input, int axis_value) {
   31:   const TfLiteIntArray* input_dims = input->dims;
   32:   const TfLiteEvalTensor* output0 =
   33:       tflite::micro::GetEvalOutput(context, node, 0);
   34: 
   35:   const int split_dimensions = input_dims->size;
   36: 
   37:   TFLITE_DCHECK_LT(axis_value, split_dimensions);
   38:   TFLITE_DCHECK_EQ(output0->dims->size, split_dimensions);
   39: 
   40:   int64_t split_size = 0;
   41:   const int output_count = NumOutputs(node);
   42:   for (int i = 0; i < output_count; i++) {
   43:     split_size +=
   44:         tflite::micro::GetEvalOutput(context, node, i)->dims->data[axis_value];
   45:   }
   46:   TFLITE_DCHECK_EQ(split_size, input_dims->data[axis_value]);
   47:   int64_t outer_size = 1;
   48:   for (int i = 0; i < axis_value; ++i) {
   49:     outer_size *= input_dims->data[i];
   50:   }
   51: 
   52:   int64_t base_inner_size = 1;
   53:   for (int i = axis_value + 1; i < split_dimensions; ++i) {
   54:     base_inner_size *= input_dims->data[i];
   55:   }
   56: 
   57:   const T* input_ptr = tflite::micro::GetTensorData<T>(input);
   58:   for (int k = 0; k < outer_size; ++k) {
   59:     for (int i = 0; i < output_count; ++i) {
   60:       TfLiteEvalTensor* output_tensor =
   61:           tflite::micro::GetEvalOutput(context, node, i);
   62:       T* output_data = tflite::micro::GetTensorData<T>(output_tensor);
   63:       const int copy_size =
   64:           output_tensor->dims->data[axis_value] * base_inner_size;
   65:       T* output_ptr = output_data + k * copy_size;
   66:       for (int j = 0; j < copy_size; ++j) output_ptr[j] = input_ptr[j];
   67:       input_ptr += copy_size;
   68:     }
   69:   }
   70: 
   71:   return kTfLiteOk;
   72: }
   73: 
   74: TfLiteStatus SplitVPrepare(TfLiteContext* context, TfLiteNode* node) {
   75:   TF_LITE_ENSURE_EQ(context, NumInputs(node), 3);
   76: 
   77:   MicroContext* micro_context = GetMicroContext(context);
   78:   // Dynamic output tensors are needed if axis tensor is not constant.
   79:   // But Micro doesn't support dynamic memory allocation, so we only support
   80:   // constant axis tensor for now.
   81:   TfLiteTensor* axis = micro_context->AllocateTempInputTensor(node, 2);
   82:   TF_LITE_ENSURE_MSG(context, IsConstantTensor(axis),
   83:                      "Non constant axis tensor not supported");
   84:   micro_context->DeallocateTempTfLiteTensor(axis);
   85:   return kTfLiteOk;
   86: }
   87: 
   88: TfLiteStatus SplitVEval(TfLiteContext* context, TfLiteNode* node) {
   89:   const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
   90:   const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 2);
   91: 
   92:   int axis_value = tflite::micro::GetTensorData<int32_t>(axis)[0];
   93:   if (axis_value < 0) {
   94:     axis_value += input->dims->size;
   95:   }
   96: 
   97:   TF_LITE_ENSURE(context, axis_value >= 0);
   98:   TF_LITE_ENSURE(context, axis_value < input->dims->size);
   99: 
  100:   switch (input->type) {
  101:     case kTfLiteFloat32: {
  102:       return SplitImpl<float>(context, node, input, axis_value);
  103:     }
  104:     case kTfLiteInt8: {
  105:       return SplitImpl<int8_t>(context, node, input, axis_value);
  106:     }
  107:     case kTfLiteInt16: {
  108:       return SplitImpl<int16_t>(context, node, input, axis_value);
  109:     }
  110:     case kTfLiteInt32: {
  111:       return SplitImpl<int32_t>(context, node, input, axis_value);
  112:     }
  113:     default:
  114:       MicroPrintf("Type %s currently not supported.",
  115:                   TfLiteTypeGetName(input->type));
  116:       return kTfLiteError;
  117:   }
  118:   return kTfLiteOk;
  119: }
  120: 
  121: }  // namespace
  122: 
  123: TFLMRegistration Register_SPLIT_V() {
  124:   return tflite::micro::RegisterOp(nullptr, SplitVPrepare, SplitVEval);
  125: }
  126: 
  127: }  // namespace tflite

