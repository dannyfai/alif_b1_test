   52: /*
   53:  * Application-local INT32 SIGN implementation.
   54:  *
   55:  * y = -1 when x < 0
   56:  * y =  0 when x = 0
   57:  * y =  1 when x > 0
   58:  *
   59:  * No temporary buffer or scratch allocation is required.
   60:  */
   61: TfLiteStatus HeatstrokeSignEval(
   62:     TfLiteContext* context,
   63:     TfLiteNode* node)
   64: {
   65:     if (context == nullptr || node == nullptr) {
   66:         return kTfLiteError;
   67:     }
   68: 
   69:     const TfLiteEvalTensor* input =
   70:         tflite::micro::GetEvalInput(context, node, 0);
   71: 
   72:     TfLiteEvalTensor* output =
   73:         tflite::micro::GetEvalOutput(context, node, 0);
   74: 
   75:     if (input == nullptr || output == nullptr) {
   76:         return kTfLiteError;
   77:     }
   78: 
   79:     if (input->type != kTfLiteInt32 ||
   80:         output->type != kTfLiteInt32) {
   81:         MicroPrintf(
   82:             "Heatstroke SIGN requires INT32 input/output. "
   83:             "Input=%d Output=%d",
   84:             input->type,
   85:             output->type);
   86:         return kTfLiteError;
   87:     }
   88: 
   89:     const auto input_shape =
   90:         tflite::micro::GetTensorShape(input);
   91: 
   92:     const auto output_shape =
   93:         tflite::micro::GetTensorShape(output);
   94: 
   95:     const int input_count = input_shape.FlatSize();
   96:     const int output_count = output_shape.FlatSize();
   97: 
   98:     if (input_count < 0 || input_count != output_count) {
   99:         MicroPrintf(
  100:             "Heatstroke SIGN tensor element-count mismatch.");
  101:         return kTfLiteError;
  102:     }
  103: 
  104:     const int32_t* input_data =
  105:         tflite::micro::GetTensorData<int32_t>(input);
  106: 
  107:     int32_t* output_data =
  108:         tflite::micro::GetTensorData<int32_t>(output);
  109: 
  110:     if (input_count > 0 &&
  111:         (input_data == nullptr || output_data == nullptr)) {
  112:         MicroPrintf(
  113:             "Heatstroke SIGN received a null tensor data pointer.");
  114:         return kTfLiteError;
  115:     }
  116: 
  117:     for (int i = 0; i < input_count; ++i) {
  118:         const int32_t value = input_data[i];
  119: 
  120:         output_data[i] =
  121:             (value > 0) ? 1 : ((value < 0) ? -1 : 0);
  122:     }
  123: 
  124:     return kTfLiteOk;
  125: }
