   39: TfLiteStatus CalculateOpData(TfLiteContext* context, TfLiteNode* node) {
   40:   MicroContext* micro_context = GetMicroContext(context);
   41: 
   42:   TF_LITE_ENSURE_EQ(context, NumInputs(node), 2);
   43:   TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
   44: 
   45:   TfLiteTensor* input1 =
   46:       micro_context->AllocateTempInputTensor(node, kInputTensor1);
   47:   TF_LITE_ENSURE(context, input1 != nullptr);
   48:   TfLiteTensor* input2 =
   49:       micro_context->AllocateTempInputTensor(node, kInputTensor2);
   50:   TF_LITE_ENSURE(context, input2 != nullptr);
   51:   TfLiteTensor* output =
   52:       micro_context->AllocateTempOutputTensor(node, kOutputTensor);
   53:   TF_LITE_ENSURE(context, output != nullptr);
   54: 
   55:   TF_LITE_ENSURE_TYPES_EQ(context, input1->type, input2->type);
   56:   TF_LITE_ENSURE_TYPES_EQ(context, input1->type, output->type);
   57: 
   58:   micro_context->DeallocateTempTfLiteTensor(input1);
   59:   micro_context->DeallocateTempTfLiteTensor(input2);
   60:   micro_context->DeallocateTempTfLiteTensor(output);
   61: 
   62:   return kTfLiteOk;
   63: }
   64: 
   65: void* FloorModInit(TfLiteContext* context, const char* buffer, size_t length) {
   66:   return nullptr;
   67: }
   68: 
   69: TfLiteStatus FloorModPrepare(TfLiteContext* context, TfLiteNode* node) {
   70:   return CalculateOpData(context, node);
   71: }
   72: 
   73: template <typename T>
   74: TfLiteStatus EvalFloorMod(TfLiteContext* context, bool requires_broadcast,
   75:                           const TfLiteEvalTensor* input1,
   76:                           const TfLiteEvalTensor* input2,
   77:                           TfLiteEvalTensor* output) {
   78:   const T* denominator_data = tflite::micro::GetTensorData<T>(input2);
   79: 
   80:   if (requires_broadcast) {
   81:     reference_ops::BroadcastBinaryFunction4DSlow<T, T, T>(
   82:         tflite::micro::GetTensorShape(input1),
   83:         tflite::micro::GetTensorData<T>(input1),
   84:         tflite::micro::GetTensorShape(input2), denominator_data,
   85:         tflite::micro::GetTensorShape(output),
   86:         tflite::micro::GetTensorData<T>(output), reference_ops::FloorMod<T>);
   87:   } else {
   88:     reference_ops::BinaryFunction<T, T, T>(
   89:         tflite::micro::GetTensorShape(input1),
   90:         tflite::micro::GetTensorData<T>(input1),
   91:         tflite::micro::GetTensorShape(input2), denominator_data,
   92:         tflite::micro::GetTensorShape(output),
   93:         tflite::micro::GetTensorData<T>(output), reference_ops::FloorMod<T>);
   94:   }
   95: 
   96:   return kTfLiteOk;
   97: }
   98: 
   99: TfLiteStatus FloorModEval(TfLiteContext* context, TfLiteNode* node) {
  100:   const TfLiteEvalTensor* input1 =
  101:       tflite::micro::GetEvalInput(context, node, kInputTensor1);
  102:   const TfLiteEvalTensor* input2 =
  103:       tflite::micro::GetEvalInput(context, node, kInputTensor2);
  104:   TfLiteEvalTensor* output =
  105:       tflite::micro::GetEvalOutput(context, node, kOutputTensor);
  106: 
  107:   bool requires_broadcast = !tflite::micro::HaveSameShapes(input1, input2);
  108: 
  109:   switch (input1->type) {
  110:     case kTfLiteFloat32: {
  111:       return EvalFloorMod<float>(context, requires_broadcast, input1, input2,
  112:                                  output);
  113:     }
  114:     default: {
  115:       MicroPrintf("Type '%s' is not supported by FLOOR_MOD.",
  116:                   TfLiteTypeGetName(input1->type));
  117:       return kTfLiteError;
  118:     }
  119:   }
  120: }
  121: 
  122: }  // namespace
