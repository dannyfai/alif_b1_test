   31: TfLiteStatus MulEval(TfLiteContext* context, TfLiteNode* node) {
   32:   TFLITE_DCHECK(node->builtin_data != nullptr);
   33:   auto* params = reinterpret_cast<TfLiteMulParams*>(node->builtin_data);
   34: 
   35:   TFLITE_DCHECK(node->user_data != nullptr);
   36:   const OpDataMul* data = static_cast<const OpDataMul*>(node->user_data);
   37: 
   38:   const TfLiteEvalTensor* input1 =
   39:       tflite::micro::GetEvalInput(context, node, kMulInput1Tensor);
   40:   const TfLiteEvalTensor* input2 =
   41:       tflite::micro::GetEvalInput(context, node, kMulInput2Tensor);
   42:   TfLiteEvalTensor* output =
   43:       tflite::micro::GetEvalOutput(context, node, kMulOutputTensor);
   44: 
   45:   switch (input1->type) {
   46:     case kTfLiteInt8:
   47:     case kTfLiteInt16:
   48:     case kTfLiteInt32:
   49:       EvalMulQuantizedReference(context, node, data, input1, input2, output);
   50:       break;
   51:     case kTfLiteFloat32:
   52:       EvalMulFloatReference(context, node, params, data, input1, input2,
   53:                             output);
   54:       break;
   55:     default:
   56:       MicroPrintf("Type %s (%d) not supported.",
   57:                   TfLiteTypeGetName(input1->type), input1->type);
   58:       return kTfLiteError;
   59:   }
   60: 
   61:   return kTfLiteOk;
