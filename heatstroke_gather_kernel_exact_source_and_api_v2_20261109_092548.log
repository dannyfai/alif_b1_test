    27	constexpr int kInputTensor = 0;
    28	constexpr int kInputPositions = 1;
    29	constexpr int kOutputTensor = 0;
    30	
    31	template <typename InputT, typename CoordsT = int32_t>
    32	TfLiteStatus Gather(const TfLiteGatherParams* params,
    33	                    const TfLiteEvalTensor* input,
    34	                    const TfLiteEvalTensor* coords, TfLiteEvalTensor* output) {
    35	  const InputT* input_data = tflite::micro::GetTensorData<InputT>(input);
    36	  const CoordsT* coords_data = tflite::micro::GetTensorData<CoordsT>(coords);
    37	  InputT* output_data = tflite::micro::GetTensorData<InputT>(output);
    38	  const TfLiteIntArray* input_dims = input->dims;
    39	  const int input_dims_size = input_dims->size;
    40	  int axis = params->axis;
    41	  if (axis < 0) {
    42	    axis += input_dims_size;
    43	  }
    44	  TFLITE_DCHECK_GE(axis, 0);
    45	  TFLITE_DCHECK_LT(axis, input_dims_size);
    46	
    47	  int batch_dims = params->batch_dims;
    48	  // batch_dims should be in range: [-rank(coords), rank(coords)].
    49	  // Negative batch_dims is added with rank of coords.
    50	  const TfLiteIntArray* coords_dims = coords->dims;
    51	  const int coords_dims_size = coords_dims->size;
    52	  if (batch_dims < 0) {
    53	    batch_dims += coords_dims_size;
    54	  }
    55	  TFLITE_DCHECK_GE(batch_dims, 0);
    56	  TFLITE_DCHECK_LT(batch_dims, input_dims_size);
    57	  TFLITE_DCHECK_LE(batch_dims, coords_dims_size);
    58	  TFLITE_DCHECK_GE(axis, batch_dims);
    59	  for (int i = 0; i < batch_dims; ++i) {
    60	    TFLITE_DCHECK_EQ(input_dims->data[i], coords_dims->data[i]);
    61	  }
    62	
    63	  const int axis_size = input_dims->data[axis];
    64	
    65	  int batch_size = 1;
    66	  for (int i = 0; i < batch_dims; ++i) {
    67	    batch_size *= input_dims->data[i];
    68	  }
    69	  int outer_size = 1;
    70	  for (int i = batch_dims; i < axis; ++i) {
    71	    outer_size *= input_dims->data[i];
    72	  }
    73	  int inner_size = 1;
    74	  for (int i = axis + 1; i < input_dims_size; ++i) {
    75	    inner_size *= input_dims->data[i];
    76	  }
    77	  int coord_size = 1;
    78	  for (int i = batch_dims; i < coords_dims_size; ++i) {
    79	    coord_size *= coords_dims->data[i];
    80	  }
    81	
    82	  for (int batch = 0; batch < batch_size; ++batch) {
    83	    for (int outer = 0; outer < outer_size; ++outer) {
    84	      for (int coord = 0; coord < coord_size; ++coord) {
    85	        TFLITE_DCHECK_GE(coords_data[coord], 0);
    86	        TFLITE_DCHECK_LT(coords_data[coord], axis_size);
    87	        std::memcpy(output_data +
    88	                        (((batch * outer_size) + outer) * coord_size + coord) *
    89	                            inner_size,
    90	                    input_data + (((batch * outer_size) + outer) * axis_size +
    91	                                  coords_data[batch * coord_size + coord]) *
    92	                                     inner_size,
    93	                    sizeof(InputT) * inner_size);
    94	      }
    95	    }
    96	  }
    97	  return kTfLiteOk;
    98	}
