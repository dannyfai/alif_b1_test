   313	void PopulateDirectionContents(TfLiteContext* context,
   314	                               TfLiteNode* node,
   315	                               int input_weight_base,
   316	                               int recurrent_weight_base,
   317	                               int bias_base,
   318	                               int hidden_state_position,
   319	                               int cell_state_position,
   320	                               const TfLiteEvalTensor* input,
   321	                               TfLiteEvalTensor* staged_output,
   322	                               LSTMKernelContents* contents) {
   323	  for (int i = 0; i < 24; ++i) {
   324	    contents->internal_tensors[i] = nullptr;
   325	  }
   326	
   327	  contents->internal_tensors[0] =
   328	      const_cast<TfLiteEvalTensor*>(input);
   329	
   330	  for (int gate = 0; gate < 4; ++gate) {
   331	    contents->internal_tensors[1 + gate] =
   332	        GetInputEvalTensor(context, node, input_weight_base + gate);
   333	
   334	    contents->internal_tensors[5 + gate] =
   335	        GetInputEvalTensor(context, node, recurrent_weight_base + gate);
   336	
   337	    contents->internal_tensors[12 + gate] =
   338	        GetInputEvalTensor(context, node, bias_base + gate);
   339	  }
   340	
   341	  // Optional peephole, projection, and layer-normalization tensors
   342	  // are not present in this model and remain nullptr.
   343	
   344	  contents->internal_tensors[18] =
   345	      GetInputEvalTensor(context, node, hidden_state_position);
   346	
   347	  contents->internal_tensors[19] =
   348	      GetInputEvalTensor(context, node, cell_state_position);
   349	
   350	  contents->output_tensor = staged_output;
   351	}
