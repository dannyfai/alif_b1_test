   353	TfLiteStatus HeatstrokeBidirectionalLstmEval(TfLiteContext* context,
   354	                                             TfLiteNode* node) {
   355	  if (node == nullptr || node->user_data == nullptr) {
   356	    return kTfLiteError;
   357	  }
   358	
   359	  const auto* op_data =
   360	      static_cast<const HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   361	
   362	  const TfLiteEvalTensor* input =
   363	      GetInputEvalTensor(context, node, 0);
   364	
   365	  TfLiteEvalTensor* output =
   366	      context->GetEvalTensor(context, node->outputs->data[0]);
   367	
   368	  if (!IsFloatTensor(input) || !IsFloatTensor(output)) {
   369	    return kTfLiteError;
   370	  }
   371	
   372	  const int time_steps = op_data->forward.size_info.time_steps;
   373	  const int input_dimension = op_data->forward.size_info.input_dimension;
   374	  const int hidden = op_data->forward.size_info.state_dimension;
   375	
   376	  auto* reversed_input = static_cast<float*>(
   377	      context->GetScratchBuffer(
   378	          context, op_data->reverse_input_buffer));
   379	
   380	  auto* staged_output = static_cast<float*>(
   381	      context->GetScratchBuffer(
   382	          context, op_data->stage_output_buffer));
   383	
   384	  if (reversed_input == nullptr || staged_output == nullptr) {
   385	    MicroPrintf("Heatstroke BiLSTM: scratch buffer unavailable");
   386	    return kTfLiteError;
   387	  }
   388	
   389	  const float* input_data = input->data.f;
   390	  float* output_data = output->data.f;
   391	
   392	  // Reverse the time dimension for the backward direction.
   393	  for (int t = 0; t < time_steps; ++t) {
   394	    std::memcpy(
   395	        reversed_input + t * input_dimension,
   396	        input_data + (time_steps - 1 - t) * input_dimension,
   397	        input_dimension * sizeof(float));
   398	  }
   399	
   400	  TfLiteEvalTensor reversed_input_tensor = *input;
   401	  reversed_input_tensor.data.f = reversed_input;
   402	
   403	  TfLiteEvalTensor staged_output_tensor = *output;
   404	  staged_output_tensor.data.f = staged_output;
   405	  staged_output_tensor.dims = op_data->staged_output_dims;
   406	
   407	  LSTMKernelContents forward_contents{};
   408	  PopulateDirectionContents(context, node, 1, 5, 9, 25, 26, input, &staged_output_tensor, &forward_contents);
   409	
   410	  LSTMBuffers<float> buffers =
   411	      CreateLSTMBuffers<float>(context, op_data->forward.buffer_indices);
   412	
   413	  TfLiteStatus forward_status =
   414	      EvalLstm<float, float, float, float>(
   415	          op_data->forward, forward_contents, buffers);
   416	  if (forward_status != kTfLiteOk) {
   417	    return forward_status;
   418	  }
   419	
   420	  // Copy forward outputs into the first half of the merged output.
   421	  for (int t = 0; t < time_steps; ++t) {
   422	    std::memcpy(
   423	        output_data + t * (2 * hidden),
   424	        staged_output + t * hidden,
   425	        hidden * sizeof(float));
   426	  }
   427	
   428	  LSTMKernelContents backward_contents{};
   429	  PopulateDirectionContents(context, node, 13, 17, 21, 27, 28, &reversed_input_tensor, &staged_output_tensor, &backward_contents);
   430	
   431	  TfLiteStatus backward_status =
   432	      EvalLstm<float, float, float, float>(
   433	          op_data->backward, backward_contents, buffers);
   434	  if (backward_status != kTfLiteOk) {
   435	    return backward_status;
   436	  }
   437	
   438	  // Restore backward outputs to original time order and copy them
   439	  // into the second half of the merged output.
   440	  for (int t = 0; t < time_steps; ++t) {
   441	    std::memcpy(
   442	        output_data + t * (2 * hidden) + hidden,
   443	        staged_output + (time_steps - 1 - t) * hidden,
   444	        hidden * sizeof(float));
   445	  }
   446	
   447	  return kTfLiteOk;
   448	}
