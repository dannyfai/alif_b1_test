bool GetElementCount(const TfLiteIntArray* dims, size_t* result)
{
    if (dims == nullptr || result == nullptr || dims->size < 0) {
        return false;
    }

    size_t count = 1U;

    for (int i = 0; i < dims->size; ++i) {
        const int dimension = dims->data[i];

        if (dimension < 0) {
            return false;
        }

        if (dimension == 0) {
            count = 0U;
            continue;
        }

        if (count > std::numeric_limits<size_t>::max() /
                        static_cast<size_t>(dimension)) {
            return false;
        }

        count *= static_cast<size_t>(dimension);
    }

    *result = count;
    return true;
}

bool SameShape(const TfLiteIntArray* a, const TfLiteIntArray* b)
{
    if (a == nullptr || b == nullptr || a->size != b->size) {
        return false;
    }

    for (int i = 0; i < a->size; ++i) {
        if (a->data[i] != b->data[i]) {
            return false;
        }
    }

    return true;
}

template <typename FromT, typename ToT>
TfLiteStatus CopyCast(
    const TfLiteEvalTensor* input,
    TfLiteEvalTensor* output,
    size_t count)
{
    const FromT* source = micro::GetTensorData<FromT>(input);
    ToT* destination = micro::GetTensorData<ToT>(output);

    if (count != 0U && (source == nullptr || destination == nullptr)) {
        MicroPrintf("Heatstroke CAST: null tensor data pointer.");
        return kTfLiteError;
    }

    for (size_t i = 0U; i < count; ++i) {
        destination[i] = static_cast<ToT>(source[i]);
    }

    return kTfLiteOk;
}

TfLiteStatus HeatstrokeCastPrepare(
    TfLiteContext* context,
    TfLiteNode* node)
{
    if (node == nullptr ||
        node->inputs == nullptr ||
        node->outputs == nullptr ||
        node->inputs->size != 1 ||
        node->outputs->size != 1 ||
        node->builtin_data == nullptr) {
        MicroPrintf("Heatstroke CAST: invalid node or parameters.");
        return kTfLiteError;
    }

    return kTfLiteOk;
}

TfLiteStatus HeatstrokeCastEval(
    TfLiteContext* context,
    TfLiteNode* node)
{
    if (context == nullptr || node == nullptr ||
        node->builtin_data == nullptr) {
        return kTfLiteError;
    }

    const TfLiteEvalTensor* input =
        micro::GetEvalInput(context, node, 0);
    TfLiteEvalTensor* output =
        micro::GetEvalOutput(context, node, 0);

    if (input == nullptr || output == nullptr) {
        MicroPrintf("Heatstroke CAST: missing input or output.");
        return kTfLiteError;
    }

    const auto* params =
        static_cast<const TfLiteCastParams*>(node->builtin_data);

    if (params->in_data_type != input->type ||
        params->out_data_type != output->type) {
        MicroPrintf("Heatstroke CAST: FlatBuffer type contract mismatch.");
        return kTfLiteError;
    }

    if (!SameShape(input->dims, output->dims)) {
        MicroPrintf("Heatstroke CAST: input/output shapes differ.");
        return kTfLiteError;
    }

    size_t count = 0U;
    if (!GetElementCount(input->dims, &count)) {
        MicroPrintf("Heatstroke CAST: invalid tensor dimensions.");
        return kTfLiteError;
    }

    // These are the six conversion combinations found in this model.
    switch (input->type) {
        case kTfLiteBool:
            if (output->type == kTfLiteFloat32) {
                return CopyCast<bool, float>(input, output, count);
            }
            if (output->type == kTfLiteInt64) {
                return CopyCast<bool, int64_t>(input, output, count);
            }
            break;

        case kTfLiteInt32:
            if (output->type == kTfLiteInt64) {
                return CopyCast<int32_t, int64_t>(
                    input, output, count);
            }
            break;

        case kTfLiteInt64:
            if (output->type == kTfLiteBool) {
                return CopyCast<int64_t, bool>(
                    input, output, count);
            }

            if (output->type == kTfLiteFloat32) {
                return CopyCast<int64_t, float>(
                    input, output, count);
            }

            if (output->type == kTfLiteInt32) {
                const int64_t* source =
                    micro::GetTensorData<int64_t>(input);
                int32_t* destination =
                    micro::GetTensorData<int32_t>(output);

                if (count != 0U &&
                    (source == nullptr || destination == nullptr)) {
                    return kTfLiteError;
                }

                for (size_t i = 0U; i < count; ++i) {
                    if (source[i] <
                            static_cast<int64_t>(
                                std::numeric_limits<int32_t>::min()) ||
                        source[i] >
                            static_cast<int64_t>(
                                std::numeric_limits<int32_t>::max())) {
                        MicroPrintf(
                            "Heatstroke CAST: INT64-to-INT32 overflow.");
                        return kTfLiteError;
                    }

                    destination[i] = static_cast<int32_t>(source[i]);
                }

                return kTfLiteOk;
            }
            break;

        default:
            break;
    }

    MicroPrintf(
        "Heatstroke CAST: unsupported conversion %s -> %s.",
        TfLiteTypeGetName(input->type),
        TfLiteTypeGetName(output->type));

    return kTfLiteError;
}

void* HeatstrokeSumInit(
    TfLiteContext* context,
    const char* buffer,
    size_t length)
{
    if (context == nullptr ||
        context->AllocatePersistentBuffer == nullptr) {
        return nullptr;
    }

    void* storage = context->AllocatePersistentBuffer(
        context, sizeof(OpDataReduce));

    if (storage == nullptr) {
        return nullptr;
    }

    return new (storage) OpDataReduce{};
}

TfLiteStatus HeatstrokeSumPrepare(
    TfLiteContext* context,
    TfLiteNode* node)
{
    if (node == nullptr || node->user_data == nullptr) {
        MicroPrintf("Heatstroke SUM: missing operator data.");
        return kTfLiteError;
    }

    // Retain the stock preparation path for FP32 and quantized SUM.
    // INT64 does not require its quantized scratch buffer.
    return PrepareMeanOrSumHelper(
        context,
        node,
        static_cast<OpDataReduce*>(node->user_data));
}

TfLiteStatus HeatstrokeSumInt64Eval(
    TfLiteContext* context,
    TfLiteNode* node,
    const TfLiteEvalTensor* input,
    const TfLiteEvalTensor* axis,
    TfLiteEvalTensor* output)
{
    if (input == nullptr || axis == nullptr || output == nullptr ||
        input->dims == nullptr || axis->dims == nullptr ||
        output->dims == nullptr) {
        return kTfLiteError;
    }

    if (output->type != kTfLiteInt64 ||
        axis->type != kTfLiteInt32 ||
        input->dims->size != 3) {
        MicroPrintf("Heatstroke SUM INT64: unsupported tensor contract.");
        return kTfLiteError;
    }

    size_t axis_count = 0U;
    if (!GetElementCount(axis->dims, &axis_count) || axis_count != 1U) {
        MicroPrintf("Heatstroke SUM INT64: expected one reduction axis.");
        return kTfLiteError;
    }

    const int* axis_values = micro::GetTensorData<int>(axis);
    if (axis_values == nullptr) {
        return kTfLiteError;
    }

    int normalized_axis = axis_values[0];
    if (normalized_axis < 0) {
        normalized_axis += input->dims->size;
    }

    // This is the model's channel-wise valid-sample count:
    // input [1,900,6], reduction axis 1, output [1,6].
    if (normalized_axis != 1 ||
        input->dims->data[0] != 1 ||
        input->dims->data[1] != 900 ||
        input->dims->data[2] != 6) {
        MicroPrintf("Heatstroke SUM INT64: unexpected input shape or axis.");
        return kTfLiteError;
    }

    const auto* params =
        static_cast<const TfLiteReducerParams*>(node->builtin_data);

    if (params == nullptr || params->keep_dims) {
        MicroPrintf("Heatstroke SUM INT64: expected keep_dims=false.");
        return kTfLiteError;
