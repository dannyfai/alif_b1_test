   485	
   486	void MainLoop()
   487	{
   488	    por_boot = true;
   489	    k_sem_init(&button_wait_sem, 0, 1);
   490	
   491	    if (configure_lpgpio()) {
   492	        LOG_ERR("Failed to configure LPGPIO for button input");
   493	        return;
   494	    }
   495	
   496	    const uint8_t* modelPointer =
   497	        arm::app::polyu_heatstroke::GetModelPointer();
   498	    const size_t modelLength =
   499	        arm::app::polyu_heatstroke::GetModelLen();
   500	
   501	    if (modelPointer == nullptr || modelLength == 0U) {
   502	        LOG_ERR("Combined heat-stress model pointer or length is invalid");
   503	        return;
   504	    }
   505	
   506	    LOG_INF("=====================");
   507	    LOG_INF("Combined model pointer: %p",
   508	            static_cast<const void*>(modelPointer));
   509	    LOG_INF("Combined model size: %u bytes",
   510	            static_cast<unsigned int>(modelLength));
   511	
   512	    /* MLEK MemoryRegion is mutable; the generated model itself is const. */
   513	    arm::app::fwk::iface::MemoryRegion modelMem{
   514	        const_cast<uint8_t*>(modelPointer), modelLength};
   515	
   516	    arm::app::fwk::iface::MemoryRegion computeMem{
   517	        arm::app::activationBuf, sizeof(arm::app::activationBuf)};
   518	
   519	    PolyUModel1 model;
   520	
   521	    if (!model.Init(computeMem, modelMem)) {
   522	        LOG_ERR("Failed to initialise combined heat-stress model");
   523	        return;
   524	    }
   525	
   526	    LOG_INF("Combined heat-stress model initialisation: OK");
   527	    LOG_INF("Contains Ethos-U operators: %s",
   528	            model.ContainsEthosUOperator() ? "yes" : "no");
   529	
   530	    if (!VerifyTensorInterface(model)) {
   531	        LOG_ERR("Combined heat-stress model I/O contract verification failed");
   532	        return;
   533	    }
   534	
   535	    LOG_INF("Combined heat-stress model I/O contract verified.");
   536	    if (!RunHeatstrokeSmokeInference(model)) {
   537	        LOG_ERR("One-sample heat-stress inference failed");
   538	        return;
   539	    }
   540	    LOG_INF("One-sample heat-stress inference: COMPLETE.");
   541	}

