    52	def load_state_dict_compat(path: Path):
    53	    """Load either a raw state_dict or a common wrapped checkpoint."""
    54	    try:
    55	        obj = torch.load(path, map_location="cpu", weights_only=True)
    56	    except TypeError:
    57	        obj = torch.load(path, map_location="cpu")
    58	
    59	    if isinstance(obj, dict):
    60	        if "model_state_dict" in obj:
    61	            obj = obj["model_state_dict"]
    62	        elif "state_dict" in obj:
    63	            obj = obj["state_dict"]
    64	
    65	    if not isinstance(obj, dict):
    66	        raise TypeError(f"{path} does not contain a state_dict")
    67	    return obj
