    33	def load_checkpoint(path: Path):
    34	    """Load a state_dict or a combined checkpoint on CPU."""
    35	    try:
    36	        obj = torch.load(path, map_location="cpu", weights_only=True)
    37	    except TypeError:
    38	        obj = torch.load(path, map_location="cpu")
    39	
    40	    if isinstance(obj, dict):
    41	        if "model_state_dict" in obj:
    42	            return obj["model_state_dict"], obj
    43	        if "state_dict" in obj:
    44	            return obj["state_dict"], obj
    45	
    46	    return obj, {}
    47	
    48	
    49	def max_abs_diff(a: torch.Tensor, b: torch.Tensor) -> float:
    50	    if a.shape != b.shape:
    51	        raise ValueError(f"Output shape mismatch: {tuple(a.shape)} vs {tuple(b.shape)}")
    52	    if a.numel() == 0:
    53	        return 0.0
    54	    return (a - b).abs().max().item()
    55	
    56	
    57	def compare_outputs(name, reference, combined, atol, rtol):
    58	    if reference is None or combined is None:
    59	        if reference is not combined:
    60	            raise AssertionError(
    61	                f"{name}: one model returned None while the other returned a tensor"
    62	            )
    63	        print(f"{name}: both outputs are None")
    64	        return 0.0
    65	
    66	    if reference.shape != combined.shape:
    67	        raise AssertionError(
    68	            f"{name}: shape mismatch: {tuple(reference.shape)} "
    69	            f"vs {tuple(combined.shape)}"
    70	        )
    71	
    72	    diff = max_abs_diff(reference, combined)
    73	    passed = torch.allclose(reference, combined, atol=atol, rtol=rtol)
    74	    print(
    75	        f"{name}: max_abs_diff={diff:.9g}, "
    76	        f"allclose(atol={atol}, rtol={rtol})={passed}"
    77	    )
    78	    if not passed:
    79	        raise AssertionError(f"{name} does not match")
    80	    return diff
    81	
