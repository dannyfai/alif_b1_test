   340	def main():
   341	    parser = argparse.ArgumentParser()
   342	    parser.add_argument(
   343	        "--model-dir",
   344	        type=Path,
   345	        default=Path("./models/trained_by_data_split_byid"),
   346	    )
   347	    parser.add_argument(
   348	        "--output-dir",
   349	        type=Path,
   350	        default=Path("./export"),
   351	    )
   352	    parser.add_argument("--skip-onnx", action="store_true")
   353	    parser.add_argument("--skip-validation", action="store_true")
   354	    args = parser.parse_args()
   355	
   356	    torch.set_grad_enabled(False)
   357	
   358	    reg_path = args.model_dir / "reg_model.pth"
   359	    cla_path = args.model_dir / "rpe_psi_cla_model.pth"
   360	    if not reg_path.is_file():
   361	        raise FileNotFoundError(reg_path)
   362	    if not cla_path.is_file():
   363	        raise FileNotFoundError(cla_path)
   364	
   365	    args.output_dir.mkdir(parents=True, exist_ok=True)
   366	
   367	    # Instantiate exact original architectures and load trained parameters.
   368	    original_reg = Reg_Model().cpu().eval()
   369	    cla_model = Cla_Model().cpu().eval()
   370	    original_reg.load_state_dict(load_state_dict_compat(reg_path), strict=True)
   371	    cla_model.load_state_dict(load_state_dict_compat(cla_path), strict=True)
   372	
   373	    # Same Reg_Model parameters and names, but with static-shape forward.
   374	    static_reg = StaticRegModel().cpu().eval()
   375	    static_reg.load_state_dict(original_reg.state_dict(), strict=True)
   376	
   377	    combined = StaticCombinedModel(static_reg, cla_model).cpu().eval()
   378	
   379	    if not args.skip_validation:
   380	        validate_against_original(original_reg, cla_model, combined)
   381	
   382	    checkpoint_path = args.output_dir / "combined_static_model.pth"
   383	    torch.save(
   384	        {
   385	            "format": "heat_stress_static_combined_v1",
   386	            "model_state_dict": combined.state_dict(),
   387	            "input_shapes": {
   388	                "x_values": [1, 900, 6],
   389	                "missing_mask": [1, 900, 6],
   390	                "x_mark": [1, 900, 3],
   391	                "worker_features": [1, 30],
   392	            },
   393	            "output_shapes": {
   394	                "rpe_logits": [1, 4],
   395	                "psi_logits": [1, 4],
   396	            },
   397	            "missing_mask_semantics": "1/True means missing; x_values must be zero at missing positions",
   398	            "notes": (
   399	                "Static masked compaction uses argsort/gather/cumsum. "
   400	                "Check downstream TFLite/TFLM/Vela operator support."
   401	            ),
   402	        },
   403	        checkpoint_path,
   404	    )
   405	    print(f"Static combined checkpoint saved: {checkpoint_path.resolve()}")
   406	
   407	    if not args.skip_onnx:
   408	        onnx_path = args.output_dir / "combined_static_model.onnx"
   409	        export_onnx(combined, onnx_path)
   410	
   411	
   412	if __name__ == "__main__":
   413	    main()

=== REAL DATASET COMBINED VALIDATOR ===
     1	#!/usr/bin/env python3
     2	"""
     3	Validate that CombinedModel produces the same predictions as the original
     4	Reg_Model -> restore observed values -> Cla_Model pipeline in run.py.
     5	
     6	Run from the directory containing run.py and combine_models.py:
     7	    python validate_combined.py
     8	
     9	Optional examples:
    10	    python validate_combined.py --data-root ./data --split-type split_byid
    11	    python validate_combined.py --data-type val --max-batches 20
    12	    python validate_combined.py --device cpu --no-random-missing
    13	
    14	The script compares:
    15	  1. RPE logits
    16	  2. PSI logits
    17	  3. RPE and PSI predicted classes
    18	
    19	It uses the same input batch for both paths, so random missing-data generation
    20	does not make the two predictions incomparable.
    21	"""
    22	
    23	import argparse
    24	from pathlib import Path
    25	
    26	import torch
    27	from torch.utils.data import DataLoader
    28	
    29	from run import Reg_Model, Cla_Model, Heat_Stress_Dataset
    30	from a_combine_models import CombinedModel
    31	
