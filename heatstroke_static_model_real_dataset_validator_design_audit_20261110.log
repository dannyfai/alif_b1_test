   131	def prepare_model_inputs(batch):
   132	    """
   133	    Dataset output:
   134	        batch_x1_1
   135	        batch_x1_2
   136	        batch_x2
   137	        batch_y
   138	        batch_x_mark
   139	        additional_data
   140	
   141	    The preprocessing below follows evaluate_onnx.py and
   142	    evaluate_tflite.py.
   143	    """
   144	
   145	    (
   146	        batch_x1_1,
   147	        batch_x1_2,
   148	        batch_x2,
   149	        batch_y,
   150	        batch_x_mark,
   151	        _,
   152	    ) = batch
   153	
   154	    x_original = to_numpy(batch_x1_1).astype(
   155	        np.float32, copy=True
   156	    )
   157	
   158	    x_reg = to_numpy(batch_x1_2).astype(
   159	        np.float32, copy=True
   160	    )
   161	
   162	    worker_features = to_numpy(batch_x2).astype(
   163	        np.float32, copy=True
   164	    )
   165	
   166	    x_mark = to_numpy(batch_x_mark).astype(
   167	        np.float32, copy=True
   168	    )
   169	
   170	    labels = to_numpy(batch_y).copy()
   171	
   172	    # Missing-value markers are stored in x_reg.
   173	    missing_mask = np.zeros(
   174	        x_reg.shape,
   175	        dtype=bool,
   176	    )
   177	
   178	    for sentinel in (-9997.0, -9998.0, -9999.0):
   179	        missing_mask |= (x_reg == sentinel)
   180	
   181	    # Replace missing values in the original input with zero.
   182	    x_values = np.where(
   183	        missing_mask,
   184	        0.0,
   185	        x_original,
   186	    ).astype(np.float32)
   187	
   188	    missing_mask_float = missing_mask.astype(
   189	        np.float32
   190	    )
   191	
   192	    return {
   193	        "x_values": x_values,
   194	        "missing_mask": missing_mask_float,
   195	        "x_mark": x_mark,
   196	        "worker_features": worker_features,
   197	    }, labels
