    70	class StaticRegModel(Reg_Model):
    71	    """
    72	    Same layers/parameter names as Reg_Model, but with a static-shape forward.
    73	
    74	    The constructor is inherited from Reg_Model, so trained state_dict keys
    75	    remain compatible. missing_mask=True means that a sensor value is missing.
    76	    """
    77	
    78	    @staticmethod
    79	    def masked_compact_adaptive_pool(x, valid, output_size=COMPACT_SEQ_LEN):
    80	        """
    81	        x, valid: [B, L, N]
    82	        returns:  [B, output_size, N]
    83	
    84	        For each channel, valid samples are compacted in chronological order.
    85	        The output is mathematically equivalent to adaptive_avg_pool1d over
    86	        that compacted variable-length sequence, including the all-missing
    87	        case (which returns zeros).
    88	
    89	        All intermediate tensor dimensions are fixed by B, L, N, output_size.
    90	        """
    91	        batch, length, channels = x.shape
    92	
    93	        # Unique sort keys preserve chronological order:
    94	        # valid positions get keys [0, L-1], missing positions [L, 2L-1].
    95	        positions = torch.arange(
    96	            length, device=x.device, dtype=torch.int64
    97	        ).view(1, length, 1).expand(batch, length, channels)
    98	
    99	        sort_keys = positions + (~valid).to(torch.int64) * length
   100	        order = torch.argsort(sort_keys, dim=1)
   101	        compacted = torch.gather(x, dim=1, index=order)
   102	
   103	        count = valid.to(torch.int32).sum(dim=1)       # [B, N]
   104	        safe_count = torch.clamp(count, min=1)         # avoid divide by zero
   105	
   106	        # Prefix sums allow each adaptive-pooling bin to be calculated using
   107	        # two gathers. PyTorch adaptive pooling uses:
   108	        # start = floor(i * input_len / output_len)
   109	        # end   = ceil((i+1) * input_len / output_len)
   110	        prefix = torch.cat(
   111	            (
   112	                torch.zeros(
   113	                    (batch, 1, channels),
   114	                    dtype=x.dtype,
   115	                    device=x.device,
   116	                ),
   117	                torch.cumsum(compacted, dim=1),
   118	            ),
   119	            dim=1,
   120	        )                                               # [B, L+1, N]
   121	
   122	        out_index = torch.arange(
   123	            output_size, device=x.device, dtype=torch.int32
   124	        ).view(1, output_size, 1)
   125	
   126	        start = (out_index * safe_count.unsqueeze(1)) // output_size
   127	        end_numerator = (out_index + 1) * safe_count.unsqueeze(1)
   128	        end = (end_numerator + output_size - 1) // output_size
   129	
   130	        start_sum = torch.gather(
   131	            prefix, 1, start.to(torch.int64).expand(batch, output_size, channels)
   132	        )
   133	        end_sum = torch.gather(
   134	            prefix, 1, end.to(torch.int64).expand(batch, output_size, channels)
   135	        )
   136	
   137	        bin_size = torch.clamp(end - start, min=1).to(x.dtype)
   138	        pooled = (end_sum - start_sum) / bin_size
   139	
   140	        # The original implementation returns zeros for an all-missing channel.
   141	        pooled = torch.where(
   142	            (count > 0).unsqueeze(1),
   143	            pooled,
   144	            torch.zeros_like(pooled),
   145	        )
   146	        return pooled
   147	
   148	    def forward(self, x, missing_mask, x_mark, worker_features):
   149	        """
   150	        Fixed deployment signature:
   151	          x:               [1, 900, 6], missing positions set to zero
   152	          missing_mask:    [1, 900, 6], True/1 means missing
   153	          x_mark:          [1, 900, 3]
   154	          worker_features: [1, 18]
   155	        """
   156	        missing_mask = missing_mask > 0.5
   157	        valid = ~missing_mask
   158	        batch = x.shape[0]
   159	
   160	        # Non-sequential worker features: [B,18] -> [B,900,1].
   161	        non_seq_enc_out = self.non_seq_enc(worker_features)
   162	        time_and_worker = torch.cat(
   163	            (x_mark, non_seq_enc_out.reshape(batch, SEQ_LEN, 1)),
   164	            dim=2,
   165	        )
   166	
   167	        # Single-variate feature branch. This reproduces the original
   168	        # valid-value compaction + adaptive_avg_pool1d(..., 1800) operation.
   169	        compacted_pool = self.masked_compact_adaptive_pool(
   170	            x, valid, COMPACT_SEQ_LEN
   171	        )
   172	
   173	        svf_out = []
   174	        for feature_index, linear in enumerate(self.svf):
   175	            svf_out.append(linear(compacted_pool[:, :, feature_index]))
   176	
   177	        svf_enc = torch.stack(svf_out, dim=2)            # [B,900,6]
   178	        svf_enc = torch.where(
   179	            missing_mask, svf_enc, torch.zeros_like(svf_enc)
   180	        )
   181	
   182	        # Cross-variate branch. Replace missing samples with the mean of
   183	        # observed samples in that channel. All-missing channels become zero.
   184	        valid_float = valid.to(x.dtype)
   185	        channel_count = valid_float.sum(dim=1, keepdim=True)
   186	        channel_sum = (x * valid_float).sum(dim=1, keepdim=True)
   187	        channel_mean = channel_sum / torch.clamp(channel_count, min=1.0)
   188	        filled = torch.where(missing_mask, channel_mean.expand_as(x), x)
   189	
   190	        cvf_enc = self.cvf(filled.permute(0, 2, 1)).permute(0, 2, 1)
   191	        cvf_enc = torch.where(
   192	            missing_mask, cvf_enc, torch.zeros_like(cvf_enc)
   193	        )
   194	
   195	        # Original observed values are zeroed in this branch; reconstructed
   196	        # features are used only at missing positions.
   197	        observed_zeroed = torch.where(missing_mask, torch.zeros_like(x), x)
   198	        embedding = torch.cat(
   199	            ((svf_enc + cvf_enc) / 2.0, observed_zeroed),
   200	            dim=2,
   201	        )
   202	        embedding = torch.cat((embedding, time_and_worker), dim=2)
   203	
   204	        encoded, _ = self.rnn(embedding)
   205	
   206	        projected = []
   207	        for projector in self.proj:
   208	            projected.append(projector(encoded).reshape(batch, SEQ_LEN))
   209	        return torch.stack(projected, dim=2)             # [B,900,6]
   210	
