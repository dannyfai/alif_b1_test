     1	#!/usr/bin/env python3
     2	"""
     3	Prepare the Heat Stress Reg_Model + Cla_Model for fixed-shape export.
     4	
     5	Requirements:
     6	  - Keep this file beside the original run.py.
     7	  - run.py must define Reg_Model and Cla_Model.
     8	  - Checkpoints:
     9	      models/trained_by_data_split_byid/reg_model.pth
    10	      models/trained_by_data_split_byid/rpe_psi_cla_model.pth
    11	
    12	Inputs to the prepared model:
    13	  x_values:       float32 [1, 900, 6], missing positions replaced by 0
    14	  missing_mask:   float32/bool [1, 900, 6], 1/True means missing
    15	  x_mark:         float32 [1, 900, 3]
    16	  worker_features:float32 [1, 30]
    17	
    18	Outputs:
    19	  rpe_logits: [1, 4]
    20	  psi_logits: [1, 4]
    21	
    22	The fixed-size masked compaction below reproduces the original operation:
    23	  select observed values in chronological order, then adaptive_avg_pool1d
    24	  from the observed count to 1800 samples.
    25	It uses fixed tensor dimensions, sorting/gathering, and prefix sums instead
    26	of boolean indexing and variable-length tensors.
    27	
    28	Note:
    29	  ONNX exportability does not guarantee that every operator is supported by
    30	  TFLite Micro or mapped to Ethos-U55. In particular, SORT/TopK and LSTM
    31	  support must be checked in the actual ONNX->TFLite->Vela toolchain.
    32	"""
    33	
    34	import argparse
    35	from pathlib import Path
    36	
    37	import torch
    38	import torch.nn as nn
    39	
