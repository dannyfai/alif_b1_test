    41	from run import Reg_Model, Cla_Model
    42	
    43	
    44	SEQ_LEN = 900
    45	SEQ_FEATURES = 6
    46	TIME_FEATURES = 3
    47	REG_WORKER_FEATURES = 18
    48	CLA_WORKER_FEATURES = 30
    49	COMPACT_SEQ_LEN = SEQ_LEN * 2
