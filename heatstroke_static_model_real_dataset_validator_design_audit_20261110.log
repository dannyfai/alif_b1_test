   307	def export_onnx(model, output_path: Path):
   308	    model.eval()
   309	    example_inputs = make_synthetic_test_inputs()
   310	
   311	    torch.onnx.export(
   312	        model,
   313	        example_inputs,
   314	        str(output_path),
   315	        export_params=True,
   316	        opset_version=18,
   317	        do_constant_folding=True,
   318	        input_names=[
   319	            "x_values",
   320	            "missing_mask",
   321	            "x_mark",
   322	            "worker_features",
   323	        ],
   324	        output_names=["rpe_logits", "psi_logits"],
   325	        dynamic_axes=None,   # no dynamic axes: fixed [1,900,...] interface
   326	        verbose=False,
   327	    )
   328	
   329	    try:
   330	        import onnx
   331	        onnx_model = onnx.load(str(output_path))
   332	        onnx.checker.check_model(onnx_model)
   333	        print("ONNX checker: passed")
   334	    except ImportError:
   335	        print("onnx package not installed; skipped ONNX checker.")
   336	
   337	    print(f"ONNX exported: {output_path.resolve()}")
   338	
