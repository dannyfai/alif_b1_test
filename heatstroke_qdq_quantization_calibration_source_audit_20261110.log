    62	def prepare_inputs(batch_x1_2, batch_x2, batch_x_mark):
    63	    """
    64	    Match evaluate_tflite.py exactly:
    65	      x_values       = x1_2 with missing sentinels replaced by zero
    66	      missing_mask   = 1 for -9997/-9998/-9999, otherwise 0
    67	      x_mark         = time features from the dataset
    68	      worker_features= 30 worker-level features from the dataset
    69	    """
    70	    x_reg = to_numpy(batch_x1_2).astype(np.float32, copy=True)
    71	    worker_features = to_numpy(batch_x2).astype(np.float32, copy=True)
    72	    x_mark = to_numpy(batch_x_mark).astype(np.float32, copy=True)
    73	
    74	    missing_mask = np.zeros(x_reg.shape, dtype=np.bool_)
    75	    for sentinel in MISSING_VALUES:
    76	        missing_mask |= (x_reg == sentinel)
    77	
    78	    x_values = np.where(missing_mask, 0.0, x_reg).astype(np.float32)
    79	    missing_mask = missing_mask.astype(np.float32)
    80	
    81	    result = {
    82	        "x_values": x_values,
    83	        "missing_mask": missing_mask,
    84	        "x_mark": x_mark,
    85	        "worker_features": worker_features,
    86	    }
    87	
    88	    expected_shapes = {
    89	        "x_values": (1, 900, 6),
    90	        "missing_mask": (1, 900, 6),
    91	        "x_mark": (1, 900, 3),
    92	        "worker_features": (1, 30),
    93	    }
    94	    for name, expected in expected_shapes.items():
    95	        if tuple(result[name].shape) != expected:
    96	            raise ValueError(
    97	                f"{name} has shape {result[name].shape}; expected {expected}. "
    98	                "Check the dataset configuration and model inputs."
    99	            )
   100	
   101	    return result
