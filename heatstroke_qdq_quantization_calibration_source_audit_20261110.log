    90	    # Identify missing sequence elements.
    91	    missing_mask = np.isin(
    92	        x1_2,
    93	        MISSING_SENTINELS
    94	    ).astype(np.float32)
    95	
    96	    # Replace missing sequence values with zero.
    97	    x_values = np.where(
