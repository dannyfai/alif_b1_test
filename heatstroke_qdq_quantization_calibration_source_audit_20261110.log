   189	def resolve_signature_input_names(saved_model_dir):
   190	    loaded = tf.saved_model.load(str(saved_model_dir))
   191	    if "serving_default" not in loaded.signatures:
   192	        raise RuntimeError(
   193	            "SavedModel has no 'serving_default' signature. "
   194	            f"Available signatures: {list(loaded.signatures.keys())}"
   195	        )
   196	
   197	    signature = loaded.signatures["serving_default"]
   198	    _, kwargs = signature.structured_input_signature
   199	    if not kwargs:
   200	        raise RuntimeError(
   201	            "The SavedModel serving_default signature does not expose "
   202	            "named keyword inputs; cannot safely map calibration tensors."
   203	        )
   204	
   205	    available = list(kwargs.keys())
   206	    mapping = {}
   207	
   208	    # Require explicit name matching. In particular, x_values and
   209	    # missing_mask have the same shape, so shape-only matching is unsafe.
   210	    for expected in INPUT_NAMES:
   211	        exact = [name for name in available if name.lower() == expected.lower()]
   212	        partial = [
   213	            name for name in available
   214	            if expected.lower() in name.lower()
   215	        ]
   216	        matches = exact if exact else partial
   217	        if len(matches) != 1:
   218	            raise RuntimeError(
   219	                f"Cannot uniquely map model input '{expected}' to the "
   220	                f"SavedModel signature. Signature inputs: {available}. "
   221	                "Do not guess the order: inspect the SavedModel signature "
   222	                "and adjust the mapping in resolve_signature_input_names()."
   223	            )
   224	        mapping[expected] = matches[0]
   225	
   226	    print("\nSavedModel signature input mapping:")
   227	    for expected in INPUT_NAMES:
   228	        spec = kwargs[mapping[expected]]
   229	        print(
   230	            f"  {expected:18s} -> {mapping[expected]} "
   231	            f"shape={spec.shape}, dtype={spec.dtype}"
   232	        )
   233	    return mapping
   234	
