5. SYSTEM INITIALIZATION CALL SITE
============================================================
    35		 * User may override and can have their own implementation.
    36		 */
    37	}
    38	
    39	
    40	/*----------------------------------------------------------------------------
    41	 *System initialization function
    42	 *----------------------------------------------------------------------------
    43	 */
    44	void SystemInit(void)
    45	{
    46		__set_FAULTMASK(0);
    47	
    48		/* Disable the MPU */
    49		ARM_MPU_Disable();
    50	
    51		/* Enable UsageFault, BusFault, MemFault and SecurityFault exceptions */
    52		/* Otherwise all you see is HardFault, even in the debugger */
    53		SCB->SHCSR |= SCB_SHCSR_USGFAULTENA_Msk | SCB_SHCSR_BUSFAULTENA_Msk |
    54			SCB_SHCSR_MEMFAULTENA_Msk | SCB_SHCSR_SECUREFAULTENA_Msk;
    55	
    56	#if (defined(__FPU_USED) && (__FPU_USED == 1U)) || \
    57		(defined(__ARM_FEATURE_MVE) && (__ARM_FEATURE_MVE > 0U))
    58		SCB->CPACR |= ((3U << 10U*2U) |           /* enable CP10 Full Access */
    59				(3U << 11U*2U));         /* enable CP11 Full Access */
    60	#endif
    61	
    62	#ifdef UNALIGNED_SUPPORT_DISABLE
    63		SCB->CCR |= SCB_CCR_UNALIGN_TRP_Msk;
    64	#endif
    65	
    66		/*
    67		 * Enable caches now, for speed, but we will have to clean
    68		 * after scatter-loading, in _platform_pre_stackheap_init
    69	
    70		 * We do not use the CMSIS functions, as these manually invalidate the
    71		 * cache - this is not required on the M55, as it is auto-invalidated
    72		 * (and we implicitly rely on this already before activating, if booting
    73		 * from MRAM).
    74		 * Enable Loop and branch info cache
    75		 */
    76		SCB->CCR |= SCB_CCR_IC_Msk | SCB_CCR_DC_Msk | SCB_CCR_LOB_Msk;
    77	
    78		/* Enable limited static branch prediction using low overhead loops */
    79		ICB->ACTLR &= ~ICB_ACTLR_DISLOBR_Msk;
    80	
    81		__DSB();
    82		__ISB();
    83	
    84	#if DT_NODE_HAS_STATUS(DT_NODELABEL(ns), okay)
    85		sau_tcm_ns_setup();
    86	#endif
    87	
    88	}

