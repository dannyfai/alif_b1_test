   179	TfLiteStatus HeatstrokeBidirectionalLstmPrepare(TfLiteContext* context,
   180	                                                TfLiteNode* node) {
   181	  if (node == nullptr || node->builtin_data == nullptr ||
   182	      node->inputs == nullptr || node->outputs == nullptr ||
   183	      node->inputs->size != 29 || node->outputs->size != 1 ||
   184	      node->user_data == nullptr) {
   185	    MicroPrintf("Heatstroke BiLSTM: invalid node configuration");
   186	    return kTfLiteError;
   187	  }
   188	
   189	  auto* op_data =
   190	      static_cast<HeatstrokeBidirectionalLstmOpData*>(node->user_data);
   191	
   192	  const auto* params =
   193	      static_cast<const TfLiteBidirectionalSequenceLSTMParams*>(
   194	          node->builtin_data);
   195	
   196	  if (!params->time_major || !params->merge_outputs ||
   197	      params->activation != kTfLiteActTanh) {
   198	    MicroPrintf("Heatstroke BiLSTM: unsupported LSTM options");
   199	    return kTfLiteError;
   200	  }
   201	
   202	  TfLiteEvalTensor* input = GetInputEvalTensor(context, node, 0);
   203	  TfLiteEvalTensor* output =
   204	      context->GetEvalTensor(context, node->outputs->data[0]);
   205	
   206	  if (!IsFloatTensor(input) || !IsFloatTensor(output) ||
   207	      input->dims == nullptr || output->dims == nullptr ||
   208	      input->dims->size != 3 || output->dims->size != 3) {
   209	    MicroPrintf("Heatstroke BiLSTM: expected rank-3 FP32 tensors");
   210	    return kTfLiteError;
   211	  }
   212	
   213	  const int time_steps = input->dims->data[0];
   214	  const int batch_size = input->dims->data[1];
   215	  const int input_dimension = input->dims->data[2];

