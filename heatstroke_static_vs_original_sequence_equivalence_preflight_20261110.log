   212	class StaticCombinedModel(nn.Module):
   213	    """One end-to-end model: static regression -> restore -> classification."""
   214	
   215	    def __init__(self, reg_model, cla_model):
   216	        super().__init__()
   217	        self.reg_model = reg_model
   218	        self.cla_model = cla_model
   219	
   220	    def forward(self, x_values, missing_mask, x_mark, worker_features):
   221	        # The input x_values must contain zero at missing positions. The
   222	        # separate mask carries missingness, avoiding -999x values in INT8.
   223	        mask = missing_mask > 0.5
   224	
   225	        reg_prediction = self.reg_model(
   226	            x_values,
   227	            mask,
   228	            x_mark,
   229	            worker_features[:, :REG_WORKER_FEATURES],
   230	        )
   231	
   232	        restored_sequence = torch.where(mask, reg_prediction, x_values)
   233	
   234	        rpe_logits, psi_logits = self.cla_model(
   235	            restored_sequence,
   236	            x_mark_enc=None,  # Cla_Model's original forward does not use it.
   237	            one_hot_x=worker_features[:, :CLA_WORKER_FEATURES],
   238	            device=x_values.device,
   239	        )
   240	        return rpe_logits, psi_logits
