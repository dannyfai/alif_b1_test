   243	def make_synthetic_test_inputs(device="cpu"):
   244	    """Shape/functional smoke-test data; not suitable for quantization calibration."""
   245	    torch.manual_seed(1234)
   246	    x = torch.randn(1, SEQ_LEN, SEQ_FEATURES, device=device)
   247	    mask = (torch.rand(1, SEQ_LEN, SEQ_FEATURES, device=device) < 0.30)
   248	    x = torch.where(mask, torch.zeros_like(x), x)
   249	    x_mark = torch.randn(1, SEQ_LEN, TIME_FEATURES, device=device)
   250	    worker = torch.randn(1, CLA_WORKER_FEATURES, device=device)
   251	    return x, mask.to(torch.float32), x_mark, worker
   252	
