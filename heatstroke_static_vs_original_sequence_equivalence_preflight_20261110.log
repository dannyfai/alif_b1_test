   254	@torch.no_grad()
   255	def validate_against_original(original_reg, cla_model, combined_model):
   256	    """
   257	    Compare the refactored regression + combined outputs with the original
   258	    sentinel-based run.py behavior on synthetic test inputs.
   259	
   260	    For final validation, repeat this using real preprocessed validation samples.
   261	    """
   262	    x_values, mask_float, x_mark, worker = make_synthetic_test_inputs()
   263	    mask = mask_float > 0.5
   264	
   265	    # Reconstruct the original run.py input representation.
   266	    x_sentinel = torch.where(
   267	        mask,
   268	        torch.full_like(x_values, -9998.0),
   269	        x_values,
   270	    )
   271	
   272	    original_reg.eval()
   273	    cla_model.eval()
   274	    combined_model.eval()
   275	
   276	    old_reg_prediction = original_reg(
   277	        x_sentinel,
   278	        x_mark_enc=x_mark,
   279	        one_hot_x=worker[:, :REG_WORKER_FEATURES],
   280	        device="cpu",
   281	    )
   282	    old_restored = torch.where(mask, old_reg_prediction, x_values)
   283	    old_rpe, old_psi = cla_model(
   284	        old_restored,
   285	        x_mark_enc=x_mark,
   286	        one_hot_x=worker[:, :CLA_WORKER_FEATURES],
   287	        device="cpu",
   288	    )
   289	
   290	    new_rpe, new_psi = combined_model(
   291	        x_values, mask_float, x_mark, worker
   292	    )
   293	
   294	    torch.testing.assert_close(
   295	        new_rpe, old_rpe, rtol=1e-3, atol=1e-3,
   296	        msg="RPE logits differ from original pipeline",
   297	    )
   298	    torch.testing.assert_close(
   299	        new_psi, old_psi, rtol=1e-3, atol=1e-3,
   300	        msg="PSI logits differ from original pipeline",
   301	    )
   302	    print("Synthetic equivalence test passed.")
   303	    print("RPE max abs error:", (new_rpe - old_rpe).abs().max().item())
   304	    print("PSI max abs error:", (new_psi - old_psi).abs().max().item())
   305	

