   103	// Wrapper function to create gate parameters for the four internal LSTM gates
   104	TfLiteStatus CreateGateParams(
   105	    TfLiteContext* context,
   106	    /*Input tensors*/
   107	    const TfLiteTensor* input, const TfLiteTensor* input_weight,
   108	    const TfLiteTensor* input_bias,
   109	    /*Hidden state tensors*/
   110	    const TfLiteTensor* hidden_state, const TfLiteTensor* hidden_state_weight,
   111	    const TfLiteTensor* hidden_state_bias,
   112	    /*Scale of the fc output (input to non-linear activation)*/
   113	    const float nonlinear_activation_input_scale, const TfLiteType cell_type,
   114	    tflite::GateParameters& gate_params) {
   115	  // A temp tflite tensor to represent the output of fc operation. Only the data
   116	  // type and quantization parameters are set since it is only used for
   117	  // parameter calculations
   118	  TfLiteTensor fc_output_temp;
   119	  fc_output_temp.type = cell_type;
   120	  fc_output_temp.params.scale = nonlinear_activation_input_scale;
   121	  fc_output_temp.params.zero_point = 0;  // symmetrical quantized
   122	
   123	  // A temp fc opdata to reuse the helper function on creating fc parameters
   124	  tflite::OpDataFullyConnected fc_data_temp;
   125	  // TODO(b/265853320): due to the lack of precision for the float scale,
   126	  // scale_diff / output_scale <= 0.02 (potentially requires 1e-8 precision) can
   127	  // not be satisified for the bias. Here we rely on the correctiveness of the
   128	  // conversion process (set input_bias=nullptr to avoid checking) for
   129	  // tensor scales
   130	  TF_LITE_ENSURE_STATUS(CalculateOpDataFullyConnected(
   131	      context, kTfLiteActNone, input->type, input, input_weight,
   132	      /*input_bias=*/nullptr, &fc_output_temp, &fc_data_temp));
   133	  gate_params.input_fc_params = FullyConnectedParamsQuantized(fc_data_temp);
   134	  double real_multiplier = 0.0;
   135	  GetQuantizedConvolutionMultipler(context, input, input_weight, nullptr,
   136	                                   &fc_output_temp, &real_multiplier);
   137	
   138	  TF_LITE_ENSURE_STATUS(CalculateOpDataFullyConnected(
   139	      context, kTfLiteActNone, hidden_state->type, hidden_state,
   140	      hidden_state_weight, hidden_state_bias, &fc_output_temp, &fc_data_temp));
   141	  gate_params.recurrent_fc_params = FullyConnectedParamsQuantized(fc_data_temp);
   142	  return kTfLiteOk;
   143	}
   144	
   145	// Create parameters for element wise multiplication that happens in a) cell
   146	// state update ; b) hidden state update
   147	// Note that all the output of gates are symmetrically quantized so only scales
   148	// are required for input. However, during the hidden state update phase, the
   149	// output is the updated hidden state, which is asymmetrically quantized. Thus
   150	// output may require zero point
   151	tflite::ArithmeticParams CreateInterGateMulParams(const float input1_scale,
   152	                                                  const float input2_scale,
   153	                                                  const float output_scale,
   154	                                                  const TfLiteType output_type,
   155	                                                  const int output_zp) {
   156	  tflite::ArithmeticParams op_params = {};
   157	  if (output_type == kTfLiteInt16) {
   158	    op_params.quantized_activation_min = std::numeric_limits<int16_t>::min();
   159	    op_params.quantized_activation_max = std::numeric_limits<int16_t>::max();
   160	  } else if (output_type == kTfLiteInt8) {
   161	    op_params.quantized_activation_min = std::numeric_limits<int8_t>::min();
   162	    op_params.quantized_activation_max = std::numeric_limits<int8_t>::max();
   163	  }
   164	
   165	  op_params.input1_offset = 0;  // symmetric
   166	  op_params.input2_offset = 0;  // symmetric
   167	  op_params.output_offset = output_zp;
   168	
   169	  const double input_product_scale =
   170	      static_cast<double>(input1_scale) * static_cast<double>(input2_scale);
   171	  double effective_scale =
   172	      input_product_scale / static_cast<double>(output_scale);
   173	
   174	  QuantizeMultiplier(effective_scale, &op_params.output_multiplier,
   175	                     &op_params.output_shift);
   176	  return op_params;
   177	}
   178	
   179	// Create the additional information about the cell state, which include:
   180	// cell_state_scale_power: used in integer nonlinear function (e.g., tanh)
   181	// quantized_cell_clip: quantized cell clip range
   182	CellStateInfo CreateLstmCellStateInfo(const float cell_state_scale,
   183	                                      const float cell_clip) {
   184	  CellStateInfo cell_state_info;
   185	  // cell_state_scale_power: 2^-cell_state_scale_power = cell state scale
   186	  int buffer;
   187	  tflite::CheckedLog2(cell_state_scale, &buffer);
   188	  cell_state_info.cell_state_scale_power = buffer;
   189	  // Cell state specifics
   190	  cell_state_info.cell_clip = cell_clip;
   191	  cell_state_info.quantized_cell_clip = static_cast<int16_t>(
   192	      std::min(std::max(static_cast<double>(cell_clip) /
   193	                            static_cast<double>(cell_state_scale),
   194	                        -32768.0),
   195	               32767.0));
   196	
   197	  return cell_state_info;
   198	}
   199	
   200	CellStateInfo CreateLstmCellStateInfoFloat(const float cell_clip) {
   201	  CellStateInfo cell_state_info;
   202	  cell_state_info.cell_clip = cell_clip;
   203	  cell_state_info.cell_state_scale_power = 0;  // no quantization
   204	  cell_state_info.quantized_cell_clip = 0;     // no quantization
   205	  return cell_state_info;
   206	}
   207	
   208	tflite::FullyConnectedParams CreateFCParamsFloat() {
   209	  FullyConnectedParams op_params;
   210	  CalculateActivationRange(kTfLiteActNone, &op_params.float_activation_min,
   211	                           &op_params.float_activation_max);
   212	  return op_params;
   213	}
   214	
   215	tflite::GateParameters CreateGateParamsFloat() {
   216	  tflite::GateParameters gate_params = {};
   217	  gate_params.input_fc_params = CreateFCParamsFloat();
   218	  gate_params.recurrent_fc_params = CreateFCParamsFloat();
   219	  return gate_params;
   220	}
   221	
   222	tflite::ArithmeticParams CreateInterGateMulParamsFloat() {
   223	  tflite::ArithmeticParams op_params = {};
   224	  CalculateActivationRange(kTfLiteActNone, &op_params.float_activation_min,
   225	                           &op_params.float_activation_max);
   226	  return op_params;
   227	}
   228	
   229	TfLiteStatus PrepareGateParametersFloat(TfLiteContext* context,
   230	                                        const LstmTensors& lstm_tensors,
   231	                                        OpDataLSTM* op_data_lstm) {
   232	  // Gate Parameters
   233	  op_data_lstm->forget_gate_parameters = CreateGateParamsFloat();
   234	  op_data_lstm->input_gate_parameters = CreateGateParamsFloat();
   235	  op_data_lstm->cell_gate_parameters = CreateGateParamsFloat();
   236	  op_data_lstm->output_gate_parameters = CreateGateParamsFloat();
   237	  // Inter gate multiplication parameters
   238	  op_data_lstm->inter_gate_parameters.forget_cell_mul_params =
   239	      CreateInterGateMulParamsFloat();
   240	  op_data_lstm->inter_gate_parameters.input_mul_params =
   241	      CreateInterGateMulParamsFloat();
   242	  op_data_lstm->inter_gate_parameters.output_mul_params =
   243	      CreateInterGateMulParamsFloat();
   244	  return kTfLiteOk;
   245	}
   246	
   247	TfLiteStatus PrepareGateParametersInteger(TfLiteContext* context,
   248	                                          const LstmTensors& lstm_tensors,
   249	                                          OpDataLSTM* op_data_lstm) {
   250	  float nonlinear_input_scale = 0.000244140625;  // 2^-12 Q3.12 -> Q0.15
   251	  TF_LITE_ENSURE_OK(
   252	      context,
   253	      CreateGateParams(
   254	          context, lstm_tensors.GetInternalTensor(kLstmInputTensor),
   255	          lstm_tensors.GetInternalTensor(kLstmInputToForgetWeightsTensor),
   256	          lstm_tensors.GetInternalTensor(kLstmForgetGateBiasTensor),
   257	          lstm_tensors.GetInternalTensor(kLstmOutputStateTensor),
   258	          lstm_tensors.GetInternalTensor(kLstmRecurrentToForgetWeightsTensor),
   259	          /*hidden_state_bias=*/nullptr, nonlinear_input_scale, kTfLiteInt16,
   260	          op_data_lstm->forget_gate_parameters));
   261	  TF_LITE_ENSURE_OK(
   262	      context,
   263	      CreateGateParams(
   264	          context, lstm_tensors.GetInternalTensor(kLstmInputTensor),
   265	          lstm_tensors.GetInternalTensor(kLstmInputToInputWeightsTensor),
   266	          lstm_tensors.GetInternalTensor(kLstmInputGateBiasTensor),
   267	          lstm_tensors.GetInternalTensor(kLstmOutputStateTensor),
   268	          lstm_tensors.GetInternalTensor(kLstmRecurrentToInputWeightsTensor),
   269	          /*hidden_state_bias=*/nullptr, nonlinear_input_scale, kTfLiteInt16,
   270	          op_data_lstm->input_gate_parameters));
   271	  TF_LITE_ENSURE_OK(
   272	      context,
   273	      CreateGateParams(
   274	          context, lstm_tensors.GetInternalTensor(kLstmInputTensor),
   275	          lstm_tensors.GetInternalTensor(kLstmInputToCellWeightsTensor),
   276	          lstm_tensors.GetInternalTensor(kLstmCellGateBiasTensor),
   277	          lstm_tensors.GetInternalTensor(kLstmOutputStateTensor),
   278	          lstm_tensors.GetInternalTensor(kLstmRecurrentToCellWeightsTensor),
   279	          /*hidden_state_bias=*/nullptr, nonlinear_input_scale, kTfLiteInt16,
   280	          op_data_lstm->cell_gate_parameters));
   281	  TF_LITE_ENSURE_OK(
   282	      context,
   283	      CreateGateParams(
   284	          context, lstm_tensors.GetInternalTensor(kLstmInputTensor),
   285	          lstm_tensors.GetInternalTensor(kLstmInputToOutputWeightsTensor),
   286	          lstm_tensors.GetInternalTensor(kLstmOutputGateBiasTensor),
   287	          lstm_tensors.GetInternalTensor(kLstmOutputStateTensor),
   288	          lstm_tensors.GetInternalTensor(kLstmRecurrentToOutputWeightsTensor),
   289	          /*hidden_state_bias=*/nullptr, nonlinear_input_scale, kTfLiteInt16,
   290	          op_data_lstm->output_gate_parameters));
   291	
   292	  // Inter gate multiplication parameters
   293	  float nonlinear_output_scale = 0.000030517578125;  // 2^-15 Q3.12 -> Q0.15
   294	  float cell_state_scale = lstm_tensors.CellStateTensor()->params.scale;
   295	  // forget gate output (nonlinear output) x cell state -> cell state
   296	  op_data_lstm->inter_gate_parameters.forget_cell_mul_params =
   297	      CreateInterGateMulParams(nonlinear_output_scale, cell_state_scale,
   298	                               cell_state_scale, kTfLiteInt16);
   299	  // input gate output x cell gate output -> cell state
   300	  op_data_lstm->inter_gate_parameters.input_mul_params =
   301	      CreateInterGateMulParams(nonlinear_output_scale, nonlinear_output_scale,
   302	                               cell_state_scale, kTfLiteInt16);
   303	  // tanh output x output gate output -> hidden state (potentially asymmetric)
   304	  op_data_lstm->inter_gate_parameters.output_mul_params =
   305	      CreateInterGateMulParams(
   306	          nonlinear_output_scale, nonlinear_output_scale,
   307	          lstm_tensors.HiddenStateTensor()->params.scale,
   308	          lstm_tensors.HiddenStateTensor()->type,
   309	          lstm_tensors.HiddenStateTensor()->params.zero_point);
   310	  return kTfLiteOk;
   311	}
   312	
   313	LSTMKernelContents CreateLSTMKernelContent(TfLiteContext* context,
   314	                                           TfLiteNode* node) {
   315	  LSTMKernelContents kernel_content;
   316	  // Point to correct tensors
   317	  for (size_t i = 0; i < 24; i++) {
   318	    kernel_content.internal_tensors[i] =
   319	        tflite::micro::GetMutableEvalInput(context, node, i);
   320	  }
   321	  // Output tensor
   322	  kernel_content.output_tensor = tflite::micro::GetEvalOutput(context, node, 0);
   323	  return kernel_content;
   324	}
   325	
   326	}  // namespace tflite

