    23	// Deduce the size information (Batch (B), Time Steps (T), Input dimension (I),
    24	// State dimension (S)) that defines the LSTM using the input and hidden state
    25	// tensor
    26	LstmSizeInfo CreateLstmSizeInfo(
    27	    const bool time_major, const TfLiteIntArray* input_tensor_shape,
    28	    const TfLiteIntArray* hidden_state_tensor_shape) {
    29	  LstmSizeInfo size_info;
    30	  size_info.time_major = time_major;
    31	  size_info.batch_size =
    32	      time_major ? input_tensor_shape->data[1] : input_tensor_shape->data[0];
    33	  size_info.time_steps =
    34	      time_major ? input_tensor_shape->data[0] : input_tensor_shape->data[1];
    35	  size_info.input_dimension = input_tensor_shape->data[2];
    36	  size_info.state_dimension = hidden_state_tensor_shape->data[1];
    37	  return size_info;
    38	}
    39	
    40	TfLiteStatus ValidateWeightTensorSize(TfLiteContext* context,
    41	                                      const TfLiteTensor* tensor, int dim1_size,
    42	                                      int dim2_size) {
    43	  TF_LITE_ENSURE_EQ(context, tensor->dims->size, 2);
    44	  TF_LITE_ENSURE_EQ(context, tensor->dims->data[0], dim1_size);
    45	  TF_LITE_ENSURE_EQ(context, tensor->dims->data[1], dim2_size);
    46	  return kTfLiteOk;
    47	}
    48	
    49	TfLiteStatus ValidateBiasTensorSize(TfLiteContext* context,
    50	                                    const TfLiteTensor* tensor, int size) {
    51	  TF_LITE_ENSURE_EQ(context, tensor->dims->size, 1);
    52	  TF_LITE_ENSURE_EQ(context, tensor->dims->data[0], size);
    53	  return kTfLiteOk;
    54	}
    55	
    56	// Go through every tensors and make sure their shape match the kernel
    57	// configuration
    58	TfLiteStatus ValidateTensorSize(TfLiteContext* context,
    59	                                const LstmTensors& tensors,
    60	                                const LstmSizeInfo& size_info) {
    61	  // Input FC weights
    62	  for (size_t i = 1; i < 5; i++) {
    63	    TF_LITE_ENSURE_OK(
    64	        context, ValidateWeightTensorSize(context, tensors.GetInternalTensor(i),
    65	                                          size_info.state_dimension,
    66	                                          size_info.input_dimension));
    67	  }
    68	  // Recurrent FC weights
    69	  for (size_t i = 5; i < 9; i++) {
    70	    TF_LITE_ENSURE_OK(
    71	        context, ValidateWeightTensorSize(context, tensors.GetInternalTensor(i),
    72	                                          size_info.state_dimension,
    73	                                          size_info.state_dimension));
    74	  }
    75	  // Biases
    76	  for (size_t i = 12; i < 16; i++) {
    77	    TF_LITE_ENSURE_OK(
    78	        context, ValidateBiasTensorSize(context, tensors.GetInternalTensor(i),
    79	                                        size_info.state_dimension));
    80	  }
    81	
    82	  // Check the shape of input state tensors.
    83	  // These tensor may be 1D or 2D. It's fine as long as the total size is
    84	  // correct.
    85	  TF_LITE_ENSURE_EQ(context, NumElements(tensors.HiddenStateTensor()),
    86	                    size_info.batch_size * size_info.state_dimension);
    87	  TF_LITE_ENSURE_EQ(context, NumElements(tensors.CellStateTensor()),
    88	                    size_info.batch_size * size_info.state_dimension);
    89	
    90	  // Check the shape of output tensor against that of input tensor
    91	  TF_LITE_ENSURE_EQ(context, tensors.OutputTensor()->dims->size, 3);
    92	  TF_LITE_ENSURE_EQ(context,
    93	                    tensors.GetInternalTensor(kLstmInputTensor)->dims->data[0],
    94	                    tensors.OutputTensor()->dims->data[0]);
    95	  TF_LITE_ENSURE_EQ(context,
    96	                    tensors.GetInternalTensor(kLstmInputTensor)->dims->data[1],
    97	                    tensors.OutputTensor()->dims->data[1]);
    98	  TF_LITE_ENSURE_EQ(context, tensors.OutputTensor()->dims->data[2],
    99	                    size_info.state_dimension);
   100	  return kTfLiteOk;
   101	}
