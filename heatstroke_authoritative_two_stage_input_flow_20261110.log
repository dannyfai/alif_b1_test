   294	def prepare_inputs(
   295	    batch_x1_2,
   296	    batch_x2,
   297	    batch_x_mark,
   298	):
   299	    """
   300	    Prepare the four inputs expected by the combined model.
   301	
   302	    x_values:
   303	        Masked sequence with missing sentinel values replaced by 0.
   304	
   305	    missing_mask:
   306	        1 = missing value
   307	        0 = available value
   308	
   309	    x_mark:
   310	        Temporal/calendar features.
   311	
   312	    worker_features:
   313	        30 worker-level features.
   314	    """
   315	
   316	    x_reg = to_numpy(batch_x1_2).astype(
   317	        np.float32,
   318	        copy=True,
   319	    )
   320	
   321	    worker_features = to_numpy(batch_x2).astype(
   322	        np.float32,
   323	        copy=True,
   324	    )
   325	
   326	    x_mark = to_numpy(batch_x_mark).astype(
   327	        np.float32,
   328	        copy=True,
   329	    )
   330	
   331	    # Identify all missing-value sentinel positions.
   332	    missing_mask = np.zeros(
   333	        x_reg.shape,
   334	        dtype=np.bool_,
   335	    )
   336	
   337	    for missing_value in MISSING_VALUES:
   338	        missing_mask |= (x_reg == missing_value)
   339	
   340	    # Replace missing values with zero.
   341	    x_values = np.where(
   342	        missing_mask,
   343	        0.0,
   344	        x_reg,
   345	    ).astype(np.float32)
   346	
   347	    # Convert mask to float32.
   348	    missing_mask = missing_mask.astype(np.float32)
   349	
   350	    return {
   351	        "x_values": x_values,
   352	        "missing_mask": missing_mask,
   353	        "x_mark": x_mark,
   354	        "worker_features": worker_features,
   355	    }, missing_mask
