    17	#define ITCM_BASE (DT_REG_ADDR(DT_NODELABEL(itcm)))
    18	#define ITCM_SIZE (DT_REG_SIZE(DT_NODELABEL(itcm)))
    19	#define DTCM_BASE (DT_REG_ADDR(DT_NODELABEL(dtcm)))
    20	#define DTCM_SIZE (DT_REG_SIZE(DT_NODELABEL(dtcm)))
    21	#define ITCM_GLOBAL_BASE DT_PROP(DT_NODELABEL(itcm), global_base)
    22	#define DTCM_GLOBAL_BASE DT_PROP(DT_NODELABEL(dtcm), global_base)
    23	
    24	static inline uint32_t local_to_global(const volatile void *local_addr)
    25	{
    26		uint32_t addr = (uint32_t)local_addr;
    27	
    28		if ((addr >= DTCM_BASE) && (addr < (DTCM_BASE + DTCM_SIZE))) {
    29			return (addr - DTCM_BASE + DTCM_GLOBAL_BASE);
    30		} else if ((addr < (ITCM_BASE + ITCM_SIZE))) {
    31			return (addr - ITCM_BASE + ITCM_GLOBAL_BASE);
    32		} else {
    33			return (addr);
    34		}
    35	}
    36	
    37	static inline uint32_t global_to_local(const volatile void *global_addr)
    38	{
    39		uint32_t addr = (uint32_t)global_addr;
    40	
    41		if ((addr >= DTCM_GLOBAL_BASE) && (addr < (DTCM_GLOBAL_BASE + DTCM_SIZE))) {
    42			return addr - DTCM_GLOBAL_BASE + DTCM_BASE;
    43		} else if ((addr >= ITCM_GLOBAL_BASE) && (addr < (ITCM_GLOBAL_BASE + ITCM_SIZE))) {
    44			return addr - ITCM_GLOBAL_BASE + ITCM_BASE;
    45		} else {
    46			return addr;
    47		}
    48	}
    49	
    50	#else /* No local TCM remap (e.g. Cortex-A32/APSS): addresses are already global */
    51	
    52	static inline uint32_t local_to_global(const volatile void *local_addr)
    53	{
    54		return (uint32_t)local_addr;
    55	}
    56	
    57	static inline uint32_t global_to_local(const volatile void *global_addr)
    58	{
    59		return (uint32_t)global_addr;
    60	}
    61	
    62	#endif
    63	
    64	#ifdef __cplusplus
    65	}
    66	#endif
    67	#endif /* SOC_MEMORY_MAP_H */

