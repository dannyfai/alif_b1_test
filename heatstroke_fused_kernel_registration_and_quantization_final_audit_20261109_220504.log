   100	
   101	#ifdef USE_TFLM_COMPRESSION
   102	
   103	// Overloads existing GetOptionalTensorData. If not compressed, this will return
   104	// tensor->data.
   105	template <typename T>
   106	const T* GetOptionalTensorData(MicroContext* micro_context,
   107	                               const TfLiteEvalTensor* tensor,
   108	                               const CompressionTensorData* compression_data,
   109	                               int scratch_buffer_handle) {
   110	  if (tensor == nullptr) {
   111	    return nullptr;
   112	  }
   113	  if (compression_data == nullptr) {
   114	    return reinterpret_cast<const T*>(tensor->data.data);
   115	  }
   116	
   117	  void* scratch_buffer = nullptr;
   118	  if (scratch_buffer_handle != -1) {
   119	    scratch_buffer = micro_context->GetScratchBuffer(scratch_buffer_handle);
   120	  } else {
   121	    size_t bytes_to_allocate = EvalTensorBytes(tensor);
   122	    scratch_buffer = micro_context->AllocateDecompressionMemory(
   123	        bytes_to_allocate, MicroArenaBufferAlignment());
   124	  }
   125	  TFLITE_DCHECK(scratch_buffer != nullptr);
   126	  void* uncompressed_data = micro_context->DecompressTensorToBuffer(
   127	      *tensor, *compression_data, scratch_buffer);
   128	  return reinterpret_cast<const T*>(uncompressed_data);
   129	}
   130	
   131	// Overloads existing GetTensorData. If not compressed, this will return
   132	// tensor->data.
   133	template <typename T>
   134	const T* GetTensorData(MicroContext* micro_context,
   135	                       const TfLiteEvalTensor* tensor,
   136	                       const CompressionTensorData* compression_data,
   137	                       int scratch_buffer_handle) {
   138	  TFLITE_DCHECK(tensor != nullptr);
   139	  return GetOptionalTensorData<T>(micro_context, tensor, compression_data,
   140	                                  scratch_buffer_handle);
   141	}
