    31	TfLiteStatus PrepareQuantizeReference(TfLiteContext* context,
    32	                                      TfLiteNode* node) {
    33	  TFLITE_DCHECK(node->user_data != nullptr);
    34	  auto* data = static_cast<OpDataQuantizeReference*>(node->user_data);
    35	
    36	  TF_LITE_ENSURE_EQ(context, NumInputs(node), 1);
    37	  TF_LITE_ENSURE_EQ(context, NumOutputs(node), 1);
    38	
    39	  MicroContext* micro_context = GetMicroContext(context);
    40	
    41	  TfLiteTensor* input = micro_context->AllocateTempInputTensor(node, 0);
    42	  TF_LITE_ENSURE(context, input != nullptr);
    43	  TfLiteTensor* output = micro_context->AllocateTempOutputTensor(node, 0);
    44	  TF_LITE_ENSURE(context, output != nullptr);
    45	
    46	  // TODO(b/128934713): Add support for fixed-point per-channel quantization.
    47	  // Currently this only support affine per-layer quantization.
    48	  TF_LITE_ENSURE_EQ(context, output->quantization.type,
    49	                    kTfLiteAffineQuantization);
    50	  const auto* affine_quantization =
    51	      reinterpret_cast<TfLiteAffineQuantization*>(output->quantization.params);
    52	  TF_LITE_ENSURE(context, affine_quantization);
    53	  TF_LITE_ENSURE(context, affine_quantization->scale);
    54	  TF_LITE_ENSURE(context, affine_quantization->scale->size == 1);
    55	
    56	  TF_LITE_ENSURE(
    57	      context, input->type == kTfLiteFloat32 || input->type == kTfLiteInt32 ||
    58	                   input->type == kTfLiteInt16 || input->type == kTfLiteInt8 ||
    59	                   input->type == kTfLiteUInt8);
    60	  TF_LITE_ENSURE(context, output->type == kTfLiteInt8 ||
    61	                              output->type == kTfLiteInt16 ||
    62	                              output->type == kTfLiteInt32 ||
    63	                              output->type == kTfLiteUInt8);
    64	
    65	  if ((input->type == kTfLiteInt16 && output->type == kTfLiteInt8) ||
    66	      (input->type == kTfLiteInt8 && output->type == kTfLiteInt8) ||
    67	      (input->type == kTfLiteInt8 && output->type == kTfLiteUInt8) ||
    68	      (input->type == kTfLiteUInt8 && output->type == kTfLiteInt8) ||
    69	      (input->type == kTfLiteInt8 && output->type == kTfLiteInt16) ||
    70	      (input->type == kTfLiteInt8 && output->type == kTfLiteInt32) ||
    71	      (input->type == kTfLiteInt16 && output->type == kTfLiteInt16) ||
    72	      (input->type == kTfLiteInt16 && output->type == kTfLiteInt32) ||
    73	      (input->type == kTfLiteInt32 && output->type == kTfLiteInt8) ||
    74	      (input->type == kTfLiteInt32 && output->type == kTfLiteInt16)) {
    75	    double effective_scale = static_cast<double>(input->params.scale) /
    76	                             static_cast<double>(output->params.scale);
    77	
    78	    QuantizeMultiplier(effective_scale, &data->requantize_output_multiplier,
    79	                       &data->requantize_output_shift);
    80	  }
    81	
    82	  data->quantization_params.zero_point = output->params.zero_point;
    83	  data->quantization_params.scale = static_cast<double>(output->params.scale);
    84	
    85	  data->input_zero_point = input->params.zero_point;
    86	
    87	  micro_context->DeallocateTempTfLiteTensor(input);
    88	  micro_context->DeallocateTempTfLiteTensor(output);
    89	  return kTfLiteOk;
    90	}
    91	
    92	TfLiteStatus EvalQuantizeReference(TfLiteContext* context, TfLiteNode* node) {
    93	  TFLITE_DCHECK(node->user_data != nullptr);
    94	  auto* data = static_cast<OpDataQuantizeReference*>(node->user_data);
    95	
    96	  const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
    97	  TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
    98	
    99	  if (input->type == kTfLiteFloat32) {
   100	    switch (output->type) {
   101	      case kTfLiteInt8:
   102	        reference_ops::AffineQuantize(
   103	            data->quantization_params, tflite::micro::GetTensorShape(input),
   104	            tflite::micro::GetTensorData<float>(input),
   105	            tflite::micro::GetTensorShape(output),
   106	            tflite::micro::GetTensorData<int8_t>(output));
   107	        break;
   108	      case kTfLiteInt16:
   109	        reference_ops::AffineQuantize(
   110	            data->quantization_params, tflite::micro::GetTensorShape(input),
   111	            tflite::micro::GetTensorData<float>(input),
   112	            tflite::micro::GetTensorShape(output),
   113	            tflite::micro::GetTensorData<int16_t>(output));
   114	        return kTfLiteOk;
   115	      default:
   116	        MicroPrintf("Input %s, output %s not supported.",
   117	                    TfLiteTypeGetName(input->type),
   118	                    TfLiteTypeGetName(output->type));
   119	        return kTfLiteError;
   120	    }
   121	  } else if (input->type == kTfLiteInt32) {
   122	    size_t size = ElementCount(*input->dims);
   123	    switch (output->type) {
   124	      case kTfLiteInt8:
   125	        reference_ops::Requantize(
   126	            tflite::micro::GetTensorData<int32_t>(input), size,
   127	            data->requantize_output_multiplier, data->requantize_output_shift,
   128	            data->input_zero_point, data->quantization_params.zero_point,
   129	            tflite::micro::GetTensorData<int8_t>(output));
   130	        break;
   131	      case kTfLiteInt16:
   132	        reference_ops::Requantize(
   133	            tflite::micro::GetTensorData<int32_t>(input), size,
   134	            data->requantize_output_multiplier, data->requantize_output_shift,
   135	            data->input_zero_point, data->quantization_params.zero_point,
   136	            tflite::micro::GetTensorData<int16_t>(output));
   137	        break;
   138	      default:
   139	        MicroPrintf("Input %s, output %s not supported.",
   140	                    TfLiteTypeGetName(input->type),
   141	                    TfLiteTypeGetName(output->type));
   142	        return kTfLiteError;
   143	    }
   144	  } else if (input->type == kTfLiteInt16) {
   145	    size_t size = ElementCount(*input->dims);
   146	    switch (output->type) {
   147	      case kTfLiteInt8:
   148	        reference_ops::Requantize(
   149	            tflite::micro::GetTensorData<int16_t>(input), size,
   150	            data->requantize_output_multiplier, data->requantize_output_shift,
   151	            data->input_zero_point, data->quantization_params.zero_point,
   152	            tflite::micro::GetTensorData<int8_t>(output));
   153	        break;
   154	      case kTfLiteInt16:
   155	        reference_ops::Requantize(
   156	            tflite::micro::GetTensorData<int16_t>(input), size,
   157	            data->requantize_output_multiplier, data->requantize_output_shift,
   158	            data->input_zero_point, data->quantization_params.zero_point,
   159	            tflite::micro::GetTensorData<int16_t>(output));
   160	        return kTfLiteOk;
   161	      case kTfLiteInt32:
   162	        reference_ops::Requantize(
   163	            tflite::micro::GetTensorData<int16_t>(input), size,
   164	            data->requantize_output_multiplier, data->requantize_output_shift,
   165	            data->input_zero_point, data->quantization_params.zero_point,
   166	            tflite::micro::GetTensorData<int32_t>(output));
   167	        return kTfLiteOk;
   168	      default:
   169	        MicroPrintf("Input %s, output %s not supported.",
   170	                    TfLiteTypeGetName(input->type),
   171	                    TfLiteTypeGetName(output->type));
   172	        return kTfLiteError;
   173	    }
   174	  } else if (input->type == kTfLiteInt8) {
   175	    // Int8 to Int8 requantization, required if the input and output tensors
   176	    // have different scales and/or zero points.
   177	    size_t size = ElementCount(*input->dims);
   178	    switch (output->type) {
   179	      case kTfLiteInt8:
   180	        reference_ops::Requantize(
   181	            tflite::micro::GetTensorData<int8_t>(input), size,
   182	            data->requantize_output_multiplier, data->requantize_output_shift,
   183	            data->input_zero_point, data->quantization_params.zero_point,
   184	            tflite::micro::GetTensorData<int8_t>(output));
   185	        break;
   186	      case kTfLiteUInt8:
   187	        reference_ops::Requantize(
   188	            tflite::micro::GetTensorData<int8_t>(input), size,
   189	            data->requantize_output_multiplier, data->requantize_output_shift,
   190	            data->input_zero_point, data->quantization_params.zero_point,
   191	            tflite::micro::GetTensorData<uint8_t>(output));
   192	        break;
   193	      case kTfLiteInt16:
   194	        reference_ops::Requantize(
   195	            tflite::micro::GetTensorData<int8_t>(input), size,
   196	            data->requantize_output_multiplier, data->requantize_output_shift,
   197	            data->input_zero_point, data->quantization_params.zero_point,
   198	            tflite::micro::GetTensorData<int16_t>(output));
   199	        break;
   200	      case kTfLiteInt32:
   201	        reference_ops::Requantize(
   202	            tflite::micro::GetTensorData<int8_t>(input), size,
   203	            data->requantize_output_multiplier, data->requantize_output_shift,
   204	            data->input_zero_point, data->quantization_params.zero_point,
   205	            tflite::micro::GetTensorData<int32_t>(output));
   206	        break;
   207	      default:
   208	        MicroPrintf("Input %s, output %s not supported.",
   209	                    TfLiteTypeGetName(input->type),
   210	                    TfLiteTypeGetName(output->type));
   211	        return kTfLiteError;
   212	    }
   213	  } else if (input->type == kTfLiteUInt8) {
   214	    size_t size = ElementCount(*input->dims);
   215	    switch (output->type) {
   216	      case kTfLiteInt8:
   217	        reference_ops::Requantize(
   218	            tflite::micro::GetTensorData<uint8_t>(input), size,
   219	            data->requantize_output_multiplier, data->requantize_output_shift,
   220	            data->input_zero_point, data->quantization_params.zero_point,
   221	            tflite::micro::GetTensorData<int8_t>(output));
   222	        break;
   223	      default:
   224	        MicroPrintf("Input %s, output %s not supported.",
   225	                    TfLiteTypeGetName(input->type),
   226	                    TfLiteTypeGetName(output->type));
   227	        return kTfLiteError;
   228	    }
   229	  } else {
   230	    MicroPrintf("Input %s, output %s not supported.",
   231	                TfLiteTypeGetName(input->type),
   232	                TfLiteTypeGetName(output->type));
   233	    return kTfLiteError;
   234	  }
   235	
   236	  return kTfLiteOk;
   237	}
