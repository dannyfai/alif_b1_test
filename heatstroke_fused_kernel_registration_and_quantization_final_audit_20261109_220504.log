2. Mutable resolver AddCustom implementation
    95	    }
    96	    return nullptr;
    97	  }
    98	
    99	  // Registers a Custom Operator with the MicroOpResolver.
   100	  //
   101	  // Only the first call for a given name will be successful. i.e. if this
   102	  // function is called again for a previously added Custom Operator, the
   103	  // MicroOpResolver will be unchanged and this function will return
   104	  // kTfLiteError.
   105	  TfLiteStatus AddCustom(const char* name,
   106	                         const TFLMRegistration* registration) {
   107	    if (registrations_len_ >= tOpCount) {
   108	      MicroPrintf(
   109	          "Couldn't register custom op '%s', resolver size is too"
   110	          "small (%d)",
   111	          name, tOpCount);
   112	      return kTfLiteError;
   113	    }
   114	
   115	    if (FindOp(name) != nullptr) {
   116	      MicroPrintf("Calling AddCustom for the same op more than once ");
   117	      MicroPrintf("is not supported (Op: %s).", name);
   118	      return kTfLiteError;
   119	    }
   120	
   121	    TFLMRegistration* new_registration = &registrations_[registrations_len_];
   122	    registrations_len_ += 1;
   123	
   124	    *new_registration = *registration;
   125	    new_registration->builtin_code = BuiltinOperator_CUSTOM;
   126	    new_registration->custom_name = name;
   127	    return kTfLiteOk;
   128	  }
   129	
   130	  // The Add* functions below add the various Builtin operators to the
   131	  // MicroMutableOpResolver object.
   132	
   133	  TfLiteStatus AddAbs() {
   134	    return AddBuiltin(BuiltinOperator_ABS, Register_ABS(), ParseAbs);
   135	  }

