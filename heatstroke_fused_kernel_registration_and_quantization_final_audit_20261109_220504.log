    32	// TODO(b/149795762): kTfLiteAbort cannot be part of the tflite TfLiteStatus.
    33	const TfLiteStatus kTfLiteAbort = static_cast<TfLiteStatus>(15);
    34	
    35	// MicroContext is eventually going to become the API between TFLM and the
    36	// kernels, replacing all the functions in TfLiteContext. The end state is code
    37	// kernels to have code like:
    38	//
    39	// MicroContext* micro_context = GetMicroContext(context);
    40	// micro_context-><TFLM kernel API>
    41	class MicroContext {
    42	 public:
    43	  virtual ~MicroContext() = default;
    44	
    45	  // Allocate persistent buffer which has the same life time as the interpreter.
    46	  // Returns nullptr on failure.
    47	  // The memory is allocated from the tail.
    48	  // This method is only available in Init or Prepare stage.
    49	  virtual void* AllocatePersistentBuffer(size_t bytes) = 0;
    50	
    51	  // Request a scratch buffer in the arena through static memory planning.
    52	  // This method is only available in Prepare stage and the buffer is allocated
    53	  // by the interpreter between Prepare and Eval stage. In Eval stage,
    54	  // GetScratchBuffer API can be used to fetch the address.
    55	  virtual TfLiteStatus RequestScratchBufferInArena(size_t bytes,
    56	                                                   int* buffer_idx) = 0;
    57	
    58	  // Get the scratch buffer pointer.
    59	  // This method is only available in Eval stage.
    60	  virtual void* GetScratchBuffer(int buffer_idx) = 0;
    61	
    62	  // Returns a temporary TfLiteTensor struct for a given index.
    63	  virtual TfLiteTensor* AllocateTempTfLiteTensor(int tensor_idx) = 0;
    64	
    65	  // Returns a temporary TfLiteTensor struct for the specified input tensor of a
    66	  // given mode. This is the recommended API over the deprecated
    67	  // GetInput/GetInputSafe to get a temp input tensor. The returned tensor shall
    68	  // be freed via calling DeallocateTempTfLiteTensor.
    69	  TfLiteTensor* AllocateTempInputTensor(const TfLiteNode* node, int index);
    70	
    71	  // Returns a temporary TfLiteTensor struct for the specified output tensor of
    72	  // a given mode. This is the recommended API over the deprecated
    73	  // GetOutput/GetOutputSafe to get a temp output tensor. The returned tensor
    74	  // shall be freed via calling DeallocateTempTfLiteTensor.
    75	  TfLiteTensor* AllocateTempOutputTensor(const TfLiteNode* node, int index);
    76	
    77	  // Returns a temporary TfLiteTensor struct for the specified intermediate
    78	  // tensor of a given mode. This is the recommended API over the deprecated
    79	  // GetIntermediates/GetIntermediatesSafe to get a temp intermediate tensor.
    80	  // The returned tensor shall be freed via calling DeallocateTempTfLiteTensor.
    81	  TfLiteTensor* AllocateTempIntermediateTensor(const TfLiteNode* node,
    82	                                               int index);
    83	
    84	  // Deallocates a temp TfLiteTensor.
    85	  virtual void DeallocateTempTfLiteTensor(TfLiteTensor* tensor) = 0;
    86	
    87	  // Returns a pointer to a temporary buffer (from the arena).
    88	  // This API is only valid from the kernel's Prepare function and
    89	  // the buffer's lifetime is also that of the Prepare function.
    90	  virtual uint8_t* AllocateTempBuffer(size_t size, size_t alignment) = 0;
    91	
    92	  // Signals that the temporary buffer is no longer needed.
    93	  virtual void DeallocateTempBuffer(uint8_t* buffer) = 0;
    94	
    95	  // Returns a TfLiteEvalTensor struct for a given index.
    96	  virtual TfLiteEvalTensor* GetEvalTensor(int tensor_idx) = 0;
    97	
    98	  // Does not take ownership of the pointer and the pointer must refer to valid
    99	  // an object that outlive this class instance.
   100	  // This can only be called once to set one external context.
   101	  virtual TfLiteStatus set_external_context(void* external_context_payload) = 0;
   102	
