    36	# ---------------------------------------------------------------------------
    37	# Ethos-U NPU selection
    38	# ---------------------------------------------------------------------------
    39	# When ETHOSU_TARGET_NPU_CONFIG is provided on the command line it is the single
    40	# source of truth for the NPU. We must act on it BEFORE find_package(Zephyr) so
    41	# that the matching Kconfig choice (CONFIG_ARM_ETHOS_U<arch>_<macs>) is fed into
    42	# the build and the Ethos-U driver targets the requested NPU. This overrides the
    43	# board default (E8 rtss_hp defaults to Ethos-U55 with 256 MACs).
    44	#
    45	# The parsed value is also used to pick the correct Vela-compiled model below.
    46	# Vela config-ID prefix: U55 -> H, U65 -> Y, U85 -> Z (e.g. ethos-u85-256 -> Z256).
    47	if (DEFINED ETHOSU_TARGET_NPU_CONFIG)
    48	    string(TOLOWER "${ETHOSU_TARGET_NPU_CONFIG}" _npu_cfg)
    49	    if (_npu_cfg MATCHES "^ethos-(u[0-9]+)-([0-9]+)$")
    50	        set(_npu_arch "${CMAKE_MATCH_1}")
    51	        set(_npu_macs "${CMAKE_MATCH_2}")
    52	        if (_npu_arch STREQUAL "u55")
    53	            set(_npu_prefix "H")
    54	        elseif (_npu_arch STREQUAL "u65")
    55	            set(_npu_prefix "Y")
    56	        elseif (_npu_arch STREQUAL "u85")
    57	            set(_npu_prefix "Z")
    58	        else()
    59	            message(FATAL_ERROR
    60	                "Unsupported Ethos-U architecture '${_npu_arch}' in "
    61	                "ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}'")
    62	        endif()
    63	        set(ETHOS_U_NPU_CONFIG_ID "${_npu_prefix}${_npu_macs}")
    64	
    65	        # Feed the matching Kconfig choice into the Zephyr configuration.
    66	        string(TOUPPER "${_npu_arch}" _npu_arch_uc)
    67	        set(CONFIG_ARM_ETHOS_${_npu_arch_uc}_${_npu_macs} y
    68	            CACHE INTERNAL "Selected Ethos-U NPU configuration" FORCE)
    69	        message(STATUS
    70	            "Ethos-U: ETHOSU_TARGET_NPU_CONFIG=${ETHOSU_TARGET_NPU_CONFIG} -> "
    71	            "CONFIG_ARM_ETHOS_${_npu_arch_uc}_${_npu_macs}=y, model ID ${ETHOS_U_NPU_CONFIG_ID}")
    72	    else()
    73	        message(FATAL_ERROR
    74	            "Invalid ETHOSU_TARGET_NPU_CONFIG='${ETHOSU_TARGET_NPU_CONFIG}'.\n"
    75	            "Expected format: ethos-u<arch>-<macs>, e.g. ethos-u55-256 or ethos-u85-256")
    76	    endif()
    77	endif()
