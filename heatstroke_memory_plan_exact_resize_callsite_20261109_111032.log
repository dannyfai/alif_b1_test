    55	// Returns true if all temporary buffers are already deallocated.
    56	bool NonPersistentArenaBufferAllocator::IsAllTempDeallocated() {
    57	  if (temp_buffer_count_ != 0 || temp_buffer_ptr_check_sum_ != 0) {
    58	    MicroPrintf(
    59	        "Number of allocated temp buffers: %d. Checksum passing status: %d",
    60	        temp_buffer_count_, !temp_buffer_ptr_check_sum_);
    61	    return false;
    62	  }
    63	  return true;
    64	}
    65	
    66	// Signals that all temporary allocations can be reclaimed. TFLM calls this
    67	// API when it knows that all temporary buffers that it requested has been
    68	// deallocated. The goal of API is to facilitate implementations of
    69	// INonPersistentBufferAllocator can reuse buffer with some reasonable
    70	// complexity.
    71	TfLiteStatus NonPersistentArenaBufferAllocator::ResetTempAllocations() {
    72	  if (!IsAllTempDeallocated()) {
    73	    MicroPrintf(
    74	        "All temp buffers must be freed before calling ResetTempAllocations()");
    75	    return kTfLiteError;
    76	  }
    77	  next_temp_ = head_temp_;
    78	  return kTfLiteOk;
    79	}
