    49	// Signals that a temporary buffer is no longer needed.
    50	void NonPersistentArenaBufferAllocator::DeallocateTemp(uint8_t* temp_buf) {
    51	  temp_buffer_ptr_check_sum_ ^= reinterpret_cast<intptr_t>(temp_buf);
