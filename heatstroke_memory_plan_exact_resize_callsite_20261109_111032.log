   100	// Resizes a buffer that is previously returned by the AllocateResizableBuffer.
   101	// Note that ResizeBuffer(old_resizable_buf, 0, 1) effectively deallocates
   102	// a previous allocated resizable buffer.
   103	TfLiteStatus NonPersistentArenaBufferAllocator::ResizeBuffer(
   104	    uint8_t* resizable_buf, size_t size, size_t alignment) {
   105	  // Only supports one resizable buffer, which starts at the buffer head.
   106	  uint8_t* expect_resizable_buf = AlignPointerUp(buffer_head_, alignment);
   107	  if (resizable_buf != expect_resizable_buf) {
   108	    MicroPrintf("Internal error: buffer is not resizable");
   109	    return kTfLiteError;
   110	  }
   111	  if (head_temp_ != next_temp_) {
   112	    MicroPrintf("ResetTempAllocations() is not called before ResizeBuffer().");
   113	    return kTfLiteError;
   114	  }
   115	
   116	  const size_t available_memory = buffer_tail_ - expect_resizable_buf;
   117	  if (available_memory < size) {
   118	    MicroPrintf(
   119	        "Failed to resize buffer. Requested: %u, available %u, missing: %u",
   120	        size, available_memory, size - available_memory);
   121	    return kTfLiteError;
   122	  }
   123	  head_temp_ = expect_resizable_buf + size;
   124	  next_temp_ = head_temp_;
   125	
   126	  return kTfLiteOk;
   127	}
   128	
   129	// Frees up the memory occupied by the resizable buffer.
   130	TfLiteStatus NonPersistentArenaBufferAllocator::DeallocateResizableBuffer(
   131	    uint8_t* resizable_buf) {
   132	  TfLiteStatus status = ResizeBuffer(resizable_buf, 0, 1);
   133	  if (status == kTfLiteOk) {
   134	    resizable_buffer_allocated_ = false;
   135	  }
   136	  return status;
   137	}
