   139	// Returns a pointer pointing to the start of the overlay memory, which is
   140	// used for activation tensors and scratch buffers by kernels at Invoke stage.
   141	uint8_t* NonPersistentArenaBufferAllocator::GetOverlayMemoryAddress() const {
   142	  return buffer_head_;
