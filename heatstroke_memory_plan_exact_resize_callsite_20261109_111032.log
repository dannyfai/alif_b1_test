    81	// Returns a buffer that is resizable viable ResizeBuffer().
    82	uint8_t* NonPersistentArenaBufferAllocator::AllocateResizableBuffer(
    83	    size_t size, size_t alignment) {
    84	  // Only supports one resizable buffer, which starts at the buffer head.
    85	  uint8_t* expected_resizable_buf = AlignPointerUp(buffer_head_, alignment);
    86	
    87	  if (resizable_buffer_allocated_) {
    88	    MicroPrintf(
    89	        "Cannot allocate a new resizable buffer when one is already allocated");
    90	    return nullptr;
    91	  }
    92	
    93	  if (ResizeBuffer(expected_resizable_buf, size, alignment) == kTfLiteOk) {
    94	    resizable_buffer_allocated_ = true;
    95	    return expected_resizable_buf;
    96	  }
    97	  return nullptr;
    98	}
