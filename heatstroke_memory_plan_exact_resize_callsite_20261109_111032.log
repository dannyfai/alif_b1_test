    82	TfLiteStatus SingleArenaBufferAllocator::ResizeBuffer(uint8_t* resizable_buf,
    83	                                                      size_t size,
    84	                                                      size_t alignment) {
    85	  // Only supports one resizable buffer, which starts at the buffer head.
    86	  uint8_t* expect_resizable_buf = AlignPointerUp(buffer_head_, alignment);
    87	  if (head_ != temp_ || resizable_buf != expect_resizable_buf) {
    88	    MicroPrintf(
    89	        "Internal error: either buffer is not resizable or "
    90	        "ResetTempAllocations() is not called before ResizeBuffer().");
    91	    return kTfLiteError;
    92	  }
    93	
    94	  uint8_t* const aligned_result = AlignPointerUp(buffer_head_, alignment);
    95	  const size_t available_memory = tail_ - aligned_result;
    96	  if (available_memory < size) {
    97	    MicroPrintf(
    98	        "Failed to resize buffer. Requested: %u, available %u, missing: %u",
    99	        size, available_memory, size - available_memory);
   100	    return kTfLiteError;
   101	  }
   102	  head_ = aligned_result + size;
   103	  temp_ = head_;
   104	
   105	  return kTfLiteOk;
   106	}
   107	
   108	uint8_t* SingleArenaBufferAllocator::AllocatePersistentBuffer(
   109	    size_t size, size_t alignment) {
   110	  uint8_t* const aligned_result = AlignPointerDown(tail_ - size, alignment);
   111	  if (aligned_result < head_) {
   112	#ifndef TF_LITE_STRIP_ERROR_STRINGS
   113	    const size_t missing_memory = head_ - aligned_result;
   114	    MicroPrintf(
   115	        "Failed to allocate tail memory. Requested: %u, "
   116	        "available %u, missing: %u",
   117	        size, size - missing_memory, missing_memory);
   118	#endif
   119	    return nullptr;
   120	  }
   121	  tail_ = aligned_result;
   122	  return aligned_result;
   123	}
