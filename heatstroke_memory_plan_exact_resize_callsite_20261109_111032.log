   144	
   145	// Reserves the size of the overlay memory. This overlay is reserved for the
   146	// kernels at Invoke stage. This is referred to as the overlay because before
   147	// Invoket state, the same memory can be used for temp buffers. The layout of
   148	// the memory is planned by the memory planner separately at Invoke stage.
   149	TfLiteStatus
   150	NonPersistentArenaBufferAllocator::ReserveNonPersistentOverlayMemory(
   151	    size_t size, size_t alignment) {
   152	  uint8_t* expect_resizable_buf = AlignPointerUp(buffer_head_, alignment);
   153	  return ResizeBuffer(expect_resizable_buf, size, alignment);
   154	}
   155	
   156	// Returns the size of non-persistent buffer in use.
   157	size_t NonPersistentArenaBufferAllocator::GetNonPersistentUsedBytes() const {
   158	  return (next_temp_ - buffer_head_);
   159	}
   160	
   161	// Returns the number of bytes available with a given alignment. This number
   162	// takes in account any temporary allocations.
   163	size_t NonPersistentArenaBufferAllocator::GetAvailableMemory(
   164	    size_t alignment) const {
   165	  uint8_t* const aligned_temp = AlignPointerUp(next_temp_, alignment);
   166	  uint8_t* const aligned_tail = AlignPointerDown(buffer_tail_, alignment);
   167	  return aligned_tail - aligned_temp;
   168	}
