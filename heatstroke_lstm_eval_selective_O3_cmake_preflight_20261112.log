    15	# Locate the alif-mlek west module. Its Zephyr port lives in a sub-directory,
    16	# so the module is not auto-discovered and must be registered explicitly. Ask
    17	# west for the module path instead of hardcoding the workspace layout.
    18	execute_process(
    19	    COMMAND west list --format "{abspath}" alif-mlek
    20	    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
    21	    OUTPUT_VARIABLE MLEK_ROOT
    22	    OUTPUT_STRIP_TRAILING_WHITESPACE
    23	    RESULT_VARIABLE MLEK_LIST_RESULT
    24	    ERROR_QUIET
    25	)
    26	if (MLEK_LIST_RESULT OR NOT EXISTS ${MLEK_ROOT})
    27	    message(FATAL_ERROR
    28	        "alif-mlek module not found. Enable and fetch it first:\n"
    29	        "  west config manifest.project-filter -- +alif-mlek\n"
    30	        "  west update\n")
    31	endif()
