+/*
+ * SIGN has a SignOptions FlatBuffer table, but no runtime parameters are
+ * required by this implementation. Validate its options type and leave
+ * builtin_data null.
+ */
+TfLiteStatus ParseHeatstrokeSign(
+    const tflite::Operator* op,
+    tflite::ErrorReporter*,
+    tflite::BuiltinDataAllocator*,
+    void** builtin_data)
+{
+    if (builtin_data != nullptr) {
+        *builtin_data = nullptr;
+    }
+
+    if (op == nullptr ||
+        op->builtin_options_type() !=
+            tflite::BuiltinOptions_SignOptions) {
+        return kTfLiteError;
+    }
+
+    return kTfLiteOk;
 }
 
+/*
+ * Application-local INT32 SIGN implementation.
+ *
+ * y = -1 when x < 0
+ * y =  0 when x = 0
+ * y =  1 when x > 0
+ *
+ * No temporary buffer or scratch allocation is required.
+ */
+TfLiteStatus HeatstrokeSignEval(
+    TfLiteContext* context,
+    TfLiteNode* node)
+{
+    if (context == nullptr || node == nullptr) {
+        return kTfLiteError;
+    }
+
+    const TfLiteEvalTensor* input =
+        tflite::micro::GetEvalInput(context, node, 0);
+
+    TfLiteEvalTensor* output =
+        tflite::micro::GetEvalOutput(context, node, 0);
+
+    if (input == nullptr || output == nullptr) {
+        return kTfLiteError;
+    }
+
+    if (input->type != kTfLiteInt32 ||
+        output->type != kTfLiteInt32) {
+        MicroPrintf(
+            "Heatstroke SIGN requires INT32 input/output. "
+            "Input=%d Output=%d",
+            input->type,
+            output->type);
+        return kTfLiteError;
+    }
+
+    const auto input_shape =
+        tflite::micro::GetTensorShape(input);
+
+    const auto output_shape =
+        tflite::micro::GetTensorShape(output);
+
+    const int input_count = input_shape.FlatSize();
+    const int output_count = output_shape.FlatSize();
+
+    if (input_count < 0 || input_count != output_count) {
+        MicroPrintf(
+            "Heatstroke SIGN tensor element-count mismatch.");
+        return kTfLiteError;
+    }
+
+    const int32_t* input_data =
+        tflite::micro::GetTensorData<int32_t>(input);
+
+    int32_t* output_data =
+        tflite::micro::GetTensorData<int32_t>(output);
+
+    if (input_count > 0 &&
+        (input_data == nullptr || output_data == nullptr)) {
+        MicroPrintf(
+            "Heatstroke SIGN received a null tensor data pointer.");
+        return kTfLiteError;
+    }
+
+    for (int i = 0; i < input_count; ++i) {
+        const int32_t value = input_data[i];
+
+        output_data[i] =
+            (value > 0) ? 1 : ((value < 0) ? -1 : 0);
+    }
+
+    return kTfLiteOk;
+}
+
+TFLMRegistration RegisterHeatstrokeSignKernel()
+{
+    return tflite::micro::RegisterOp(
+        nullptr,
+        nullptr,
+        HeatstrokeSignEval);
+}
