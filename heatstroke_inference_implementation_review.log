   217	std::shared_ptr<iface::TensorIface> TflmModel::GetInputTensor(size_t index) const
   218	{
   219	    if (index < this->GetNumInputs()) {
   220	        return this->m_input.at(index);
   221	    }
   222	    return {};
   223	}
