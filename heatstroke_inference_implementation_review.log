   368	size_t TflmModel::GetNumInputs() const
   369	{
   370	    if (this->m_backendData.m_pModel && this->m_backendData.m_pInterpreter) {
   371	        return this->m_backendData.m_pInterpreter->inputs_size();
   372	    }
   373	    return 0;
