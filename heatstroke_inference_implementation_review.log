    22	namespace arm::app::fwk::tflm {
    23	
    24	TflmTensor::TflmTensor(TfLiteTensor* tensor) : m_tensor(tensor) {}
    25	
    26	void* TflmTensor::GetData()
    27	{
    28	    assert(this->m_tensor);
    29	    return this->m_tensor->data.data;
    30	}
    31	
    32	size_t TflmTensor::Bytes()
    33	{
    34	    assert(this->m_tensor);
    35	    return this->m_tensor->bytes;
    36	}
    37	
    38	size_t TflmTensor::GetNumElements()
    39	{
    40	    assert(this->m_tensor);
    41	    const auto shape = this->Shape();
    42	    size_t nElements = 1;
    43	    for (auto& dim : shape) {
    44	        nElements *= dim;
    45	    }
    46	    return nElements;
    47	}
    48	
    49	std::vector<size_t> TflmTensor::Shape()
    50	{
    51	    assert(this->m_tensor);
    52	    assert(this->m_tensor->dims);
    53	    return std::vector<size_t>(this->m_tensor->dims->data,
    54	                               this->m_tensor->dims->data + this->m_tensor->dims->size);
    55	}
    56	
    57	iface::TensorType TflmTensor::Type()
    58	{
    59	    assert(this->m_tensor);
    60	
    61	    switch (this->m_tensor->type) {
    62	    case kTfLiteUInt8:
    63	        return iface::TensorType::UINT8;
    64	    case kTfLiteInt8:
    65	        return iface::TensorType::INT8;
    66	    case kTfLiteInt16:
    67	        return iface::TensorType::INT16;
    68	    case kTfLiteInt32:
    69	        return iface::TensorType::INT32;
    70	    case kTfLiteFloat16:
    71	        return iface::TensorType::FP16;
    72	    case kTfLiteFloat32:
    73	        return iface::TensorType::FP32;
    74	    default:
    75	        return iface::TensorType::INVALID;
    76	    }
    77	}
    78	
    79	iface::TensorLayout TflmTensor::Layout()
    80	{
    81	    return iface::TensorLayout::NHWC;
    82	}
    83	
    84	iface::QuantParams TflmTensor::GetQuantParams()
    85	{
    86	    iface::QuantParams params{0.f, 0};
    87	    assert(this->m_tensor);
    88	    if (kTfLiteAffineQuantization == this->m_tensor->quantization.type) {
    89	        auto* quantParams =
    90	            reinterpret_cast<TfLiteAffineQuantization*>(this->m_tensor->quantization.params);
    91	        if (quantParams && 0 == quantParams->quantized_dimension) {
    92	            if (quantParams->scale->size) {
    93	                params.scale = quantParams->scale->data[0];
    94	            }
    95	            if (quantParams->zero_point->size) {
    96	                params.offset = quantParams->zero_point->data[0];
    97	            }
    98	        } else if (this->m_tensor->params.scale != 0.0) {
    99	            /* Legacy tensorflow quantisation parameters */
   100	            params.scale  = this->m_tensor->params.scale;
   101	            params.offset = this->m_tensor->params.zero_point;
   102	        }
   103	    }
   104	    return params;
   105	}
