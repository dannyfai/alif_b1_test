   106	/**
   107	 * @brief Tensor interface class.
   108	 */
   109	class TensorIface {
   110	public:
   111	    TensorIface()                        = default; /**< Constructor */
   112	    virtual ~TensorIface()               = default; /** Destructor */
   113	
   114	    /** Gets pointer to actual tensor data. */
   115	    virtual void* GetData()              = 0;
   116	
   117	    /** Gets number of bytes occupied by tensor data. */
   118	    virtual size_t Bytes()               = 0;
   119	
   120	    /** Gets number of elements in the tensor (all dimensions combined). */
   121	    virtual size_t GetNumElements()      = 0;
   122	
   123	    /** Gets the tensor data type. */
   124	    virtual TensorType Type()            = 0;
   125	
   126	    /** Gets the tensor layout. */
   127	    virtual TensorLayout Layout()        = 0;
   128	
   129	    /** Gets the tensor shape, expressed as a std::vector */
   130	    virtual std::vector<size_t> Shape()  = 0;
   131	
   132	    /** Gets the quantization parameters for this tensor. */
   133	    virtual QuantParams GetQuantParams() = 0;
   134	
   135	    /** Utility function to get the tensor data pointer in required pointer format. */
   136	    template <typename T>
   137	    T* GetData()
   138	    {
   139	        return reinterpret_cast<T*>(this->GetData());
   140	    }
   141	};
