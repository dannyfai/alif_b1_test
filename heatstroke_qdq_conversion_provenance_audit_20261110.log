   261	def convert_savedmodel_to_int8(
   262	    saved_model_dir,
   263	    signature_mapping,
   264	    representative_dataset,
   265	    output_path,
   266	):
   267	    converter = tf.lite.TFLiteConverter.from_saved_model(
   268	        str(saved_model_dir),
   269	        signature_keys=["serving_default"],
   270	    )
   271	    converter.optimizations = [tf.lite.Optimize.DEFAULT]
   272	    converter.representative_dataset = representative_dataset
   273	    converter.target_spec.supported_ops = [
   274	        tf.lite.OpsSet.TFLITE_BUILTINS_INT8
   275	    ]
   276	    converter.inference_input_type = tf.int8
   277	    converter.inference_output_type = tf.int8
   278	    converter.allow_custom_ops = False
   279	
   280	    print("\nConverting SavedModel to full-integer INT8 TFLite...")
   281	    tflite_bytes = converter.convert()
   282	
   283	    output_path.parent.mkdir(parents=True, exist_ok=True)
   284	    output_path.write_bytes(tflite_bytes)
   285	    print("INT8 TFLite saved:", output_path)
