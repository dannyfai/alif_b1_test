   116	def process_regor(
   117	    arch,
   118	    input_name,
   119	    accelerator,
   120	    system_config,
   121	    options,
   122	    enable_debug_db,
   123	    output_dir,
   124	    output_format,
   125	    verbose_weights=False,
   126	    verbose_cycle_estimate=False,
   127	    show_cpu_operations=False,
   128	    verbose_performance=False,
   129	):
   130	    os.makedirs(output_dir, exist_ok=True)
   131	
   132	    with open(input_name, "rb") as f:
   133	        with mmap.mmap(f.fileno(), length=0, access=mmap.ACCESS_READ) as network:
   134	            fmt = get_format(network)
   135	            compiled_model = regor.compile(accelerator, network, fmt, system_config, options=options, verbose=True)
   136	
   137	    model_name = os.path.splitext(os.path.basename(input_name))[0]
   138	
   139	    output_basename = os.path.join(output_dir, model_name)
   140	
   141	    if output_format == "tflite":
   142	        assert isinstance(compiled_model, regor.CompiledTFLiteModel)
   143	        output_name = output_basename + "_vela.tflite"
   144	        with open(output_name, "wb") as f:
   145	            f.write(compiled_model.model)
   146	    elif output_format == "raw":
   147	        assert isinstance(compiled_model, regor.CompiledRawModel)
   148	        rawdata_writer.write_rawdata_output_from_model(output_basename, compiled_model)
   149	    else:
   150	        assert False, f"Unsupported output_format = {output_format}"
   151	
   152	    summary_csv_file = "{0}_summary_{1}.csv".format(output_basename, arch.system_config)
   153	
   154	    if verbose_performance:
   155	        stats_writer.write_regor_perlayer_performance_csv(
   156	            arch, compiled_model.opt_database, compiled_model.perf_report, output_basename
   157	        )
   158	        stats_writer.print_regor_perlayer_performance(
   159	            arch, compiled_model.opt_database, compiled_model.perf_report, output_basename
   160	        )
   161	
   162	    stats_writer.print_regor_performance_metrics(
   163	        arch,
   164	        compiled_model.perf_report,
   165	        model_name,
   166	        summary_csv_file,
   167	        compiled_model.opt_database,
   168	        verbose_weights,
   169	        verbose_cycle_estimate,
   170	        show_cpu_operations,
   171	    )
   172	    if enable_debug_db:
   173	        stats_writer.write_regor_db(compiled_model.opt_database, output_basename)
