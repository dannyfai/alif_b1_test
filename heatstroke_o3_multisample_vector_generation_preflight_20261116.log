=== CURRENT MCU SMOKE FUNCTION ===

static float DecodeSmokeReference(const std::uint32_t bits)
{
    float value = 0.0F;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

static int SmokeFloatToMicro(const float value)
{
    const double scaled = static_cast<double>(value) * 1000000.0;
    if (scaled > 2147483647.0) {
        return 2147483647;
    }
    if (scaled < -2147483648.0) {
        return (-2147483647 - 1);
    }
    return static_cast<int>(scaled >= 0.0 ? scaled + 0.5 : scaled - 0.5);
}

static unsigned int SmokeArgMax4(const float* values)
{
    unsigned int best = 0U;
    for (unsigned int i = 1U; i < 4U; ++i) {
        if (values[i] > values[best]) {
            best = i;
        }
    }
    return best;
}

static bool RunHeatstrokeSmokeInference(PolyUModel1& model)
{
    using arm::app::fwk::iface::TensorIface;

    static_assert(sizeof(float) == sizeof(std::uint32_t),
                  "Smoke test requires 32-bit FP32");
    static_assert(sizeof(heatstroke_smoke::kXValuesBits) == 5400U * sizeof(float),
                  "x_values payload size mismatch");
    static_assert(sizeof(heatstroke_smoke::kMissingMaskBits) == 5400U * sizeof(float),
                  "missing_mask payload size mismatch");
    static_assert(sizeof(heatstroke_smoke::kXMarkBits) == 2700U * sizeof(float),
                  "x_mark payload size mismatch");
    static_assert(sizeof(heatstroke_smoke::kWorkerFeaturesBits) == 30U * sizeof(float),
                  "worker_features payload size mismatch");

    LOG_INF("=== ONE-SAMPLE HEATSTROKE MCU INFERENCE ===");
    LOG_INF("Calibration sample index: %u",
            static_cast<unsigned int>(heatstroke_smoke::kDatasetSampleIndex));
    LOG_INF("Missing positions: %u",
            static_cast<unsigned int>(heatstroke_smoke::kMissingCount));
    LOG_INF("Input-vector SHA256: %s",
            heatstroke_smoke::kInputReferenceSha256);

    if (!BindSmokeInputTensor(
            model, 0U, "x_values",
            heatstroke_smoke::kXValuesBits,
            sizeof(heatstroke_smoke::kXValuesBits),
            std::vector<size_t>{1U, 900U, 6U})) {
        return false;
    }

    if (!BindSmokeInputTensor(
            model, 1U, "missing_mask",
            heatstroke_smoke::kMissingMaskBits,
            sizeof(heatstroke_smoke::kMissingMaskBits),
            std::vector<size_t>{1U, 900U, 6U})) {
        return false;
    }

    if (!BindSmokeInputTensor(
            model, 2U, "x_mark",
            heatstroke_smoke::kXMarkBits,
            sizeof(heatstroke_smoke::kXMarkBits),
            std::vector<size_t>{1U, 900U, 3U})) {
        return false;
    }

    if (!BindSmokeInputTensor(
            model, 3U, "worker_features",
            heatstroke_smoke::kWorkerFeaturesBits,
            sizeof(heatstroke_smoke::kWorkerFeaturesBits),
            std::vector<size_t>{1U, 30U})) {
        return false;
    }

    arm::app::fwk::tflm::ResetHeatstrokeOperatorTiming();
    const std::int64_t startMs = k_uptime_get();
    LOG_INF("HEATSTROKE_DIAG: entering TFLM RunInference()");
    StartHeatstrokeEthosuMonitor();
    const bool inferenceOk = model.RunInference();
    StopHeatstrokeEthosuMonitor();
    arm::app::fwk::tflm::LogHeatstrokeOperatorTiming();
    if (!inferenceOk) {
        LOG_ERR("TFLM RunInference() returned false");
        return false;
    }
    const std::int64_t elapsedMs = k_uptime_get() - startMs;

    auto rpeTensor = model.GetOutputTensor(0U);
    auto psiTensor = model.GetOutputTensor(1U);

    if (!VerifyOneTensor(
            "Output rpe_logits", 0U, rpeTensor,
            std::vector<size_t>{1U, 4U}) ||
        !VerifyOneTensor(
            "Output psi_logits", 1U, psiTensor,
            std::vector<size_t>{1U, 4U})) {
        return false;
    }

    const float* rpe = rpeTensor->GetData<float>();
    const float* psi = psiTensor->GetData<float>();

    if (rpe == nullptr || psi == nullptr) {
        LOG_ERR("Inference output data pointer is null");
        return false;
    }

    float rpeRef[4];
    float psiRef[4];
    float rpeMaxError = 0.0F;
    float psiMaxError = 0.0F;
    double rpeErrorSum = 0.0;
    double psiErrorSum = 0.0;

    for (unsigned int i = 0U; i < 4U; ++i) {
        rpeRef[i] = DecodeSmokeReference(
            heatstroke_smoke::kReferenceRpeBits[i]);
        psiRef[i] = DecodeSmokeReference(
            heatstroke_smoke::kReferencePsiBits[i]);

        if (!std::isfinite(rpe[i]) || !std::isfinite(psi[i]) ||
            !std::isfinite(rpeRef[i]) || !std::isfinite(psiRef[i])) {
            LOG_ERR("Non-finite output/reference at class index %u", i);
            return false;
        }

        const float rpeError = std::fabs(rpe[i] - rpeRef[i]);
        const float psiError = std::fabs(psi[i] - psiRef[i]);

        if (rpeError > rpeMaxError) {
            rpeMaxError = rpeError;
        }
        if (psiError > psiMaxError) {
            psiMaxError = psiError;
        }

        rpeErrorSum += rpeError;
        psiErrorSum += psiError;
    }

    const float rpeMeanError = static_cast<float>(rpeErrorSum / 4.0);
    const float psiMeanError = static_cast<float>(psiErrorSum / 4.0);

    LOG_INF("TFLM RunInference: SUCCESS; elapsed=%u ms",
            static_cast<unsigned int>(elapsedMs));

    LOG_INF("RPE reference micro: [%d,%d,%d,%d]",
            SmokeFloatToMicro(rpeRef[0]), SmokeFloatToMicro(rpeRef[1]),
            SmokeFloatToMicro(rpeRef[2]), SmokeFloatToMicro(rpeRef[3]));
    LOG_INF("RPE MCU micro:       [%d,%d,%d,%d]",
            SmokeFloatToMicro(rpe[0]), SmokeFloatToMicro(rpe[1]),
            SmokeFloatToMicro(rpe[2]), SmokeFloatToMicro(rpe[3]));

    LOG_INF("PSI reference micro: [%d,%d,%d,%d]",
            SmokeFloatToMicro(psiRef[0]), SmokeFloatToMicro(psiRef[1]),
            SmokeFloatToMicro(psiRef[2]), SmokeFloatToMicro(psiRef[3]));
    LOG_INF("PSI MCU micro:       [%d,%d,%d,%d]",
            SmokeFloatToMicro(psi[0]), SmokeFloatToMicro(psi[1]),
            SmokeFloatToMicro(psi[2]), SmokeFloatToMicro(psi[3]));

    LOG_INF("RPE max/mean abs error micro: %d / %d",
            SmokeFloatToMicro(rpeMaxError),
            SmokeFloatToMicro(rpeMeanError));
    LOG_INF("PSI max/mean abs error micro: %d / %d",
            SmokeFloatToMicro(psiMaxError),
            SmokeFloatToMicro(psiMeanError));

    const unsigned int rpeRefClass = SmokeArgMax4(rpeRef);
    const unsigned int psiRefClass = SmokeArgMax4(psiRef);
    const unsigned int rpeMcuClass = SmokeArgMax4(rpe);
    const unsigned int psiMcuClass = SmokeArgMax4(psi);

    LOG_INF("RPE class reference=%u MCU=%u match=%s",
            rpeRefClass, rpeMcuClass,
            rpeRefClass == rpeMcuClass ? "yes" : "no");
    LOG_INF("PSI class reference=%u MCU=%u match=%s",
            psiRefClass, psiMcuClass,
            psiRefClass == psiMcuClass ? "yes" : "no");

    LOG_INF("Activation arena capacity: %u bytes",
            static_cast<unsigned int>(model.GetComputeBuffer().size));
    LOG_INF("Model buffer size: %u bytes",
            static_cast<unsigned int>(model.GetModelBuffer().size));

    LOG_INF("=== ONE-SAMPLE HEATSTROKE INFERENCE COMPLETE ===");
    return true;
}

