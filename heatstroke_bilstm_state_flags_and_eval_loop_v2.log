   107	const int32_t kInt16Max = std::numeric_limits<int16_t>::max();
   108	const int32_t kInt16Min = std::numeric_limits<int16_t>::min();
   109	
   110	void AddElementWise(const int16_t* input_1, const int16_t* input_2, int n_batch,
   111	                    int n_input, int16_t* output) {
   112	  for (int batch = 0; batch < n_batch; ++batch) {
   113	    for (int i = 0; i < n_input; ++i) {
   114	      const int index = batch * n_input + i;
   115	      int32_t sum = input_1[index] + input_2[index];
   116	      const int32_t sum_clamped = std::min(kInt16Max, std::max(kInt16Min, sum));
   117	      output[index] = static_cast<int16_t>(sum_clamped);
   118	    }
   119	  }
   120	}
   121	
   122	void AddElementWise(const float* input_1, const float* input_2, int n_batch,
   123	                    int n_input, float* output) {
   124	  for (int batch = 0; batch < n_batch; ++batch) {
   125	    for (int i = 0; i < n_input; ++i) {
   126	      const int index = batch * n_input + i;
   127	      output[index] = input_1[index] + input_2[index];
   128	    }
   129	  }
   130	}
