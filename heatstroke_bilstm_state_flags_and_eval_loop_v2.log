    31	LstmTensors::LstmTensors(TfLiteContext* context, TfLiteNode* node) {
    32	  micro_context_ = GetMicroContext(context);
    33	  // 24 internal tensors. see lstm_shared.h for tensor names
    34	  for (size_t i = 0; i < 24; i++) {
    35	    internal_tensors_[i] = micro_context_->AllocateTempInputTensor(node, i);
    36	  }
    37	  output_tensor_ =
    38	      micro_context_->AllocateTempOutputTensor(node, kLstmOutputTensor);
    39	}
    40	
    41	LstmTensors::~LstmTensors() {
    42	  for (size_t i = 0; i < 24; i++) {
    43	    if (internal_tensors_[i] != nullptr) {
    44	      micro_context_->DeallocateTempTfLiteTensor(internal_tensors_[i]);
    45	    }
    46	  }
    47	  micro_context_->DeallocateTempTfLiteTensor(output_tensor_);
    48	}
    49	
    50	// Verify the LSTM internal tensor properties (e.g., type checks)
    51	// Input/output/states/fc weights tensors are required for kernel evaulation.
    52	// The state tensors should be variables. Variants of the standard LSTM
    53	// are not supported here, therefore their corresponding tensors should be
    54	// invalid
    55	TfLiteStatus LstmTensors::ValidateTensorStatus(TfLiteContext* context) const {
    56	  // Verify certain tensor properties
    57	  // input tensor
    58	  TF_LITE_ENSURE(context, internal_tensors_[kLstmInputTensor] != nullptr);
    59	  // hidden state
    60	  TF_LITE_ENSURE(context, internal_tensors_[kLstmOutputStateTensor] != nullptr);
    61	  TF_LITE_ENSURE(context,
    62	                 internal_tensors_[kLstmOutputStateTensor]->is_variable);
    63	  // hidden state becomes input so they must have the same type
    64	  TF_LITE_ENSURE_EQ(context, internal_tensors_[kLstmOutputStateTensor]->type,
    65	                    internal_tensors_[kLstmInputTensor]->type);
    66	  // cell state
    67	  TF_LITE_ENSURE(context, internal_tensors_[kLstmCellStateTensor] != nullptr);
    68	  TF_LITE_ENSURE(context, internal_tensors_[kLstmCellStateTensor]->is_variable);
    69	  // output
    70	  TF_LITE_ENSURE(context, output_tensor_ != nullptr);
    71	  // output type is the same as the input type (activations)
    72	  TF_LITE_ENSURE_EQ(context, output_tensor_->type,
    73	                    internal_tensors_[kLstmInputTensor]->type);
    74	
    75	  // weight tensors (1-9, see lstm_shared for index definition)
    76	  const auto weight_type =
    77	      internal_tensors_[kLstmInputToForgetWeightsTensor]->type;
    78	  for (size_t i = 1; i < 9; i++) {
    79	    TF_LITE_ENSURE(context, internal_tensors_[i] != nullptr);
    80	    TF_LITE_ENSURE_EQ(context, internal_tensors_[i]->type, weight_type);
    81	  }
    82	
    83	  // bias tensors (12-15, see lstm_shared for index definition)
    84	  const auto bias_type = internal_tensors_[kLstmForgetGateBiasTensor]->type;
    85	  for (size_t i = 12; i < 16; i++) {
    86	    TF_LITE_ENSURE(context, internal_tensors_[i] != nullptr);
    87	    TF_LITE_ENSURE_EQ(context, internal_tensors_[i]->type, bias_type);
    88	  }
    89	  // Tensors from LSTM variants are invalid
    90	  // No peephole
    91	  for (size_t i = 9; i < 12; i++) {
    92	    TF_LITE_ENSURE(context, internal_tensors_[i] == nullptr);
    93	  }
    94	  // No projection
    95	  for (size_t i = 16; i < 18; i++) {
    96	    TF_LITE_ENSURE(context, internal_tensors_[i] == nullptr);
    97	  }
    98	  // No internal layer norm
    99	  for (size_t i = 20; i < 24; i++) {
   100	    TF_LITE_ENSURE(context, internal_tensors_[i] == nullptr);
   101	  }
   102	  return kTfLiteOk;
   103	}
