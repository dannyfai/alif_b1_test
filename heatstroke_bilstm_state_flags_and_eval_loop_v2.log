    17	struct HeatstrokeBidirectionalLstmOpData {
    18	  OpDataLSTM forward;
    19	  OpDataLSTM backward;
    20	  TfLiteIntArray* staged_output_dims;
    21	  int reverse_input_buffer;
    22	  int stage_output_buffer;
